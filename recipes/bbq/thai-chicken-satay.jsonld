{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai Chicken Satay",
  "cookTime": "PT8M",
  "recipeYield": "4 Servings",
  "recipeCategory": "Starter",
  "recipeIngredient": [
    "500 g chicken breast ( cut into 2.5 cm wide 7.5 cm long)",
    "8 bamboo skewers",
    "1/2 cup coconut milk (For the marinade)",
    "2 tbsp minced galangal",
    "2 tbsp minced lemon grass",
    "1 tbsp coriander powder",
    "1-2 tbsp turmeric or curry powder",
    "1 tsp salt",
    "1 tsp sugar (for the marinade)",
    "1-2 tsp white or black pepper",
    "1/2 cup coconut milk (For the satay sauce)",
    "1/4 cup coarsely ground roast peanut or peanut",
    "1/4 cup red curry paste",
    "1/4 cup tamarind juice",
    "1 tsp salt or fish sauce",
    "2 red spur chillies (finely sliced)",
    "1 cucumber (sliced in quarters length then sliced thin)",
    "1-2 shallot (finely chopped)",
    "1/2 sugar (for the cucumber relish sauce)",
    "1/2 cup vinegar"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the chicken into thin wide strips. A single strip will be threaded on a skewer lengthways."
    },
    {
      "@type": "HowToStep",
      "text": "Make the marinade, by combining all the dry ingredients in a food processor, then adding the liquids."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chicken to the marinade, cover with clingfilm, and refrigerate for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "To make the satay sauce, put the coarsely ground peanuts in a pan,then add the red curry paste, and coconut milk. Bring to the boil, then turn down the heat and add the remaining ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "To make the cucumber relish, put the vinegar in a small pan, add the sugar, and dissolve over  low heat. Turn off the heat and allow to cool. Add the cucumber, shallot and chilli."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 15 minutes plus 2 hours marrinade"
    }
  ],
  "prepTime": "15 minutes plus 2 hours marrinade",
  "keywords": [
    "BBQ"
  ]
}
