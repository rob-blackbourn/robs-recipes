{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Rum & Lime Lamb",
  "recipeYield": "1 serving",
  "recipeIngredient": [
    "220 g lamb neck fillet (cut into 2.5 cm cubes,",
    "1 tbsp olive oil,",
    "2 tbsp rum,",
    "juice of 1 lime,",
    "2 small spring onions,",
    "1/2 bay leaf,",
    "1 chilli (seeded and sliced),",
    "1/2 tsp ground allspice,",
    "1/2 tsp dried thyme,",
    "a pinch of cloves,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix together and marinate for 4 hours."
    }
  ],
  "keywords": [
    "BBQ"
  ]
}
