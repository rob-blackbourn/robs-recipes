{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Sweet Chili Chicken Skewers",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "1 tbsp coriander leaves",
    "20ml vegetable oil",
    "1 tsp Asian hot chilli sauce, such as Sriracha",
    "1 tsp light brown sugar",
    "1 tsp soy sauce",
    "1 cloves garlic",
    "1 cm fresh ginger (peeled and roughly chopped)",
    "1/2 small onion (roughly chopped)",
    "sea salt",
    "200 g boneless, skinless chicken thighs (cut into twelve 10 cm strips)",
    "Sweet chilli dipping sauce (to serve)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the coriander, oil, chilli sauce, sugar, soy sauce, garlic, ginger, onions and 1/2 tsp salt in a mini food processor and process until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the skewers and thread a piece of chicken onto each skewer. Place the skewers in a large nonreactive baking dish and rub with the marinade mixture. Cover and marinate in the refrigerator 1 to 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat a grill or grill pan over medium-high heat. Remove the skewers from the baking dish and discard the marinade."
    },
    {
      "@type": "HowToStep",
      "text": "Cook the chicken, turning once, until well charred and cooked through, 4 to 6 minutes per side."
    }
  ],
  "keywords": [
    "BBQ"
  ]
}
