{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Honeyed Prawn Skewers",
  "cookTime": "PT4M",
  "prepTime": "PT20M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 kg large raw shrimp, peeled and tails intact",
    "2 tbsp light soy sauce",
    "3 tsp hoisin sauce",
    "1 tbsp barbecue sauce",
    "1 tsp chili sauce",
    "1 tbsp honey",
    "1 tbsp oil",
    "1 tbsp dry sherry",
    "2 cloves garlic, crushed"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine sauces, honey, oil, sherry and garlic in large bowl, add prawns and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and marinate for 1-2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Barbecue over high heat until prawns are cooked, brushing with marinade while cooking."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 2 hours to marinate."
    }
  ],
  "keywords": [
    "BBQ"
  ]
}
