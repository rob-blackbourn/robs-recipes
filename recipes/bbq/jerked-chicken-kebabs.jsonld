{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Jerked Chicken Kebabs",
  "prepTime": "PT20M",
  "cookTime": "PT10M",
  "recipeCuisine": "Jamaica",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "200 g boneless skinless chicken breasts",
    "50 ml jerked chicken marinade",
    "1 medium bowl jerked chicken Mango Salsa"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the chicken into 3cm pieces. Add all but most of the marinade to a 3.75L plastic sealable bag. Add the chicken to the bag and leave to marinate in the refrigerator for 1 to 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the grill to medium-high. Remove the chicken from the marinade and discard the used marinade. Skewer the chicken pieces and grill on 1 side for about 5 minutes. Flip and grill the other side until cooked through and grill marks appear."
    },
    {
      "@type": "HowToStep",
      "text": "Serve the chicken topped with the mango salsa. Use the reserved (unused) marinade as a dipping sauce."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Metal skewers, or bamboo skewers presoaked in water"
    }
  ],
  "citation": [
    "../jerked-chicken-marinade.jsonld",
    "../jerked-chicken-mango-salsa.jsonld"
  ],
  "keywords": [
    "BBQ",
    "poultry",
    "chicken"
  ]
}
