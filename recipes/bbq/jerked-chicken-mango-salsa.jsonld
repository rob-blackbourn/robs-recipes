{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Jerked Chicken Mango Salsa",
  "prepTime": "PT5M",
  "recipeYield": "1 bowl",
  "recipeCuisine": "Jamaica",
  "recipeIngredient": [
    "2 tbsp brown sugar",
    "3 tbsp freshly squeezed lime juice",
    "1/2 tsp hot sauce",
    "1 tbsp minced ginger",
    "1 mango, diced",
    "1 English cucumber, diced",
    "2 spring onions, diced",
    "Pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "in a medium bowl, combine the sugar, lime juice, hot sauce and ginger. Mix thoroughly and then add the remaining ingredients. Toss and refrigerate for 1 hour."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Waiting time: 1 hour"
    },
    {
      "@type": "Comment",
      "text": "Original yield: 1 medium bowl"
    }
  ],
  "keywords": [
    "BBQ"
  ]
}
