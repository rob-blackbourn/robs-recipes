{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Lamb Shish Kebab",
  "prepTime": "10 minutes plus 2 hour marinade",
  "cookTime": "PT10M",
  "recipeCuisine": "Indian",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 kg boned leg of lamb (cut into chunks)",
    "2 medium onions (cut into chunks)",
    "2 green peppers (cut into chunks)",
    "2 tomatoes (cut into chunks)",
    "1 clove garlic (finely chopped)",
    "1” ginger (finely chopped)",
    "2 tbsp lemon juice",
    "4 tbsp olive oil",
    "1/2 tsp ground turmeric",
    "1 tsp ground coriander",
    "1 tsp ground cumin",
    "1/8 tsp cayenne pepper",
    "1 tbsp grated onion (For the marinade)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the marinade ingredients in a large bowl. Add the lamb and mix well. Leave in the fridge for 2 hours or overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Skewer the meat and vegetables and grill fof 10 minutes.."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 2 hour to marinate."
    }
  ],
  "keywords": [
    "BBQ",
    "meat",
    "lamb"
  ]
}
