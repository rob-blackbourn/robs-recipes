{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai Grilled Whole Chicken - Gai Yang",
  "prepTime": "PT1H30M",
  "cookTime": "PT1H30M",
  "recipeCuisine": "Thai",
  "recipeYield": "2 chickens",
  "recipeIngredient": [
    "1 large chicken",
    "Bamboo sticks or skewers",
    "2 heads garlic finely chopped",
    "1 stalks lemongrass finely chopped",
    "1 1/4 tbsp black pepper corns",
    "4 coriander roots, finely chopped (optional)",
    "2 tbsp soy sauce",
    "1/2 tsp fish sauce (for the marinade)",
    "1 tbsp palm sugar",
    "1/2 tsp dark soy sauce",
    "4 tbsp water",
    "3/4 tbsp khao kua",
    "3/4 tbsp chili flakes",
    "1/2 tsp of sugar",
    "1 1/2 tbsp fish sauce (for the sauce)",
    "4 tbsp tamarind water",
    "few sprigs of coriander"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare the marinade by whizzing the dry ingredients in a food processor then adding the liquids."
    },
    {
      "@type": "HowToStep",
      "text": "Butterfly the chicken and marinate in the fridge for 2 hours or overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Tie the chicken to a frame of skewers."
    },
    {
      "@type": "HowToStep",
      "text": "Grill over a low heat for 1 hour 30 minutes, turning every 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Prepare the sauce by mixing the ingredients."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Add 2 hours for the marinade"
    },
    {
      "@type": "Comment",
      "text": "A large chicken should weigh 1.8 kg."
    }
  ],
  "keywords": [
    "BBQ"
  ]
}
