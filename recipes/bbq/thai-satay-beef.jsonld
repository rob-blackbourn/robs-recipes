{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai Satay Beef",
  "cookTime": "PT7M",
  "recipeCuisine": "Thai",
  "recipeYield": "4 skewers",
  "recipeIngredient": [
    "1 kg beef top sirloin steak, sliced thin across grain, about 3 mm thick",
    "1 tbsp grated ginger",
    "4 cloves garlic, crushed",
    "2 tbsp minced onion",
    "1/4 cup packed brown sugar",
    "1/4 cup fish sauce",
    "2 tbsp soy sauce",
    "2 tbsp vegetable oil",
    "2 tbsp ground coriander",
    "1 tbsp cumin",
    "1/2 tsp turmeric",
    "1/8 tsp cayenne pepper",
    "1 rounded tbsp minced lemongrass"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine all the ingredients for the marinade."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the beef into thin strips."
    },
    {
      "@type": "HowToStep",
      "text": "Put the sliced beef in the marinade, cover with clingfilm, and refrigerate for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Thread onto four long metal skewers and barbecue for 8 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 15 minutes with a 2 hour marination"
    },
    {
      "@type": "Comment",
      "text": "Original yield: 4 large skewers"
    }
  ],
  "prepTime": "15 minutes with a 2 hour marination",
  "keywords": [
    "BBQ"
  ]
}
