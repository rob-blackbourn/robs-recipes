{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Beef Empanada",
  "prepTime": "PT30M",
  "cookTime": "PT12M",
  "recipeCuisine": "Argentina",
  "recipeCategory": "Street Food",
  "recipeYield": "12 servings",
  "recipeIngredient": [
    "1 kg of empanada dough",
    "4 onions chopped",
    "2 tsp salt",
    "1 tbsp smoked paprika",
    "1 tbsp chilli flakes",
    "1 tbsp cumin",
    "oregano",
    "500 g sirloin chopped into 1cm cubes",
    "3 spring onions chopped",
    "3 eggs - boiled and roughly chopped",
    "egg wash",
    "black olives (optional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put some lard in a medium frying pan on a medium heat, add four chopped onions and fry till soft."
    },
    {
      "@type": "HowToStep",
      "text": "Season with 2 tsp salt, 1 tbsp smoked paprika, 1 tbsp chilli flakes,  1 tbsp cumin."
    },
    {
      "@type": "HowToStep",
      "text": "Empty the pan into a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add some more lard and sear 500g sirloin chopped into 1cm cubes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the meat to the bowl with the onions."
    },
    {
      "@type": "HowToStep",
      "text": "Add to the mixture, 3 chopped spring onions, and 3 roughly chopped boiled eggs."
    },
    {
      "@type": "HowToStep",
      "text": "Chill the mixture in the fridge."
    },
    {
      "@type": "HowToStep",
      "text": "After the mixture is cooled fill the empanada with 2 tbsp per circle of pstry."
    },
    {
      "@type": "HowToStep",
      "text": "Bake them in the oven at 200°C for 10-15 minutes."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Parchment paper."
    }
  ],
  "citation": [
    "./empanada-dough.jsonld"
  ]
}
