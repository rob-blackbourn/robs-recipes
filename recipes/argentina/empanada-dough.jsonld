{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Argentina",
  "name": "Empanada Dough",
  "prepTime": "PT10M",
  "recipeYield": "1 kg",
  "recipeIngredient": [
    "500 ml water",
    "15 ml coarse salt",
    "60 g lard",
    "1 kg plain flour"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a small saucepan bring the water to the boil and add the salt and lard."
    },
    {
      "@type": "HowToStep",
      "text": "Once the lard has melted, let the liquid cool."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the liquid with 840 g plain flour and knead it till dry and a little hard."
    },
    {
      "@type": "HowToStep",
      "text": "Roll out the dough and cut into 5 circles the size of side plates."
    },
    {
      "@type": "HowToStep",
      "text": "Put the dough into the fridge to chill."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Small saucepan"
    },
    {
      "@type": "HowToTool",
      "name": "Rolling pin,"
    }
  ]
}
