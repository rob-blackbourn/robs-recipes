{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Steamed Sea Bass with Lime",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 whole sea bass (approximately 450g, cleaned, scaled, and trimmed),",
    "5 green and red hot chillis (finely chopped),",
    "5 cloves garlic (finely chopped),",
    "½ cup chicken stock (or water),",
    "3 tbsp lime juice,",
    "1 ½ tbsp light soy sauce.",
    "1 lime (sliced),",
    "1 sprig coriander,",
    "1 medium tomato."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Score the fish diagonally on both sides and put on a plate."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the chilli and garlic with the stock and stir well. Add the lime juice and light soy sauce and stir again. Pour over the fish. If possible leave a stripe of the sauce over the top of the fish for good presentation."
    },
    {
      "@type": "HowToStep",
      "text": "Steam over boiling water on high heat for 8-10 mins or until done."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the steamer and garnish with the slices of lime and a sprig of coriander."
    },
    {
      "@type": "HowToStep",
      "text": "Prepare the tomato by cutting down from the top into quarters, but not breaking the skin at the bottom. Open it like the petals of a flower and put on the side of the plate."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Prep time: ?"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 8-10 minutes"
    },
