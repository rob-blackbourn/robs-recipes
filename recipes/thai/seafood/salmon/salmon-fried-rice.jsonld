{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thai",
  "recipeCategory": "Small Plate",
  "name": "Salmon Fried Rice",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 clove garlic (minced with a little salt)",
    "1 banana shallot",
    "1 large egg (lightly mixed)",
    "250g cooked rice",
    "large pinch white sugar",
    "2 tbsp light soy sauce",
    "3 spring onions (cut into 1cm lengths)",
    "2 salmon steak weighing 240g (cut into bite size pieces)",
    "plenty of coriander to garnish (cut roughly)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat oil in a hot wok on a high heat."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, fry until fragrant and beginning to colour, then reserve."
    },
    {
      "@type": "HowToStep",
      "text": "Add the shallot, fry and reserve."
    },
    {
      "@type": "HowToStep",
      "text": "Add the egg. Wait a few seconds for the albumen to whiten, then continually move. Once cooked reserve."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce to a medium heat and add the salmon, after a few seconds move continually. When cooked reserve."
    },
    {
      "@type": "HowToStep",
      "text": "Add a little more oil, and then the rice. Fry gently mixing well."
    },
    {
      "@type": "HowToStep",
      "text": "Add the soy sauce, sugar, and pepper, and mix thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Add the reserved egg and salmon."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with coriander and cucumber."
    }
  ],
  "keywords": [
    "Seafood",
    "Salmon",
    "fish"
  ]
}
