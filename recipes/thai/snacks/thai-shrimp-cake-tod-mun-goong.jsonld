{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Thai Shrimp Cake - Tod Mun Goong",
  "recipeYield": "8 servings",
  "recipeIngredient": [
    "800g prawn",
    "100g pork fat",
    "1 egg white",
    "1 tbsp tapioca flour",
    "1 1/2 tbsp light soy sauce",
    "1/2 tsp sea salt",
    "1 1/2 tsp pepper",
    "3 tbsp sesame oil",
    "1 cup panko breadcrumbs"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Clean prawns, shell, discard heads and tails, and devein without slitting back."
    },
    {
      "@type": "HowToStep",
      "text": "Toss prawns in tapioca flour and wash under running water until clear."
    },
    {
      "@type": "HowToStep",
      "text": "Pat dry with a paper towel and flatten each prawn with a cleaver."
    },
    {
      "@type": "HowToStep",
      "text": "Put prawns in a mixing bowl and add pork fat, egg white, tapioca flour, soy sauce, salt and pepper. Knead to combine."
    },
    {
      "@type": "HowToStep",
      "text": "Add sesame oil and continue kneading the mixture by throwing it against the side of the bowl until stiff."
    },
    {
      "@type": "HowToStep",
      "text": "Refrigerate until very cold."
    },
    {
      "@type": "HowToStep",
      "text": "Roll the prawn mixture into a donut shape (about 80 grams each) and coat with breadcrumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry until golden."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from oil and drain on kitchen towels."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Untried"
    }
  ],
  "keywords": [
    "Snacks",
    "meat",
    "pork",
    "seafood",
    "prawns"
  ]
}
