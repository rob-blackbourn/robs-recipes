{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Fish Cakes - Thawt Man Plaa",
  "recipeCuisine": "Thai",
  "recipeCategory": "Small Plate",
  "recipeYield": "30 servings",
  "recipeIngredient": [
    "450 g firm white fish fillets (roughly chopped)",
    "1 tbsp red curry paste",
    "1 tbsp fish sauce",
    "1 egg",
    "50 g green beans (very thinly sliced)",
    "5 kaffir lime leaves (finely shredded)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mince the fish in a food processor until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add the curry paste, fish sauce, and egg, then blend briefly."
    },
    {
      "@type": "HowToStep",
      "text": "Spoon into a bowl and mix with the beans and lime leaves."
    },
    {
      "@type": "HowToStep",
      "text": "Take a tbsp of the mixture and form into a 2” round cake."
    },
    {
      "@type": "HowToStep",
      "text": "Shallow fry on both sides."
    }
  ],
  "keywords": [
    "fish",
    "white fish"
  ]
}
