{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Pineapple Fried Rice",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "230 g leftover and overnight rice,",
    "2 cloves garlic (finely chopped),",
    "1 fresh pineapple,",
    "8 medium prawns (shelled and deveined),",
    "2 tbsp cashew nuts,",
    "1 tsp shrimp paste,",
    "1 tbsp fish sauce,",
    "1/4 tsp dark soy sauce,",
    "1 fresh red chili (seeded and cut into small pieces),",
    "2 tbsp oil,",
    "Coriander leaves for garnishing."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the pineapple in two. Scoop out the flesh and reserve. Separate the juice into a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Heat up a wok and add oil. Stir-fry garlic, red chili, and shrimp paste until aromatic."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prawns and stir-fry until half-cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rice, pineapple pieces, 1/2 tbsp of the pineapple juice, and stir. Add fish sauce and dark soy sauce to blend well with rice."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cashew nuts"
    },
    {
      "@type": "HowToStep",
      "text": "Stir-fry for another minute then serve."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Prep Time: ?"
    },
