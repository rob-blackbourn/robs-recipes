{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Thai Satay Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT0M",
  "totalTime": "PT15M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "150g  unsalted roasted peanuts,",
    "80ml water,",
    "2 cloves garlic,",
    "1/2 tbsp dark soy sauce,",
    "2 tsp sesame oil,",
    "1½ tbsp brown sugar,",
    "2 tbsp fish sauce (for vegetarians substitute 3 tbsp light soy sauce),",
    "1/2 tsp tamarind paste,",
    "1/2 tsp cayenne pepper,",
    "1/3 cup coconut milk."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place all ingredients in a blender. Blend or process until smooth."
    }
  ],
