{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Cucumber Relish",
  "recipeYield": "3/4 cup",
  "recipeIngredient": [
    "80 ml rice vinegar",
    "125g sugar",
    "1 small red chilli (seeded and chopped)",
    "1 tsp fish sauce",
    "80g peanuts (lightly roasted and roughly chopped)",
    "1 cucumber (unpeeled, seeded, and finely diced)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the vinegar and sugar into a small saucepan with 125 ml water and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce heat and simmer for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Allow to cool before adding the chilli, fish sauce, and peanuts."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Very good."
    }
  ],
  "keywords": [
    "Dips"
  ]
}
