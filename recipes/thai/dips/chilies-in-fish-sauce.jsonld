{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Chilies in Fish Sauce",
  "recipeIngredient": [
    "1/4 cup fish sauce",
    "10-15 birds eye chilies (finely sliced)",
    "2 garlic cloves (finely sliced)",
    "1 tbsp lime juice",
    "good pinch of chopped coriander"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the fish sauce, chillies and garlic in a bowl and set aside. It keeps for some time – in fact it becomes richer and milder as it settles for a day. Make sure it is covered if you are making it in advance – and if the fish sauce evaporates, add an equivalent amount of water to refresh it. Just before serving, stir through the lime juice and coriander."
    }
  ],
  "keywords": [
    "Dips",
    "fish"
  ]
}
