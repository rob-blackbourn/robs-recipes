{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Tom Yum Kung",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "2 cups chicken stock",
    "5 slices young galangal",
    "2 stalks lemongrass (diagonally sliced)",
    "2 kaffir lime leaves (torn)",
    "10 tiger prawns (shelled, deveined, with tails)",
    "15 straw mushrooms (halved)",
    "3 tbsp fish sauce",
    "3 tbsp lime juice",
    "1 tbsp roasted chilli paste",
    "6 hot chilies (lightly crushed)",
    "2 bunches coriander (cut to 1 cm long)",
    "Kaffir lime leaves, coriander sprig and diagonally sliced lemongrass for granish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Bring the stock to the boil over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Add galangal, lemongrass, and kaffir lime leaves. Cook until fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prawns and mushroom. Cook until done."
    },
    {
      "@type": "HowToStep",
      "text": "Season with fish sauce, lime juice, and roasted chili paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add hot chili and coriander. Remove from heat."
    }
  ],
  "keywords": [
    "Soup",
    "seafood",
    "prawns",
    "poultry",
    "chicken",
    "fish"
  ]
}
