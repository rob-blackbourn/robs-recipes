{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Tom Kha Kai",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "totalTime": "PT20M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "400ml coconut milk",
    "15 slices young galangal",
    "200g chicken breast (cut into very thin pieces)",
    "75g straw mushrooms",
    "1 tsp palm sugar",
    "2 tbsp tamarind juice or 1 tbsp tamarind concentrate",
    "1 tbsp lime juice",
    "3 tbsp fish sauce",
    "3 kaffir lime leaves (torn)",
    "1 stalk lemongrass (lightly crushed, then sliced diagonally)",
    "2 long red chillies (lightly crushed, then sliced)",
    "2 kaffir lime leaves (Garnish)",
    "2 sprigs coriander leaves",
    "1/4 stalk lemongrass (sliced diagonally) (Garnish)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the coconut milk in a saucepan and bring to a boil over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Add galangal and reduce to a low heat. Simmer until the milk is fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Add chicken and mushrooms. Increase to a medium heat and cook until the chicken is done."
    },
    {
      "@type": "HowToStep",
      "text": "Season with sugar, tamarind juice, lime juice and fish sauce. Add torn kaffir lime leaves and lemongrass. Bring to the boil, then turn off the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Ladle into serving bowls. Add the chilli, kaffir lime leaves, coriander and lemongrass."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Made once, contains untried changes.."
    }
  ],
  "keywords": [
    "Soup"
  ]
}
