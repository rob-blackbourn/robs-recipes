{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Red Curry with Roasted Duck and Lychees\nKaeng Phet Pet Yaang",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1/2 Chinese roast duck",
    "4 tsp red curry paste",
    "400 ml coconut cream",
    "2 tsp ground sweet paprika",
    "2 mild fresh chilies (de-seeded)",
    "3 kaffir lime leaves (torn in half)",
    "1 tbsp palm sugar",
    "2 tbsp fish sauce",
    "8 lychees (cut in half)",
    "Salt",
    "Lime juice",
    "Fresh basil leaves to garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Remove the meat from the bones and slice."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the curry paste with half the coconut milk and simmer for 2 1/2 minutes stirring occasionally."
    },
    {
      "@type": "HowToStep",
      "text": "Add the remaining coconut cream."
    },
    {
      "@type": "HowToStep",
      "text": "Add 1/3 cup water."
    },
    {
      "@type": "HowToStep",
      "text": "Add the paprika chillies, lime leaves, sugar and fish sauce. Simmer for 3-4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat and add the duck and the lychees to the sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and lime juice."
    },
    {
      "@type": "HowToStep",
      "text": "Serve when the duck is warmed through."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1Hq6wHvx19q4IBzHeiEgGrNewZqysK3wSSiXECilwnyA/edit"
  ],
  "keywords": [
    "Meat",
    "Duck"
  ]
}
