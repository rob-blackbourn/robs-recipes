{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Beef with Chilli and Kaffir Lime Leaves",
  "recipeYield": "5 servings",
  "recipeIngredient": [
    "2 1/2 tbsp oil",
    "2 cloves of garlic (chopped)",
    "2-5 birds eye chilies (to taste)",
    "1 medium sized red onion (chopped)",
    "400 g beef fillet (very thinly sliced)",
    "1 1/2 tbsp fish sauce",
    "1 tbsp oyster sauce",
    "1/2 - 1 tbsp sugar",
    "4-5 Kaffir lime leaves (very finely shredded)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Stir fry the garlic, chilies, and onion for 1 1/2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beef and stir fry over a high heat for about 1 1/2 minutes until the meat changes colour."
    },
    {
      "@type": "HowToStep",
      "text": "Season with fish sauce, oyster sauce, and sugar, then stir in the shredded lime leaves."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Really good."
    },
    {
      "@type": "Comment",
      "text": "Original yield: 4-5"
    }
  ],
  "keywords": [
    "Meat",
    "Beef"
  ]
}
