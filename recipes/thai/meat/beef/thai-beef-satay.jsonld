{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thai",
  "name": "Thai Beef Satay",
  "prepTime": "PT30M",
  "cookTime": "PT15M",
  "totalTime": "PT45M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "500 g beef steak sliced into very thin strips or diced into 3/4” cubes",
    "12 wooden skewers",
    "Thai Satay Marinade",
    "Thai Satay Sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the skewers for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the marinade over and stir well to combine. Allow at least 1 hour for marinating, or longer (up to 24 hours)."
    },
    {
      "@type": "HowToStep",
      "text": "When ready to cook, thread meat onto the skewers. Tip: Fill up to 3/4 of the skewer; leaving the lower half empty so the person grilling has a \"handle\" to easily turn the satay."
    },
    {
      "@type": "HowToStep",
      "text": "Cook on an outdoor grill, basting the first time you time it with a little of the leftover marinade from the bottom of the bowl. Turn the satay every 5 to 6 minutes until done to your liking (15 to 25 minutes)."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Successful"
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1eJfYMmuzKkpLKXjIcgBCsgpO-EN1ffAypXl1qxPvwss/edit",
    "https://docs.google.com/document/d/192KFaQAN3KjAMe9je1wKzudpX54_MLCeFam-acZDi80/edit"
  ],
  "keywords": [
    "Meat",
    "Beef"
  ]
}
