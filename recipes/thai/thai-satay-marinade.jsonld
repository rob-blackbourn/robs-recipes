{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Thai Satay Marinade",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "totalTime": "PT10M",
  "recipeYield": "100 g",
  "recipeIngredient": [
    "1/4 cup chopped fresh lemongrass stalks",
    "2 roughly chopped shallots",
    "4 cloves garlic",
    "1 fresh red chilli",
    "1 chopped thumb-size piece galangal",
    "1/2 tsp turmeric",
    "2 tbsp ground coriander",
    "2 tsp cumin",
    "3 tbsp dark soy sauce",
    "4 tbsp fish sauce",
    "5 tbsp brown sugar",
    "2 tbsp vegetable oil",
    "3 cardamom pods"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place all marinade ingredients in a blender and whizz until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Leave the meat in the marinade for 4-18 hours."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Successful"
    },
    {
      "@type": "Comment",
      "text": "Original yield: Makes enough marinade for 500g of beef or chicken."
    }
  ]
}
