{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Phanaeng Curry Paste - SD Books",
  "recipeYield": "140 ml",
  "recipeIngredient": [
    "5 dried spur chilies (seeded and soaked until tender),",
    "1 tsp sea salt,",
    "1 tsp mature galangal (finely sliced),",
    "½ tbsp kaffir lime rind (finely sliced),",
    "1 tsp coriander root (finely sliced),",
    "1 tsp lemongrass (sliced),",
    "10 gloves small garlic (sliced),",
    "⅓ cup shallot (sliced),",
    "½ tsp pepper,",
    "1 tsp shrimp paste."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Process to a smooth paste."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: ½ cup + 1 tbsp"
    }
  ],
  "keywords": [
    "Curry Pastes"
  ]
}
