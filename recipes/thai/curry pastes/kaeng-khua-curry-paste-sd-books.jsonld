{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Kaeng Khua Curry Paste - SD Books",
  "recipeYield": "1/2 cup",
  "recipeIngredient": [
    "5 dried spur chillies (seeded and soaked until tender)",
    "1 tsp sea salt",
    "1 tsp mature galangal (finely sliced)",
    "1 tbsp lemongrass (sliced)",
    "20 cloves small garlic (peeled)",
    "2/3 cup shallot (sliced)",
    "1 tsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Process to a smooth paste."
    }
  ],
  "keywords": [
    "Curry Pastes"
  ]
}
