  "recipeCuisine": "Thailand",
  "name": "Mussamun Curry Paste - SD Books",
  "recipeYield": "1/2 cup",
  "recipeIngredient": [
    "3 dried spur chilies (seeded and soaked until tender)",
    "1 tsp sea salt",
    "1 tsp mature galangal (sliced and roasted)",
    "1 tbsp lemongrass (sliced and roasted)",
    "2 bulbs garlic (grilled and peeled)",
    "5 shallots (grilled and peeled)",
    "1 tbsp coriander seeds (roasted and ground)",
    "1 tsp cumin (roasted and ground)",
    "1 tsp pepper",
    "1 tsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Process to a smooth paste."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 1/2 cup"
    }
