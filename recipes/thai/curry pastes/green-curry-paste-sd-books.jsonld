{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Green Curry Paste - SD Books",
  "recipeYield": "1/2 cup",
  "recipeIngredient": [
    "3 tbsp green hot chillies",
    "5 green spur chillies (sliced)",
    "1 tsp sea salt",
    "1 tsp mature galangal (finely sliced)",
    "1 tbsp lemongrass (sliced)",
    "1/2 tsp kaffir lime rind (finely sliced)",
    "1 tsp coriander root (finely sliced)",
    "2 tbsp small garlic (peeled)",
    "1/4 cup shallot (sliced)",
    "5 peppercorns",
    "1 tbsp coriander seeds (roasted and ground)",
    "1 tsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add both kinds of chilli to a food processor, with the salt, and process."
    },
    {
      "@type": "HowToStep",
      "text": "Add the galangal, lemongrass, kaffir lime rind, and coriander root. Process."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, shallot, peppercorns, coriander seed, cumin and shrimp paste."
    },
    {
      "@type": "HowToStep",
      "text": "Process until a smooth paste."
    }
  ],
  "keywords": [
    "Curry Pastes",
    "seafood",
    "shrimp"
  ]
}
