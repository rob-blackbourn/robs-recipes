{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Red Curry Paste - Thai Bible",
  "recipeYield": "4 curries",
  "recipeIngredient": [
    "1 tsp toasted coriander seeds",
    "1/2 tsp toasted cumin seeds",
    "1 tsp black peppercorns",
    "1 tsp dried chilli flakes",
    "1/2 tsp shrimp paste",
    "2 tbsp chopped lemongrass",
    "3 tbsp chopped onions",
    "2 tsp chopped galangal",
    "1 tbsp chopped garlic",
    "3 tbsp deseeded chopped red chillies",
    "1-2 tbsp ground sweet paprika (optional)",
    "1-2 tbsp oil",
    "2-3 pinches of salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine all ingredients and grind to a smooth paste."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 2-4 curries"
    }
  ],
  "keywords": [
    "Curry Pastes"
  ]
}
