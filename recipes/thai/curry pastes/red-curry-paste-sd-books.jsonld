{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Red Curry Paste - SD Books",
  "recipeYield": "1/2 cup",
  "recipeIngredient": [
    "3 dried spur chilies (seeded and soaked for 2 minutes)",
    "1 tsp sea salt",
    "1 tsp mature galangal (finely sliced)",
    "1 tbsp lemongrass (finely sliced)",
    "1 tsp kaffir lime rind (finely sliced)",
    "2 tsp coriander root (sliced)",
    "10 small cloves of garlic",
    "1/3 cup shallot",
    "1 tbsp coriander seeds",
    "1 tsp cumin (roasted and ground)",
    "1 tsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add the chilli and salt and pound."
    },
    {
      "@type": "HowToStep",
      "text": "Add the galangal, lemongrass, kaffir lime rind, and coriander root and pound finely."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, shallot, coriander seed, cumin and shrimp paste."
    },
    {
      "@type": "HowToStep",
      "text": "Continue pounding until a smooth paste."
    }
  ],
  "keywords": [
    "Curry Pastes",
    "seafood",
    "shrimp"
  ]
}
