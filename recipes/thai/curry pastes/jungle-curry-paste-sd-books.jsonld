{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Jungle Curry Paste - SD Books",
  "recipeCuisine": "Thai",
  "recipeCategory": "Spice Paste",
  "recipeYield": "1 cup",
  "recipeIngredient": [
    "5 dried spur chilies (seeded and soaked until tender)",
    "30 g dried hot chilies",
    "20 fresh hot chillies (assorted colours)",
    "1 tsp sea salt",
    "1 1/2 tbsp mature galangal (finely sliced)",
    "3 stalks lemongrass (sliced)",
    "2 tsp kaffir lime rind (finely sliced)",
    "60 g small garlic (peeled)",
    "1/4 cup shallot (sliced)",
    "1 tsp black peppercorns",
    "1 tbsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Process to a smooth paste."
    }
  ],
