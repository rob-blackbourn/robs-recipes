  "name": "Sour Curry Paste - SD Books",
  "recipeYield": "1/4 cup",
  "recipeIngredient": [
    "10 dried spur chilies (seeded and soaked until tender)",
    "1 tsp sea salt",
    "2 tbsp mature galangal (finely sliced)",
    "2 tbsp lemongrass (sliced)",
    "1/3 cup shallot (sliced)",
    "1 tbsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Process to a smooth paste."
    }
  ],
