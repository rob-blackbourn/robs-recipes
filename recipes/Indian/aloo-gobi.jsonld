  "recipeCuisine": "India",
  "name": "Aloo Gobi",
  "text": "Aloo Gobi\n\nPreparation time: 10 minutes\n\nCooking Time: 20 mins\n\nYield: 4\n\nIngredients\n\n2 tbsp sunflower oil\n\n25g/1oz butter (or alternative)\n\n2 tsp cumin seeds\n\n2 tsp ground turmeric\n\n4cm/1½in fresh root ginger, finely grated\n\n2 onions, roughly chopped\n\n2 tsp freshly chopped green bird’s-eye chillies (or to taste)\n\n3 tbsp dried fenugreek leaves (methi)\n\n1 cauliflower, broken into florets, leaves chopped\n\n2 large potatoes, cut into 2cm/¾in cubes\n\n2 tsp garam masala\n\nsalt and freshly ground black pepper\n\nhandful fresh coriander, to garnish\n\nPreparation\n\nHeat the oil and butter in a large heavy-based saucepan over a medium heat.\n\nAdd the cumin, turmeric, ginger, onions, chillies and fenugreek and fry for a few minutes.\n\nAdd the cauliflower florets and leaves, stir to coat in the spices and cook for a few minutes.\n\nAdd the potatoes, stir again, cover and steam for 10–15 minutes, or until the vegetables are tender.\n\nSprinkle over the garam masala and season to taste. Garnish with coriander before serving with the rice.",
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "recipeYield": "4",
  "recipeIngredient": [
    "2 tbsp sunflower oil",
    "25g/1oz butter (or alternative)",
    "2 tsp cumin seeds",
    "2 tsp ground turmeric",
    "4cm/1½in fresh root ginger, finely grated",
    "2 onions, roughly chopped",
    "2 tsp freshly chopped green bird’s-eye chillies (or to taste)",
    "3 tbsp dried fenugreek leaves (methi)",
    "1 cauliflower, broken into florets, leaves chopped",
    "2 large potatoes, cut into 2cm/¾in cubes",
    "2 tsp garam masala",
    "salt and freshly ground black pepper",
    "handful fresh coriander, to garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil and butter in a large heavy-based saucepan over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cumin, turmeric, ginger, onions, chillies and fenugreek and fry for a few minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cauliflower florets and leaves, stir to coat in the spices and cook for a few minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the potatoes, stir again, cover and steam for 10–15 minutes, or until the vegetables are tender."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle over the garam masala and season to taste. Garnish with coriander before serving with the rice."
    }
