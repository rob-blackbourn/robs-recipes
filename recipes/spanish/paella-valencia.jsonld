{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Spain",
  "name": "Paella Valenciana",
  "recipeYield": "8 servings",
  "recipeIngredient": [
    "60 g chorizo (cut into thin slices) - optional",
    "4 garlic cloves (peeled and lightly crushed and chopped)",
    "1 brown onion (finely diced)",
    "1 red pepper (diced or sliced)",
    "2 tomatoes",
    "100g runner beans",
    "1 tsp smoked paprika",
    "200 g calasparra (Spanish short-grain) rice",
    "75 ml dry white wine",
    "750 ml chicken stock (heated with 1/4 tsp saffron threads)",
    "6 boneless chicken thighs (halved and browned)",
    "30 g fresh or frozen peas",
    "olive oil",
    "2 tbsp chopped flat-leaf parsley",
    "Salt and pepper for seasoning",
    "Lemon wedges"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat half the olive oil in a paella dish or heavy-based saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "If using, cook the chorizo a little to flavour the oil."
    },
    {
      "@type": "HowToStep",
      "text": "Add chicken thighs and brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add the pepper and beans."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion and heat until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic and smoked paprika and heat until aromatic."
    },
    {
      "@type": "HowToStep",
      "text": "Add the passata and warm through."
    },
    {
      "@type": "HowToStep",
      "text": "Add calasparra rice, and stir until all the grains of rice are nicely coated and glossy."
    },
    {
      "@type": "HowToStep",
      "text": "Add the stock and simmer, adding more liquid if necessary, until the rice is cooked."
    },
    {
      "@type": "HowToStep",
      "text": "When done, turn up the heat to medium and cook for a further minute."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat, cover with foil and a cloth and rest for 7 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Scatter the chopped parsley over the paella and serve."
    }
  ],
  "prepTime": "PT1H",
  "cookTime": "PT30M",
  "keywords": [
    "poultry",
    "chicken"
  ]
}
