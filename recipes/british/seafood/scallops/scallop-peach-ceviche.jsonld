{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Scallop & Peach Ceviche",
  "prepTime": "PT30M",
  "cookTime": "PT0M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "8 scallops (coral removed)",
    "3 limes",
    "1/2 red onion (grated)",
    "3 peaches (stoned and chopped into small pieces)",
    "1 tbsp fresh tarragon (chopped)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Slice each scallop horizontally into four disks,"
    },
    {
      "@type": "HowToStep",
      "text": "Place the scallop slices into a bowl with the lime juice and zest, peaches, tarragon, and a pinch of salt."
    },
    {
      "@type": "HowToStep",
      "text": "Stir, cover with cling film and put in the fridge for 20 minutes."
    }
  ],
  "keywords": [
    "Seafood",
    "Scallops"
  ]
}
