{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Salmon & Smoked Haddock Fish Cakes",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "275g haddock fillets",
    "175g salmon",
    "Milk for poaching the haddock",
    "275g dry mashed potatoes",
    "50g melted butter",
    "1 small onion (finely chopped and sweated in butter)",
    "2 tsp anchovy essence",
    "2 hard boiled eggs (chopped)",
    "2 tbsp chopped parsley",
    "1 tbsp chopped dill",
    "Salt and pepper for seasoning",
    "Flour for coating",
    "Beaten egg for dripping",
    "Natural breadcrumbs",
    "50g butter for frying"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook the haddock and salmon in seasoned milk (onion, carrot, bay leaf, peppercorns and 2 cloves) until cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the milk and when cool enough to handle, flake the fish discarding any skin or bone. Combine the  haddock with the potato, butter, onions and anchovy essence in a mixer with a dough hook, then fold in the salmon,  egg, parsley and dill by hand until well combined, do not over-mix."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste. If the mixture is too dry at this point add some of the haddock poaching milk."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the mixture up into 4 equal amounts, then shape into patties. Dip in the flour, egg and finally breadcrumbs and  reshape."
    },
    {
      "@type": "HowToStep",
      "text": "Refrigerate for 2 hours before use."
    },
    {
      "@type": "HowToStep",
      "text": "Pan-fry in butter for 5 minutes each side – keep warm in the oven.  Assembly  Serve one cake on a bed of buttered spinach surrounded by parsley sauce."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4 servings as a starter"
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
