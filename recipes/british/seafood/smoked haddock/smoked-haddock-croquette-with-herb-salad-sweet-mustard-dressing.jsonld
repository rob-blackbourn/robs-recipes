{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Smoked Haddock Croquette with Herb Salad & Sweet Mustard Dressing",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "500g pale smoked haddock fillet",
    "700ml fish stock",
    "60g butter",
    "60g plain flour",
    "1 tbsp coarse grain mustard",
    "50g grated mature cheddar cheese",
    "1 tbsp chopped chives",
    "Salt, pepper and nutmeg to season",
    "500g home-made bread crumbs",
    "200g flour (for coating)",
    "3 whisked eggs (for coating)",
    "Mixed salad leaves and fresh herbs eg. dill, chives, fennel"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "2 egg yolks,"
    },
    {
      "@type": "HowToStep",
      "text": "4 tablespoon white wine vinegar,"
    },
    {
      "@type": "HowToStep",
      "text": "1 tablespoon caster sugar,"
    },
    {
      "@type": "HowToStep",
      "text": "1 teaspoon English mustard,"
    },
    {
      "@type": "HowToStep",
      "text": "2 tablespoon coarse grain mustard,"
    },
    {
      "@type": "HowToStep",
      "text": "200ml sunflower oil,"
    },
    {
      "@type": "HowToStep",
      "text": "Salt, pepper and lukewarm water."
    },
    {
      "@type": "HowToStep",
      "text": "Bring 500ml of your fish stock to boiling point, add the haddock and then remove from heat to cool down."
    },
    {
      "@type": "HowToStep",
      "text": "When cooled, remove haddock from fish stock then flake the haddock."
    },
    {
      "@type": "HowToStep",
      "text": "Top up the juices with fish stock until you have 500ml again, set aside for next stage."
    },
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a pan, add the flour and cook for 1 minute, remove from heat and add the fish stock from the first stage. Put the pan back on a low heat and bring to the boil slowly. Simmer gently until a “thicker than sauce” consistency has been achieved, stirring constantly."
    },
    {
      "@type": "HowToStep",
      "text": "Gently stir in the flaked haddock, chives, mustard and grated cheese and season to taste with salt, pepper and nutmeg."
    },
    {
      "@type": "HowToStep",
      "text": "Allow to cool then pipe into a continuous sausage shape of 3cm diameter on grease-proof paper, then refrigerate overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Cut into 10cm logs and prepare a breadcrumb station."
    },
    {
      "@type": "HowToStep",
      "text": "Dip croquettes into the flour, then whisked egg and then finally into the breadcrumbs, ensuring they are totally covered."
    },
    {
      "@type": "HowToStep",
      "text": "Place in a deep fat fryer at 180°C until golden brown. (Test one first - if the croquettes are breaking repeat the egg/breadcrumb step)."
    },
    {
      "@type": "HowToSection",
      "name": "For the mustard dressing",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Put egg yolks in a liquidiser, add sugar, English mustard, vinegar and salt and pepper."
        },
        {
          "@type": "HowToStep",
          "text": "Turn on the machine and pour in the oil very slowly until you have a thick emulsion."
        },
        {
          "@type": "HowToStep",
          "text": "Add coarse grain mustard and use some lukewarm water to get the right pouring consistency."
        }
      ]
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
