{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "10 Minute Haddock with Spring Onion Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "450g fresh haddock fillets,",
    "2 tsp salt,",
    "1/2 tsp freshly ground white or black pepper,",
    "500 ml water,",
    "6 tbsp coarsely chopped spring onions,",
    "1 tbsp finely chopped fresh root ginger,",
    "1 1/2 tbsp groundnut oil,",
    "2 tsp sesame oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Rub the haddock fillets with 1 teaspoon of the salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Bring the water to the simmer in the wok. Add the haddock, simmer for 2–3 minutes, cover tightly and turn off the heat Allow to stand for 4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the spring onions, ginger and the remaining 1 teaspoon salt together in a small bowl."
    },
    {
      "@type": "HowToStep",
      "text": "In a small pan combine the oil and sesame oil and bring it to the smoking point. Assembly Remove the haddock from the water and arrange on a platter. Scatter the spring onion mixture on top and pour hot oil over it."
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
