{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Smoked Haddock With Chive, Pea & Potato Crush",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "300g small salad potatoes (halved)",
    "2 handfuls frozen peas",
    "50g butter",
    "2 smoked haddock fillets (about 150g each)",
    "a splash white wine",
    "1/2 small bunch chives (chopped)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook the potatoes until tender, then add the frozen peas for the last 2 minutes of cooking. Gently crush with half the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the rest of the butter in a pan and cook the haddock for 3 minutes on each side. Remove the haddock then add a splash of wine or chicken stock and reduce a little. Stir in the chives."
    },
    {
      "@type": "HowToStep",
      "text": "Put the potato on 2 plates, top with the haddock and the chive butter."
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
