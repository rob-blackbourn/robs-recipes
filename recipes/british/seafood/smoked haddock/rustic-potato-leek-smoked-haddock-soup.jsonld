{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Rustic Potato, Leek & Smoked Haddock Soup",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "100g butter",
    "2 natural smoked haddock skin on bone in",
    "60ml white wine",
    "100g smoked bacon (diced 15 mm)",
    "1 onion (peeled and finely chopped)",
    "4 large leeks (harsh green removed, quarter and wash well, then sliced)",
    "2 large potatoes (peeled and cut into 15mm chunks)",
    "250ml milk",
    "600ml light fish stock or vegetable stock",
    "120ml double cream ",
    "1 tablespoon flat parsley (chopped)",
    "Sea salt",
    "White pepper and nutmeg"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place a couple of knobs of butter on the flesh side of each haddock add a splash of white wine, wrap each haddock in tin foil and place in a hot oven for five minutes,"
    },
    {
      "@type": "HowToStep",
      "text": "Remove from oven and pick the fish clean of all skin and bone, keep warm and reserve any juices."
    },
    {
      "@type": "HowToStep",
      "text": "Melt the remaining butter then add bacon, onions, leeks and potatoes and sweat over a low heat for 10–15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add milk and stock and cook for a further 15 minutes. Stir in the cream and any reserved juices from the fish, bring  back to the boil. The potatoes should be cooked by this stage."
    },
    {
      "@type": "HowToStep",
      "text": "Add flaked haddock and chopped parsley and season with pepper and nutmeg."
    },
    {
      "@type": "HowToStep",
      "text": "You may only need a little salt as the haddock can be quite salty.  Assembly  Ladle into bowls and swirl on some extra cream and chopped parsley, serve with hunks of soda bread."
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
