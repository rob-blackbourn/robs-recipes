{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Mixed Haddock Supper for Two",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "A piece of fresh haddock about 225 g,",
    "A piece of smoked haddock about the same weight,",
    "A good handful of button mushrooms wiped not washed, sliced,",
    "Tablespoon capers,",
    "50 g lump of butter to sauté mushrooms,",
    "25 g flour,",
    "150 ml milk,",
    "Glass of white wine,",
    "Pinch of salt to taste,",
    "A good shake of Parmesan cheese or grated Gruyere"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sauté the mushrooms in the butter until soft and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Leaving the skin, poach the two pieces of fish in the milk with capers for about 4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Don’t forget the smoked fish has already been cooked so can be lifted first. Remember the golden rule for any kind of fish – DO NOT OVER COOK."
    },
    {
      "@type": "HowToStep",
      "text": "Lift fish from stock and flake away from skin into a flat gratin dish. Sauce"
    },
    {
      "@type": "HowToStep",
      "text": "Shake flour into mushrooms stirring well and slowly as you pour in stock from fish over gentle heat, to make creamy sauce. Season to taste with pepper (you should not need salt), gently stir in the wine."
    },
    {
      "@type": "HowToStep",
      "text": "Pour over the fish."
    },
    {
      "@type": "HowToStep",
      "text": "Give a sprinkle of cheese, pop into a fairly hot oven – not to cook – just to brown the top. 8. Serve with peas, broccoli or spinach and a few new potatoes."
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
