{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Smoked Haddock Risotto with Roasted Baby Onions",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "300g natural smoked haddock",
    "250g Arborio rice",
    "500ml fresh fish stock",
    "500ml fresh chicken stock",
    "75ml white wine",
    "80g Mascarpone",
    "100g Parmesan",
    "1 shallot",
    "1 garlic clove",
    "30g butter",
    "10g flat leaf parsley",
    "Seasoning",
    "20 peeled shallots"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Peel and chop the shallots and garlic and sweat in a pan with the butter, but don’t colour. Add the rice to the pan with the onions and seal for about 30 seconds over a low heat. Add the white wine and add the stocks in stages to the rice and bring to the boil, then simmer for about 12 minutes, stirring a few times. After 10 minutes add the flaked smoked haddock."
    },
    {
      "@type": "HowToStep",
      "text": "Grate the Parmesan cheese and chop up the flat leaf parsley."
    },
    {
      "@type": "HowToStep",
      "text": "Heat a frying pan until very hot and drizzle with olive oil and butter. Add the peeled baby onions and sauté, then place into the oven to cook."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the Mascarpone and Parmesan into the risotto with the parsley and season well. Assembly To serve, spoon the risotto on to the centre of the plate, top with the roasted shallots and serve immediately."
    }
  ],
  "keywords": [
    "fish",
    "haddock"
  ]
}
