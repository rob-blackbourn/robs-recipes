{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "British",
  "name": "Poached Fillet of Haddock Rested on a Cullen Skink Risotto with Watercress Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 fillet of haddock",
    "1 fillet of smoked haddock (diced)",
    "1 leek finely chopped ",
    "1 bunch watercress",
    "750g fish stock",
    "250g double cream",
    "Salt and pepper for seasoning",
    "100g risotto rice",
    "1 lemon grass, finely chopped",
    "500g approx fish stock/bouillon",
    "25g finely diced onion",
    "10g ginger purée"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For risotto - fry onion, rice, ginger and lemon grass, slowly add stock till rice has a bite, finish with salt and pepper to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Fry leek and smoked haddock in a little white wine until cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Add risotto mixture and 100g of cream and cook until a thick consistency."
    },
    {
      "@type": "HowToStep",
      "text": "Poach haddock in a little white wine and fish stock."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce rest of fish stock with cream, add watercress and blend till smooth texture."
    },
    {
      "@type": "HowToStep",
      "text": "Put risotto mixture in centre of plate, place poached haddock on top and pour sauce around it."
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock",
    "fish",
    "haddock"
  ]
}
