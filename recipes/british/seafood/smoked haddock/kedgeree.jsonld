{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Kedgeree",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "recipeYield": "3 servings",
  "recipeIngredient": [
    "1 1/2 fillets of smoked haddock",
    "1 medium onion (sliced)",
    "2 tbsp olive oil",
    "2 scant tsp curry powder",
    "2 tbsp sultanas",
    "125 g basmati rice",
    "2 hard boiled eggs",
    "chopped parsley",
    "lemon wedges and mango chutney"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pour boiling water over the haddock, leave for 3 minutes, drain, skin, and flake."
    },
    {
      "@type": "HowToStep",
      "text": "Cook the onion until pale yellow in the oil in a saute pan."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the curry powder and cook for a minute, stirring."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sultanas and rice, plus 600 ml water."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil and simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Put in the haddock and season."
    },
    {
      "@type": "HowToStep",
      "text": "Continue cooking until the rice is soft, and the water absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with hard boiled eggs and parsley on top, and lemon wedges and mango chutney on the side."
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
