{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Place with Crab & Kalamata Olive Stuffing",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 fillets of plaice",
    "50 ml white wine",
    "juice of 1 lemon",
    "50 g unsalted butter",
    "1 finely chopped shallot",
    "1 clove of garlic (peeled and crushed)",
    "1/2 medium chilli (de-seeded and finely chopped)",
    "100 g fresh white breadcrumbs",
    "30 g finely chopped Kalamata olives",
    "1/2 bunch flat leaf parsley (finely chopped)",
    "zest of 1 lemon",
    "extra virgin olive oil",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the butter in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the shallot, garlic and chilli, and cook for 2 minutes, until soft."
    },
    {
      "@type": "HowToStep",
      "text": "Add the breadcrumbs and cook for a further 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat and add the crab, olives, parsley and lemon zest, and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "If the stuffing seems dry add a splash of olive oil and season."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200°C."
    },
    {
      "@type": "HowToStep",
      "text": "Put the stuffing in the middle of each fillet and roll up from the tail to the head."
    },
    {
      "@type": "HowToStep",
      "text": "Place in an ovenproof baking dish and add olive olive, lemon juice and white wine."
    },
    {
      "@type": "HowToStep",
      "text": "Bake for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with spinach and buttered potatoes."
    }
  ],
  "keywords": [
    "Seafood",
    "Place"
  ]
}
