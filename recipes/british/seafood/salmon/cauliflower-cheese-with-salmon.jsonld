{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Cauliflower Cheese With Salmon",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 large cauliflower (cut into florets),",
    "50g/2oz butter (plus extra for greasing),",
    "50g/2oz plain flour,",
    "450ml/16fl oz milk,",
    "2 egg yolks,",
    "1 tsp English mustard,",
    "splash of Worcestershire sauce,",
    "Salt and pepper for seasoning",
    "150g/5oz cooked flaked salmon,",
    "125g/4½oz cheddar cheese (grated),",
    "75g/3oz emmental cheese (grated)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 200°C."
    },
    {
      "@type": "HowToStep",
      "text": "Bring a large pan of salted water to the boil, then add the cauliflower and cook for two minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Drain and place in a buttered ovenproof dish."
    },
    {
      "@type": "HowToStep",
      "text": "Place the butter and flour into a saucepan and heat to melt the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Cook, stirring for one to two minutes until lightly golden."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat and gradually whisk in the milk to form a smooth sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Return to the heat and simmer for two to three minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat and beat in the egg yolks, mustard and Worcestershire sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Flake the salmon into the sauce, stirring carefully."
    },
    {
      "@type": "HowToStep",
      "text": "Pour over the cauliflower and top with the grated cheeses."
    },
    {
      "@type": "HowToStep",
      "text": "Place in the oven and cook for 10-15 minutes, until golden brown."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: less than 30 mins"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 30 mins to 1 hour"
    },
    {
      "@type": "Comment",
      "text": "Original yield: Serves 4"
    }
  ],
  "prepTime": "less than 30 mins",
  "cookTime": "30 mins to 1 hour",
  "keywords": [
    "Seafood",
    "Salmon"
  ]
}
