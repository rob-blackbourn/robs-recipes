{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Miso glazed salmon with pickled cucumber salad and sushi rice",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "50 ml mirin",
    "50 ml sake",
    "75 g caster sugar (For the salmon)",
    "150 g white miso paste",
    "4 x 125 g salmon fillets (skinless and boneless, any brown flesh",
    "removed)",
    "1 cucumber (peeled in stripes, halved lengthwise, seeds removed and",
    "cut into 3mm slices)",
    "1 large red chilli (halved, de-seeded and finely sliced)",
    "9 dried shitake mushrooms (soaked and torn into strips)",
    "1/2 tsp fine sea salt",
    "90 ml rice wine vinegar (For the pickled cucumber salad)",
    "45 g caster sugar (For the pickled cucumber salad)",
    "1 1/2 tbsp Japanese pickled ginger (roughly chopped)",
    "60 ml rice wine vinegar (For the sushi rice)",
    "2 1/2 tbsp caster sugar (For the sushi rice)",
    "3/4 tbsp fine salt",
    "250 g sushi rice",
    "black and white sesame seeds (toasted)",
    "herb cress (such as rocket or coriander cress)",
    "Japanese seven spice pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the salmon, combine the mirin, sake and sugar in a small pan. Bring to the boil over a medium heat, to dissolve the sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Add the miso paste and bring to the boil and simmer for three minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Pass the miso mixture through a fine sieve and set aside to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Onced cooled, coat the salmon fillets with the miso marinade, (reserving some to finally coat the salmon before cooking), and lay on a tray to marinade for at least six hours."
    },
    {
      "@type": "HowToStep",
      "text": "Once the salmon has marinated, preheat the oven to its highest"
    },
    {
      "@type": "HowToStep",
      "text": "To cook the salmon, wipe any excess marinade off the salmon fillets and heat a dry pan until very hot."
    },
    {
      "@type": "HowToStep",
      "text": "Sear the salmon fillets briefly in the very hot pan, then place them onto a baking tray."
    },
    {
      "@type": "HowToStep",
      "text": "Rub the top presentation side of the salmon with a little miso marinade and allow to dry for at least 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Finish cooking the salmon in the oven, for about five minutes until just cooked and still slightly pink inside."
    },
    {
      "@type": "HowToStep",
      "text": "For the cucumber salad, mix the cucumber, chilli, trompette mushrooms and sprinkle with the salt."
    },
    {
      "@type": "HowToStep",
      "text": "Allow the vegetables to stand for 30 minutes then rinse in cold water and pat dry with kitchen paper."
    },
    {
      "@type": "HowToStep",
      "text": "In a small pan, bring the vinegar with caster sugar to the boil, then pour it over the cucumber mixture. Allow to stand for an hour, then add the pickled ginger."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the pickling liquor off the vegetables when ready to serve."
    },
    {
      "@type": "HowToStep",
      "text": "For the sushi rice, in a small pan, bring the rice wine vinegar, sugar and salt up to the boil, stirring to dissolve the sugar and salt. Once dissolved, remove the mixture from the heat and allow to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Wash the sushi rice three or four times in cold water, and set aside in the colander for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Place the rice into a saucepan then add 500 ml water. Cover the rice and bring to the boil over a low heat."
    },
    {
      "@type": "HowToStep",
      "text": "Boil the sushi rice for 12-15 minutes until the water has been absorbed, then remove the pan from the heat, keeping the lid on, and allow finish cooking, off the heat, for 10-15 minutes more."
    },
    {
      "@type": "HowToStep",
      "text": "Tip the rice into a wide bowl and fold in four tablespoons of the cooled sushi vinegar."
    },
    {
      "@type": "HowToStep",
      "text": "When the rice is cool shape it into balls or triangles. To serve, warm the sushi rice in a steamer or microwave."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, sprinkle the miso salmon fillet with black and white sesame seeds and place onto serving plates. Serve the pickled cucumber salad alongside with the sushi rice, sprinkled with a few sesame seeds. Garnish with herb cress and a dusting of seven spice pepper."
    }
  ],
  "prepTime": "PT2H",
  "cookTime": "PT1H",
  "keywords": [
    "Seafood",
    "Salmon"
  ]
}
