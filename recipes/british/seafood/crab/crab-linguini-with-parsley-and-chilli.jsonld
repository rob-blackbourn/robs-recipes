{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Crab Linguini with Parsley and Chilli",
  "prepTime": "PT15M",
  "cookTime": "PT10M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "160 g dried linguine,",
    "2 skinned deseeded and chopped vine ripened tomatoes,",
    "100 g white crab meat,",
    "1/2 tbsp chopped parsley,",
    "3/4 tbsp lemon juice,",
    "25 ml extra virgin olive oil,",
    "a pinch dried chilli flakes,",
    "1/2 finely chopped clove of garlic."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook the pasta in a large pan of salted boiling water."
    },
    {
      "@type": "HowToStep",
      "text": "Put the remaining ingredients into a small pan and warm through."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the pasta and mix with the sauce."
    }
  ],
  "keywords": [
    "Seafood",
    "Crab"
  ]
}
