{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Fillet of John Dory with Olives, Capers and Rosemary",
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "2 fillets of John Dory",
    "25 ml extra virgin olive oil",
    "2 new potatoes",
    "1 anchovy fillet (cut lengthways into thin slivers)",
    "1 1/2 pieces of sun dried tomato (roughly chopped)",
    "roughly chopped flat leaf parsley",
    "2 very small vine ripened tomatoes (skinned, quartered and de-seeded)",
    "4 pitted and halved black olives",
    "6 nonpareil capers",
    "leaves from 1” rosemary"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the grill to high."
    },
    {
      "@type": "HowToStep",
      "text": "Halve each fillet diagonally. Brush with olive oil and season. Place skin side up on a baking sheet."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the potato into quarters and cook in boiling salted water until tender. Drain and return to the pan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the anchovies, sun dried tomatoes, parsley, fresh tomatoes, olives capers, rosemary, and oil. Warm through and season."
    },
    {
      "@type": "HowToStep",
      "text": "Grill the fish for 3-4 minutes until barely cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the sauce over the fish."
    }
  ],
  "keywords": [
    "Seafood",
    "John Dory",
    "fish",
    "anchovies"
  ]
}
