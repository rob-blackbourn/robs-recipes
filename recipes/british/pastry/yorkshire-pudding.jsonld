{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Yorkshire Pudding",
  "prepTime": "PT5M",
  "cookTime": "PT35M",
  "recipeCuisine": "British",
  "recipeCategory": "Batter",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "225 g plain flour",
    "Salt and pepper for seasoning",
    "8 eggs",
    "600 ml milk",
    "55 g dripping"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the flour and a little salt and freshly ground black pepper into a bowl. Add the eggs, mixing in with a whisk, then gradually pour in the milk, mixing slowly to prevent lumps forming."
    },
    {
      "@type": "HowToStep",
      "text": "Cover the bowl with clingfilm and chill in the fridge overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 220°C."
    },
    {
      "@type": "HowToStep",
      "text": "Put a little of the dripping in four non-stick Yorkshire pudding tins. Place the tins in the oven until smoking hot."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the oven and quickly fill the moulds with the batter. Return to the oven and cook for 20-25 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the oven down to 190°C and cook for a further 10 minutes to set the bottom of the puddings."
    }
  ],
  "keywords": [
    "Pastry"
  ]
}
