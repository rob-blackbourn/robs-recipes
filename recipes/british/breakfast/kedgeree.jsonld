{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Kedgeree",
  "prepTime": "PT30M",
  "totalTime": "PT30M",
  "recipeCuisine": "British",
  "recipeCategory": "Rice Bowl",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "1/2 onion (finely chopped)",
    "55 g butter",
    "300 g basmati rice",
    "1 tsp madras curry powder",
    "freshly grated nutmeg",
    "200 ml milk",
    "110 ml double cream",
    "300 g smoked haddock (picked over, bones removed and flesh cut into chunks)",
    "Salt and pepper for seasoning",
    "small bunch parsley (chopped)",
    "3 hard-boiled eggs (shelled and halved)",
    "a good pinch cayenne and freshly ground nutmeg (optional)",
    "knob of butter",
    "wedges of lemon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook the onion gently in the butter for a few minutes, then add the rice."
    },
    {
      "@type": "HowToStep",
      "text": "Continue cooking gently and stirring, adding the curry powder and nutmeg. After a few minutes, add the milk, cream and 250ml water."
    },
    {
      "@type": "HowToStep",
      "text": "When the mixture begins to simmer, add the fish and continue simmering, stirring occasionally until the rice is cooked. Add water if the mixture becomes dry."
    },
    {
      "@type": "HowToStep",
      "text": "Season, add the parsley and stir. Add the eggs and garnish with cayenne and nutmeg if using. Serve topped with a knob of butter and wedges of lemon."
    }
  ],
  "keywords": [
    "Breakfast",
    "fish",
    "haddock"
  ]
}
