{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Asian-flavoured beef shin with papaya salad",
  "prepTime": "PT30M",
  "cookTime": "PT2H",
  "recipeYield": "8 servings",
  "recipeIngredient": [
    "3 kg beef shin (on the bone)",
    "4 tbsp sunflower oil",
    "Salt and pepper for seasoning",
    "600 g chopped white onions (about 4 onions)",
    "1 piece root ginger (finely chopped)",
    "1/2 red chilli (chopped)",
    "20 g miso paste",
    "1/2 tsp Chinese five-spice powder",
    "20 g clear honey",
    "20 g sweet soy sauce",
    "3 tbsp dark soy sauce",
    "4 tbsp mirin",
    "3 kaffir lime leaves, torn (optional)",
    "fresh coriander, to serve",
    "1 snub nose red chilli, seeds removed, finely chopped",
    "2 garlic cloves, finely chopped",
    "2 limes, juice only",
    "2 tbsp fish sauce",
    "2 tsp palm sugar, grated",
    "150 g papaya, unripe green, cut in half, peeled and sliced into",
    "2 mm fine strips",
    "150 g cucumber, seeds removed, cut in half, sliced into thin strips",
    "3 spring onions, finely sliced at an angle, 2mm",
    "1 handful coriander, roughly chopped, plus a few torn leaves to garnish",
    "1 handful mint (spearmint or Vietnamese mint), roughly chopped, plus a few torn leaves to garnish",
    "40 g pomegranate seeds, pith removed (half reserved for the garnish) (optional)",
    "60 g peanuts, unsalted, dry roasted, roughly chopped reserved for the garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the beef, preheat the oven to 150°C."
    },
    {
      "@type": "HowToStep",
      "text": "Rub the shin of beef all over with half of the oil and season with salt and pepper. In a large flame-proof casserole on a medium high heat brown the beef for four minutes on either side. Remove the beef and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Add the remaining oil to the pan and fry the onion, ginger, chilli, miso paste and Chinese five-spice powder for 8-10 minutes, or until softened and golden-brown."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the honey, soy sauces, mirin and 500g water and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beef to the cooking liquid. Bring to a simmer, cover and transfer to the oven to cook for 4 1/2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the beef from the casserole and set aside on a plate. Place the casserole over a high heat, and boil the sauce until it starts to thicken slightly. Add the kaffir lime leaves."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the beef into four equal portions and stir it back into the sauce."
    },
    {
      "@type": "HowToStep",
      "text": "For the salad, mix all the ingredients for the dressing together in a large bowl. Toss the ingredients for the salad with three tablespoons of the dressing in a large bowl. Taste and correct the seasoning if necessary with more lime juice, fish sauce and palm sugar. You are looking for an even balance of salty, sweet, acid, and spicy"
    },
    {
      "@type": "HowToStep",
      "text": "To finish the dish, arrange the beef and sauce in the centre of four large plates with the salad to the side. Garnish the salad with the pomegranate seeds and roasted peanuts and a few torn leaves of coriander and mint. Top the beef shin with some chopped fresh coriander."
    }
  ],
  "keywords": [
    "Meat",
    "Beef",
    "fish"
  ]
}
