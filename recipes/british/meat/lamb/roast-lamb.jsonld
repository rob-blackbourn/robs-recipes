{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Roast Lamb",
  "prepTime": "PT10M",
  "cookTime": "PT1H30M",
  "recipeCuisine": "British",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1.75 kg half leg",
    "2 cloves garlic",
    "6 anchovy fillets",
    "4 sprigs rosemary",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 190°C."
    },
    {
      "@type": "HowToStep",
      "text": "Stud the lamb with slices of garlic, rosemary, and anchovy fillets."
    },
    {
      "@type": "HowToStep",
      "text": "Put in the oven for 20 mins per 500g plus 20 mins, or until the internal temperature has reached 52°C for rare, 60°C for medium, 75°C for rare."
    }
  ],
  "keywords": [
    "Meat",
    "Lamb",
    "fish",
    "anchovies"
  ]
}
