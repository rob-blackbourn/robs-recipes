{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Pan-roasted Canon of Lamb with Port and Chocolate Sauce, Blue Cheese Leeks and Pommes Fondant",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "125g unsalted butter (For the pommes fondant)",
    "2 potatoes (peeled, each cut into a rectangle to weigh 100g each),",
    "sprig fresh thyme,",
    "1 garlic clove (crushed) (For the pommes fondant)",
    "sea salt,",
    "white pepper,",
    "150ml chicken stock,",
    "500g canon of lamb (265),",
    "salt and freshly ground black pepper,",
    "2 sprigs fresh rosemary,",
    "1 tbsp olive oil (For the lamb)",
    "2 garlic cloves (crushed) (For the lamb)",
    "2 tbsp olive oil (For the creamy leeks)",
    "½ onion (chopped into rings and then cut in half to make half-rings),",
    "½ leek (cut into rings),",
    "1 garlic clove (finely chopped) (For the creamy leeks)",
    "85ml double cream,",
    "25g blue cheese such as Stilton,",
    "50ml dry white wine,",
    "4 tbsp ruby port,",
    "150ml beef stock,",
    "50g unsalted butter (For the port and chocolate sauce)",
    "2 tsp grated chocolate,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200°C."
    },
    {
      "@type": "HowToStep",
      "text": "For the pommes fondant, melt the butter in a small, ovenproof frying pan, then add the potatoes, thyme and garlic and season with sea salt and white pepper. Fry the potatoes for 1-2 minutes on each side, basting with the butter as they cook."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the chicken stock until it reaches halfway up the side of the potatoes, then transfer the pan to the oven and bake for 10-15 minutes, or until the potatoes are tender."
    },
    {
      "@type": "HowToStep",
      "text": "For the lamb, season the lamb with salt and freshly ground black pepper and insert the rosemary sprigs into the folds of the meat."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in an ovenproof frying pan over a medium heat and add the garlic and lamb. Fry the lamb on all sides, until golden-brown all"
    },
    {
      "@type": "HowToStep",
      "text": "over, then transfer to the oven to roast for 5-8 minutes (for medium), or until cooked to your liking."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the lamb from the oven, place onto a warm plate and set aside to rest. Set the pan and its remaining contents aside."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, for the creamy leeks, heat the oil in a frying pan over a medium heat, add the onion, leek and garlic and fry for 2-3 minutes, or until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cream, blue cheese and white wine, bring the mixture to a simmer and cook until the cheese has melted and the sauce has thickened."
    },
    {
      "@type": "HowToStep",
      "text": "For the port and chocolate sauce, return the frying pan used to cook the lamb to the heat, then de-glaze the pan with the port, using a wooden spoon to scrape up any browned bits from the bottom of the pan. Add the beef stock and bring the mixture to the boil, then continue to cook until the volume of the liquid has reduced by one-third. Stir in the butter and chocolate until melted."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, carve the lamb into thick slices. Spoon some creamed leeks into the centre of each serving plate and top with the slices of lamb and pommes fondant. Drizzle the port and chocolate sauce around the edge of the plates."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: less than 30 mins"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 10 to 30 mins"
    }
  ],
  "prepTime": "less than 30 mins",
  "cookTime": "10 to 30 mins",
  "keywords": [
    "Meat",
    "Lamb"
  ]
}
