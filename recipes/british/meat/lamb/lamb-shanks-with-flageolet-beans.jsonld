{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Lamb Shanks with Flageolet Beans",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 lamb shanks",
    "Salt and pepper for seasoning",
    "1 tbsp olive oil",
    "350ml red wine",
    "1 onion (cut into quarters) (For the lamb shanks)",
    "1 head garlic (cut in half horizontally)",
    "2 sprigs fresh rosemary",
    "5 anchovy fillets",
    "1 litre hot beef stock",
    "50g butter (For the lamb shanks)",
    "75g butter (For the flageolet beans)",
    "1 onion (finely chopped) (For the flageolet beans)",
    "1 garlic clove (finely chopped)",
    "1 tsp chopped fresh rosemary",
    "4 tomatoes (skins and seeds removed, chopped)",
    "400g canned flageolet beans (drained and rinsed)",
    "3 tbsp chopped fresh flat leaf parsley"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the lamb shanks, preheat the oven to 150°C."
    },
    {
      "@type": "HowToStep",
      "text": "Season the lamb shanks with salt and freshly ground black pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a large casserole over a medium heat. When the oil is hot, add the lamb shanks and fry on all sides until browned all over."
    },
    {
      "@type": "HowToStep",
      "text": "Add the red wine and bring to a simmer. Continue to simmer until the volume of liquid has reduced by a third."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion, garlic, rosemary and anchovy fillets and stir well to combine."
    },
    {
      "@type": "HowToStep",
      "text": "Add enough of the hot beef stock to just cover the lamb (the bones should be protruding from the surface of the liquid). Return the mixture to a gentle simmer."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the casserole to the oven and cook, uncovered, for three hours, turning the lamb shanks occasionally (about once every 45 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, for the flageolet beans, heat half of the butter in a frying pan over a medium heat. When the butter is foaming, add the onion, garlic and rosemary and fry for 2-3 minutes, or until just softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes and cook for a further 2-3 minutes, or until they have broken down slightly."
    },
    {
      "@type": "HowToStep",
      "text": "Add the drained flageolet beans and stir until heated through. Season, to taste, with salt and freshly ground black pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Add the remaining butter and stir until the butter has melted. Add the parsley and stir well to combine."
    },
    {
      "@type": "HowToStep",
      "text": "When the lamb shanks are cooked through, remove them from the cooking liquid and set aside on a warm plate."
    },
    {
      "@type": "HowToStep",
      "text": "Return the casserole to the hob and bring the cooking liquid to the boil. Boil for 4-5 minutes, or until it has reduced slightly."
    },
    {
      "@type": "HowToStep",
      "text": "Strain the reduced cooking liquid through a fine sieve into a clean saucepan, then season, to taste, with salt and freshly ground black pepper. Add the butter and whisk until it has melted and the sauce is glossy."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, divide the flageolet beans equally among four serving plates. Place one lamb shank on top of each. Drizzle the reduced sauce over and around the lamb shanks."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: less than 30 mins"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: over 2 hours"
    }
  ],
  "prepTime": "less than 30 mins",
  "cookTime": "over 2 hours",
  "keywords": [
    "Meat",
    "Lamb"
  ]
}
