{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "British",
  "name": "Slow Roast Haunch of Venison with Shallots, cranberries, and chestnuts.",
  "cookTime": "PT4H",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "2 - 2 1/2 kg haunch of venison (bone in)",
    "12 banana shallots (peeled but whole)",
    "100g dried cranberries",
    "150g vac-pack chestnuts (crumbled)",
    "300ml red wine",
    "50g redcurrant jelly",
    "750ml beef stock",
    "2 tsp dried sage",
    "200g bacon lardons",
    "Vegetable oil for cooking",
    "2 tsp juniper",
    "8 cloves",
    "1 tbsp cracked black pepper",
    "2 tbsp flakey sea salt",
    "1 tbsp cumin seeds",
    "2 tbsp thyme leaves,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Lightly score the venison haunch with a sharp knife. In a pestle and mortar or spice grinder blend together the venison rub ingredients. Rub them into the haunch and leave for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "In a large casserole pan, heat a layer of vegetable oil and cook the lardons until crispy brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add the shallots and cook until they start to brown. Stir in the dried sage. Add the redcurrant jelly, cranberries, red wine, and stock. Bring to the boil and place the venison on top. Turn the heat off and cover with a lid or tin foil. Place in a pre-heated oven at 150°C for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "After 2 hours check and add more stock if dry. Cook for another 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Leave to rest for 30 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 2 hours marinade"
    }
  ],
  "prepTime": "PT15M",
  "keywords": [
    "Meat",
    "Venison",
    "pork",
    "beef"
  ]
}
