{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Roast Potatoes",
  "prepTime": "PT10M",
  "cookTime": "PT1H",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "2 tbsp fat (preferably duck fat)",
    "2 medium size potatoes (Maris Piper or King Edward)",
    "2 cloves of garlic",
    "1 sprig thyme",
    "semolina flour",
    "salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 190°C."
    },
    {
      "@type": "HowToStep",
      "text": "Parboil the potatoes for 8 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Drain, and shake until slightly rough on the outside."
    },
    {
      "@type": "HowToStep",
      "text": "Dust with semolina flour."
    },
    {
      "@type": "HowToStep",
      "text": "Put the fat in the baking tray, and leave in the oven for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Roast for 45 minutes to 1 hour, basting occasionally."
    }
  ],
  "keywords": [
    "Vegetables"
  ]
}
