{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Cauliflower soup",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "15 g butter",
    "1/2 onion (chopped)",
    "150 g cauliflower (trimmed and chopped)",
    "150 ml vegetable stock",
    "85 g Stilton (crumbled)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a saucepan over a medium heat and fry the onion, until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cauliflower and vegetable stock, bring to the boil and simmer for 5-6 minutes, or until the cauliflower is cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer into a food processor, add the Stilton and blend until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Pour into bowls and serve."
    }
  ],
  "prepTime": "PT30M",
  "cookTime": "PT10M",
  "keywords": [
    "Vegetables"
  ]
}
