{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Pea and Mint Risotto",
  "prepTime": "PT30M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 tbsp olive oil",
    "1/4 onion, finely chopped",
    "1 garlic clove, sliced",
    "200 g risotto rice",
    "3 tbsp white wine",
    "about 570 ml hot chicken stock",
    "50 g fresh peas or frozen peas, defrosted",
    "1 small handful fresh mint, chopped leaves only",
    "2 tbsp double cream",
    "25 g butter",
    "Salt and pepper for seasoning",
    "two handfuls rocket leaves",
    "drizzle olive oil",
    "drizzle balsamic vinegar",
    "parmesan shavings"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a large saucepan over a medium heat, add the onion and garlic and fry gently for three minutes or until softened but not coloured. Stir in the rice and stir well for 2-3 minutes, until the grains turn translucent at the edges."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the wine and increase the heat to medium high. Cook for 1-2 minutes, or until the wine has been absorbed. Add a ladleful of the hot chicken stock and stir continuously until all the stock has been absorbed, then repeat until all the stock has been absorbed and the rice is cooked but still slightly firm (al dente)."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the peas, mint, cream and butter and season with salt and freshly ground black pepper. Cover with a lid and leave to cook gently for 2-3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, toss the rocket with the olive oil and balsamic vinegar and scatter over the parmesan. Spoon the risotto into warm bowls and serve the salad alongside."
    }
  ],
  "cookTime": "PT30M",
  "keywords": [
    "Vegetables",
    "poultry",
    "chicken"
  ]
}
