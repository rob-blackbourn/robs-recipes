{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Steak & Kidney Pie",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "300 g puff pastry",
    "1 egg and 1 extra egg yolk beaten together",
    "2 tbsp vegetable oil",
    "700 g stewing beef, diced",
    "200 g lamb kidney, diced",
    "2 medium onions, diced",
    "30 g plain flour",
    "850 ml beef stock",
    "salt and pepper for seasoning",
    "a dash of Worcestershire sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 220°C"
    },
    {
      "@type": "HowToStep",
      "text": "Heat the vegetable oil in a large frying pan, and brown the beef all over. (You may need to do this in batches.) Set aside, then brown the kidneys on both sides in the same pan. Add the onions and cook for 3-4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Return the beef to the pan, sprinkle flour over and coat the meat and onions"
    },
    {
      "@type": "HowToStep",
      "text": "Add the stock to the pan, stir well and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the heat down and simmer for 1 1/2 hours without a lid. If the liquid evaporates too much, add more stock."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat. Add salt, pepper and Worcestershire sauce and allow to cool completely. Place the cooked meat mixture into a pie dish."
    },
    {
      "@type": "HowToStep",
      "text": "Roll out the pastry to 5mm thick and 5cm larger than the dish you are using."
    },
    {
      "@type": "HowToStep",
      "text": "Using a rolling pin, lift the pastry and place it over the top of the pie dish. Trim and crimp the edges with your fingers and thumb."
    },
    {
      "@type": "HowToStep",
      "text": "Brush the surface with the beaten egg mixture and bake for 30-40 minutes until golden-brown and puffed."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with creamy mash and steamed vegetables to soak up the gravy."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: less than 30 mins"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 1 to 2 hours"
    }
  ],
  "prepTime": "less than 30 mins",
  "cookTime": "1 to 2 hours",
  "keywords": [
    "Pies"
  ]
}
