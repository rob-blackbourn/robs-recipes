{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Chicken & Tarragon Pie",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "500 g plain flour (For the shortcrust pastry)",
    "125 g unsalted butter (For the shortcrust pastry)",
    "125 g lard",
    "a pinch salt",
    "1 tsp white wine vinegar",
    "1 egg, beaten",
    "75 g unsalted butter (For the filling)",
    "50 g plain flour (For the filling)",
    "350 ml whole milk, warmed",
    "Salt and pepper for seasoning",
    "2 x 150g chicken breasts, cut into chunks",
    "125 g good-quality ham, cut into strips",
    "2 large leeks",
    "5 tbsp chopped fresh tarragon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sift the flour and salt into a large bowl and rub the butter and lard into the flour until it resembles breadcrumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Add the vinegar and enough cold water to bring the mixture together into a smooth dough."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the dough into two pieces, wrap in cling film and chill in the fridge for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, for the filling heat 25 g of the butter in a frying pan and cook the chicken for 5-6 minutes, then add the leeks and continue to cook for a further 3-4 minutes, or until just soft. Transfer the mixture to a large bowl, then season and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Melt the remaining butter in a saucepan, then add the flour and whisk to a smooth paste. Cook for a minute or two then remove from the heat and slowly whisk in the milk. Return the sauce to the heat and cook over a gentle heat until smooth and thick (do not boil)."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the chicken mixture, ham and tarragon."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 180°C."
    },
    {
      "@type": "HowToStep",
      "text": "Roll one of the pieces of pastry thinly and use it to line a 25cm pie plate. Trim the edges. Spoon in the chicken mixture and brush the edges of the pastry with the beaten egg."
    },
    {
      "@type": "HowToStep",
      "text": "Roll the second piece of pastry out thinly and cover the pie. Seal and crimp the edges. Cut a hole in the top of the pie and brush the top with the beaten egg."
    },
    {
      "@type": "HowToStep",
      "text": "Bake in the oven for 35-40 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: less than 30 mins"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 30 mins to 1 hour"
    }
  ],
  "prepTime": "less than 30 mins",
  "cookTime": "30 mins to 1 hour",
  "keywords": [
    "Pies"
  ]
}
