{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Beef, Ale & Carrot Pie - James Martin",
  "recipeYield": "6 servings",
  "prepTime": "PT30M",
  "cookTime": "PT2H",
  "recipeIngredient": [
    "75 g plain flour,",
    "Salt and pepper for seasoning",
    "750 g braising steak (cut into 5 cm cubes),",
    "2 tbsp vegetable oil,",
    "2 shallots (chopped),",
    "125 g baby onions or small onions (peeled),",
    "400 g carrots, cut into large pieces,",
    "4 sprigs fresh thyme,",
    "3 bay leaves,",
    "4 tbsp tomato purée,",
    "300 ml ale,",
    "300 ml hot beef stock,",
    "500 g ready-made puff pastry (rolled to 0.5 cm thickness),",
    "1 egg (beaten),",
    "steamed vegetables of your choice, to serve."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 170°C."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle the flour onto a plate and season well with salt and freshly ground black pepper. Dredge the steak pieces in the seasoned flour."
    },
    {
      "@type": "HowToStep",
      "text": "Heat an ovenproof casserole dish over a high heat, add the steak pieces in batches and fry for 3-4 minutes, or until golden-brown on all sides, stirring regularly. Remove the cooked steak from the dish, transfer to a warm plate and set aside. Repeat the process with the remaining steak pieces, then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Add the shallots, onions and carrots to the emptied casserole and fry for 2-3 minutes, or until just softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the thyme, bay leaves and tomato purée and stir well to combine."
    },
    {
      "@type": "HowToStep",
      "text": "Add the ale and stir well, scraping any sediment up from the bottom of the casserole using a wooden spoon."
    },
    {
      "@type": "HowToStep",
      "text": "Return the browned steak pieces to the casserole, add the hot stock, stir well and bring the mixture to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the dish to the oven and cook for 11/2 hours, or until the beef is tender and the gravy has thickened. Remove from the oven and set aside to cool slightly."
    },
    {
      "@type": "HowToStep",
      "text": "Increase the heat of the oven to 220°C."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the beef and gravy mixture among four small ovenproof dishes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4-6"
    }
  ],
  "keywords": [
    "Pies"
  ]
}
