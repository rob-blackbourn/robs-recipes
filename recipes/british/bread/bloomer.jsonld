{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Bloomer",
  "cookTime": "PT25M",
  "recipeYield": "1 loaf",
  "recipeIngredient": [
    "500g strong white flour",
    "1 tbsp dried active yeast",
    "1/2 tbsp salt",
    "2 tbsp olive oil",
    "water"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the flour in a large mixing bowl. Add the yeast to one side of the bowl, and the salt to the other. Add the oil."
    },
    {
      "@type": "HowToStep",
      "text": "Add enough water to bring the dry ingredients together."
    },
    {
      "@type": "HowToStep",
      "text": "Knead for 1o minutes on olive oil."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with cling film and let rise for 2 hours, or until doubled in size."
    },
    {
      "@type": "HowToStep",
      "text": "Knock back and shape by stretching and folding."
    },
    {
      "@type": "HowToStep",
      "text": "Put on a baking tray lined with a baking sheet covered with cling film, and let rise for another 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Spray with water, dust with flour, slash with a knife."
    },
    {
      "@type": "HowToStep",
      "text": "Cook in a preheated oven at 220°C, for 25 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 4 hours waiting for the dough to rise."
    }
  ],
  "prepTime": "30 minutes, plus 4 hours waiting.",
  "keywords": [
    "Bread"
  ]
}
