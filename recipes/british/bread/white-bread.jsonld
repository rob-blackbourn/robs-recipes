{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "White Bread",
  "recipeYield": "1 loaf",
  "recipeIngredient": [
    "500g strong white bread flour,",
    "1 tsp sugar,",
    "1 tbsp dried yeast,",
    "2 tsp salt,",
    "1 tbsp oil,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put a little warm water in a small mixing bowl. Add the sugar and yeast, and whisk until dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Put the flour in a large mixing bowl, and add the salt."
    },
    {
      "@type": "HowToStep",
      "text": "When the yeast mixture is frothy, add to the flour, and mix with a wooden spoon."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oil and mix again."
    },
    {
      "@type": "HowToStep",
      "text": "Add enough water (very little) to make the mixture a stiff dough."
    },
    {
      "@type": "HowToStep",
      "text": "Knead for 10 minutes on a clean surface."
    },
    {
      "@type": "HowToStep",
      "text": "Wash the bowl, dry, and lightly oil."
    },
    {
      "@type": "HowToStep",
      "text": "Return the dough to the bowl and leave to rest until it has doubled in size (about 45 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Knock down, break into 8 rolls and put on a lightly oiled baking tray. Leave to rise until doubled in size (about 30 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Cook on 220°C (oven) for 8 to 10 minutes."
    }
  ],
  "keywords": [
    "Bread"
  ]
}
