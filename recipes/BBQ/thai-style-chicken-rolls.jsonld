{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai-style chicken rolls",
  "prepTime": "PT15M",
  "cookTime": "PT7M",
  "recipeYield": "20 pieces",
  "recipeIngredient": [
    "For the chicken: 4 boneless, skinless chicken breast halves (about 110 g each),",
    "For the chicken: 2 tsp Asian chili paste, such as sambal oelek,",
    "For the chicken: Salt and freshly ground black pepper,",
    "For the chicken: 4 spring onions,",
    "For the chicken: 1/4 red pepper (cut into long thin strips),",
    "For the chicken: 1/4 yellow pepper (cut into long thin strips),",
    "For the chicken: 1 tbsp vegetable oil, like soy or groundnut,",
    "For the chicken: 2 tbsp chopped toasted peanuts,",
    "For the dipping sauce: 2 tbsp freshly squeezed lime juice,",
    "For the dipping sauce: 2 tbsp southeast asian fish sauce,",
    "For the dipping sauce: 2 tbsp water,",
    "For the dipping sauce: 1/2 tsp asian chili paste, such as sambal oelek,",
    "For the dipping sauce: 1 tsp honey,",
    "For the dipping sauce: 1 tbsp chopped fresh mint or coriander."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "For the chicken",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Pound each chicken breast between cling film into a 10 by 10 cm by 0.3cm thick."
        },
        {
          "@type": "HowToStep",
          "text": "Lay a piece of chicken smooth-side down on the work surface."
        },
        {
          "@type": "HowToStep",
          "text": "Spread 1/2 teaspoon of the chilli paste over the surface and season with salt and pepper, to taste."
        },
        {
          "@type": "HowToStep",
          "text": "Trim and halve the spring onions lengthwise. Lay them side-by-side across the lower third of the chicken, so there is white and greens at both ends."
        },
        {
          "@type": "HowToStep",
          "text": "Top with 2 or 3 pieces of the red and yellow peppers."
        },
        {
          "@type": "HowToStep",
          "text": "Roll the chicken around the vegetables into a tight cylinder and thread a wooden skewer through the seam of the roll to seal."
        },
        {
          "@type": "HowToStep",
          "text": "Repeat with the remaining chicken and vegetables to make 4 rolls. These can be made up to 24 hours ahead and refrigerated."
        },
        {
          "@type": "HowToStep",
          "text": "Preheat the oven to 220°C."
        },
        {
          "@type": "HowToStep",
          "text": "Heat the oil in an ovenproof non-stick pan over high heat. Season the rolls with salt and"
        },
        {
          "@type": "HowToStep",
          "text": "pepper, to taste. Lay the rolls, seam side down, in the pan, and cook, turning occasionally, until browned, about 2 minutes."
        },
        {
          "@type": "HowToStep",
          "text": "Transfer the pan to the oven, and cook until the chicken is cooked through, about 5 minutes more."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For the assembly",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Carefully remove the skewers, taking care to keep the rolls intact. Cut across the rolls to make round pieces about 2 cm thick, and thread onto skewers."
        },
        {
          "@type": "HowToStep",
          "text": "Transfer to a platter, sprinkle with peanuts and serve with the dipping sauce."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For the dipping sauce",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Combine the lime juice, fish sauce, water, chili paste, honey, mint and coriander in a small bowl and set aside."
        }
      ]
    }
  ]
}
