{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai Chicken Satay",
  "cookTime": "PT8M",
  "recipeIngredient": [
    "500g chicken breast ( cut into 1 in wide 3 in long)",
    "8-10 bamboo skewers.",
    "For the marinade: 1/2 cup coconut milk,",
    "For the marinade: 2 tbsp minced galangal,",
    "For the marinade: 2 tbsp minced lemon grass,",
    "For the marinade: 1 tbsp coriander powder,",
    "For the marinade: 1-2 tbsp turmeric or curry powder,",
    "For the marinade: 1 tsp salt,",
    "For the marinade: 1-2 tsp sugar,",
    "For the marinade: 1-2 tsp white or black pepper.",
    "For the satay sauce: 1/2- 3/4 cup coconut milk",
    "For the satay sauce: 1/4 cup coarsely ground roast peanut or peanut",
    "For the satay sauce: 1/4 cup red curry paste",
    "For the satay sauce: 1/4 cup tamarind juice",
    "For the satay sauce: 1 tsp salt or fish sauce",
    "For the cucumber relish sauce: 2 red spur chillies ( finely sliced)",
    "For the cucumber relish sauce: 1 cucumber ( sliced in quarters lenght then sliced thin)",
    "For the cucumber relish sauce: 1-2 shallot ( finely chopped)",
    "For the cucumber relish sauce: 1/2 sugar",
    "For the cucumber relish sauce: 1/2 cup vinegar"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the chicken into thin wide strips. A single strip will be threaded on a skewer lengthways."
    },
    {
      "@type": "HowToStep",
      "text": "Make the marinade, by combining all the dry ingredients in a food processor, then adding the liquids."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chicken to the marinade, cover with clingfilm, and refrigerate for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "To make the satay sauce, put the coarsely ground peanuts in a pan,then add the red curry paste, and coconut milk. Bring to the boil, then turn down the heat and add the remaining ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "To make the cucumber relish, put the vinegar in a small pan, add the sugar, and dissolve over  low heat. Turn off the heat and allow to cool. Add the cucumber, shallot and chilli."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 15 minutes plus 2 hours marrinade"
    }
  ],
  "prepTime": "15 minutes plus 2 hours marrinade"
}
