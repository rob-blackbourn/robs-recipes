    "1 teaspoon chili sauce",
    "1 tablespoon honey",
    "1 tablespoon oil",
    "1 tablespoon dry sherry",
    "2 cloves garlic, crushed"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Combine sauces, honey, oil, sherry and garlic in large bowl, add prawns and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "2. Cover and marinate for 1-2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "3. Barbecue over high heat until prawns are cooked, brushing with marinade while cooking."
