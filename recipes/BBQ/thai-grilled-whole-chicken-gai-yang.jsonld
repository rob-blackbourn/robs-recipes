{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai Grilled Whole Chicken - Gai Yang",
  "recipeYield": "2 chickens",
  "recipeIngredient": [
    "1 whole chickens (1.8 kg. each)",
    "Bamboo sticks or skewers",
    "For the marinade: 2 heads garlic (30 - 40 cloves) finely chopped,",
    "For the marinade: 1 stalks lemongrass finely chopped,",
    "For the marinade: 1 1/4 tablespoons black pepper corns,",
    "For the marinade: 4 coriander roots (optional) finely chopped,",
    "For the marinade: 2 tablespoons soy sauce,",
    "For the marinade: 1/2 tablespoon fish sauce,",
    "For the marinade: 1 tablespoons palm sugar,",
    "For the marinade: 1/2 tablespoon dark soy sauce,",
    "For the marinade: 4 tablespoons water,",
    "For the sauce: 3/4 tablespoons khao kua",
    "For the sauce: 3/4 tablespoons chili flakes",
    "For the sauce: 1/2 tablespoon of sugar",
    "For the sauce: 1 1/2 tablespoons fish sauce",
    "For the sauce: 4 tablespoons tamarind water",
    "For the sauce: few sprigs of coriander"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare the marinade by whizzing the dry ingredients in a food processor then adding the liquids."
    },
    {
      "@type": "HowToStep",
      "text": "Butterfly the chicken and marinate in the fridge for 2 hours or overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Tie the chicken to a frame of skewers."
    },
    {
      "@type": "HowToStep",
      "text": "Grill over a low heat for 1 hour 30 minutes, turning every 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Prepare the sauce by mixing the ingredients."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 30 minutes plus 2 hours for the marinade"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 1 1/2 hours"
    }
  ],
  "prepTime": "30 minutes plus 2 hours for the marinade",
  "cookTime": "PT1H30M"
}
