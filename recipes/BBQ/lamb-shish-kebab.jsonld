{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Lamb Shish Kebab",
  "cookTime": "PT10M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1kg boned leg of lamb (cut into chunks),",
    "2 medium onions (cut into chunks),",
    "2 green peppers (cut into chunks),",
    "2 tomatoes (cut into chunks),",
    "For the marinade: 1 clove garlic (finely chopped),",
    "For the marinade: 1” ginger (finely chopped),",
    "For the marinade: 2 tbsp lemon juice,",
    "For the marinade: 4 tbsp olive oil,",
    "For the marinade: 1/2 tsp ground turmeric,",
    "For the marinade: 1 tsp ground coriander,",
    "For the marinade: 1 tsp ground cumin,",
    "For the marinade: 1/8 tsp cayenne pepper,",
    "For the marinade: 1 tbsp grated onion."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the marinade ingredients in a large bowl. Add the lamb and mix well. Leave in the fridge for 2 hours or overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Skewer the meat and vegetables and grill fof 10 minutes.."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 10 minutes plus 2 hour marinade"
    }
  ],
  "prepTime": "10 minutes plus 2 hour marinade",
  "keywords": [
    "BBQ"
  ]
}
