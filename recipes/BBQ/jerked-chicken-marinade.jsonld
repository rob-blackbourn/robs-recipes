{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Jerked Chicken Marinade",
  "prepTime": "PT20M",
  "recipeYield": "50 ml",
  "recipeIngredient": [
    "1/4 tsp ground nutmeg",
    "1 tsp ground allspice",
    "1/2 tsp ground cinnamon,",
    "1/2 red onion (chopped),",
    "1 spring onions, chopped",
    "15 ml extra-virgin olive oil",
    "juice of 1/2 an orange,",
    "15 ml soy sauce",
    "1 tbsp fresh thyme sprigs",
    "1/4 lime, juiced",
    "1 garlic cloves",
    "1/4 Scotch bonnet pepper",
    "1 cm piece fresh ginger, peeled",
    "Salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a food processor, combine all the marinade ingredients and puree until smooth."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Small food processor"
    }
  ],
  "keywords": [
    "BBQ"
  ]
}
