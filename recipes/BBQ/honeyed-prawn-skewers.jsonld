{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Honeyed Prawn Skewers",
  "cookTime": "PT4M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 kg large raw shrimp, peeled and tails intact",
    "2 tablespoons light soy sauce",
    "3 teaspoons hoisin sauce",
    "1 tablespoon barbecue sauce",
    "1 teaspoon chili sauce",
    "1 tablespoon honey",
    "1 tablespoon oil",
    "1 tablespoon dry sherry",
    "2 cloves garlic, crushed"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine sauces, honey, oil, sherry and garlic in large bowl, add prawns and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and marinate for 1-2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Barbecue over high heat until prawns are cooked, brushing with marinade while cooking."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 20 mins plus 2 hours marinade"
    }
  ],
  "prepTime": "20 mins plus 2 hours marinade",
  "keywords": [
    "BBQ"
  ]
}
