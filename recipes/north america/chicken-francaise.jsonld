{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chicken Francaise",
  "prepTime": "PT20M",
  "cookTime": "PT10M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 large chicken breast",
    "2 large eggs",
    "2 tbsp Parmesan cheese (finely grated)",
    "1 tbsp chopped parsley (roughly chopped)",
    "1 clove of garlic (crushed)",
    "2 tbsp seasoned flour"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Slice the chicken breast into thin wide strips. Flatten with a meat tenderizer."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly beat the eggs in a medium glass bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Dip the chicken in the flour, then into the egg, leaving in the bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Put some butter in a frying pan over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "When the butter is foaming add the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle the parmesan over the chicken and some parsley."
    },
    {
      "@type": "HowToStep",
      "text": "After a couple of minutes flip turn."
    },
    {
      "@type": "HowToStep",
      "text": "Add some crushed garlic to the pan."
    },
    {
      "@type": "HowToStep",
      "text": "When the chicken is cooked remove it from the pan, then reduce the sauce for few more seconds."
    }
  ],
  "keywords": [
    "North America",
    "poultry",
    "chicken"
  ]
}
