{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chocolate Brownie",
  "recipeYield": "8 servings",
  "recipeIngredient": [
    "140g dark chocolate,",
    "225g butter,",
    "5 eggs,",
    "450g caster sugar,",
    "110g plain flour,",
    "55g cocoa powder,",
    "1 tsp baking powder."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oven to 190°C. Line a 20x30cm roasting tin with baking parchment."
    },
    {
      "@type": "HowToStep",
      "text": "Melt the chocolate in a large mixing bowl over simmering water."
    },
    {
      "@type": "HowToStep",
      "text": "Add the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Take off the heat and beat in the rest of the ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Turn into the roasting tin and bake for 30-40 minutes until the top of the brownie is firm but the inside still feels soft."
    },
    {
      "@type": "HowToStep",
      "text": "Take out of the oven and cool in the tin. Cut into 5cm squares when cool."
    }
  ],
  "keywords": [
    "North America"
  ]
}
