{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chicken Cacciatore",
  "prepTime": "PT15M",
  "cookTime": "PT25M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "3 shallots (chopped),",
    "1 green bell pepper (seeded and coarsely chopped),",
    "280g mushrooms, sliced",
    "3 garlic cloves, chopped",
    "5 skinless chicken breasts (halved),",
    "1 tin chopped tomatoes,",
    "1 tbsp paste",
    "20 pitted black olives",
    "50g parmesan cheese",
    "120ml dry white wine",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a large pressure cooker, saute shallots and bell pepper until shallots soften slightly, or around 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Cook mushrooms and garlic, stirring occasionally and removing any browned bits at the bottom of the pressure cooker."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dry white wine. Bring to a boil until the liquid is reduced in half."
    },
    {
      "@type": "HowToStep",
      "text": "Lay the chicken on top and cover with crushed tomatoes. Be careful not to stir. Set tomato paste on top."
    },
    {
      "@type": "HowToStep",
      "text": "Secure the lid in place and bring to high pressure, according to manufacturer's instruction. Reduce the heat to stabilise the pressure. Cook until chicken is tender, or around 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Turn off the heat. Let pressure release naturally. Carefully remove lid and allow steam to escape."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the olives and cheese. Season with salt and pepper, to taste. Serve with additional sprinkling of parmesan cheese."
    }
  ],
  "keywords": [
    "Pressure Cooker"
  ]
}
