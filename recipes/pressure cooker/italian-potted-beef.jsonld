{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Italian Potted Beef",
  "prepTime": "PT10M",
  "cookTime": "PT45M",
  "recipeYield": "15 servings",
  "recipeIngredient": [
    "4kg rump steak or chuck roast",
    "3 tsp cooking oil",
    "3 onions (chopped)",
    "2 cups diced celery",
    "3 carrots (chopped)",
    "3 bay leaves",
    "1 tsp salt",
    "2 cups sliced mushrooms",
    "3 (150 g) cans tomato paste",
    "2 (300 g) cans beef broth",
    "1 1/2 cups dry red wine"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the cooker, add oil and brown roast on all sides."
    },
    {
      "@type": "HowToStep",
      "text": "Add veggies and seasonings."
    },
    {
      "@type": "HowToStep",
      "text": "Blend the paste with the broth and wine."
    },
    {
      "@type": "HowToStep",
      "text": "Pour over meat and veg."
    },
    {
      "@type": "HowToStep",
      "text": "Close cover securely."
    },
    {
      "@type": "HowToStep",
      "text": "Place pressure regulator on vent pipe and cook 35 minutes at 15 pounds pressure."
    },
    {
      "@type": "HowToStep",
      "text": "Let pressure drop of its own accord."
    },
    {
      "@type": "HowToStep",
      "text": "Thicken gravy if desired."
    }
  ],
  "keywords": [
    "Pressure Cooker"
  ]
}
