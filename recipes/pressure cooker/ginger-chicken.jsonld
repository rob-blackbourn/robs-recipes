{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Ginger Chicken",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 chicken cut into pieces",
    "1 large onion - finely diced",
    "1 good piece of fresh ginger - finely grated",
    "1/4 cup dry sherry",
    "1/4 cup soya sauce",
    "1/4 cup water"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat pressure cooker (lid off) with some oil"
    },
    {
      "@type": "HowToStep",
      "text": "Brown pieces of chicken"
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle the chicken with the onion and ginger"
    },
    {
      "@type": "HowToStep",
      "text": "Mix well, then add sherry, soya sauce and water"
    },
    {
      "@type": "HowToStep",
      "text": "Close the lid, and when full pressure is reached reduce the heat and cook for 8 minutes (10psi) or about 6 minutes for higher pressure (15psi) cookers"
    },
    {
      "@type": "HowToStep",
      "text": "Add salt and pepper to taste"
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Pressure cooker"
    }
  ],
  "keywords": [
    "poultry",
    "chicken"
  ]
}
