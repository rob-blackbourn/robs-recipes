{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Cider and Molasses Pot Roast",
  "cookTime": "PT1H30M",
  "recipeYield": "8 servings",
  "recipeIngredient": [
    "2 cups apple cider",
    "2 tablespoons light molasses",
    "2 teaspoons salt",
    "8 allspice berries",
    "1/2 teaspoon black peppercorns",
    "2 garlic cloves, minced",
    "1/2 teaspoon ground ginger",
    "2.72 kg beef, chuck roast",
    "4 large onions, quartered",
    "4 stalks celery, coarsely chopped",
    "1/4 cup butter",
    "3 tablespoons cornstarch or 3 tablespoons arrowroot",
    "3 tablespoons water"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix apple cider, molasses, salt, allspice, peppercorns, garlic and ginger together. Place beef, onions and celery in a large dish and pour apple cider mixture over meat and vegetables. Cover, refrigerate and marinate for 24 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Remove meat from marinade and wipe dry."
    },
    {
      "@type": "HowToStep",
      "text": "Heat butter in a skillet over medium-high heat and brown pot roast very well on all sides."
    },
    {
      "@type": "HowToStep",
      "text": "Place the pressure cooker trivet in the cooder and place meat on top."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in marinade and vegetable and bring to a boil."
    },
    {
      "@type": "HowToStep",
      "text": "Seal cooker, bring up to high pressure, reduce heat to stablize pressure and cook for 45 minutes to 1 hour."
    },
    {
      "@type": "HowToStep",
      "text": "Remove cooker from heat and release pressure."
    },
    {
      "@type": "HowToStep",
      "text": "Strain out meat and vegetable, reserving juices."
    },
    {
      "@type": "HowToStep",
      "text": "Return strained juices to cooker and bring to a boil."
    },
    {
      "@type": "HowToStep",
      "text": "Mix arrowroot or cornstarch with water and add to heated juices, stirring until thickened."
    },
    {
      "@type": "HowToStep",
      "text": "Taste and adjust seasonings."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow an overnight marinade"
    }
  ],
  "prepTime": "PT15M",
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Pressure cooker"
    }
  ],
  "keywords": [
    "meat",
    "beef"
  ]
}
