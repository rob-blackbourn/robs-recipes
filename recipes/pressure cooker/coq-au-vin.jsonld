{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Coq au Vin",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 kg chicken pieces",
    "1/4 cup olive or peanut oil",
    "250g diced (smoked) bacon",
    "2 medium brown onions, sliced",
    "2 garlic cloves, crushed",
    "500ml red wine",
    "2 tbsp flour",
    "1 or 2 bay leaves",
    "200g small white mushrooms",
    "1 cup chopped parsley",
    "3 small potatoes per person",
    "Salt and pepper for seasoning",
    "2 tbsp cognac (optional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat oil in your pressure cooker (lid off) and brown the chicken pieces in batches, set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Brown the bacon pieces and sliced onions."
    },
    {
      "@type": "HowToStep",
      "text": "Add chicken, sift over flour, mix well. Add cognac and light if you wish."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with red wine, then add salt, pepper and bay leaves"
    },
    {
      "@type": "HowToStep",
      "text": "Bring to boil and lock your pressure cooker."
    },
    {
      "@type": "HowToStep",
      "text": "After reaching pressure, cook on reduced heat for 25 to 35 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "5 Minutes before end, open pressure cooker (quick release method) and add the mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "Close and finish cooking. Steam potatoes (in separate pressure cooker or conventional steamer) and serve with chopped parsley."
    }
  ],
  "keywords": [
    "Pressure Cooker"
  ]
}
