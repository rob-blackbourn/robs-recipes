{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Beef Bourguignon",
  "prepTime": "PT25M",
  "cookTime": "PT30M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "900 gm. round steak, cut into 2-3cm pieces",
    "1 cup dry red wine",
    "1/2 cup beef stock",
    "2 carrots, sliced 1/2 cm thick",
    "3 slices of bacon",
    "225 gm fresh mushrooms, quartered",
    "2 Tbs. flour",
    "12 sm. pearl onions or 1 lg. onion, chopped",
    "1/4 tsp. basil",
    "2 cloves garlic, minced"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Slice bacon into 1 cm pieces and fry in cooker."
    },
    {
      "@type": "HowToStep",
      "text": "Add onion and cook for 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add round steak and brown meat for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in flour and blend thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in wine, beef stock and seasonings. Close the lid."
    },
    {
      "@type": "HowToStep",
      "text": "Cook for 20 minutes. Remove the lid."
    },
    {
      "@type": "HowToStep",
      "text": "Add carrots and mushrooms. Close the lid."
    },
    {
      "@type": "HowToStep",
      "text": "Cook for 5 minutes. Remove the lid."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Pressure cooker"
    }
  ],
  "keywords": [
    "meat",
    "pork",
    "beef"
  ]
}
