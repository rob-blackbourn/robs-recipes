{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Arroz Con Pollo",
  "prepTime": "PT20M",
  "cookTime": "PT20M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "150 g white rice",
    "1 whole chicken (chopped into serving slices)",
    "300 g green peas",
    "180 g sliced green olives",
    "110 g sliced pimiento",
    "2 chopped onions",
    "1 chopped tomato",
    "1 minced clove of garlic",
    "1 bay leaf",
    "2 tbsps olive oil",
    "1/4 tsp saffron",
    "1/2 tsp crushed red pepper",
    "paprika",
    "Salt and pepper for seasoning",
    "625 ml water",
    "400 ml chicken broth"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix rice and 375 ml of water in a metal bowl. Make sure it can loosely fit in your pressure cooker."
    },
    {
      "@type": "HowToStep",
      "text": "Place your steamer basket and the bowl in the pressure cooker."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rest of the water to the cooker."
    },
    {
      "@type": "HowToStep",
      "text": "Securely close the cooker with the pressure regulator on the vent pipe."
    },
    {
      "@type": "HowToStep",
      "text": "Cook at 15 PSI for 5 minutes. The pressure regulator should rock slowly during this time."
    },
    {
      "@type": "HowToStep",
      "text": "After cooking time is done, let the pressure drop on its own. Then remove the bowl of rice, water and steamer basket from the cooker."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, season the chicken with paprika, salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Heat oil in the pressure cooker and cook a few pieces of the chicken at a time until browned. Set chicken aside."
    },
    {
      "@type": "HowToStep",
      "text": "Next, saute garlic and onions until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Place the chicken back to the pressure cooker, together with the red pepper, saffron, bay leaf and broth."
    },
    {
      "@type": "HowToStep",
      "text": "Close the pressure cooker with the pressure regulator on the vent pipe."
    },
    {
      "@type": "HowToStep",
      "text": "Cook at 15 PSI for 8 minutes. The pressure regulator should rock slowly during this time."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the chicken and stir in with the rice. Add in green peas, tomato, olives, and pimiento."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Pressure cooker"
    }
  ],
  "keywords": [
    "poultry",
    "chicken"
  ]
}
