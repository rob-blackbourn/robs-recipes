{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Mediterranean Lamb Shanks",
  "prepTime": "PT20M",
  "cookTime": "PT35M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 lamb shanks",
    "2 tbsps olive oil",
    "1 lge onion chopped coarsely",
    "2 medium carrots chopped coarsely",
    "2 cloves garlic peeled",
    "3 tomatoes peeled, cut into quarters (or 400g can crushed tomatoes)",
    "1 tbsp tomato paste",
    "2/3 cup red wine",
    "1/3 cup beef or chicken stock",
    "6 sprigs fresh thyme",
    "Grated rind of 1 lemon",
    "4 bay leaves",
    "Salt",
    "Freshly ground black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat half the oil in the pressure cooker over medium heat"
    },
    {
      "@type": "HowToStep",
      "text": "Wipe dry the shanks and brown, remove and set aside"
    },
    {
      "@type": "HowToStep",
      "text": "In remaining oil, saute onion, carrots and garlic for 5 mins. Add tomato paste, tomatoes, herbs, lemon rind, wine and stock. Bring to the boil and stir well"
    },
    {
      "@type": "HowToStep",
      "text": "Return the lamb shanks to the cooker, season to taste with salt and pepper"
    },
    {
      "@type": "HowToStep",
      "text": "Close and lock the lid, bring the cooker to HIGH pressure over high heat. Once pressure is reached, reduce the heat to a minimum and cook for 35 mins - Use natural release method to depressurise your pressure cooker, then remove the lid"
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Pressure cooker"
    }
  ],
  "keywords": [
    "meat",
    "lamb"
  ]
}
