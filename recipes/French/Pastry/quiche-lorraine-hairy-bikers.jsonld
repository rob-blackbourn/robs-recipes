{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Quiche Lorraine - Hairy Bikers",
  "recipeYield": "4",
  "recipeIngredient": [
    "For the pastry: 180g/6¼oz plain flour, plus extra for dusting",
    "For the pastry: 100g/3½oz cold unsalted butter, cubed",
    "For the pastry: 50g/2oz parmesan, grated",
    "For the pastry: 2 tsp thyme, leaves only",
    "For the pastry: 1 free-range egg yolk",
    "For the pastry: 1 tsp chilled water (more if needed)",
    "For the filling: 3 free-range eggs",
    "For the filling: 150g/5¼oz pancetta, cubed",
    "For the filling: 250ml/9fl oz crème fraîche",
    "For the filling: 150g/5¼oz Gruyère",
    "For the filling: freshly ground black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 180°C."
    },
    {
      "@type": "HowToStep",
      "text": "For the pastry, sieve the flour into a mixing bowl. Add the butter, parmesan and thyme and rub into the flour until the mixture resembles breadcrumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Add the egg yolk and the water and mix to form a firm dough. Wrap the dough in cling film and place in the fridge for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "On a floured surface, roll out the pastry to fit one large flan tin. Line the tin with the pastry, then place a circle of baking paper over the pastry and fill with baking beans."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to the oven and bake for 15 minutes. Remove the beans and paper and return to the oven for five minutes."
    },
    {
      "@type": "HowToStep",
      "text": "For the filling, place all the ingredients (except 50g/2oz of the Gruyère) into a large bowl and mix gently, to avoid filling the mixture with air."
    },
    {
      "@type": "HowToStep",
      "text": "Spoon the filling into the pastry case and sprinkle the remaining Gruyère on top."
    },
    {
      "@type": "HowToStep",
      "text": "Bake the quiche for 15 minutes, or until the filling is set. Serve hot or cold with a green salad."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 30 mins to 1 hour"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 10 to 30 mins"
    }
  ],
  "prepTime": "30 mins to 1 hour",
  "cookTime": "10 to 30 mins"
}
