{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Quiche Lorraine - Rachel Khoo",
  "cookTime": "PT40M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "For the pastry: 90g unsalted butter,",
    "For the pastry: 1 tsp sugar,",
    "For the pastry: 1 pinch salt,",
    "For the pastry: 180g plain flour,",
    "For the pastry: 2 egg yolks,",
    "For the pastry: 2 egg whites (for the wash).",
    "For the filling: 4 whole eggs,",
    "For the filling: 2 egg yolks,",
    "For the filling: 300 ml double cream.",
    "For the filling: 150g bacon lardons."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soften the butter and cream with 1 tsp sugar and 1 pinch salt."
    },
    {
      "@type": "HowToStep",
      "text": "Add 180g of plain flour, 2 egg yolks, and 2 tbsp cold water."
    },
    {
      "@type": "HowToStep",
      "text": "Using a wooden spoon, mix until it has a coarse sandy texture."
    },
    {
      "@type": "HowToStep",
      "text": "Using your hands bring the dough together, wrap in cling film for a minimum of 30 minutes, ideally overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the pastry from the fridge 30 minutes before use."
    },
    {
      "@type": "HowToStep",
      "text": "Butter and flour with dish, then roll out the pastry and line the dish with it."
    },
    {
      "@type": "HowToStep",
      "text": "Brush the base with egg white, and put in the fridge for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Fry the lardons without oil, then dry with a paper towel."
    },
    {
      "@type": "HowToStep",
      "text": "Into a medium sized glass mixing bowl add 4 whole eggs, 2 egg yolks, and 300ml of double cream. Season with salt and pepper and mix lightly with a bowl whisk."
    },
    {
      "@type": "HowToStep",
      "text": "Scatter the fried lardons into the pastry base, and pour over the cream and eggs."
    },
    {
      "@type": "HowToStep",
      "text": "Cook at 180°C (oven) for 40 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 10 mins pastry - 1 hour chill, 10 mins rest."
    }
  ],
  "prepTime": "10 mins pastry - 1 hour chill, 10 mins rest.",
  "keywords": [
    "Pastry"
  ]
}
