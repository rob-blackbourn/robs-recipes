{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Choux Paste - Michel Roux",
  "text": "Choux Paste - Michel Roux\n\nPreparation time:\n\nCooking time:\n\nYield:\n\nIngredients\n\n125ml Milk,\n\n125ml water,\n\n100g unsalted butter (diced and at room temperature),\n\n1/2 tsp salt,\n\n1 tsp caster sugar,\n\n150g plain flour,\n\n4 medium eggs,\n\neggwash (1 egg yolk mixed with 1 tbsp milk).\n\nPreparation\n\n1. Combine the water, milk, butter, salt and sugar in a saucepan, and set over a low heat.\n\n2. Bring to a boil and immediately remove from the heat.\n\n3. Shower with flour and mix with a wooden spoon until completely smooth.\n\n4. Return the pan to a medium heat and stir continuously for 1 minute to dry out the paste, then tip into a bowl and allow to cool.\n\n5. Add the eggs one at a time, beating with the wooden spoon or in a food mixer. Once the eggs are combined the paste should be smooth and shiney with a thick ribbon like consistency.",
  "recipeIngredient": [
    "125ml Milk,",
    "125ml water,",
    "100g unsalted butter (diced and at room temperature),",
    "1/2 tsp salt,",
    "1 tsp caster sugar,",
    "150g plain flour,",
    "4 medium eggs,",
    "eggwash (1 egg yolk mixed with 1 tbsp milk)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Combine the water, milk, butter, salt and sugar in a saucepan, and set over a low heat."
    },
    {
      "@type": "HowToStep",
      "text": "2. Bring to a boil and immediately remove from the heat."
    },
    {
      "@type": "HowToStep",
      "text": "3. Shower with flour and mix with a wooden spoon until completely smooth."
    },
    {
      "@type": "HowToStep",
      "text": "4. Return the pan to a medium heat and stir continuously for 1 minute to dry out the paste, then tip into a bowl and allow to cool."
    },
    {
      "@type": "HowToStep",
      "text": "5. Add the eggs one at a time, beating with the wooden spoon or in a food mixer. Once the eggs are combined the paste should be smooth and shiney with a thick ribbon like consistency."
    }
  ]
