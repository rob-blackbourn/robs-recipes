{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Pate Brisee",
  "text": "Pate Brisee\n\nYield:\n\nPreparation time:\n\nCooking time:\n\nIngredients\n\n250g plain flour,\n\n150 g butter (cut into small pieces and slightly softened),\n\n1 tsp fine salt,\n\npinch of caster sugar,\n\n1 egg,\n\n1 tbsp cold milk.\n\nPreparation\n\n1. Heap the flour on a work surface and make a well. Put in the butter, salt, sugar and egg. Using your fingertips, mix and cream these ingredients together.\n\n2. Little by little, draw in the flour, working the dough delicately until it has a grainy texture.\n\n3. Add the milk and incorporate gently with your fingertips until the dough begins to hold together.\n\n4. Using the palm of your hand, work the dough by pushing it away from you 4 or 5 times until it is smooth. Roll it into a ball, wrap in clingfilm and refrigerate until ready to use.",
  "recipeIngredient": [
    "250g plain flour,",
    "150 g butter (cut into small pieces and slightly softened),",
    "1 tsp fine salt,",
    "pinch of caster sugar,",
    "1 egg,",
    "1 tbsp cold milk."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heap the flour on a work surface and make a well. Put in the butter, salt, sugar and egg. Using your fingertips, mix and cream these ingredients together."
    },
    {
      "@type": "HowToStep",
      "text": "Little by little, draw in the flour, working the dough delicately until it has a grainy texture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the milk and incorporate gently with your fingertips until the dough begins to hold together."
    },
    {
      "@type": "HowToStep",
      "text": "Using the palm of your hand, work the dough by pushing it away from you 4 or 5 times until it is smooth. Roll it into a ball, wrap in clingfilm and refrigerate until ready to use."
    }
  ]
