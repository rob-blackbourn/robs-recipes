{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Pate Brisee",
  "recipeYield": "400g",
  "recipeIngredient": [
    "250 g plain flour,",
    "150 g butter (cut into small pieces and slightly softened),",
    "1 tsp fine salt,",
    "pinch of caster sugar,",
    "1 egg,",
    "1 tbsp cold milk."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heap the flour on a work surface and make a well. Put in the butter, salt, sugar and egg. Using your fingertips, mix and cream these ingredients together."
    },
    {
      "@type": "HowToStep",
      "text": "Little by little, draw in the flour, working the dough delicately until it has a grainy texture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the milk and incorporate gently with your fingertips until the dough begins to hold together."
    },
    {
      "@type": "HowToStep",
      "text": "Using the palm of your hand, work the dough by pushing it away from you 4 or 5 times until it is smooth. Roll it into a ball, wrap in clingfilm and refrigerate until ready to use."
    }
  ],
  "keywords": [
    "Pastry",
    "Basic"
  ]
}
