{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Herb Crêpes",
  "recipeYield": "8 crepes",
  "recipeIngredient": [
    "60g plain flour,",
    "150ml milk,",
    "2 eggs,",
    "15g mixed herbs (parsley, chervil, chives; chopped),",
    "30g clarified butter."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the flour in a bowl, season, and make a well in the centre."
    },
    {
      "@type": "HowToStep",
      "text": "Add one-third of the milk and the eggs then whisk lightly to make a smooth batter."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the rest of the milk and mix thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Pass the batter through a chinois or fine sieve."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chopped herbs."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with cling film and leave to rest for at least 30 minutes in the fridge."
    }
  ]
}
