{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Flan Pastry - Pate a Foncer",
  "recipeYield": "400 g",
  "recipeIngredient": [
    "250 g plain flour,",
    "125 g butter (cut into small pieces and slightly softened,",
    "1 egg,",
    "1 tsp caster sugar,",
    "1/2 tsp fine salt,",
    "40 ml cold water."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heap the flour on a work surface and make a well. Put the butter eggs, sugar and salt in the middle. With your fingertips, mix and cream the ingredients in the well."
    },
    {
      "@type": "HowToStep",
      "text": "Now, little by little, draw the flour into the centre and work the dough with your fingertips to a grainy texture. Add the cold water and mix it until the dough begins to hold together."
    },
    {
      "@type": "HowToStep",
      "text": "Using the palm of your hand, push the dough away from you 4 or 5 times until it is smooth. Roll the pastry into a ball, wrap in clingfilm and refrigerate until ready to use."
    }
  ]
}
