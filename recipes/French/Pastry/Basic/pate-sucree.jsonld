{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Pâte Sucrée",
  "recipeYield": "350 g",
  "recipeIngredient": [
    "250g plain flour,",
    "100g butter (cubed and slightly softened),",
    "pinch of salt,",
    "2 eggs (at room temperature)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the flour in a mound on a work surface and make a well. Put in the butter, icing sugar, and salt, and mix these ingredients together with your fingertips."
    },
    {
      "@type": "HowToStep",
      "text": "Gradually draw the flour into the centre and mix with your fingertips until the dough becomes slightly grainy."
    },
    {
      "@type": "HowToStep",
      "text": "Again make a well and add the eggs. Work them into the flour mixture, using your fingertips, until the dough begins to hold together."
    },
    {
      "@type": "HowToStep",
      "text": "When the dough is well amalgamated, knead it a few times with the palm of your hand until smooth. Roll the dough into a ball, wrap in cling film, and rest in the fridge for 1-2 hours before using."
    },
    {
      "@type": "HowToStep",
      "text": "When the dough is rested and you are ready to use it, unwrap and roll out on a lightly floured clean surface to a 2-3mm thickness."
    }
  ]
}
