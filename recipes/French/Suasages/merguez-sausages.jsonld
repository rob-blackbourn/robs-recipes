{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Merguez Sausages",
  "text": "Merguez Sausages\n\nPreparation time:\n\nCooking time:\n\nYield:\n\nIngredients\n\n1 kg lamb,\n\n3 tsp salt,\n\n2 tsp pepper,\n\n2 cloves garlic,\n\n2 tsp cayenne pepper,\n\n1/2 tsp ground allspice,\n\n2 tsp paprika,\n\n1/2 tsp cumin,\n\n1 tbsp olive oil.\n\nPreparation\n\n1. Grind through 1/4” (6 mm) plate.\n\n2. Mix ground meat with all ingredients and olive oil.\n\n3. Stuff into 24-26 mm sheep casings. Leave as one long rope or make 5” links.",
  "recipeIngredient": [
    "1 kg lamb,",
    "3 tsp salt,",
    "2 tsp pepper,",
    "2 cloves garlic,",
    "2 tsp cayenne pepper,",
    "1/2 tsp ground allspice,",
    "2 tsp paprika,",
    "1/2 tsp cumin,",
    "1 tbsp olive oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Grind through 1/4” (6 mm) plate."
    },
    {
      "@type": "HowToStep",
      "text": "Mix ground meat with all ingredients and olive oil."
    },
    {
      "@type": "HowToStep",
      "text": "Stuff into 24-26 mm sheep casings. Leave as one long rope or make 5” links."
    }
  ]
}
