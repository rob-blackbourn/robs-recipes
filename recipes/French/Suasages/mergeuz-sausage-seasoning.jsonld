  "name": "Mergeuz Sausage Seasoning",
  "text": "Mergeuz Sausage Seasoning\n\nPrep Time: 10 minutes\n\nTotal Time: 10 minutes\n\nIngredients\n\n¼ cup sweet paprika\n\n2 tbsp ground fennel seeds\n\n2 tbsp ground cumin\n\n1 tbsp ground coriander seeds\n\n2 tbsp salt\n\n1 tsp ground cinnamon\n\n1 tsp cayenne pepper\n\n3/4 tsp black pepper\n\nPreparation\n\nMeasure all ingredients into a bowl and stir to combine. Sift once, stir again and transfer to an airtight container for storage.",
  "prepTime": "PT10M",
  "totalTime": "PT10M",
  "recipeIngredient": [
    "¼ cup sweet paprika",
    "2 tbsp ground fennel seeds",
    "2 tbsp ground cumin",
    "1 tbsp ground coriander seeds",
    "2 tbsp salt",
    "1 tsp ground cinnamon",
    "1 tsp cayenne pepper",
    "3/4 tsp black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Measure all ingredients into a bowl and stir to combine. Sift once, stir again and transfer to an airtight container for storage."
    }
  ]
}
