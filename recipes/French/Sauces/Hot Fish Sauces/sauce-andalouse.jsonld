{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Sauce Andalouse",
  "text": "Sauce Andalouse\n\nPreparation time: 10 minutes\n\nYield:\n\nIngredients\n\n600 ml velouté,\n\n2 very large tomatoes (peeled and chopped),\n\na clove of garlic,\n\nolive oil,\n\n2 peppers,\n\nparsley.\n\nPreparation\n\n1. Boil the peppers for 10 minutes. Allow to cool, then peel and chop.\n\n2. Cook the tomatoes in a little olive oil with the crushed clove of garlic.\n\n3. When the tomato is reduced to a puree, add the sauce and the peppers.\n\n4. Finish with a little parsley.",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "recipeIngredient": [
    "600 ml velouté,",
    "2 very large tomatoes (peeled and chopped),",
    "a clove of garlic,",
    "olive oil,",
    "2 peppers,",
    "parsley."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Boil the peppers for 10 minutes. Allow to cool, then peel and chop."
    },
    {
      "@type": "HowToStep",
      "text": "Cook the tomatoes in a little olive oil with the crushed clove of garlic."
    },
    {
      "@type": "HowToStep",
      "text": "When the tomato is reduced to a puree, add the sauce and the peppers."
    },
    {
      "@type": "HowToStep",
      "text": "Finish with a little parsley."
    }
  ]
}
