  "recipeCuisine": "France",
  "name": "Fumet de Poisson",
  "text": "Fumet de Poisson\n\nPreparation time: 10 minutes\n\nYield: 2 l\n\nIngredients\n\n1-1/2 kg fish bones and heads,\n\n1 sliced onion,\n\n1 sliced carrot,\n\nthe sliced white part of a leek,\n\n1 sliced celery stalk,\n\nbouquet garni,\n\n1o black peppercorns,\n\n450 ml dry white wine,\n\n2 tsp white wine vinegar,\n\n2 l water.\n\nPreparation\n\n1. Put all the ingredients in a pan, adding the water last.\n\n2. Bring slowly to the boil, skimming until the liquid is clear.\n\n3. Cover, and simmer for 30 minutes.\n\n4 Strain the stock through a double muslin lined sieve.",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "recipeYield": "2 l",
  "recipeIngredient": [
    "1-1/2 kg fish bones and heads,",
    "1 sliced onion,",
    "1 sliced carrot,",
    "the sliced white part of a leek,",
    "1 sliced celery stalk,",
    "bouquet garni,",
    "1o black peppercorns,",
    "450 ml dry white wine,",
    "2 tsp white wine vinegar,",
    "2 l water."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the ingredients in a pan, adding the water last."
    },
    {
      "@type": "HowToStep",
      "text": "Bring slowly to the boil, skimming until the liquid is clear."
    },
    {
      "@type": "HowToStep",
      "text": "Cover, and simmer for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Strain the stock through a double muslin lined sieve."
    }
  ]
}
