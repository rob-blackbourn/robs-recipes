{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Mayonnaise - 1 egg",
  "recipeYield": "1/4 pint",
  "prepTime": "PT5M",
  "recipeIngredient": [
    "1 egg yolk,",
    "1 tsp strong Dijon mustard,",
    "125 ml groundnut oil,",
    "1/2 tbsp white wine vinegar (warmed) or 1/2 tbsp cold lemon juice,",
    "Salt and freshly ground pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a bowl combine the egg yolk, mustard and a little salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the oil in a thin stream. whisking continually."
    },
    {
      "@type": "HowToStep",
      "text": "When it is all incorporated, whisk more vigorously for 30 seconds until glossy."
    },
    {
      "@type": "HowToStep",
      "text": "Add the hot vinegar or cold lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "Check the seasoning."
    }
  ],
  "keywords": [
    "Sauces",
    "Emulsions"
  ]
}
