{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Mayonnaise - 1 egg",
  "text": "Mayonnaise - 1 egg\n\nYield: 1/4 pint\n\nPreparation time: 5 minutes\n\nIngredients\n\n1 egg yolk,\n\n1 tsp strong Dijon mustard,\n\n125 ml groundnut oil,\n\n1/2 tbsp white wine vinegar (warmed) or 1/2 tbsp cold lemon juice,\n\nSalt and freshly ground pepper.\n\nPreparation\n\n1. In a bowl combine the egg yolk, mustard and a little salt and pepper.\n\n2. Pour in the oil in a thin stream. whisking continually.\n\n3. When it is all incorporated, whisk more vigorously for 30 seconds until glossy.\n\n4. Add the hot vinegar or cold lemon juice.\n\n5. Check the seasoning.",
  "recipeYield": "1/4 pint",
  "prepTime": "PT5M",
  "recipeIngredient": [
    "1 egg yolk,",
    "1 tsp strong Dijon mustard,",
    "125 ml groundnut oil,",
    "1/2 tbsp white wine vinegar (warmed) or 1/2 tbsp cold lemon juice,",
    "Salt and freshly ground pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. In a bowl combine the egg yolk, mustard and a little salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "2. Pour in the oil in a thin stream. whisking continually."
    },
    {
      "@type": "HowToStep",
      "text": "3. When it is all incorporated, whisk more vigorously for 30 seconds until glossy."
    },
    {
      "@type": "HowToStep",
      "text": "4. Add the hot vinegar or cold lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "5. Check the seasoning."
    }
  ]
}
