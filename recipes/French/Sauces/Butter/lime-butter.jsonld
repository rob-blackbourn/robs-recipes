{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Lime Butter",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "60 g",
  "recipeIngredient": [
    "60 g lightly salted butter,",
    "2 tsp fresh lime juice,",
    "2 tsp lime zest,",
    "1 tsp chopped chives,",
    "pinch of dried thyme,",
    "small pinch grated fresh ginger."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the ingredients."
    }
  ],
  "keywords": [
    "Sauces",
    "Butter"
  ]
}
