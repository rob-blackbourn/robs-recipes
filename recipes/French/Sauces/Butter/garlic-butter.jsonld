{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Garlic Butter",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "300 g",
  "recipeIngredient": [
    "250 g unsalted butter,",
    "3 large cloves of garlic (finely chopped),",
    "30 g chopped shallot,",
    "50 g chopped parsley,",
    "1-2 tsp salt,",
    "freshly ground black pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cream the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the ingredients."
    }
  ],
  "keywords": [
    "Sauces",
    "Butter"
  ]
}
