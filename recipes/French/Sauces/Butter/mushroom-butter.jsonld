{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Mushroom Butter",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "400 g",
  "recipeIngredient": [
    "250 g unsalted butter,",
    "3 large cloves garlic (finely chopped),",
    "75 g mushrooms (finely chopped),",
    "1 slice cooked ham (finely chopped),",
    "60 g chopped parsley,",
    "salt and freshly ground black pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cream the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, mushrooms, ham and parsley, and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste."
    }
  ]
}
