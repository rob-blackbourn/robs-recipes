  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Mushroom Butter",
  "text": "Mushroom Butter\n\nPreparation time: 5 minutes\n\nIngredients\n\n250 g unsalted butter,\n\n3 large cloves garlic (finely chopped),\n\n75 g mushrooms (finely chopped),\n\n1 slice cooked ham (finely chopped),\n\n60 g chopped parsley,\n\nsalt and freshly ground black pepper.\n\nPreparation\n\n1. Cream the butter.\n\n2. Add the garlic, mushrooms, ham and parsley, and mix well.\n\n3. Season to taste.",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeIngredient": [
    "250 g unsalted butter,",
    "3 large cloves garlic (finely chopped),",
    "75 g mushrooms (finely chopped),",
    "1 slice cooked ham (finely chopped),",
    "60 g chopped parsley,",
    "salt and freshly ground black pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cream the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, mushrooms, ham and parsley, and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste."
    }
  ]
}
