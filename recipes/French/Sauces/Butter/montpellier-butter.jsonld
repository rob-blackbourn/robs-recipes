{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Montpellier Butter",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "recipeIngredient": [
    "25 g watercress,",
    "25 g spinach,",
    "25 g tarragon leaves,",
    "25 g parsley,",
    "25 g chervil,",
    "6 anchovy fillets,",
    "2 tbsp capers,",
    "4 miniature gherkins,",
    "1 egg yolk,",
    "3 hard boiled egg yolk,",
    "125 g softened butter,",
    "5-6 tbsp olive oil,",
    "lemon juice."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pour boiling water over the herbs, leave for 1 minute, then drain and dry as completely as possible."
    },
    {
      "@type": "HowToStep",
      "text": "Put the herbs in a food processor with the anchovy fillets, capers, gherkins and egg yolks, and process until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a bowl and mash in the softened the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Sieve the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Mix in the olive oil gradually."
    },
    {
      "@type": "HowToStep",
      "text": "Sharpen with a little lemon juice."
    }
  ]
}
