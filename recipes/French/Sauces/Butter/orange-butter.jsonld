{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Orange Butter",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "125 g",
  "recipeIngredient": [
    "125 g unsalted butter,",
    "4 tsp Seville orange juice,",
    "4 tsp Seville orange zest,",
    "2 tsp tomato concentrate,",
    "salt and pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the ingredients, then season taste."
    }
  ]
}
