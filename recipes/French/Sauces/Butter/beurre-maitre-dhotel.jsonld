  "recipeCuisine": "France",
  "name": "Beurre Maître D’Hôtel",
  "text": "Beurre Maître D’Hôtel\n\nPreparation time: 5 minutes\n\nCooking time: none\n\nIngredients\n\n250 g lightly salted butter,\n\n60-75 g chopped parsley,\n\nlemon juice to taste.\n\nPreparation\n\n1. Soften the butter to a thick cream.\n\n2. Mix in the parsley and lemon.\n\n3. Form into a roll and wrap in foil to store in the fridge.",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeIngredient": [
    "250 g lightly salted butter,",
    "60-75 g chopped parsley,",
    "lemon juice to taste."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soften the butter to a thick cream."
    },
    {
      "@type": "HowToStep",
      "text": "Mix in the parsley and lemon."
    },
    {
      "@type": "HowToStep",
      "text": "Form into a roll and wrap in foil to store in the fridge."
    }
  ]
}
