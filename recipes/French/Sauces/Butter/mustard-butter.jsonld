  "name": "Mustard Butter",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "125 g",
  "recipeIngredient": [
    "125 g unsalted butter (softened),",
    "1 tbsp French mustard,",
    "salt and freshly ground black pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add the mustard to the butter and season with salt and pepper."
    }
  ]
