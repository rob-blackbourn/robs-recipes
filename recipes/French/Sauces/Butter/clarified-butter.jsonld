{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Clarified Butter",
  "prepTime": "PT0M",
  "recipeYield": "1 portion",
  "recipeIngredient": [
    "Butter"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut up the butter and place in a cold saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Boil for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Cool for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Strain through a damp muslin cloth."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Saucepan,"
    },
    {
      "@type": "HowToTool",
      "name": "Muslin cloth."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 12 minutes (including 10 minutes cooling)"
    }
  ],
  "cookTime": "12 minutes (including 10 minutes cooling)"
}
