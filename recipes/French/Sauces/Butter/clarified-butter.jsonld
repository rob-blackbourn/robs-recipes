    {
      "@type": "HowToStep",
      "text": "Cut up the butter and place in a cold saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Boil for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Cool for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Strain through a damp muslin cloth."
    }
