{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Blond Roux",
  "text": "Blond Roux\n\nYield: 100 g\n\nPreparation time: 3 minutes\n\nIngredients\n\n50 g unsalted butter,\n\n50 g flour (sifted).\n\nPreparation\n\n1. Melt the butter in a saucepan.\n\n2. Take the pan off the heat and stir in the flour with a small whisk or a spatula.\n\n3. Cook over a medium heat for 5 minutes, stirring continuously, until it becomes a pale hazelnut brown.\n\n4. Transfer to a bowl and cover with cling film.",
  "recipeYield": "100 g",
  "prepTime": "PT3M",
  "cookTime": "PT6M",
  "recipeIngredient": [
    "50 g unsalted butter,",
    "50 g flour (sifted)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Take the pan off the heat and stir in the flour with a small whisk or a spatula."
    },
    {
      "@type": "HowToStep",
      "text": "Cook over a medium heat for 5 minutes, stirring continuously, until it becomes a pale hazelnut brown."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a bowl and cover with cling film."
    }
  ]
}
