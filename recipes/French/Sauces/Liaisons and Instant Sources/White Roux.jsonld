{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "White Roux",
  "text": "White Roux\n\nYield: 100 g\n\nPreparation time: 3 minutes\n\nCooking time: 4 minutes\n\nIngredients\n\n50 g butter,\n\n50 g flour (sifted).\n\nPreparation\n\n1. Melt the butter in a saucepan.\n\n2. Off the heat, add the flour and stir with a small whisk or a wooden spoon.\n\n3. Cook over a medium heat for 3 minutes, stirring continuously.\n\n4. Transfer to a bowl and cover with cling film.\n\n5. Keep at room temperature, or store in the fridge for several days.",
  "recipeYield": "100 g",
  "prepTime": "PT3M",
  "cookTime": "PT4M",
  "recipeIngredient": [
    "50 g butter,",
    "50 g flour (sifted)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Melt the butter in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "2. Off the heat, add the flour and stir with a small whisk or a wooden spoon."
    },
    {
      "@type": "HowToStep",
      "text": "3. Cook over a medium heat for 3 minutes, stirring continuously."
    },
    {
      "@type": "HowToStep",
      "text": "4. Transfer to a bowl and cover with cling film."
    },
    {
      "@type": "HowToStep",
      "text": "5. Keep at room temperature, or store in the fridge for several days."
    }
  ]
}
