{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Beurre Blanc with Cream",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "2 tbsp water,",
    "2 tbsp white wine vinegar,",
    "2 tbsp white wine,",
    "1 shallot (finely chopped),",
    "2 tbsp double cream,",
    "125g butter (chilled and diced),"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the shallot, water, wine and vinegar into a small saucepan and reduce until almost all the liquid has gone."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat and allow to cool a little."
    },
    {
      "@type": "HowToStep",
      "text": "Whisk in the cold butter a piece at a time until the sauce has a custard like consistency, returning the sauce to the heat from time to time to keep warm."
    },
    {
      "@type": "HowToStep",
      "text": "Season."
    }
  ]
}
