{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Chicken Fricassee with Mushrooms",
  "text": "Chicken Fricassee with Mushrooms\n\nPreparation time: 30 minutes\n\nCooking time: 45 minutes\n\nYield: 4\n\nIngredients\n\n4 chicken breasts (ideally bone in)\n\n500 g button mushrooms\n\n4 cloves garlic (finely diced)\n\n3 onions (finely diced)\n\n2 carrots (finely diced)\n\n2 stalks of celery (finely diced)\n\n1/2 block unsalted butter\n\n300ml double cream\n\n1/3 bottle white wine\n\n80ml cider vinegar\n\n2 tbsp plain flour\n\n250ml chicken stock\n\nsalt and pepper to taste\n\nPreparation\n\nDry Fry The Mushrooms\n\nDry fry the mushrooms over a medium high heat, tossing and turning often. The mushrooms will start to steam and appear glossy as the water comes to the surface. When the mushrooms are dry, add the cider and reduce until all the liquid has been absorbed. Remove from the pan and set aside.\n\nBrown The Chicken\n\nSeason each side of the chicken breasts and brown in vegetable oil over a medium high heat. If they have skin, start skin side down. Remove from the pan and set aside.\n\nMake The Mirepoix\n\nOn a medium low heat add 1/8 block of butter. The heat should be such that the butter starts to foam.\n\nAdd the carrot and cook for 3 minutes, stirring occasionally. Then add the celery and cook for 2 more minutes. Add the onion and cook for a further 4 minutes. Lastly add the garlic and cook for 3 minutes. This is ready when the onions have changed from hard white to soft and translucent.\n\nMake The Roux\n\nAdd to the mirepoix 1/4 block of butter. When it has melted add 2 tablespoons of plain flour, and cook through for 2 minutes stirring continuously.\n\nWhile stirring gently, gradually add the white wine and chicken stock, and bring to a rolling boil.\n\nAdd the cream, and cook for a further 2 minutes.\n\nAdd The Chicken And Mushrooms\n\nAdd the chicken and mushrooms. Cover the pan, and either simmer on the hob on a low heat for 40 minutes or put in the oven on gas 2 / 150C for 45 minutes.\n\nOnce done, if the sauce is too thin, cook uncovered until reduced to the desired consistency.",
  "prepTime": "PT30M",
  "cookTime": "PT45M",
  "recipeYield": "4",
  "recipeIngredient": [
    "4 chicken breasts (ideally bone in)",
    "500 g button mushrooms",
    "4 cloves garlic (finely diced)",
    "3 onions (finely diced)",
    "2 carrots (finely diced)",
    "2 stalks of celery (finely diced)",
    "1/2 block unsalted butter",
    "300ml double cream",
    "1/3 bottle white wine",
    "80ml cider vinegar",
    "2 tbsp plain flour",
    "250ml chicken stock",
    "salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Dry Fry The Mushrooms",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Dry fry the mushrooms over a medium high heat, tossing and turning often. The mushrooms will start to steam and appear glossy as the water comes to the surface. When the mushrooms are dry, add the cider and reduce until all the liquid has been absorbed. Remove from the pan and set aside."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Brown The Chicken",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Season each side of the chicken breasts and brown in vegetable oil over a medium high heat. If they have skin, start skin side down. Remove from the pan and set aside."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Make The Mirepoix",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "On a medium low heat add 1/8 block of butter. The heat should be such that the butter starts to foam."
        },
        {
          "@type": "HowToStep",
          "text": "Add the carrot and cook for 3 minutes, stirring occasionally. Then add the celery and cook for 2 more minutes. Add the onion and cook for a further 4 minutes. Lastly add the garlic and cook for 3 minutes. This is ready when the onions have changed from hard white to soft and translucent."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Make The Roux",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add to the mirepoix 1/4 block of butter. When it has melted add 2 tablespoons of plain flour, and cook through for 2 minutes stirring continuously."
        },
        {
          "@type": "HowToStep",
          "text": "While stirring gently, gradually add the white wine and chicken stock, and bring to a rolling boil."
        },
        {
          "@type": "HowToStep",
          "text": "Add the cream, and cook for a further 2 minutes."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Add The Chicken And Mushrooms",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add the chicken and mushrooms. Cover the pan, and either simmer on the hob on a low heat for 40 minutes or put in the oven on gas 2 / 150C for 45 minutes."
        },
        {
          "@type": "HowToStep",
          "text": "Once done, if the sauce is too thin, cook uncovered until reduced to the desired consistency."
        }
      ]
    }
  ]
}
