    "2 carrots (peeled and sliced),",
    "200 g button mushrooms,",
    "600 ml Brown chicken stock,",
    "1 bay leaf,",
    "Sprig of fresh thyme,",
    "6 peppercorns."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oven to 190°C."
    },
