{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Roast Mallard",
  "recipeYield": "2",
  "recipeIngredient": [
    "1 wild mallard duck,",
    "Salt",
    "Freshly ground black pepper",
    "A little soft lard or butter"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 230°C."
    },
    {
      "@type": "HowToStep",
      "text": "Season the mallard with salt and freshly ground pepper, running some lard or butter over the carcass to keep it moist."
    },
    {
      "@type": "HowToStep",
      "text": "Tip: For heavier birds of 1kg, double the cooking time to 60 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Place in a baking tray and roast for 10 mins. Reduce the temperature to 180°C (oven) and cook for 30 minutes. Remove from the oven and leave to rest in a warm place for 10 to 15 minutes. The meat should be slightly pink to serve, but if you prefer the meat less pink add 5-7 minutes onto the cooking time."
    }
  ]
}
