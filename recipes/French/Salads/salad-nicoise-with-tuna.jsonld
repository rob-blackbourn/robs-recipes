{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Salad Nicoise (With Tuna)",
  "prepTime": "PT30M",
  "cookTime": "PT45M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "For the salad: 400g/14oz fresh tuna loin",
    "For the salad: 1 tbsp olive oil",
    "For the salad: 4 free-range eggs",
    "For the salad: 100g French beans, cooked",
    "For the salad: 10 cherry tomatoes",
    "For the salad: olive oil, for drizzling",
    "For the salad: 8 new potatoes, cooked",
    "For the salad: 10 black olives",
    "For the salad: 1 Little Gem lettuce",
    "For the dressing: ½ garlic clove",
    "For the dressing: 2 canned anchovy fillets, drained",
    "For the dressing: 1 free-range egg yolk",
    "For the dressing: ½ lemon, juice only",
    "For the dressing: 100ml olive oil",
    "For the dressing: 1 tsp Dijon mustard",
    "For the dressing: salt and freshly ground black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 210°C."
    },
    {
      "@type": "HowToStep",
      "text": "For the salad, heat an ovenproof frying pan until hot. Rub the tuna loin with olive oil, then sear the tuna on each side."
    },
    {
      "@type": "HowToStep",
      "text": "Place in the oven for 5-6 minutes, or until just cooked, but still pink in the centre."
    },
    {
      "@type": "HowToStep",
      "text": "Bring a small pan of water to the boil and place the eggs into the water. Boil for 4-5 minutes, then drain and run under cold water to stop them continuing to cook. Peel off the shell."
    },
    {
      "@type": "HowToStep",
      "text": "Bring another pan of salted water to the boil, add the French beans and cook for 3-4 minutes, until just tender. Drain and refresh under cold water, then slice in half lengthways."
    },
    {
      "@type": "HowToStep",
      "text": "Place the cherry tomatoes onto a baking sheet and drizzle with a little olive oil. Place in the oven for 3-4 minutes, until just softened."
    },
    {
      "@type": "HowToStep",
      "text": "For the dressing, place the garlic and anchovy fillets into a pestle and mortar with the egg yolk and pound to a paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add the lemon juice and stir, then gradually add the olive oil in a slow drizzle, mixing all the time with a whisk."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the mustard and season, to taste, with salt and freshly ground black pepper."
    },
    {
      "@type": "HowToStep",
      "text": "To assemble the salad, place the beans, tomatoes, potatoes, olives, eggs and lettuce leaves into a bowl. Drizzle over the dressing and stir well."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, divide the salad among four serving plates. Cut the cooked tuna loin into thin slices and place on top of the salad."
    }
  ]
}
