{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Sole à la Bonne Femme",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "recipeYield": "2",
  "recipeIngredient": [
    "1 chopped shallot,",
    "1/2 tsp finely chopped parsley,",
    "60 g chopped mushrooms,",
    "1 large sole (cleaned and skinned),",
    "60 ml white wine,",
    "salt & pepper,",
    "juice of 1/2 lemon,",
    "3 tbsp butter,",
    "1 tbsp flour."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Rub an ovenproof dish with buttered paper."
    },
    {
      "@type": "HowToStep",
      "text": "Put the shallot, parsley and mushrooms over the base in an even layer and lay the sole on top."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the wine and the same amount of hot water over it, and season with salt, pepper, and lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with foil, and bake in a moderate oven, 180°C for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, mash up 1 tbsp butter with flour to make a beurre manié, then add it in little pieces to the sole liquor."
    },
    {
      "@type": "HowToStep",
      "text": "Return to the oven for a further 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the sole to a serving dish,"
    },
    {
      "@type": "HowToStep",
      "text": "Whisk i 2 tbsp butter into the cooking juices and pour over the sole."
    },
    {
      "@type": "HowToStep",
      "text": "Put under a hot grll to brown lightly."
    }
  ]
}
