{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Tartelet de Mackerel avec Beurre Blanc",
  "recipeIngredient": [
    "1 whole mackerel,",
    "rich shortcrust pastry.",
    "For the mouse: whiting,",
    "For the mouse: 1 egg white,",
    "For the mouse: double cream.",
    "For the tomato fondue: 1 shallot (finely chopped),",
    "For the tomato fondue: 1 clove of garlic (crush and finely chopped),",
    "For the tomato fondue: oil,",
    "For the tomato fondue: 1/2 tbsp tomato paste,",
    "For the tomato fondue: 2 fresh tomatoes (skinned, deseeded and cubed)",
    "For the beurre blanc: 1 portion of beurre blanc,",
    "For the beurre blanc: chives."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Poaching the mackerel",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Take the head and fins off the mackerel."
        },
        {
          "@type": "HowToStep",
          "text": "Poach in a court bouillon."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Preparing the mouse",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Add the egg white to the whiting."
        },
        {
          "@type": "HowToStep",
          "text": "Puree in a blender."
        },
        {
          "@type": "HowToStep",
          "text": "Pass through a sieve."
        },
        {
          "@type": "HowToStep",
          "text": "Beat in the double cream until it has the texture of mash potato."
        },
        {
          "@type": "HowToStep",
          "text": "Season."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For the pastry case",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Roll out the pastry to 3mm thick."
        },
        {
          "@type": "HowToStep",
          "text": "Blind bake the tartlet (about 4”) without trimming the edges."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For the tomato fondue",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Sweat the shallot and garlic."
        },
        {
          "@type": "HowToStep",
          "text": "Add the tomato paste."
        },
        {
          "@type": "HowToStep",
          "text": "Add the tomato."
        },
        {
          "@type": "HowToStep",
          "text": "Season with the emphasis on pepper."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For the tartlet",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Flake the fish."
        },
        {
          "@type": "HowToStep",
          "text": "Pipe the mousse into the blind baked pastry case."
        },
        {
          "@type": "HowToStep",
          "text": "Add the flaked mackerel."
        },
        {
          "@type": "HowToStep",
          "text": "Top with the tomato fondue."
        },
        {
          "@type": "HowToStep",
          "text": "Return to the oven to bake."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For the Beurre blanc",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Make the beurre blanc.."
        }
      ]
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1GqT2cw74uRLbc_jRyKAjEyrTJovbVQdmUS2f9Dg8dGM/edit?usp=sharing"
  ]
}
