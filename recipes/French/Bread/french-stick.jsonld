{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "French Stick",
  "recipeYield": "3 baguettes",
  "recipeIngredient": [
    "For the starter: 120 ml (4 fl oz) cool water,",
    "For the starter: 1/4 tsp dried yeast,",
    "For the starter: 125 g (4 1/2 oz) strong white bread flour.",
    "For the bread: 1 tsp dried yeast,",
    "For the bread: 230 - 300 ml (7 1/2 - 10 fl oz) lukewarm water,",
    "For the bread: 450 g strong white bread flour,",
    "For the bread: 1 1/2 tsp fine salt,",
    "For the bread: 2 tbsp polenta."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "The day before baking, make the starter by mixing the cool water and the yeast in a glass bowl. Add the flour. Cover and leave at room temperature for 12 - 15 hours. When the starter has risen and has bubbles on the surface it is ready."
    },
    {
      "@type": "HowToStep",
      "text": "To make the dough, mix the yeast with the lukewarm water in a large bowl. Add the flour, the starter and the salt and mix together with your hands until you have a soft dough."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the dough out onto a lightly floured surface and knead for 5 - 10 minutes or until it is smooth and elastic in texture."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly oil a large bowl, place the dough in it and cover with a damp tea towel. Leave to rise in a warm place for 1 hour."
    },
    {
      "@type": "HowToStep",
      "text": "Knock back the dough, turn it over, cover the bowl again and leave to rise for a further hour."
    },
    {
      "@type": "HowToStep",
      "text": "Repeat step 5 so the dough has been left to ris for a total of 3 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly grease your work surface to prevent the dough from sticking and turn it out from the bowl. Divide the dough into three. Cover and leave to rest for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Take each piece of dough, fold in half lenghtways and seal the edges with the heal of your hand. Repeat."
    },
    {
      "@type": "HowToStep",
      "text": "With the seam side down gently roll the dough with your hands until you have 3 long slim baguettes."
    },
    {
      "@type": "HowToStep",
      "text": "Line a large baking tray with parchment that has been sprinkled with polenta and place the baguettes seam side down. Cover with a damp tea towel or oiled cling film and leave to prove for a further 90 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Towards the end of the final proving time preheat the oven to 230°C."
    },
    {
      "@type": "HowToStep",
      "text": "Slash the baguettes with three cuts each."
    },
    {
      "@type": "HowToStep",
      "text": "Bake in the centre of the oven for 25-30 minutes until they are golden brown."
    }
  ]
}
