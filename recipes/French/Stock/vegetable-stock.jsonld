    "50 g bulb of fennel (very thinly sliced),",
    "150 g shallots (thinly sliced),",
    "100 g onion (thinly sliced),",
    "2 cloves of garlic (unpeeled),",
    "1 bouquet garni,",
    "250 ml dry white wine,",
    "2 l water",
    "10 white peppercorns (crushed and wrapped in muslin),"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Put all the ingredients except the peppercorns into a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "2. Bring to the boil over a high heat, then reduce immediately to a simmer."
    },
    {
      "@type": "HowToStep",
      "text": "3. Cook at a bare simmer for 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "4. After 35 minutes add the muslin wrapped peppercorns."
    },
    {
      "@type": "HowToStep",
      "text": "5. Strain and cool as quickly as possible."
    }
  ]
}
