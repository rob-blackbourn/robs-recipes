{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Fish Stock",
  "recipeYield": "2 l",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "recipeIngredient": [
    "1.5 kg bones and trimmings of white fish (cut into pieces),",
    "50 g unsalted butter,",
    "2 leeks (white part, thinly sliced),",
    "75 g onions (thinly sliced),",
    "75 g button mushrooms (thinly sliced),",
    "200 ml dry white wine,",
    "1 bouquet garni,",
    "2 slices of lemon,",
    "8 white peppercorns (crushed and wrapped in a piece of muslin)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Rinse the bones and trimmings then drain."
    },
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a saucepan and sweat the vegetables over a low heat for a few minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the fish bones and trimmings and bubble gently for a few seconds."
    },
    {
      "@type": "HowToStep",
      "text": "Pur in the wine."
    },
    {
      "@type": "HowToStep",
      "text": "Cook until reduced to one third."
    },
    {
      "@type": "HowToStep",
      "text": "Add 2.5 l cold water, bring to the boil, then immediately reduce to a simmer."
    },
    {
      "@type": "HowToStep",
      "text": "Skim the surface."
    },
    {
      "@type": "HowToStep",
      "text": "Add the bouquet garni and lemon."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer gently for 25 minutes, skimming when necessary."
    },
    {
      "@type": "HowToStep",
      "text": "10 minutes before the end add the muslin wrapped peppercorns."
    },
    {
      "@type": "HowToStep",
      "text": "Strain the stock and cool as quickly as possible."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1ApMSfXhCOThtVDLk7fhTr1J_yzvej9FlOwQg1WIuu7M/edit"
  ]
}
