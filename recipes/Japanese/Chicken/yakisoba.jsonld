{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Yakisoba",
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "recipeYield": "1 servings",
  "recipeIngredient": [
    "150 g / 1 pack of Yakisoba Noodles,",
    "1/3 tbsp Sake,",
    "50 g sliced pork (cut into 1 1/2 inch pieces),",
    "75 g bean sprouts,",
    "1/2 cabbage leaf (40g, cut into 1 inch squares),",
    "1/2 long green onion or 2 spring onions (sliced diagonally)",
    "15 g carrot (sliced into 1 inch long thin sticks),",
    "1 clove garlic (crushed, root removed, and finely diced),",
    "1 tsp sesame oil,",
    "For the Yakisoba Sauce: 1 tbsp oyster sauce,",
    "For the Yakisoba Sauce: 1/2~1 tsp soy sauce,",
    "For the Yakisoba Sauce: 1/2 tbsp sake or water,",
    "For the Yakisoba Sauce: A pinch of Salt and Pepper",
    "Toppings: Katsuobushi Shavings - Bonito Flakes",
    "Toppings: Aonori - Green Laver",
    "Toppings: Beni Shoga - Pickled Ginger"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Make the yakisoba sauce by combining the soy sauce and sake with the oyster sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Put the fresh noodles on a griddle, and pour the sake over the noodles."
    },
    {
      "@type": "HowToStep",
      "text": "Press the noodles into the surface with a spatula. When the underside begins to brown, turn, divide into 4 pieces, and move to the edge of the griddle."
    },
    {
      "@type": "HowToStep",
      "text": "Add sesame oil to the griddle, and fry the pork and garlic in the oil."
    },
    {
      "@type": "HowToStep",
      "text": "When the pork is brown add the cabbage, onion, carrot, and beansprouts, then season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "When the vegetables are almost cooked, mix with the noodles."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the yakisoba sauce over the noodles and mix again."
    }
  ]
}
