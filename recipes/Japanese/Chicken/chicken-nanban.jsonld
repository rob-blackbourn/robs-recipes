{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Chicken Nanban",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "For the chicken: 300g Chicken Thigh,",
    "For the chicken: 1 tbsp Sake,",
    "For the chicken: 1/2 tbsp Soy Sauce,",
    "For the chicken: 1 tsp Ginger Juice,",
    "For the chicken: 2 tbsp Potato Starch.",
    "For the vegetables: 70g Onion (cut into thin strips),",
    "For the vegetables: 20g carrot (cut into matchsticks),",
    "For the vegetables: 2 green Peppers (cut into rings,",
    "For the vegetables: 3 lettuce leaves (to serve on),",
    "For the vegetables: 1/2 tsp Cooking Oil.",
    "For the sauce: 4 tbsp Water,",
    "For the sauce: 4cm x 4cm Kombu Kelp (cut into thin strips),",
    "For the sauce: 4 tbsp Vinegar,",
    "For the sauce: 1 tbsp Soy Sauce,",
    "For the sauce: 1 1/2 tbsp Sugar,",
    "For the sauce: 1/8 tsp Salt,",
    "For the sauce: 1/2 dried red chili (deseeded and cut into thin rings),",
    "For the sauce: Toasted White Sesame Seeds."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the water in a small saucepan and add the Kombu, vinegar, soy sauce, sugar, and salt."
    },
    {
      "@type": "HowToStep",
      "text": "Mix well, bring to the boil, then remove from the heat and transfer to a small glass bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chili."
    },
    {
      "@type": "HowToStep",
      "text": "Put a small frying pan on a medium heat with a little oil and add the onion and carrot. Fry for 1 1/2 minutes until softened, then transfer to the glass bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add the green pepper and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Prick the chicken thigh. Cut in half, the cut each half into four pieces. Put in a bowl and add the soy sauce, sake and ginger juice. Massage until the liquid is absorbed, and leave for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Dry the chicken with kitchen towel and dust with potato starch."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry until golden brown."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the chicken to the vegetables and suave, mix quickly, then drain the sauce into separate dipping bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Serve the chicken and vegetables on a lettuce leaf with and scatter on a few sesame seeds."
    }
  ],
  "keywords": [
    "Chicken"
  ]
}
