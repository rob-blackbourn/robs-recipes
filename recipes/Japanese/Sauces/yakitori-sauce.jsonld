{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Yakitori Sauce",
  "prepTime": "PT1M",
  "cookTime": "PT10M",
  "recipeYield": "200 ml",
  "recipeIngredient": [
    "100 ml soy sauce,",
    "100 ml sake,",
    "3 tbsp brown sugar,",
    "1 tbsp honey,",
    "1 clove of garlic (crushed)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add all the ingredients to a pan."
    },
    {
      "@type": "HowToStep",
      "text": "On a medium heat, dissolve the sugar."
    },
    {
      "@type": "HowToStep",
      "text": "When it starts to boil remove the foam."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat, and allow the sauce to reduce a little."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 200ml"
    }
  ]
}
