{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Nobu-Style Saikyo Miso",
  "recipeYield": "800 g",
  "recipeIngredient": [
    "3/4 cup (150ml) sake,",
    "3/4 cup (150ml) mirin,",
    "2 cups (450g) wihte miso paste,",
    "1 1/4 cups (225 g) granulated sugar."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Bring the sake and mirin to boil in a medium saucepan over high heat. Boil for 20 seconds to evaporate the alcohol."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the heat down to low and add the miso paste, mixing with a wooden spoon, until the miso has dissolved completely."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the heat up to high and add the sugar, stirring constantly with the wooden spoon, ensuring the bottom of the pan doesn’t burn."
    },
    {
      "@type": "HowToStep",
      "text": "When all the sugar is dissolved, remove from the heat and allow to cool to room temperature before using."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 3 cups (800 g)"
    }
  ]
}
