{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Nobu-Style Saikyo Miso",
  "text": "Nobu-Style Saikyo Miso\n\nPreparation time:\n\nCooking time:\n\nYield: 3 cups (800 g)\n\nIngredients\n\n3/4 cup (150ml) sake,\n\n3/4 cup (150ml) mirin,\n\n2 cups (450g) wihte miso paste,\n\n1 1/4 cups (225 g) granulated sugar.\n\nPreparation\n\n1.Bring the sake and mirin to boil in a medium saucepan over high heat. Boil for 20 seconds to evaporate the alcohol.\n\n2. Turn the heat down to low and add the miso paste, mixing with a wooden spoon, until the miso has dissolved completely.\n\n3. Turn the heat up to high and add the sugar, stirring constantly with the wooden spoon, ensuring the bottom of the pan doesn’t burn.\n\n4. When all the sugar is dissolved, remove from the heat and allow to cool to room temperature before using.",
  "recipeYield": "3 cups (800 g)",
  "recipeIngredient": [
    "3/4 cup (150ml) sake,",
    "3/4 cup (150ml) mirin,",
    "2 cups (450g) wihte miso paste,",
    "1 1/4 cups (225 g) granulated sugar."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1.Bring the sake and mirin to boil in a medium saucepan over high heat. Boil for 20 seconds to evaporate the alcohol."
    },
    {
      "@type": "HowToStep",
      "text": "2. Turn the heat down to low and add the miso paste, mixing with a wooden spoon, until the miso has dissolved completely."
    },
    {
      "@type": "HowToStep",
      "text": "3. Turn the heat up to high and add the sugar, stirring constantly with the wooden spoon, ensuring the bottom of the pan doesn’t burn."
    },
    {
      "@type": "HowToStep",
      "text": "4. When all the sugar is dissolved, remove from the heat and allow to cool to room temperature before using."
    }
  ]
