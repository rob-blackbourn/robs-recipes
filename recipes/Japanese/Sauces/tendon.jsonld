{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Tendon Sauce",
  "recipeYield": "2",
  "recipeIngredient": [
    "100ml dashi stock,",
    "2 tbsp soy sauce,",
    "2 tbsp mirin,",
    "1 tbsp sake,",
    "1 tbsp sugar."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add to a medium saucepan, dashi stock, mirin and sake."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, then add the sugar and soy sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Bring the sauce back to the boil, stirring until the sugar has dissolved, then remove from the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Cool to room temperature before serving."
    }
  ]
}
