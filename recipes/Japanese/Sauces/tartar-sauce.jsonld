{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Tartar Sauce",
  "recipeIngredient": [
    "1 egg,",
    "2 tbsp minced onion,",
    "2 tbsp minced parsley,",
    "1 small pickled cucumber,",
    "2 tbsp mayonnaise,",
    "? tsp salt,",
    "2 tsp lemon juice."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Boil the egg for 6 minutes, then cool in cold water."
    },
    {
      "@type": "HowToStep",
      "text": "Finely dice the egg (this is easier with an egg slicer)."
    },
    {
      "@type": "HowToStep",
      "text": "Finely dice the onion."
    },
    {
      "@type": "HowToStep",
      "text": "Put the onion in a small bowl. Rub in a little salt. Rinse the onion in cold water, then drain with a mesh strainer. Squeeze out the water, and dry on a paper towel."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion to the chopped egg."
    },
    {
      "@type": "HowToStep",
      "text": "Finely chop the parsley, and add to the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Finely dice the pickled cucumber and add to the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mayonnaise."
    },
    {
      "@type": "HowToStep",
      "text": "Add the lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt."
    }
  ]
}
