{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Takikomi Gohan",
  "recipeYield": "2",
  "recipeIngredient": [
    "180ml rice (washed),",
    "180ml dashi stock,",
    "70g chicken breast (cut into small bite sizes pieces),",
    "20g carrot (cut into matchsticks),",
    "25g burdock root (cut into matchsticks and rinsed in cold water),",
    "30g shitaki mushrooms (sliced then halved),",
    "20g maitake mushrooms (torn and chopped into small bite sized pieces),",
    "1/2 aburaage (thin deep fried tofu cut into short fingers),",
    "5g ginger root (thinly shredded),",
    "Mitsuba parsley,",
    "1 tsp soy sauce,",
    "1/2 tsp salt,",
    "1 tbsp sake,",
    "1/2 tbsp mirin."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the rice in a rice cooker and add the dashi stock."
    },
    {
      "@type": "HowToStep",
      "text": "Marinate the chicken in the soy sauce, Dali, mirin and salt."
    },
    {
      "@type": "HowToStep",
      "text": "Add the carrot, burdock, mushrooms, aburaage and ginger to the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mixture on top of the rice."
    },
    {
      "@type": "HowToStep",
      "text": "Start the rice cooker as for ordinary rice cooking."
    },
    {
      "@type": "HowToStep",
      "text": "When cooked, mix through and serve garnished with mitsuba parsley."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Rice cooker"
    }
  ]
}
