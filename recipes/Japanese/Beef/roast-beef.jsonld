{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Roast Beef",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "300 g silverside (at room temperature),",
    "salt and coarsely ground pepper,",
    "200 ml dashi stock,",
    "50 ml soy sauce,",
    "40 ml mirin.",
    "Garnish: 4 shiso leaves,",
    "Garnish: cress,",
    "Garnish: ¼ onion (thinly sliced)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a small deep saucepan, combine the dashi stock, soy sauce, and mirin."
    },
    {
      "@type": "HowToStep",
      "text": "Bring the mixture to the boil, then remove from the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Season the beef with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Brown the beef on all sides in a hot frying pan with vegetable oil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the meat to the liquid, bring to the boil, then reduce the heat to a very gentle simmer."
    },
    {
      "@type": "HowToStep",
      "text": "Cook for 15 minutes, ladling the sauce over the meat, and turning occasionally."
    },
    {
      "@type": "HowToStep",
      "text": "Soak the thinly sliced onion in a bowl of ice water for 5 minutes, then dry with a paper towel."
    },
    {
      "@type": "HowToStep",
      "text": "Put the onion in the center of a long thin plate, with the shiso leaves at either end."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the beef very thinly. and place over the onion."
    },
    {
      "@type": "HowToStep",
      "text": "Top with cress."
    },
    {
      "@type": "HowToStep",
      "text": "Serve the stock as a sauce, in a bowl."
    }
  ],
  "image": [
    "Roast%20Beef.assets/image1.png"
  ]
}
