{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Gyudon",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "200g thinly sliced beef,",
    "1/2 onion (cut into thin wedges),",
    "1 inch ginger (grated),",
    "2 tbsp soy sauce,",
    "1 tbsp sake,",
    "1 tbsp sugar,",
    "1 tbsp hon-mirin,",
    "100 ml dashi stock,",
    "2 eggs,",
    "beni shoga (Japanese pickled ginger),",
    "shichimi (“Seven Flavor” chili pepper)",
    "4 spring onions (sliced),",
    "steamed rice."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "To poach the eggs, put them in a small saucepan and cover with boiling water. Put on the lid, and leave for 20 minutes. Remove and place into iced water."
    },
    {
      "@type": "HowToStep",
      "text": "To par-boil the beef, bring a medium saucepan of water to the boil and add the beef. When the beef loses its red colour remove and drain well."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sake, mirin, soy sauce, and sugar to a medium frying pan. Turn on the heat and stir the mixture at medium heat until it starts to boil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beef and stir to coat the beef with the sauce. after a minute remove the beef."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dashi stock, grated ginger and onion to the mixture, stir and cover. When the liquid starts to boil reduce the heat to low and cook for 5 more minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the lid and add the beef and warm though."
    },
    {
      "@type": "HowToStep",
      "text": "Put the rice in a bowl and add the beef and juices."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle on the spring onions."
    },
    {
      "@type": "HowToStep",
      "text": "Top with the poached egg."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time:\nYield: 2"
    }
  ]
}
