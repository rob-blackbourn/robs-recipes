{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Tonkatsu Curry",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "For the curry: 1 large onion (chopped),",
    "For the curry: 1/2 onion (chopped in 2x2cm pieces)",
    "For the curry: 100g carrot (coarsely grated),",
    "For the curry: 2 aubergine (peeled in strips, and then chunked with a rolling cut),",
    "For the curry: 2 small bell peppers (cut into 2x2cm pieces),",
    "For the curry: 2 cloves of garlic (finely grated),",
    "For the curry: ginger (finely grated),",
    "For the curry: 1 tbsp curry powder,",
    "For the curry: 2 tbsp olive oil,",
    "For the curry: 200cc canned tomato,",
    "For the curry: 300cc Water (1.27 u.s. cup)",
    "For the curry: 1 Soup Stock Cube",
    "For the curry: 1 Dried Bay Leaf",
    "For the curry: 25g Medium Spicy Curry Block (0.88oz)",
    "For the curry: 1/2 Small apple (peeled, soaked in salt water)",
    "Relishes: Fukujinzuke",
    "Relishes: Rakkyo",
    "For the tonkatsu: 2 slices of 1.2cm thick Pork Loin ( 1/2 inch thick)",
    "For the tonkatsu: Flour",
    "For the tonkatsu: Beaten Egg (1/2 Egg & 1/2 tsp Water)",
    "For the tonkatsu: Panko - Bread Crumbs",
    "For the tonkatsu: Frying Oil",
    "For the tonkatsu: A pinch of Salt",
    "For the tonkatsu: A pinch of Pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add oil to a saute pan and fry the chopped onions until golden brown (5 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Add the coarsely grated carrot and fry for 2-3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the grated garlic and ginger until fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the heat low and add the curry powder, frying for 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the aubergine and onions."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chopped tomatoes."
    },
    {
      "@type": "HowToStep",
      "text": "Add water and crumble in the stock cube."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dry bay leaf."
    },
    {
      "@type": "HowToStep",
      "text": "Put the lid on a simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Turn off the heat and add the chopped curry block. Stir until combined."
    },
    {
      "@type": "HowToStep",
      "text": "Grate the apple into the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the bell pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the heat back on and simmer with the lid on until the pepper is soft (2 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Season the pork."
    },
    {
      "@type": "HowToStep",
      "text": "Make cuts along the stringy parts of the port."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly coat with flour, then egg wash, then breadcrumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Shallow fry until golden brown."
    }
  ],
  "keywords": [
    "Pork"
  ]
}
