{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Katsudon",
  "recipeYield": "1 servings",
  "recipeIngredient": [
    "120g 1cm thick pork loin,",
    "a pinch of salt,",
    "a pinch of pepper,",
    "flour,",
    "1/4 egg (For the Tonkatsu)",
    "a dash of water,",
    "Nama-Panko (fresh bread crumbs)",
    "Frying Oil",
    "50ml dashi,",
    "1 tbsp soy sauce,",
    "1 tbsp mirin,",
    "1 tsp sugar,",
    "To complete the dish",
    "1/4 onion (cut into thin slices),",
    "1 egg (For the sauce)",
    "To Garnish: Mitsuba (Japanese wild parsley, roughly chopped)",
    "Serve with: 200g steamed rice."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare the pork loin by making cuts across the tough parts, including the fat. Pound the loin with a meat hammer to tenderize (not to make it thinner)."
    },
    {
      "@type": "HowToStep",
      "text": "Season one side of the loin with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Put 1/4 egg into a shallow dish and beat lightly."
    },
    {
      "@type": "HowToStep",
      "text": "Coat both sides of the pork loin with flour using a brush, dip the floured pork loin into the beaten egg and coat with breadcrumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry at 170°C until golden brown,turning once."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the fat and cut into 1” pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dashi stock to a medium frying pan with the soy sauce, mirin, sugar and onion."
    },
    {
      "@type": "HowToStep",
      "text": "With the lid on, bring to the boil, then simmer for 3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the pork loin to the pan, then cover with the beaten egg."
    },
    {
      "@type": "HowToStep",
      "text": "With the lid on cook on high heat for 30 seconds."
    }
  ],
  "keywords": [
    "Pork"
  ]
}
