{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Niboshi Dashi",
  "recipeIngredient": [
    "4 cups water,",
    "1/2 cup niboshi,",
    "small piece of kombu (optional)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the niboshi in water for 30 minutes. Optionally add a small piece of kombu; remove before heating."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, then simmer for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Strain through a paper towel."
    }
  ]
}
