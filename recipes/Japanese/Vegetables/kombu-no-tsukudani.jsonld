{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Kombu no tsukudani",
  "recipeIngredient": [
    "100g Kombu,",
    "4 tbsp dark soy sauce,",
    "2 tbsp rice vinegar,",
    "2 tbsp mirin,",
    "2 tbsp sugar,",
    "1 tsp grated ginger juice (optional)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the Kombu in enough water to cover it until it is soft enough to cut."
    },
    {
      "@type": "HowToStep",
      "text": "Reserve the water and cut into bite size pieces, and return to the water."
    },
    {
      "@type": "HowToStep",
      "text": "Add the vinegar and leave for at least 1 hour."
    },
    {
      "@type": "HowToStep",
      "text": "Add the other ingredients, bring the pan to a simmer, then lower the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Add liquid if necessary."
    },
    {
      "@type": "HowToStep",
      "text": "Cook until soft, shiny, caramalised, and transluscent."
    }
  ]
}
