{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Simmered Aubergine with Miso",
  "recipeYield": "1 servings",
  "recipeIngredient": [
    "100g Aubergine (cut into bite sized pieces),",
    "1 tbsp miso,",
    "1 tbsp mirin,",
    "3 tbsp sake,",
    "1 chilli pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the ingredients into a saucepan and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat and cook for 8 minutes."
    }
  ]
}
