{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Saba Misoni",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 mackerel fillet (bines removed, halved, with a diagonal cut in the skin on each half),",
    "1 bell pepper, (seeded and quartered),",
    "white part of a long green onion (shredded),",
    "180 ml water,",
    "3 tbsp sake,",
    "1 tbsp sugar,",
    "1 tbsp mirin,",
    "1½ tbsp brown miso,",
    "3 slices of ginger root,",
    "10cm green part of long green onion",
    "wooden drop-lid (otoshi buta)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare a bowl of iced water, large enough to take the fish pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Bring a pan to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Add a ladle of cold water to the boiling (to slightly reduce the temperature), then using a mesh strainer, add the first piece of mackerel, skin side up."
    },
    {
      "@type": "HowToStep",
      "text": "When the surface turns white, remove and plug into iced water."
    },
    {
      "@type": "HowToStep",
      "text": "Repeat with the other piece of mackerel."
    },
    {
      "@type": "HowToStep",
      "text": "Gently wash the fillet in the ticed water, then dry on a paper towel."
    },
    {
      "@type": "HowToStep",
      "text": "Into a cold small frying pan add the water, sake, sugar, mirin and half of the miso (using the ladle method)."
    },
    {
      "@type": "HowToStep",
      "text": "Turn on the heat, and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Put the fish in the pan, skin side up."
    },
    {
      "@type": "HowToStep",
      "text": "Bring the mixture to a simmer, removing any scum before adding the ginger and green part of the onion."
    },
    {
      "@type": "HowToStep",
      "text": "Place a dampened otoshi buta onto the fish to help it cook evenly."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer for 5 minutes on medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Uncover and remove the long green onion."
    },
    {
      "@type": "HowToStep",
      "text": "Carefully dissolve the rest of the miso, and add the bell pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with the otoshi buta and simmer for 2-3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Uncover, and remove the bell pepper before it’s colour fades."
    },
    {
      "@type": "HowToStep",
      "text": "Baste the fish, and leave uncovered to reduce the sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Serve on a plate with the pepper, and some shredded green onion."
    }
  ],
  "keywords": [
    "Seafood",
    "Mackerel"
  ]
}
