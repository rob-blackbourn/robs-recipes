{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Grilled Mackerel with Chilli & Tamarind Sauce",
  "recipeYield": "4",
  "recipeIngredient": [
    "2 cloves of garlic (peeled),",
    "1 tbsp of coriander (chopped, including the root),",
    "1 thin slice of fresh ginger,",
    "3 tsp fish sauce,",
    "1 1/2 tbsp oil,",
    "4 mackerel steaks.",
    "For the Tamarind Sauce: 1 small fresh hot red chilli (deseeded and finely chopped),",
    "For the Tamarind Sauce: 1 tbsp tamarind paste,",
    "For the Tamarind Sauce: 2 tbsp palm sugar,",
    "For the Tamarind Sauce: 1 tbsp fish sauce."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a spice grinder or blender, grind the garlic, coriander, ginger and fish sauce to a paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oil and blend again."
    },
    {
      "@type": "HowToStep",
      "text": "Rub the mixture over the fish and set aside to marinate for 20 mins."
    },
    {
      "@type": "HowToStep",
      "text": "In a small saucepan combine the tamarind sauce ingredients with 1/3 cup water and simmer for 3-4 minutes. Taste and adjust with extra tamarind, sugar of fish sauce. Remove from heat and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Grill the fish for about 3 minutes on each side basting with the sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Serve, spooning over with the remaining sauce."
    }
  ]
}
