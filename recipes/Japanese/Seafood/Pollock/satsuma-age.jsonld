    "1/3 tsp salt,",
    "1/2~1 tbsp potato starch or cornstarch,",
    "1/2 egg,",
    "1/2 tsp ginger root juice,",
    "10g carrot (finely diced),",
    "1/4 onion (finely diced),",
    "1 tsp plain flour,",
    "Oil for deep frying,",
    "To serve: soy sauce,",
    "To serve: grated ginger root."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Put the fish, sake, and salt in the food processor and process of a few seconds."
    },
