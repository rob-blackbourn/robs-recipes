    "3 tbsp dashi,",
    "3 tbsp cup soy sauce,",
    "2 tbsp brown sugar,",
    "corn flour,",
    "2 spring onions,",
    "1/2 tbsp shredded ginger."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oven to 180C/Gas 4/350F."
    },
    {
      "@type": "HowToStep",
      "text": "Cut fish into pieces and dust with flour."
    },
    {
