{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Baked Monkfish with Ginger",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "250 g Monkfish,",
    "3 tbsp cup sake,",
    "2 tbsp cup mirin,",
    "3 tbsp dashi,",
    "3 tbsp cup soy sauce,",
    "2 tbsp brown sugar,",
    "corn flour,",
    "2 spring onions,",
    "1/2 tbsp shredded ginger."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oven to 180°C."
    },
    {
      "@type": "HowToStep",
      "text": "Cut fish into pieces and dust with flour."
    },
    {
      "@type": "HowToStep",
      "text": "In a small saucepan, add the saki and mirin to a pan, and boil off the alcohol."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat then add the soy sauce and sugar and stir until dissolved. Remove from the heat."
    },
    {
      "@type": "HowToStep",
      "text": "In a small frying pan over a medium heat, add a little oil, then fry the fish for 1 minute on each side."
    },
    {
      "@type": "HowToStep",
      "text": "Add the ginger, spring onion, and the liquids."
    },
    {
      "@type": "HowToStep",
      "text": "Put the pan in the oven for 5-7 minutes."
    }
  ],
  "keywords": [
    "Seafood",
    "Monkfish"
  ]
}
