    },
    {
      "@type": "HowToStep",
      "text": "In a small frying pan over a medium heat, add a little oil, then fry the fish for 1 minute on each side."
    },
    {
      "@type": "HowToStep",
      "text": "Add the ginger, spring onion, and the liquids."
    },
    {
      "@type": "HowToStep",
