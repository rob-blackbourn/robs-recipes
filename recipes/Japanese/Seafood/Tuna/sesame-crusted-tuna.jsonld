{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Sesame Crusted Tuna",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "olive oil",
    "4 tuna steaks",
    "sesame seed (I haven't listed quantity as it will vary for size of steaks, but enough to cover one side of tuna)",
    "18 g paste miso",
    "3 tablespoons mirin",
    "3 tablespoons sake",
    "2 tablespoons sugar",
    "2 tablespoons rice vinegar",
    "2 teaspoons Japanese soy sauce",
    "1/4 teaspoon wasabi"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cover one side of tuna completely with sesame seeds and place steaks back in fridge."
    },
    {
      "@type": "HowToStep",
      "text": "Combine all the other ingredients in a saucepan heat until blended and sugar has dissolved. Leave on low heat to keep warm."
    },
    {
      "@type": "HowToStep",
      "text": "Heat some olive oil in a fry pan, place Tuna sesame seed side down cook for 4 minutes turn over and cook on the other side for a further 4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Serve tuna on plate with dipping sauce in separate small serving bowls."
    }
  ]
}
