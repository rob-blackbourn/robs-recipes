{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Ninjin Shirishiri",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 large carrot (about 120g, half grated, half cut into matchsticks),",
    "40g tin of tuna in oil,",
    "1 egg (seasoned with a pinch of salt and lightly beaten),",
    "1 tsp sesame oil,",
    "1/2 tsp soy sauce,",
    "salt,",
    "3 tbsp bonito flakes."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Open the tin of tuna and drain the oil into a small frying pan."
    },
    {
      "@type": "HowToStep",
      "text": "Fry the carrot in the pan. Adding a small amount of water will help the carrot cook quickly. Cook until soft."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tuna. Crumble into small pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Season with soy sauce and salt, and continue to stir fry."
    },
    {
      "@type": "HowToStep",
      "text": "Pour over the egg and mix."
    },
    {
      "@type": "HowToStep",
      "text": "Add the bonito flakes, lightly stir, and remove from the heat."
    }
  ]
}
