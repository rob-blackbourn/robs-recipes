{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Tai-meshi",
  "recipeYield": "2",
  "recipeIngredient": [
    "1 fillet of sea bream (with bones),",
    "180 ml rice,",
    "200 ml water,",
    "1 tbsp sake,",
    "½ tsp salt,",
    "¼ tsp soy sauce,",
    "4x5cm dashi kombu seaweed,",
    "5 g ginger root (thinly sliced).",
    "Toppings: 4 sprigs of Kinome - Young Leaves of Sansho Pepper (or mitsuba, parsley, shiso leaves),",
    "Toppings: toasted white sesame seeds."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the rice in water with the kombu for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle salt on both sides of the sea bream. Lightly rub in the salt, then pour the sake over it. Allow to marinate for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Brush the grilling basket with vinegar to prevent sticking."
    },
    {
      "@type": "HowToStep",
      "text": "Dry the fillet in a paper towel, put in the grilling basket, and cook with the skin side facing the heat. When the skin is browned flip over and cook until lightly browned."
    },
    {
      "@type": "HowToStep",
      "text": "Add the salt, sake, and soy sauce to the rice. Place this fish on top and add the ginger."
    },
    {
      "@type": "HowToStep",
      "text": "Cover, and bring to a boil on medium heat, leaving the lid slightly open. When it begins to boil, cover completely and reduce the heat to a very low setting. Cook for 12 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Allow to rest for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Put the fish on a plate, and remove the bones. Break into bite size pieces, then roughly crumble."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the kombu seaweed and cut into thin strips."
    },
    {
      "@type": "HowToStep",
      "text": "Return the fish and the seaweed to the rice and lightly mix."
    },
    {
      "@type": "HowToStep",
      "text": "Serve in a bowl garnished with toasted sesame seeds and kinome."
    }
  ],
  "image": [
    "Tai-meshi.assets/image1.png"
  ]
}
