{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Morocco",
  "name": "Khobz Kesra",
  "cookTime": "PT15M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 cups of bread flour,",
    "2 cups semolina flour,",
    "2 cups warm water,",
    "1 packet of instant yeast,",
    "2 tsp salt,",
    "1 tsp sugar,",
    "1/4 cup olive oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a small bowl add the yeast, sugar and 1 cup of warm water. Stir well and allow the yeast to bubble. This should take 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200°C,"
    },
    {
      "@type": "HowToStep",
      "text": "With the dough hook on the kitchen aid, mix the flour and salt,"
    },
    {
      "@type": "HowToStep",
      "text": "Make a well in the flour and pour in the yeast and water mixture and the oil."
    },
    {
      "@type": "HowToStep",
      "text": "Start the dough hook on a low speed, and as the mixture comes together add as much of the second cup of warm water as it needs to form a ball."
    },
    {
      "@type": "HowToStep",
      "text": "Increase the speed to knead for 5 minutes"
    },
    {
      "@type": "HowToStep",
      "text": "Put the dough in an oiled bowl, cover with a tea towel and allow to rest for 15 minutes until a knuckle leaves an impression in the dough."
    },
    {
      "@type": "HowToStep",
      "text": "Divide into four."
    },
    {
      "@type": "HowToStep",
      "text": "On a floured board take each of the four, and flatten into a 1/4” thick round."
    },
    {
      "@type": "HowToStep",
      "text": "Put on a baking sheet sprinkled with semolina flour, cover with a towel, and allow to rise for 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Once risen slice a cross on the top with a knife. Sprinkle with a little semolina, and cook in the oven at 200°C for 15 minutes, until the bottom is brown and sounds hollow when tapped."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 10 minutes with 50 minutes waiting."
    }
  ],
  "prepTime": "10 minutes with 50 minutes waiting.",
  "keywords": [
    "Bread"
  ]
}
