  "recipeCuisine": "Morocco",
  "name": "Ras-el-Hanout",
  "text": "Ras-el-Hanout\n\nPreparation time: 5 minutes\n\nYield: 5 tsp\n\nIngredients\n\n2 tsp ground cinnamon\n\n1 tsp ground turmeric\n\n1 tsp coriander seeds\n\n½ tsp freshly ground black pepper\n\n¼ tsp freshly grated nutmeg, or to taste\n\n¼ tsp freshly ground cardamom seeds\n\n¼ tsp freshly ground cloves\n\nPreparation\n\nMix all of the ingredients together until well combined. Grind in a spice grinder or coffee grinder to a fine powder. Store in an airtight jar.",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "5 tsp",
  "recipeIngredient": [
    "2 tsp ground cinnamon",
    "1 tsp ground turmeric",
    "1 tsp coriander seeds",
    "½ tsp freshly ground black pepper",
    "¼ tsp freshly grated nutmeg, or to taste",
    "¼ tsp freshly ground cardamom seeds",
    "¼ tsp freshly ground cloves"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all of the ingredients together until well combined. Grind in a spice grinder or coffee grinder to a fine powder. Store in an airtight jar."
    }
  ]
}
