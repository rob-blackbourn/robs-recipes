{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Morocco",
  "name": "Merguez Spice Mix",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "recipeIngredient": [
    "4 tbsp sweet paprika",
    "2 tbsp ground fennel seeds",
    "2 tbsp ground cumin",
    "1 tbsp ground coriander seeds",
    "2 tbsp salt",
    "1 tsp ground cinnamon",
    "1 tsp cayenne pepper",
    "3/4 tsp black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the ingredients in a pestle and mortar and grind to a powder."
    }
  ],
  "keywords": [
    "Spices"
  ]
}
