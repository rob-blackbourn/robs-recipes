{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Morocco",
  "name": "Couscous",
  "prepTime": "PT0M",
  "cookTime": "PT10M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 cup couscous,",
    "1 cup hot water,",
    "a knob of butter,",
    "salt & pepper.",
    "Optional Ingredients: Chives (chopped),",
    "Optional Ingredients: red pepper (diced)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the couscous in a pyrex bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Boil the water and pour over the couscous."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with cling film and wait for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the cling film and fluff with a fork."
    },
    {
      "@type": "HowToStep",
      "text": "Add a knob of butter and season."
    },
    {
      "@type": "HowToStep",
      "text": "If required add the optional ingredients."
    }
  ]
}
