{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Easter Lamb",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 kg lamb shoulder (roughly cut into 2 cm cubes)",
    "5 anchovy fillets",
    "1 carrot (chopped into 1 cm cubes)",
    "2 onions (roughly chopped)",
    "3 stalks of celery (roughly chopped)",
    "2 large cloves of garlic",
    "1 mild red chilli",
    "Fresh thyme",
    "1 glass of white wine",
    "2 tbsp white wine vinegar",
    "3 medium white potatoes (cut into 2cm chunks)",
    "250g plum cherry tomatoes (whole)",
    "250ml chicken stock",
    "250g frozen peas",
    "Bread to serve"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Season the lamb with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Heat a very wide pan to medium hot with olive oil. Add the anchovy fillets, after 30 seconds add the lamb and brown."
    },
    {
      "@type": "HowToStep",
      "text": "When the meat is browned turn the heat to medium and add the carrots. Wait one minute then add the onions. After another minute add the celery. After another minute add the garlic and chilli. Finally add the thyme."
    },
    {
      "@type": "HowToStep",
      "text": "Add the wine and reduce while stirring until very little liquid remains. Then add the white wine vinegar. Reduce to a low heat, cover, and cook for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Season the potatoes, and add them to the pot. Add the plum cherry tomatoes. Add the stock, and cook for 35-40 minutes or until the lamb is soft."
    },
    {
      "@type": "HowToStep",
      "text": "Add the peas and cook for a further 8 minutes, then serve with bread."
    }
  ],
  "prepTime": "PT30M",
  "cookTime": "PT1H",
  "keywords": [
    "meat",
    "lamb"
  ]
}
