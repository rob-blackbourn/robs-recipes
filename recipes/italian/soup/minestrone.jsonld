{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Minestrone",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 tbsp olive oil,",
    "knob of butter,",
    "1 sprig of fresh thyme,",
    "1 clove garlic (crushed),",
    "2 carrots (diced),",
    "1 large onion (diced),",
    "2 celery sticks (diced),",
    "1 head of fennel (diced),",
    "750 ml chicken or vegetable stock,",
    "1 potato (diced),",
    "1 courgette (diced),",
    "ditalini pasta,",
    "1 tbsp fresh parsley (finely chopped),",
    "handful of freshly grated parmesan to serve,",
    "salt & pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil and butter in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the thyme, garlic, carrots onion, celery and fennel. Cook over a medium heat for 8-10 minutes without colouring, stirring constantly, until soft."
    },
    {
      "@type": "HowToStep",
      "text": "Add enough stock to cover the vegetables, reduce the heat and simmer for 8-10 more minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the potato and cook for a further 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the courgette, pasta and parsley and warm through."
    },
    {
      "@type": "HowToStep",
      "text": "Season and serve with parmesan."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: Serves 4"
    }
  ],
  "keywords": [
    "Soup"
  ]
}
