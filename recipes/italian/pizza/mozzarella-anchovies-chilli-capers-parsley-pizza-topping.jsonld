{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Mozzarella, anchovies, chilli, capers & parsley pizza topping",
  "recipeCategory": "Pizza topping",
  "recipeYield": "1 pizza topping",
  "recipeIngredient": [
    "4 anchovy fillets",
    "1/2 fresh red chilli (sliced)",
    "1 heaped teaspoon small capers (rinsed if salty)",
    "extra virgin olive oil",
    "zest and juice of 1/2 lemon",
    "3 tablespoons tomato sauce",
    "50 g mozzarella",
    "1 tablespoon finely sliced fresh flat-leaf parsley",
    "sea salt",
    "freshly ground black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the anchovy fillets in half lengthways and add to a bowl with the sliced chilli, the capers, a couple of tablespoons of extra virgin olive oil and the lemon zest."
    },
    {
      "@type": "HowToStep",
      "text": "Squeeze over a little lemon juice as well and mix up."
    },
    {
      "@type": "HowToStep",
      "text": "Let the anchovies sit in the marinade for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Smear the tomato sauce evenly over the pizza base and scatter torn-up pieces of mozzarella over the top."
    },
    {
      "@type": "HowToStep",
      "text": "Evenly lay over the anchovy fillets, scatter over the capers and chilli, and sprinkle with a little parsley and seasoning."
    },
    {
      "@type": "HowToStep",
      "text": "Drizzle with the leftover marinating oil and cook until crisp and golden."
    }
  ],
  "keywords": [
    "Pizza"
  ]
}
