{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "San Marzano tomato pizza",
  "recipeYield": "4 pizzas",
  "recipeIngredient": [
    "800 g '00' flour,",
    "200 g semolina flour,",
    "1 tsp salt,",
    "1 tbsp caster sugar,",
    "14g dried yeast,",
    "4 tbsp extra virgin olive oil,",
    "650 ml water,",
    "2 x 400g tins San Marzano tomatoes,",
    "2 large cow’s milk mozzarella balls (grated),",
    "3 tbsp olive oil,",
    "3 tbsp peanut oil,",
    "Salt and pepper for seasoning",
    "1 large handful basil leaves."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "To make the dough, place the flours, salt, sugar and yeast into a large bowl and stir. Make a well in the centre of the flour and pour in the water, gradually mixing in the flour to form a soft dough."
    },
    {
      "@type": "HowToStep",
      "text": "Tip out and knead on an oiled work surface for about 10 minutes or until the dough is smooth and elastic. Place it into a bowl, cover and leave to rise for 24 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to its highest temperature. Place a heavy baking tray or pizza stone in the oven and allow it to heat."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the dough from the bowl and knead for a couple of minutes, then divide into four pieces. Allow to rest for five minutes, then stretch each piece over your hands to form a disc about 5mm thick."
    },
    {
      "@type": "HowToStep",
      "text": "Place the circles of dough onto upturned floured baking trays or a pizza peel if you have one."
    },
    {
      "@type": "HowToStep",
      "text": "Place the tinned tomatoes into a food processor and blend to a purée. Spoon the tomato purée thinly over the pizzas, scatter over the grated mozzarella, then drizzle over the oils. Season with sea salt and freshly ground black pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Slide each pizza off the baking tray directly onto the heated baking tray or pizza stone in the oven and cook for 5 -10 minutes, or until golden-brown and crisp."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, scatter the basil leaves over the pizza and drizzle with a little more peanut oil."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: overnight"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: less than 10 mins"
    },
    {
      "@type": "Comment",
      "text": "Original yield: Makes 4 pizzas"
    }
  ],
  "prepTime": "overnight",
  "cookTime": "less than 10 mins",
  "keywords": [
    "Pizza"
  ]
}
