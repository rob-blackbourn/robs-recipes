{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Risotto with Radicchio and Sea Scallops",
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "For the scallops",
    "1/4 cup extra virgin olive oil,",
    "230 g sea scallops (diced into 1.25 cm pieces),",
    "1 garlic clove (minced),",
    "1/2 tsp salt (plus more to taste).",
    "For the risotto",
    "6 cups vegetable broth,",
    "4 tbsp unsalted butter,",
    "1/2 small onion (minced),",
    "2 cups arborio rice,",
    "1 cup dry white wine,",
    "3 medium heads of radicchio (leaves),",
    "Ground black pepper (to taste)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a medium frying pan over high heat. Fry the scallops until barely golden (2 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Bring the broth to the boil then kept warm over a low heat."
    },
    {
      "@type": "HowToStep",
      "text": "Melt 3 tbsp butter in a large heavy pan over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "When the butter begins to foam add the onions. Cook until pale yellow and soft (4 - 5 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rice, stir to coat with the butter, and cook until it turns white (2 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Add the wine and stir until absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Add the radicchio and a ladle of stock and stir until the broth has been absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Continue adding the stock a ladle at a time, stirring to absorb before adding the next."
    },
    {
      "@type": "HowToStep",
      "text": "Add the scallops and their juices and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Add a knob of butter. Mix and season."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4 to 6"
    }
  ],
  "keywords": [
    "Risotto"
  ]
}
