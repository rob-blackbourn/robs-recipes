{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italian",
  "name": "Ciabatta 2",
  "recipeYield": "6 loaves",
  "recipeIngredient": [
    "750 g strong white bread flour",
    "250 g fine semolina (plus 500g for dusting)",
    "10 g dried yeast",
    "25 g salt",
    "800 ml warm water",
    "1 tbsp olive oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare the dough:"
    },
    {
      "@type": "HowToStep",
      "text": "By hand: Mix the flour semolina, yeast, salt, and water together in a very large bowl, then add the oil. You won’t be kneading in a conventional manner. Instead, form your strongest hand into an “eagle claw”, and beat the mix for about 5 minutes, until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "By machine: Fit a dough hook to a food mixer and add the flour, semolina, yeast, salt, and water to the mixer bowl. Mix on a slow speed until evenly combined, then add the oil and mix for a further 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Put the bowl in a bin liner and leave to ferment. Every half hour for the next three hours, do the following: uncover the bowl, slug in some olive oil, smooth it all over and underneath, then make an attempt to fold the hold thing in two in one direction, then in three n the other direction (a bit like flding a blanket). The first time this will really not work, but this repeated action over the next three hours gives real structure to the gluten, and the dough will become cohesive and elastic."
    },
    {
      "@type": "HowToStep",
      "text": "Now prepare yourself. Have ready some linen cloth, and dust this, the work surface, the dough, and your hands generously with semolina. Make a big pile of semolina to one side where it’s easy to grab"
    }
  ],
  "keywords": [
    "Bread"
  ]
}
