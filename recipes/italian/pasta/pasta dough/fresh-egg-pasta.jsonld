{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Fresh Egg Pasta",
  "cookTime": "PT5M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "100 g ‘00’ plain flour",
    "1 large egg",
    "salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the flour and salt in the bowl of a mixer."
    },
    {
      "@type": "HowToStep",
      "text": "Add the egg."
    },
    {
      "@type": "HowToStep",
      "text": "Mix on a slow setting until the egg is combined (less than 1 minute)."
    },
    {
      "@type": "HowToStep",
      "text": "Bring together with your hands, and transfer to a floured surface."
    },
    {
      "@type": "HowToStep",
      "text": "Knead for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Wrap in cling film and put in the fridge for 30 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 30 minutes (plus 30 minutes resting)"
    },
    {
      "@type": "Comment",
      "text": "Original yield: 2 (of tagliatelle)"
    }
  ],
  "prepTime": "30 minutes (plus 30 minutes resting)",
  "keywords": [
    "Pasta",
    "Pasta Dough"
  ]
}
