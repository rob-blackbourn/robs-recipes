{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Fresh Egg Pasta",
  "prepTime": "PT30M",
  "cookTime": "PT5M",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Dough",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "100 g \"00\" plain flour",
    "1 large egg",
    "salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the flour and salt in the bowl of a mixer."
    },
    {
      "@type": "HowToStep",
      "text": "Add the egg."
    },
    {
      "@type": "HowToStep",
      "text": "Mix on a slow setting until the egg is combined (less than 1 minute)."
    },
    {
      "@type": "HowToStep",
      "text": "Bring together with your hands, and transfer to a floured surface."
    },
    {
      "@type": "HowToStep",
      "text": "Knead for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Wrap in cling film and put in the fridge for 30 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 30 minutes resting"
    }
  ],
  "keywords": [
    "pasta"
  ]
}
