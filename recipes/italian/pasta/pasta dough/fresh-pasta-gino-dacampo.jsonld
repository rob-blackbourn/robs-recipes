{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Fresh Pasta - Gino D'Acampo",
  "prepTime": "PT30M",
  "cookTime": "PT2M",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Dough",
  "recipeYield": "1 servings",
  "recipeIngredient": [
    "200 g 00 or plain flour (plus extra to flour the pasta machine)",
    "4 free-range egg yolks",
    "1/2 tsp salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the pasta, mix the flour and egg yolks in a blender with the salt until combined."
    },
    {
      "@type": "HowToStep",
      "text": "Turn out onto a floured surface and flour a pasta machine."
    },
    {
      "@type": "HowToStep",
      "text": "Starting at the lowest (thickest) setting, feed the dough through the machine, holding the dough with one hand as it comes out of the machine."
    },
    {
      "@type": "HowToStep",
      "text": "Change the setting on the machine to the next-thickest setting, flour the machine again and feed the pasta through."
    },
    {
      "@type": "HowToStep",
      "text": "Repeat this process 3-4 times or until the desired thickness is achieved."
    }
  ],
  "keywords": [
    "pasta"
  ]
}
