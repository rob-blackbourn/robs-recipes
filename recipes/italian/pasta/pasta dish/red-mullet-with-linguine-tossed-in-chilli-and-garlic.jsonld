{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Red mullet with linguine tossed in chilli and garlic",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "300g/10½oz Italian ‘00’ flour",
    "3 free-range eggs",
    "1 tbsp olive oil",
    "pinch salt",
    "4 tsp finely sliced red chilli,",
    "4 tsp finely sliced garlic,",
    "125ml white wine,",
    "125ml fish or vegetable stock,",
    "4 whole red mullet (filleted, pin boned and cut into strips),",
    "2 tbsp flat leaf parsley ,",
    "1 tbsp basil leaves,",
    "1 lemon (zest only)",
    "salt and freshly ground black pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the pasta, blend the flour and eggs in a food processor to fine"
    },
    {
      "@type": "HowToStep",
      "text": "crumbs, then add the olive oil and salt and pulse to just combine."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the mixture from the processor, and pull the dough together"
    },
    {
      "@type": "HowToStep",
      "text": "into a ball. Knead the dough until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Wrap the pasta dough in cling film and rest in the fridge for 30"
    },
    {
      "@type": "HowToStep",
      "text": "minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Once rested, take the dough out of the fridge and roll out to about"
    },
    {
      "@type": "HowToStep",
      "text": "1cm/½in thick."
    },
    {
      "@type": "HowToStep",
      "text": "Pass the rolled dough through a pasta machine, starting with the"
    },
    {
      "@type": "HowToStep",
      "text": "widest setting, and reducing the setting each time until on the finest"
    },
    {
      "@type": "HowToStep",
      "text": "setting."
    },
    {
      "@type": "HowToStep",
      "text": "Change to the linguine cutter on the pasta machine and pass the"
    },
    {
      "@type": "HowToStep",
      "text": "pasta through once more."
    },
    {
      "@type": "HowToStep",
      "text": "Weigh out about 35g/1¼oz of pasta per person.,Hang the remaining"
    },
    {
      "@type": "HowToStep",
      "text": "pasta over the back of a chair and allow to dry."
    },
    {
      "@type": "HowToStep",
      "text": "For the sauce, heat a frying pan until hot, add the olive oil, chilli and"
    },
    {
      "@type": "HowToStep",
      "text": "garlic and gently fry until just softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the red mullet and gently fry for a couple of minutes, then add"
    },
    {
      "@type": "HowToStep",
      "text": "the white wine and cook until the volume of liquid has reduced."
    },
    {
      "@type": "HowToStep",
      "text": "Add the stock to the mullet and cook until reduced again."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, bring a pan of salted water to the boil, add the pasta"
    },
    {
      "@type": "HowToStep",
      "text": "and cook until it floats to the surface and is just tender."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the pasta and stir straight into the sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Finish with the herbs and lemon zest then season with salt and"
    },
    {
      "@type": "HowToStep",
      "text": "freshly ground black pepper."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 30 mins to 1 hour"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 10 to 30 mins"
    }
  ],
  "prepTime": "30 mins to 1 hour",
  "cookTime": "10 to 30 mins",
  "keywords": [
    "Pasta",
    "Pasta Dish"
  ]
}
