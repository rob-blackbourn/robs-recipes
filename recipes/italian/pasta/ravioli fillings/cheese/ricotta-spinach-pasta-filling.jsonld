{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Ricotta & Spinach Pasta Filling",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "225 g (8 oz) spinach leaves,",
    "100 g (4 oz) ricotta cheese,",
    "25 g (1 oz) grated Parmesan cheese,",
    "1 egg,",
    "a pinch of nutmeg,",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the spinach in a large saucepan pan with only the water which is left clinging to the leaves. Cover, place over a medium heat and cook for a few minutes, shaking the pan vigorously from time to time, until the spinach has wilted."
    },
    {
      "@type": "HowToStep",
      "text": "Drain well, squeezing as much water out of the leaves as possible then transfer to a chopping board and chop."
    },
    {
      "@type": "HowToStep",
      "text": "Place the chopped spinach in a mixing bowl together with the and cheeses, egg, nutmeg, salt and pepper and mix well. Allow to cool before using."
    }
  ],
  "keywords": [
    "Pasta",
    "Ravioli Fillings",
    "Cheese"
  ]
}
