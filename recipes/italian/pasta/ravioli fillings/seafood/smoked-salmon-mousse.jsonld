{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Smoked Salmon Mousse",
  "recipeCategory": "Starter",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "250 g smoked salmon",
    "1 egg",
    "100 ml double cream",
    "1 tsp fresh chopped chives",
    "pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Puree the smoked salmon and egg until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cream, chives and a little pepper."
    }
  ],
  "keywords": [
    "Pasta",
    "Ravioli Fillings",
    "Seafood",
    "fish",
    "salmon"
  ]
}
