{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Broccoli and Anchovy Ravioli Filling",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "A large knob of Butter",
    "1 Small Onion, very finely chopped",
    "1 Garlic Clove, crushed",
    "4 Tinned Anchovy fillets, chopped",
    "350g Broccoli Florets, chopped",
    "240ml Ricotta Cheese",
    "Pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the butter in a medium sized saucepan, add the onion and sauté over a medium heat for 5 minutes until soft and translucent."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, anchovy and broccoli and continue to cook for a further 3-4 minutes, stirring frequently."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat, transfer to a food processor and process to a rough purée. Don't make the mixture too smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Allow the mixture to cool before mixing in the ricotta and pepper."
    }
  ],
  "keywords": [
    "Pasta",
    "Ravioli Fillings",
    "Seafood"
  ]
}
