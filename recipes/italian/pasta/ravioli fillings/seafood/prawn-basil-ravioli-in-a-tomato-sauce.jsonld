{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Prawn & Basil Ravioli in a Tomato Sauce",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Dish",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "500 g pasta dough",
    "275 g raw peeled prawns",
    "10 basil leaves (chopped)",
    "1 handful breadcrumbs",
    "1 medium egg",
    "1/2 lemon, zest only",
    "6 tomatoes (halved across the middle)",
    "1 bunch watercress (roughly chopped)",
    "2 garlic cloves (whole, in their skin)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the tomatoes in a roasting tin. Drizzle with olive oil, and roast for 40 minutes at 140°C."
    },
    {
      "@type": "HowToStep",
      "text": "After 30 mins add the garlic."
    },
    {
      "@type": "HowToStep",
      "text": "Push the tomatoes through a sieve into a pan, squeeze in the garlic, discarding the skin. Add the watercress."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the prawns, basil leaves, breadcrumbs, egg, and lemon zest and fill the ravioli."
    },
    {
      "@type": "HowToStep",
      "text": "Boil the ravioli for 4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Warm through the sauce, adding a little cream at the end."
    },
    {
      "@type": "HowToStep",
      "text": "Season the sauce and serve."
    }
  ],
  "keywords": [
    "pasta",
    "seafood",
    "prawns"
  ]
}
