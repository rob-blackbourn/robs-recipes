{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Salmon ravioli with tomato cream sauce",
  "prepTime": "PT15M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "4 oz fresh pasta,",
    "1 egg,",
    "1 salmon fillet,",
    "5 oz ricotta cheese,",
    "1 tbsp lemon zest,",
    "Salt and pepper for seasoning",
    "2 cups cherry tomatoes,",
    "1 tbsp extra virgin olive oil,",
    "1 clove finely chopped garlic,",
    "1 tbsp finely chopped sage leaves,",
    "3 anchovy fillets,",
    "1/4 cup white wine,",
    "1/2 cup double cream,",
    "Salt and pepper for seasoning",
    "1/2 cup freshly grated Parmesan,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 190.6°C."
    },
    {
      "@type": "HowToStep",
      "text": "Toss cherry tomatoes with an olive oil, chopped garlic, sea salt and sage leaves."
    },
    {
      "@type": "HowToStep",
      "text": "Put them on a baking sheet and bake for 15-20 min until tender."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer roasted tomatoes with a juice in a small sauce pan, add chopped anchovy fillet and add the white wine."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to a simmer, then reduce heat to a medium-low and continue simmering 5 min."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the tomatoes with all the juice in a blender and puree until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Pour tomato mixture through a sieve and return to a sauce pan over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in cream and simmer until slightly thickened, about 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add 2-3 tablespoons of Parmesan, season with salt and black pepper to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat."
    },
    {
      "@type": "HowToStep",
      "text": "In a food processor combine salmon fillet, ricotta and lemon, then process until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "In a small bowl lightly beat an egg."
    },
    {
      "@type": "HowToStep",
      "text": "Fill the ravioli, using the egg wash to seal."
    },
    {
      "@type": "HowToStep",
      "text": "Drop ravioli into a salted boiling water and cook until they float."
    },
    {
      "@type": "HowToStep",
      "text": "Serve ravioli with a hot tomato cream sauce and grated Parmesan."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 40-45 minutes"
    }
  ],
  "cookTime": "40-45 minutes",
  "keywords": [
    "Pasta",
    "Ravioli Fillings",
    "Seafood"
  ]
}
