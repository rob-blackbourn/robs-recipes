{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Mushroom & Olive Pasta Filling",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 tbsp Butter",
    "2 tbsp Olive oil",
    "1 Small Onion, finely chopped",
    "450g Mushrooms, finely chopped",
    "16 Green Olives, pitted and finely chopped",
    "2 Garlic Cloves, crushed",
    "1 tbsp Freshly Chopped Oregano",
    "2 tbsp Freshly chopped Parsley",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the butter and oil in a frying pan, add the onion and mushrooms and sauté over a medium/high heat, stirring constantly, for 5 minutes, until the mushrooms are lightly browned."
    },
    {
      "@type": "HowToStep",
      "text": "Add the olives, garlic, herbs, salt and pepper and continue to cook for 1-2 minutes."
    }
  ],
  "keywords": [
    "Pasta",
    "Ravioli Fillings",
    "Vegetable"
  ]
}
