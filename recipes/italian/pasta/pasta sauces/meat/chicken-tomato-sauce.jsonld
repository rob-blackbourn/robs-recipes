{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chicken & Tomato Sauce",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Sauce",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "2 tbsp olive oil",
    "250 g boneless skinless chicken breasts (diced)",
    "1 large onion (finely chopped)",
    "3 celery sticks (diced)",
    "2 carrots (diced)",
    "2 tsp dried oregano",
    "125 ml red wine",
    "400 g tin of chopped tomatoes",
    "Salt and pepper for seasoning",
    "1 tbsp chopped oregano (to garnish)",
    "Parmesan cheese shavings (to server)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a saucepan and fry the chicken, stirring occasionally, until lightly coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion, celery, and carrots, and cook for 5 minutes until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oregano, wine and tomatoes."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, cover, then reduce the heat and simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with oregano and serve with parmesan shavings."
    }
  ],
  "keywords": [
    "pasta",
    "poultry",
    "chicken",
    "tomato"
  ]
}
