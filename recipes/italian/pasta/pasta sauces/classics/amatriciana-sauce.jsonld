{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Amatriciana Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT40M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "5 tbsp olive oil",
    "1 large onion (finely chopped)",
    "1 celery stick (finely chopped)",
    "75 g guanciale, pancetta (cubed) or unsmoked bacon",
    "3 garlic cloves (crushed)",
    "1 hot red chilli (deseeded and finely chopped)",
    "1 kg ripe full tomatoes (skinned and roughly chopped)",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a large, heavy-based saucepan and gently fry the onion, celery and pancetta, stirring frequently, for 6-8 minutes or until softened. Add the garlic and chilli and fry for a further 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the chopped tomatoes and cook gently, uncovered, stirring frequently, for about 30 minutes, or until the sauce is thick and very pulpy. Season to taste with salt and pepper, then serve."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Large saucepan"
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
