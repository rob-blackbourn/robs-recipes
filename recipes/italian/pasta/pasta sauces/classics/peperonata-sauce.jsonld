{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Peperonata Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 tbsp olive oil,",
    "3 onions (finely chopped),",
    "2 cloves of garlic (finely chopped),",
    "400 g can chopped tomatoes,",
    "1 tbsp tomato puree,",
    "1 tbsp chopped oregano,",
    "2 bay leaves,",
    "1 green pepper (cored, deseeded, and diced),",
    "freshly grated Parmesan to serve."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the garlic in a saucepan, add the onio and garlic and cook for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes with their juice, the tomato puree, oregano and bay leaves."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, reduce the heat and simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the peppers and cook for another 10 minutes until they are soft."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the bay leaves and serve with a bowl of grated Parmesan cheese."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
