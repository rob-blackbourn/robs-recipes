{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Ciociara-Style Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT8M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "125 g frozen peas,",
    "50 g butter,",
    "250 g button mushrooms (thinly sliced),",
    "200 ml single cream,",
    "125 g piece of lean cooked ham (thinly sliced),",
    "125 g Parmesan cheese (freshly grated),",
    "salt."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the peas in a pan of salted boiling water and cook according to the packet instructions until tender."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, melt half of the butter in a frying pan, add the mushrooms and saute gently until just tender, adding salt to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Put the remaining butter in a saucepan with the cream and heat gently without allowing the mixture to boil. Add the mushrooms with their juice, the peas and the cooked ham."
    },
    {
      "@type": "HowToStep",
      "text": "Stir a ladle of boiling water and a third of the Parmesan into the sauce, then serve with the remaining cheese."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
