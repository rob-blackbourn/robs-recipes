{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Herby al'Arrabiata Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT40M",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 x 400 g cans of plum tomatoes (drained)",
    "1 onion (finely chopped)",
    "125 g streaky bacon (rind removed and diced)",
    "2 cloves of garlic (finely chopped)",
    "1-2 red chilies (finely chopped)",
    "1 tbsp chopped oregano",
    "1 tbsp chopped thyme",
    "25 g butter",
    "1 tbsp chopped parsley to garnish",
    "125 g Parmesan cheese (freshly grated) to serve",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Puree the tomatoes in a food processor."
    },
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a large saucepan over a moderate heat. Add the onion and bacon then cook, stirring for 5 minutes. Add the garlic and chilies then cook, stirring occasionally for another 5 minutes until the onion is tender."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes, oregano and thyme and season to taste with salt and pepper. Cover the sauce, bring to the boil then reduce the heat and simmer for about 30 minutes. Garnish with parsley and serve with grated Parmesan cheese."
    }
  ],
  "keywords": [
    "pasta",
    "classics",
    "meat",
    "pork"
  ]
}
