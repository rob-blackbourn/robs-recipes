{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Pesto Trapanese",
  "prepTime": "PT12M",
  "cookTime": "PT0M",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Sauce",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "3 ripe tomatoes",
    "4 cloves of garlic",
    "50 g basil leaves (plus extra to garnish)",
    "125 g blanched almonds (toasted)",
    "150 ml olive oil",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place all of the ingredients in a food processor and blend until they are smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Can be kept in a lidded jar covered with olive oil for up to 5 days."
    }
  ],
  "keywords": [
    "pasta",
    "classic"
  ]
}
