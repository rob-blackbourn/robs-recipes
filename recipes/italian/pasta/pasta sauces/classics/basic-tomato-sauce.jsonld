{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Basic Tomato Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT1H",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 x 400 g cans of plum tomatoes (drained and roughly chopped),",
    "1 onion (finely chopped),",
    "2 cloves garlic (chopped),",
    "4 basil leaves (bruised),",
    "125 ml olive oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the tomatoes in a large saucepan with the onions and garlic. Cover the pan, bring to the boil, then cook slowly for 25 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Uncover the pan and simmer for another 15-20 minutes to evaporate any extra liquid, as the sauce should be quite thick."
    },
    {
      "@type": "HowToStep",
      "text": "Puree the sauce in a blender, then sieve it to remove any seeds and skin. Stir in the basil and oil."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Large saucepan"
    },
    {
      "@type": "HowToTool",
      "name": "Blender or food processor"
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
