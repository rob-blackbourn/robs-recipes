{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Syracuse Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT35M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "2 medium onions (sliced)",
    "2 cloves of garlic (crushed)",
    "500 g courgettes (chopped)",
    "2 green peppers (cored, deseeded, and chopped)",
    "400 g can of plum tomatoes (drained and roughly chopped)",
    "250 g pitted black olives",
    "4 anchovy fillets (finely chopped)",
    "1 tbsp parsley (chopped)",
    "2 tsp chopped marjoram",
    "Salt and pepper for seasoning",
    "a few sprigs of flat leaf parsley to garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the large frying pan and fry the onion and garlic in a little oil for 3-6 minutes, turning constantly, until soft. Add the courgettes and cook for another 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the green pepper, tomatoes, olives, anchovies and herbs. Bring to the boil, stirring, then cover the pan and simmer for 15 minutes. Season to taste with salt and pepper and garnish with parsley."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
