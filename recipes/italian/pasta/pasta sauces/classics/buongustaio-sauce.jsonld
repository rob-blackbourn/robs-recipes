{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Buongustaio Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT22M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 tbsp olive oil",
    "1 large onion, (finely chopped)",
    "2 cloves of garlic (finely chopped)",
    "1 aubergine (peeled and diced)",
    "125 g mushrooms (sliced)",
    "400 g can chopped tomatoes",
    "sprig of sage",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion, garlic and aubergine and cook for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mushrooms and tomatoes, plus the juice from the can."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sage and a little salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, then reduce the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Cover the pan and cook gently for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the sage before serving."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "1 large saucepan"
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
