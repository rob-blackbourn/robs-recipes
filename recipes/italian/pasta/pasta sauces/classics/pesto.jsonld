{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Pesto",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeCuisine": "Italian",
  "recipeCategory": "Pasta Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "50 g basil (including stalks)",
    "50 g pine nuts",
    "65 g Parmesan cheese (freshly grated)",
    "2 cloves of garlic (chopped)",
    "125 ml olive oil",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Tear the basil into pieces and put into a food processor with the pine nuts, Parmesan and garlic."
    },
    {
      "@type": "HowToStep",
      "text": "Blend lightly in the food processor until the nuts and cheese are broken into small pieces, scraping the mixture down from the sides of the bowl if necessary."
    },
    {
      "@type": "HowToStep",
      "text": "Add the olive oil and a little salt and blend to a thick paste."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Can be kept in a lidded jar for up to 5 days."
    }
  ],
  "keywords": [
    "pasta",
    "classic"
  ]
}
