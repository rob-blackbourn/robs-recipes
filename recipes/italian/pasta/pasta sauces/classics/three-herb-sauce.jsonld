{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Three Herb Sauce",
  "recipeCuisine": "Italy",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "3 tbsp chopped parsley",
    "1 tbsp chopped tarragon",
    "2 tbsp chopped basil",
    "1 tbsp olive oil",
    "1 large garlic clove (crushed)",
    "4 tbsp chicken stock",
    "2 tbsp dry white wine",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all of the ingredients into a food processor or blender and work until smooth, then add salt and pepper to taste."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
