  "name": "Merguez Sausages 2",
  "recipeIngredient": [
    "1 kilo ground shoulder and leg",
    "250 grams finely diced hard fat",
    "4 cloves garlic, mashed with 1 tablespoon salt",
    "1 teaspoon harissa",
    "1 tablespoon finely minced cilantro",
    "1 tablespoon merguez spice blend",
    "1 part Cumin",
    "1/4 part turmeric",
    "1/8 part caraway",
    "1/6 coriander",
    "1/16 fennel",
    "1/8 dried thyme (zaatar)",
    "¼ sumac",
    "1/4 sweet paprika",
    "1/8 ancho chile powder",
    "1/4 cayenne",
    "1/32 black pepper",
    "1/32 white pepper",
    "1/32 pink pepper"
  ],
  "keywords": [
