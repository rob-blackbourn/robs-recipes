{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Mergeuz Sausages",
  "prepTime": "PT15M",
  "totalTime": "PT15M",
  "recipeYield": "12 sausages",
  "recipeIngredient": [
    "250 g lamb",
    "250 g beef",
    "120 g ground or finely chopped fat",
    "3 cloves garlic, finely chopped or pressed",
    "2 tbsp chopped fresh coriander",
    "2 tbsp merguez sausage seasoning",
    "2 to 3 tsp harissa",
    "Sheep sausage casings"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mince the meat through a 6mm plate."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the ingredients in a bowl. (Add ice water?)"
    },
    {
      "@type": "HowToStep",
      "text": "Mince the batch again through a 6mm plate or process briefly in a food processor."
    },
    {
      "@type": "HowToStep",
      "text": "Fill out into pre soaked natural sheep casings 20/22 or 22/24."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1Hvt5ygawT90DpfVXXikXZQu3mOzty1PB-Yy-1BVNNYo/edit",
    "https://docs.google.com/document/d/1Bz_yls5JhCyCOQoTZGNmMdTDs8Vw0vgbriSbioJarBw/edit"
  ],
  "keywords": [
    "Suasages",
    "meat",
    "lamb",
    "beef"
  ]
}
