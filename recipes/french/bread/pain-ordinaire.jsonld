{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Pain Ordinaire",
  "recipeYield": "1 loaf",
  "recipeIngredient": [
    "350 ml warm water",
    "15 g of fresh yeast or 2 tsp dried yeast",
    "500 g strong white flour",
    "1 1/2 tsp salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pour 100 ml of water in a large bowl, sprinkle in the yeast, whisk lightly, and leave for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add a third of the flour and mix to a light paste. Cover the bowl with a tea towel and wait for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rest of the flour and salt and the majority of the remaining water. Mix, and add enough water to make a moist yet firm dough."
    },
    {
      "@type": "HowToStep",
      "text": "Knead for 10 minutes on a floured surface."
    },
    {
      "@type": "HowToStep",
      "text": "Leave covered to prove for 30 minutes to 2 hours, until more than doubled in size."
    },
    {
      "@type": "HowToStep",
      "text": "Knock back the dough for 1 minute and put in a greased bread tin."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with a tea towel and leave for 45 minutes to 1 hour until doubles in size."
    },
    {
      "@type": "HowToStep",
      "text": "Place in a pre-heated oven at 220°C for 45 minutes."
    }
  ],
  "keywords": [
    "Bread"
  ]
}
