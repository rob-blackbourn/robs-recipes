{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Vegetable Stock",
  "recipeYield": "1.5 l",
  "prepTime": "PT15M",
  "cookTime": "PT45M",
  "recipeIngredient": [
    "300 g carrots (cut into rounds)",
    "2 leeks (white part, thinly sliced)",
    "100 g celery stalks (thinly sliced)",
    "50 g bulb of fennel (very thinly sliced)",
    "150 g shallots (thinly sliced)",
    "100 g onion (thinly sliced)",
    "2 cloves of garlic (unpeeled)",
    "1 bouquet garni",
    "250 ml dry white wine",
    "2 l water",
    "10 white peppercorns (crushed and wrapped in muslin)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the ingredients except the peppercorns into a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil over a high heat, then reduce immediately to a simmer."
    },
    {
      "@type": "HowToStep",
      "text": "Cook at a bare simmer for 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "After 35 minutes add the muslin wrapped peppercorns."
    },
    {
      "@type": "HowToStep",
      "text": "Strain and cool as quickly as possible."
    }
  ],
  "keywords": [
    "Stock"
  ]
}
