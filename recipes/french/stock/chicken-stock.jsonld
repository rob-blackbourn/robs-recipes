{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Chicken Stock",
  "recipeYield": "1.5 l",
  "prepTime": "PT15M",
  "recipeIngredient": [
    "1 chicken (1.5 kg, blanched and refreshed)",
    "200 g carrots (cut into chunks)",
    "2 leeks (white part, cut into chunks)",
    "1 celery stalk (coarsely chopped)",
    "1 onion studded with 2 cloves",
    "150 g button mushrooms (thinely sliced)",
    "1 bouquet garni"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put chicken in a large saucepan and cover with 2.5 l cold water."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil on a high heat, then immediately lower to a simmer."
    },
    {
      "@type": "HowToStep",
      "text": "After 5 minutes skim and add the other ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Cook gently for 1 1/2 hours without boiling, skimming when necessary."
    },
    {
      "@type": "HowToStep",
      "text": "Strain and cool as quickly as possible."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 1 3/4 hours"
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1ApMSfXhCOThtVDLk7fhTr1J_yzvej9FlOwQg1WIuu7M/edit"
  ],
  "cookTime": "PT1H45M",
  "keywords": [
    "Stock"
  ]
}
