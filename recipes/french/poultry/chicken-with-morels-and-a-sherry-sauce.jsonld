{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Chicken with Morels and a Sherry Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "7 g dried morel mushrooms",
    "2 chicken breasts",
    "Salt and pepper for seasoning",
    "1/2 tbsp unsalted butter (For the chicken)",
    "30 g button mushrooms",
    "50 ml of dry white wine or sherry (boiled for 30 seconds to reduce the alcohol",
    "100 ml double cream",
    "Salt",
    "1/2 tbsp unsalted butter (For the leeks)",
    "2 leeks (sliced into 2 cm pieces)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the morels in 125 ml of water (ideally overnight)."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the morels, reserving the juice, sieve to remove any grit, squeezing the mushrooms dry. Rinse the mushrooms to remove any grit. Chop the roughly."
    },
    {
      "@type": "HowToStep",
      "text": "Season the chicken breasts and Brown in butter over a medium heat for 3 minutes per side. Remove from the pan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the morel and button  mushrooms to the pan with a pinch of salt and soften for 2 minutes. Add the boiled wine or sherry and the mushroom juice and double cream. Bring to the boil and add the chicken breasts. Reduce the heat to a bare simmer and cook for 7 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the chicken breasts and keep warm. Increase the heat, and boil down the sauce until it coats the back of a spoon. Season."
    },
    {
      "@type": "HowToStep",
      "text": "Boil the chopped leaks in 100ml of water with the butter and salt with the lid on for 3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Return the chicken breasts to the sauce, warm through, then serve over the leeks."
    }
  ],
  "keywords": [
    "Poultry",
    "chicken"
  ]
}
