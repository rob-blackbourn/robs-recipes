{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Chicken Fricassée",
  "prepTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2.5 kg chicken (cut into pieces),",
    "60 ml olive oil,",
    "2 cloves garlic (skin on)",
    "150 g shallots (cut in half),",
    "125 g mixed peppers,",
    "2 carrots (peeled and sliced),",
    "200 g button mushrooms,",
    "600 ml Brown chicken stock,",
    "1 bay leaf,",
    "Sprig of fresh thyme,",
    "6 peppercorns."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oven to 190°C."
    },
    {
      "@type": "HowToStep",
      "text": "Season the chicken and colour quickly in oil."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the chicken and place in a roasting pan with the bay leaf, peppercorns, fresh thyme, and garlic cloves."
    },
    {
      "@type": "HowToStep",
      "text": "Sauté the vegetables together until lightly Brown. Place them in with the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Swill out the sauté pan with the chicken stock. Bring to the boil, season, and add to the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Place in the oven until the chicken is cooked through."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 30 mins to 1 hour"
    }
  ],
  "cookTime": "30 mins to 1 hour",
  "keywords": [
    "Poultry"
  ]
}
