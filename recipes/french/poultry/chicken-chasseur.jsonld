{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Chicken chasseur",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1.5 kg chicken (cut into 8 pieces}",
    "Salt and pepper for seasoning",
    "50 g plain flour",
    "2 tbsp olive oil",
    "110 g butter (For the chicken)",
    "175 g button mushrooms",
    "150 g shallots, thickly sliced",
    "40 g caster sugar",
    "175 ml white wine",
    "350 ml chicken stock",
    "3 tbsp tomato purée",
    "small handful fresh tarragon, half left as sprigs, half finely chopped",
    "2 tomatoes, peeled, seeds removed, chopped",
    "2 tbsp fresh flatleaf parsley, finely chopped",
    "1 kg floury potatoes (such as King Edwards or Desiree), peeled",
    "cut into chunks",
    "110 g butter (For the mashed potatoes)",
    "110 ml full fat milk",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Season the chicken pieces with salt and freshly ground black pepper,"
    },
    {
      "@type": "HowToStep",
      "text": "then dredge in the flour to coat."
    },
    {
      "@type": "HowToStep",
      "text": "Heat a large, deep frying pan over a medium heat. Add the oil, and a"
    },
    {
      "@type": "HowToStep",
      "text": "third of the butter and heat until the butter is foaming."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chicken pieces and fry skin-side down for 1-2 minutes until"
    },
    {
      "@type": "HowToStep",
      "text": "golden-brown, then turn the chicken and fry on the other side for"
    },
    {
      "@type": "HowToStep",
      "text": "another 1-2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, heat a separate frying pan over a medium heat and add"
    },
    {
      "@type": "HowToStep",
      "text": "another third of the butter. When the butter is foaming add the button"
    },
    {
      "@type": "HowToStep",
      "text": "mushrooms and fry, stirring occasionally, until golden-brown all over."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mushrooms to the chicken pan."
    },
    {
      "@type": "HowToStep",
      "text": "To the pan used to fry the mushrooms, add the remaining third of the"
    },
    {
      "@type": "HowToStep",
      "text": "butter, the shallots and the caster sugar and fry for 2-3 minutes until"
    },
    {
      "@type": "HowToStep",
      "text": "the shallots are golden-brown and caramelised."
    },
    {
      "@type": "HowToStep",
      "text": "Add the wine and bring to the boil, scraping the base of the pan with"
    },
    {
      "@type": "HowToStep",
      "text": "a wooden spoon to dislodge any brown bits."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the shallots and wine mixture over the chicken, then add the"
    },
    {
      "@type": "HowToStep",
      "text": "stock, tomato purée and whole tarragon sprigs. Bring to the boil, then"
    },
    {
      "@type": "HowToStep",
      "text": "reduce the heat to simmer for 45 minutes to one hour, or until the"
    },
    {
      "@type": "HowToStep",
      "text": "chicken is completely cooked through and the sauce has reduced"
    },
    {
      "@type": "HowToStep",
      "text": "slightly."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes, flatleaf parsley and the chopped tarragon and"
    },
    {
      "@type": "HowToStep",
      "text": "season, to taste, with salt and freshly ground black pepper. Simmer"
    },
    {
      "@type": "HowToStep",
      "text": "for a further two minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, for the mashed potatoes, place the potatoes into a pan"
    },
    {
      "@type": "HowToStep",
      "text": "of salted water and bring to the boil. Reduce the heat and simmer"
    },
    {
      "@type": "HowToStep",
      "text": "for 12-15 minutes, or until the potatoes are tender."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the potatoes and return to the pan. Place over a low heat for"
    },
    {
      "@type": "HowToStep",
      "text": "one minute to drive off any excess moisture."
    },
    {
      "@type": "HowToStep",
      "text": "Mash the potatoes well, then add the butter and milk, beating well"
    },
    {
      "@type": "HowToStep",
      "text": "to form a smooth mash. Season, to taste, with salt and freshly"
    },
    {
      "@type": "HowToStep",
      "text": "ground black pepper."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, place two pieces of chicken onto each plate. Drizzle the"
    },
    {
      "@type": "HowToStep",
      "text": "sauce over each and place a dollop of mashed potatoes alongside."
    }
  ],
  "prepTime": "PT30M",
  "cookTime": "PT1H",
  "keywords": [
    "Poultry",
    "chicken"
  ]
}
