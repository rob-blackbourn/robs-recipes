{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Coq Au Vin",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 chicken (jointed)",
    "2 sticks celery (chopped)",
    "2 carrots (chopped)",
    "1 onion (chopped)",
    "Peppercorns",
    "Bay leaf",
    "125g lardons",
    "1 bottle red Burgundy",
    "2 cloves garlic (chopped)",
    "2 tbsp flour",
    "parsley",
    "thyme",
    "button mushrooms",
    "pearl onions"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the jointed chick in a large mixing bowl and add the celery, carrot, onion, garlic, peppercorns and bay leaf. Pour over the bottle of wine, the leave in the fridge to marinate overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Pick out the meat from the marinade, and dry on paper towels. Strain the marinade from the vegetables."
    },
    {
      "@type": "HowToStep",
      "text": "Add some oil to a pan on a medium high heat. Add the lardons, and after a minute, brown the chicken pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the chicken, reduce the heat to medium and add the vegetables. After three minutes add the flour, and keep it moving with a bowl whisk."
    },
    {
      "@type": "HowToStep",
      "text": "Slowly add the cold marinade liquid to the pad, whisking continuously."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, parsley and thyme."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chicken pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Leave on the hob at a low heat, or in the oven on 180°C for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the chicken pieces and put them on a warm plate."
    },
    {
      "@type": "HowToStep",
      "text": "Warm a pan to a medium heat. Add some butter, the fry off the mushroom, seasoning."
    },
    {
      "@type": "HowToStep",
      "text": "Take the mushrooms out then put in the pearl onions."
    },
    {
      "@type": "HowToStep",
      "text": "After a couple of minutes put the onions back in."
    },
    {
      "@type": "HowToStep",
      "text": "Add the strained sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Add more parsley and thyme."
    },
    {
      "@type": "HowToStep",
      "text": "Pour over the chicken, and top with crispy bacon."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow for an overnight marinade."
    }
  ],
  "prepTime": "PT1H",
  "keywords": [
    "Poultry"
  ]
}
