{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Choux Paste - Michel Roux",
  "recipeYield": "500 ml",
  "recipeIngredient": [
    "125ml Milk,",
    "125ml water,",
    "100g unsalted butter (diced and at room temperature),",
    "1/2 tsp salt,",
    "1 tsp caster sugar,",
    "150g plain flour,",
    "4 medium eggs,",
    "eggwash (1 egg yolk mixed with 1 tbsp milk)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the water, milk, butter, salt and sugar in a saucepan, and set over a low heat."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to a boil and immediately remove from the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Shower with flour and mix with a wooden spoon until completely smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Return the pan to a medium heat and stir continuously for 1 minute to dry out the paste, then tip into a bowl and allow to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Add the eggs one at a time, beating with the wooden spoon or in a food mixer. Once the eggs are combined the paste should be smooth and shiney with a thick ribbon like consistency."
    }
  ],
  "keywords": [
    "Pastry",
    "Basic"
  ]
}
