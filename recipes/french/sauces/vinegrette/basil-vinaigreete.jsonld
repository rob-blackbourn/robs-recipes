{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Basil Vinaigrette",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 tsp Dijon mustard,",
    "1 shallot (chopped),",
    "1/2 tsp salt,",
    "1 tsp sugar,",
    "1/2 cup roughly chopped basil leaves,",
    "1/4 cup white wine vinegar,",
    "3/4 cup olive oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the salt, sugar, mustard, shallot and basil in a blender or food processor. Scrape the sides of the blender down with a spatula. Add the vinegar and pulse again."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the blender on low and take off the cap in the centre of the blenders lid and dribble in the olive oil."
    },
    {
      "@type": "HowToStep",
      "text": "Scrape down the sides of the blender and pulse for a further 2 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4 people"
    }
  ],
  "keywords": [
    "Sauces",
    "Vinegrette"
  ]
}
