{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "White Roux",
  "recipeYield": "100 g",
  "prepTime": "PT3M",
  "cookTime": "PT4M",
  "recipeIngredient": [
    "50 g butter,",
    "50 g flour (sifted)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Off the heat, add the flour and stir with a small whisk or a wooden spoon."
    },
    {
      "@type": "HowToStep",
      "text": "Cook over a medium heat for 3 minutes, stirring continuously."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a bowl and cover with cling film."
    },
    {
      "@type": "HowToStep",
      "text": "Keep at room temperature, or store in the fridge for several days."
    }
  ],
  "keywords": [
    "Sauces",
    "Liaisons and Instant Sources"
  ]
}
