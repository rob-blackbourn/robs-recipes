{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Blond Roux",
  "recipeYield": "100 g",
  "prepTime": "PT3M",
  "cookTime": "PT6M",
  "recipeIngredient": [
    "50 g unsalted butter",
    "50 g flour (sifted)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Take the pan off the heat and stir in the flour with a small whisk or a spatula."
    },
    {
      "@type": "HowToStep",
      "text": "Cook over a medium heat for 5 minutes, stirring continuously, until it becomes a pale hazelnut brown."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a bowl and cover with cling film."
    }
  ],
  "keywords": [
    "Sauces",
    "Liaisons and Instant Sources"
  ]
}
