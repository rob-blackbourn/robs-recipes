{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Hollandaise Sauce",
  "prepTime": "PT20M",
  "recipeYield": "3 servings",
  "recipeIngredient": [
    "2 tbsp cold water",
    "1/2 tbsp white wine vinegar",
    "1/2 tsp white peppercorns (crushed)",
    "2 egg yolks",
    "125g unsalted butter (freshly clarified, and cooled to tepid)",
    "Juice of 1/4 lemon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the water, vinegar and pepper into a small saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Over a low heat reduce by one third then leave to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Put the egg yolks into a glass bowl and add the cold liquid."
    },
    {
      "@type": "HowToStep",
      "text": "Mix thoroughly with a small whisk."
    },
    {
      "@type": "HowToStep",
      "text": "Set the boil over a pan of gently boiling water and whisk continually until the mixture becomes smooth and creamy after 8-10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Take the bowl off the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Gradually add the cooled clarified butter, initially a drop at a time, gradually increasing."
    }
  ],
  "cookTime": "PT15M",
  "keywords": [
    "Sauces",
    "Emulsions"
  ]
}
