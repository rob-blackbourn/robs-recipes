{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Mayonnaise",
  "recipeYield": "4 servings",
  "prepTime": "PT5M",
  "recipeIngredient": [
    "2 egg yolks,",
    "1 tbsp strong Dijon mustard,",
    "250 ml groundnut oil,",
    "1 tbsp white wine vinegar (warmed) or 1 tbsp cold lemon juice,",
    "Salt and freshly ground pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a bowl combine the egg yolks, mustard and a little salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the oil in a thin stream. whisking continually."
    },
    {
      "@type": "HowToStep",
      "text": "When it is all incorporated, whisk more vigorously for 30 seconds until glossy."
    },
    {
      "@type": "HowToStep",
      "text": "Add the hot vinegar or cold lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "Check the seasoning."
    }
  ],
  "keywords": [
    "Sauces",
    "Emulsions"
  ]
}
