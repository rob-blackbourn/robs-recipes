{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Bearnaise Sauce",
  "recipeYield": "6 servings",
  "prepTime": "PT20M",
  "recipeIngredient": [
    "2 tbsp white wine vinegar",
    "3 tbsp snipped tarragon",
    "30 g shallots (finely chopped)",
    "10 peppercorns (crushed)",
    "4 egg yolks",
    "4 tbsp cold water",
    "3 tbsp cold water",
    "250 g freshly clarified butter (cooled to tepid)",
    "2 tbsp snipped chervil",
    "Juice of 1/2 lemon",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the vinegar, 2 tbsp tarragon, the shallot and peppercorns in a small thick bottomed saucepan, and reduce by half over a low heat. Set aside to cool."
    },
    {
      "@type": "HowToStep",
      "text": "When cool add the vinegar reduction to the egg yolks and cold water."
    },
    {
      "@type": "HowToStep",
      "text": "Set the bowl over a pan of boiling water and whisk continuously."
    },
    {
      "@type": "HowToStep",
      "text": "Gently increase the heat until creamy (8-10 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Turn off the heat and add the clarified butter, initially a drop at a time, then in increasing quantities."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    }
  ],
  "cookTime": "PT15M",
  "keywords": [
    "Sauces",
    "Emulsions"
  ]
}
