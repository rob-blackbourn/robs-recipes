{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Beurre Maître D’Hôtel",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "recipeYield": "300 g",
  "recipeIngredient": [
    "250 g lightly salted butter",
    "60-75 g chopped parsley",
    "lemon juice to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soften the butter to a thick cream."
    },
    {
      "@type": "HowToStep",
      "text": "Mix in the parsley and lemon."
    },
    {
      "@type": "HowToStep",
      "text": "Form into a roll and wrap in foil to store in the fridge."
    }
  ],
  "keywords": [
    "Sauces",
    "Butter"
  ]
}
