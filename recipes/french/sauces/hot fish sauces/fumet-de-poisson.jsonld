{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Fumet de Poisson",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "recipeYield": "2 l",
  "recipeIngredient": [
    "1-1/2 kg fish bones and heads,",
    "1 sliced onion,",
    "1 sliced carrot,",
    "the sliced white part of a leek,",
    "1 sliced celery stalk,",
    "bouquet garni,",
    "1o black peppercorns,",
    "450 ml dry white wine,",
    "2 tsp white wine vinegar,",
    "2 l water."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the ingredients in a pan, adding the water last."
    },
    {
      "@type": "HowToStep",
      "text": "Bring slowly to the boil, skimming until the liquid is clear."
    },
    {
      "@type": "HowToStep",
      "text": "Cover, and simmer for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Strain the stock through a double muslin lined sieve."
    }
  ],
  "keywords": [
    "Sauces",
    "Hot Fish Sauces"
  ]
}
