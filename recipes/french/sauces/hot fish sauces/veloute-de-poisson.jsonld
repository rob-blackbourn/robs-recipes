{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Velouté de Poisson",
  "prepTime": "PT5M",
  "cookTime": "PT1H",
  "recipeCuisine": "France",
  "recipeCategory": "Sauce",
  "recipeYield": "600 ml",
  "recipeIngredient": [
    "60 g butter",
    "4 tbsp plain flour",
    "1 l fumet de poisson",
    "100 g chopped mushroom stalks",
    "double cream to taste",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt the butter, stir in the flour and cook it for 1 minute, stirring frequently."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile heat the fumet to boiling point."
    },
    {
      "@type": "HowToStep",
      "text": "Pur the fumet over the roux gradually, off the heat, using a whisk to make the sauce as smooth as possible."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mushroom stalks and bring back to boiling point."
    },
    {
      "@type": "HowToStep",
      "text": "Lower the heat or use a bain marie, and reduce by half (about 45 minutes), whisking in any skin that forms on top."
    },
    {
      "@type": "HowToStep",
      "text": "Add cream until the taste and consistency is right."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste."
    }
  ],
  "keywords": [
  ]
}
