{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Smoked Haddock Soufflé",
  "prepTime": "PT30M",
  "cookTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "30 g butter (For the béchamel)",
    "30 g flour",
    "400 ml milk",
    "6 free-range egg yolks (beaten),",
    "Salt and pepper for seasoning",
    "40 g butter (softened) (For the soufflé)",
    "110 g gruyère (finely grated),",
    "125 g smoked haddock fillet,",
    "300 ml double cream,",
    "8 free-range egg whites,",
    "1 tbsp fresh dill (roughly chopped),",
    "4 quail's eggs (poached),",
    "4 sprigs fresh dill."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 190°C."
    },
    {
      "@type": "HowToStep",
      "text": "To make the béchamel, melt the butter in a small heavy-based pan over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat and stir in the flour (this is called a roux). Return the pan to a low heat and cook for two minutes, whisking continuously."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat again and add the milk, stirring constantly."
    },
    {
      "@type": "HowToStep",
      "text": "Place over a medium heat and bring to the boil, stirring continuously. Reduce the heat and simmer for 4-5 minutes, stirring continuously. Allow to cool slightly."
    },
    {
      "@type": "HowToStep",
      "text": "For the soufflé, beat the egg yolks into the béchamel and season well with salt and freshly ground black pepper. Cover with cling film and set aside at room temperature."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, grease the insides of four individual soufflé dishes or ramekins (10cm in diameter and 6.5cm deep) with softened butter."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle a handful of the grated gruyère into each soufflé dish, rotating it to coat the insides."
    },
    {
      "@type": "HowToStep",
      "text": "Place the smoked haddock into a small pan. Add the cream and place over a low heat. When the cream starts to just come to the boil, reduce the heat to a gentle simmer and cook for two minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Turn off the heat and leave to rest until cool enough to handle, then remove the skin from the haddock and flake the fish into a bowl with your fingertips, removing any bones you may find. Return the fish to the heated cream."
    },
    {
      "@type": "HowToStep",
      "text": "In a clean bowl, whisk the egg whites with a pinch of salt, until soft peaks form when the whisk is removed."
    },
    {
      "@type": "HowToStep",
      "text": "Place one third of the egg whites into the béchamel mixture and stir well."
    },
    {
      "@type": "HowToStep",
      "text": "Add the béchamel and egg white mixture to the bowl of remaining egg whites and fold in very gently, adding the gruyère and dill as you fold."
    },
    {
      "@type": "HowToStep",
      "text": "Half-fill each prepared soufflé dish or ramekin with the soufflé mixture, then spoon in equal amounts of the smoked haddock and cream mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Fill the dishes with the remaining soufflé so that the mixture is slightly above the top edge."
    },
    {
      "@type": "HowToStep",
      "text": "Smooth the surface with a palette knife and run a knife around the inside edge of the dish to ease the soufflé mixture away from the side of the dish - this helps the soufflé to rise."
    },
    {
      "@type": "HowToStep",
      "text": "Stand the soufflé dishes into a deep roasting pan and pour in enough boiling water to come halfway up the sides of the dishes (this is a bain-marie)."
    },
    {
      "@type": "HowToStep",
      "text": "Place into the oven to cook for 7-8 minutes, or until risen and golden."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, top each soufflé with a poached quail's egg and a sprig of dill. Serve immediately."
    }
  ],
  "keywords": [
    "Seafood",
    "Mackerel"
  ]
}
