{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Saint-Pierre à l’orange",
  "prepTime": "PT10M",
  "cookTime": "PT40M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "2 fillets of John Dory",
    "Salt and pepper for seasoning",
    "cayenne pepper",
    "1 small orange",
    "1/4 large lemon",
    "125 g butter",
    "12 chopped shallot",
    "125 ml Madeira",
    "125 ml double cream",
    "2 large egg yolks",
    "samphire to garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sprinkle the fish on both sides with salt, pepper and cayenne pepper, and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Zest and juice the lemon."
    },
    {
      "@type": "HowToStep",
      "text": "Cook the shallot without browning in butter."
    },
    {
      "@type": "HowToStep",
      "text": "Put in the fish, lemon juice, wine, and enough water to come almost to the top of the fish."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and simmer until almost cooked (but still pinkish)."
    },
    {
      "@type": "HowToStep",
      "text": "With a slotted spoon, lift the fillets onto a serving plate and keep them warm in a low oven (where they will finish cooking)."
    },
    {
      "@type": "HowToStep",
      "text": "Boil down the cooking juices leaving 250 ml."
    },
    {
      "@type": "HowToStep",
      "text": "Remove a third."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the cream with the egg yolks and, off the heat, stir them into the hot juices."
    },
    {
      "@type": "HowToStep",
      "text": "Put the pan back on a low heat for the sauce to thicken without boiling."
    },
    {
      "@type": "HowToStep",
      "text": "Add the remaining butter in small cubes and splashes of the reserved cooking liquor, until the taste is good."
    },
    {
      "@type": "HowToStep",
      "text": "Pour around the fish and garnish with steamed samphire."
    }
  ],
  "keywords": [
    "Seafood",
    "John Dory",
    "fish"
  ]
}
