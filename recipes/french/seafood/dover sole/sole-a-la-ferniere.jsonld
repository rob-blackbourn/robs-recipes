{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Sole à la Fermière",
  "prepTime": "PT8M",
  "cookTime": "PT15M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 chopped shallot",
    "1/2 tsp chopped parsley",
    "1 sprig thyme",
    "1/2 bay leaf",
    "175 g sliced mushrooms",
    "1 large sole (375-400 g)",
    "175 ml red wine",
    "Salt and pepper for seasoning",
    "75 g butter",
    "1 tsp plain flour"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Grease an oval flameproof dish, and add the shallot, 60 g mushrooms, parsley, thyme and a bay leaf."
    },
    {
      "@type": "HowToStep",
      "text": "Lay the sole on top, pour in the wine and season."
    },
    {
      "@type": "HowToStep",
      "text": "Cover, and cook gently on the hob until the sole is cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the remaining mushrooms and cook in 30 g butter, tossing the so they are golden brown, but still firm."
    },
    {
      "@type": "HowToStep",
      "text": "Arrange the mushrooms around the edge off an oval dish and place the cooked sole in the center."
    },
    {
      "@type": "HowToStep",
      "text": "Boil down the sauce by half."
    },
    {
      "@type": "HowToStep",
      "text": "Mash the flour with an equal amount of butter to make a beurre manié and add it to the sauce in pieces. When the sauce is ready, whisk in the remaining butter off the heat, and strain it over the fish."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly brown under a hot grill."
    }
  ],
  "keywords": [
    "Seafood",
    "Dover Sole"
  ]
}
