{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "France",
  "name": "Chocolate and Raspberry Tart",
  "recipeCategory": "6 servings",
  "recipeIngredient": [
    "240g pâte sucrée",
    "250g raspberries",
    "20g mint leaves, finely snipped",
    "250ml whipping cream",
    "200g 60-70% cocoa solids chocolate (finely chopped)",
    "25g liquid glucose",
    "50g butter (cubed)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Roll out the pastry to a round, 2mm thick, and use to line a lightly greased 20cm diameter 2.5cm deep flan ring. Chill for at least 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 190°C. Prick the pastry base. Bake the case blind for 20 minutes.Lower the oven temperature to 180°C, remove the beans and paper, and bake for a further 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Place on a wire rack, lift off the ring and leave until cold."
    },
    {
      "@type": "HowToStep",
      "text": "Set aside 24 of the best raspberries. Halve the rest, delicately mix with the snipped mint and spread evenly on the pastry case."
    },
    {
      "@type": "HowToStep",
      "text": "For the chocolate ganache, bring the cream to the boil in a heavy based pan over a medium heat. Take off the heat, add the chocolate and glucose, and mix with a whisk to a very smooth cream. Still whisking, incorporate the butter a piece at a time."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the ganache over the halved raspberries to fill the pastry case. Set aside until cold, then chill the tart for at least 2 hours before serving."
    },
    {
      "@type": "HowToStep",
      "text": "Use a very sharp knife dipped in hot water and wiped dry to cut each slice. Place the tart slices on individual plates with the reserved raspberries. Serve cold, but not straight from the fridge."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1v_yiXTNlWd-95NNI1AU0Lgc86h3KP-eWvg5Iijq5DEk/edit?usp=sharing"
  ],
  "keywords": [
    "Dessert"
  ]
}
