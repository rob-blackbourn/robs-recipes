{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Ireland",
  "name": "Chicken Stew with Dumplings",
  "citation": "Donal Skehan",
  "recipeYield": "2 servings",
  "prepTime": "PT15M",
  "cookTime": "PT45M",
  "recipeIngredient": [
    "1kg chicken thighs (skin on, bone in),",
    "3 celery stalks (trimmed and cut into bite sized pieces),",
    "3 large carrots (peeled and cut into bite sized pieces),",
    "1 large onion (roughly chopped),",
    "A few sprigs of thyme (leaves picked),",
    "50g salted butter (For the stew)",
    "2 tbsp plain flour,",
    "1 litre chicken stock,",
    "Salt & pepper (For the stew)",
    "100g salted butter (cold, cubed) (For the dumplings)",
    "225g self raising flour,",
    "Handful of chives (finely chopped),",
    "100 ml buttermilk,",
    "50g grated Irish cheddar,",
    "Salt & pepper (For the dumplings)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Stew",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat oil in a large heavy based casserole pan over a medium heat."
        },
        {
          "@type": "HowToStep",
          "text": "In batches, brown the chicken skin side down  for 3-4 minutes until golden. Set aside."
        },
        {
          "@type": "HowToStep",
          "text": "Lower the heat slightly and add the butter, celery, carrots, onion and thyme. Stir occasionally for about 6-8 minutes until softened."
        },
        {
          "@type": "HowToStep",
          "text": "Add the flour and cook for 60 seconds while stirring."
        },
        {
          "@type": "HowToStep",
          "text": "Add the chicken."
        },
        {
          "@type": "HowToStep",
          "text": "Pour over the chicken stock and bring to a boil."
        },
        {
          "@type": "HowToStep",
          "text": "Reduce the heat to a simmer and cook  for 30-35 minutes without a lid until the chicken is tender and the sauce has reduced, it should be thick."
        },
        {
          "@type": "HowToStep",
          "text": "Season to taste with sea salt and freshly ground white pepper."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Dumplings",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Rub the butter into the flour, season with lots of pepper and a little salt."
        },
        {
          "@type": "HowToStep",
          "text": "Stir through the chives."
        },
        {
          "@type": "HowToStep",
          "text": "Mix through the buttermilk and cheddar."
        },
        {
          "@type": "HowToStep",
          "text": "Tear into rough pieces (about 12) onto the top of the chicken stew. They should cover the top of the surface."
        },
        {
          "@type": "HowToStep",
          "text": "Replace lid and leave to simmer for 20-25 minutes. The dumplings when cooked will have covered the surface."
        }
      ]
    }
  ]
}
