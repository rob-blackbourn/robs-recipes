{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chermoula",
  "recipeYield": "50 g",
  "recipeIngredient": [
    "2-3 garlic cloves (chopped)",
    "1 fresh red chillie (chopped)",
    "1 tsp sea salt",
    "small bunch of fresh coriander",
    "a pinch of saffron threads",
    "1-2 tsp ground cumin",
    "3-4 tbsp olive oil",
    "juice of 1 lemon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Use a mortar and pestle to pound the garlic, chilli and salt into a paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add the coriander leaves and work into a paste."
    },
    {
      "@type": "HowToStep",
      "text": "Mix in the saffron and cumin."
    },
    {
      "@type": "HowToStep",
      "text": "Bind with the oil and lemon juice."
    }
  ],
  "keywords": [
    "Books",
    "Easy Tagine"
  ]
}
