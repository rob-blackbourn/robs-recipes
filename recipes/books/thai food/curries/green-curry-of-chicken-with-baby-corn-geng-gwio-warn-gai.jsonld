{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Green Curry of Chicken with Baby Corn (geng gwio warn gai)",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "2 cups coconut cream,",
    "150g skinless chicken thigh fillets (sliced),",
    "2 tbsp fish sauce,",
    "2 cups thin coconut milk or stock,",
    "6 - 10 baby corn,",
    "3 kaffir lime leaves (torn),",
    "2 long red chilies (diagonally sliced),",
    "handful of Thai basil leaves.",
    "3 tbsp green birds eye chilies,",
    "a large pinch of salt,",
    "1 tbsp chopped galangal,",
    "2 tbsp chopped lemongrass,",
    "1 tbsp finely chopped kaffir lime zest,",
    "1 tbsp scraped and chopped corriander root,",
    "1 teaspoon chopped red turmeric,",
    "3 tbsp chopped red shallot,",
    "2 tbsp chopped garlic,",
    "1 tsp gapi shrimp paste,",
    "10 white peppercorns,",
    "1/2 tsp coriander seeds (roasted and ground),",
    "1/4 tsp cumin seeds (roasted and ground)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Make the curry",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Crack the coconut cream in a pan and add 2 tbsp of the paste."
        },
        {
          "@type": "HowToStep",
          "text": "Fry over a medium heat, stirring regularly to prevent the paste burning."
        },
        {
          "@type": "HowToStep",
          "text": "Add chicken and continue to cook, still stirring, until the paste is fragrant."
        },
        {
          "@type": "HowToStep",
          "text": "Season with fish sauce, and then add coconut milk or stock."
        },
        {
          "@type": "HowToStep",
          "text": "Bring to the boil, reduce the heat, add corn, and simmer."
        },
        {
          "@type": "HowToStep",
          "text": "When the chicken is cooked (about 3-4 minutes), garnish with lime leaves and thai basil."
        }
      ]
    }
  ],
  "keywords": [
    "Books",
    "Thai Food",
    "Curries"
  ]
}
