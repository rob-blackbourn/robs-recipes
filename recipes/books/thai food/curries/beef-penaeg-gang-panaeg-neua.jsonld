{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Beef Penaeg (gang panaeg neua)",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "200 g beef brisket (sinew removed)",
    "1l coconut milk (for cooking the beef)",
    "750ml coconut milk (for the curry)",
    "750ml coconut cream",
    "1 1/2 tbsp palm sugar",
    "2 tbsp fish sauce",
    "3 kaffir lime leaves (torn)",
    "3 long red or green chilies (cut in half and de-seeded",
    "large handful of thai basil leaves",
    "4 tbsp peanuts, (for the paste)",
    "7 dried long red chilies (de-seeded, soaked and drained), (for the paste)",
    "a large pinch of salt, (for the paste)",
    "1 tsp scraped and chopped coriander root, (for the paste)",
    "1 1/2 tbsp chopped galangal, (for the paste)",
    "1 tbsp chopped lemongrass, (for the paste)",
    "3 tbsp chopped red shallot, (for the paste)",
    "2 tbsp chopped garlic, (for the paste)",
    "1/2 nutmeg (coarsely pounded and briefly roasted) (for the paste)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "First make the paste. Boil the peanuts for at least 30 minutes until very soft, drain and cool. Pound or blend the paste, adding the peanuts last."
    },
    {
      "@type": "HowToStep",
      "text": "Blanch the meat from a cold water start (to soften it’s flavour) and rinse. Bring the coconut milk to the boil, add the beef, then turn down the heat and braise gently until tender (about 2 hours). Allow to cool in the liquid, then remove and slice."
    },
    {
      "@type": "HowToStep",
      "text": "Crack the coconut cream by simmering over a medium heat, then fry 4 tbsp of the paste in the coconut cream for 10 minutes. Season, first with palm sugar, and then, after a minute with the fish sauce. Moisten with 3 cups of coconut milk. Add the sliced beef, simmer briefly to heat through, and finish with the remaining ingredients."
    }
  ],
  "keywords": [
    "Books",
    "Thai Food",
    "Curries"
  ]
}
