{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Steamed Fish Curry - Hor Mok Pla",
  "recipeYield": "2 servings",
  "recipeCuisine": "Thai",
  "recipeCategory": "Curry",
  "recipeIngredient": [
    "200 g fish fillets (whiting, blue eye cod, or perch)",
    "a pinch of salt",
    "a little lime juice",
    "2 tbsp fish sauce",
    "a pinch of palm sugar",
    "1/2 cup coconut cream",
    "1 small lightly beaten egg",
    "6 kaffir lime leaves",
    "2 banana leaves (optional)",
    "handful of Thai basil leaves",
    "1 tbsp thick coconut cream",
    "a few long red chilies (julienned)",
    "8 dried long red chilli (de-seeded, soaked, and drained)",
    "a large pinch of salt (For the paste)",
    "1 tbsp chopped galangal",
    "2 tbsp chopped lemongrass",
    "1 tsp finely chopped kaffir lime zest",
    "1 tsp scraped and chopped coriander root",
    "2 tbsp chopped red shallot",
    "3 tbsp chopped garlic",
    "1 tsp gapi shrimp paste (roasted)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Make the paste."
    },
    {
      "@type": "HowToStep",
      "text": "Wash the fish in water with a little salt and a squeeze of lime juice. Drain, pat dry, and slice finely."
    },
    {
      "@type": "HowToStep",
      "text": "In a bowl, season the fish with fish sauce and sugar, stirring with a spoon."
    },
    {
      "@type": "HowToStep",
      "text": "Gradually and cautiously, work in the coconut cream. Like a mayonnaise it must not separate; if it does add a little ice cold water and stir to incorporate."
    },
    {
      "@type": "HowToStep",
      "text": "Fold in 3 tbsp of the paste and check the seasoning: it should be salty and sweet, redolent with coconut cream. Stir in the egg and finish with the lime leaves, reserving a few for garnish."
    },
    {
      "@type": "HowToStep",
      "text": "Cut banana leaves (if using) into large circles around 12cm in diameter. Wipe them and put one circle on top of another, shiny sides out. At four evenly spaced intervals crimp the leaves to form a basket securing with small toothpicks. Flatten the bottom, line with Thai basil leaves and add to the curry. (Or more simple line a porcelain bowl with the Thai basil and spoon in the curry)."
    },
    {
      "@type": "HowToStep",
      "text": "Steam over a medium heat for 15-30 minutes until the curry has set. This will depend on the amount prepared and the size of the steaming receptacle."
    }
  ],
  "keywords": [
    "bbq",
    "fish",
    "cod",
    "whiting",
    "perch"
  ]
}
