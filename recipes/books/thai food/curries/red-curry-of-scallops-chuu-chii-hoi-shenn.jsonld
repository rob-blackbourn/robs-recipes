{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Red Curry of Scallops (chuu chii hoi shenn)",
  "recipeYield": "2 servings",
  "recipeCuisine": "Thai",
  "recipeIngredient": [
    "500 ml coconut cream",
    "1 tbsp palm sugar",
    "2 tbsp fish sauce",
    "250 ml coconut milk",
    "12 small scallops",
    "4 kaffir lime leaves (shredded)",
    "1 tbsp thick coconut cream",
    "a little read chilli (julienned)",
    "1 tbsp coriander leaves",
    "6 dried long red chilies (de-seeded, soaked and drained)",
    "a large pinch salt",
    "5 slices galangal",
    "3 tbsp chopped lemongrass",
    "4 tbsp chopped garlic",
    "3 tbsp sliced red shallot",
    "1 tbsp scraped and chopped coriander root",
    "10 white peppercorns",
    "1 rounded tbsp gapi shrimp paste (roasted)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Make the curry paste."
    },
    {
      "@type": "HowToStep",
      "text": "Crack the coconut cream over medium heat, add 3 tbsp of the paste and fry, stirring regularly, for 5 minutes, until fragrant. Season with sugar and fish sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Add coconut milk and simmer until reduced, quite thick, and separated."
    },
    {
      "@type": "HowToStep",
      "text": "Add scallops, and half the kaffir lime leaves and continue to simmer briefly, with the scallops immersed, until the flesh is just cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Check seasoning: it should be salty, a little hot, and fragrant from the kaffir lime."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, arrange the scallops on a plate, drizzle over the coconut cream, then sprinkle with the remaining lime leaves, red chilli and coriander."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "12 scallops should weigh around 200 g."
    }
  ],
  "keywords": [
    "Books",
    "BBQ",
    "Curries"
  ]
}
