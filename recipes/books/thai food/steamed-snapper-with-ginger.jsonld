{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Steamed Snapper with Ginger",
  "recipeYield": "1 serving",
  "recipeIngredient": [
    "1 whole snapper (around 400g),",
    "3 tbsp light soy sauce,",
    "a pinch of white sugar,",
    "1 cup shredded ginger,",
    "4 spring onions (shredded),",
    "a large pinch ground white pepper,",
    "1 tbsp coriander leaves."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Clean and score the fish."
    },
    {
      "@type": "HowToStep",
      "text": "Place on a plate and cover with soy sauce, sugar and half the ginger."
    },
    {
      "@type": "HowToStep",
      "text": "Steam until just cooked (around 20 minutes) checking the underside of the fish to make sure it is done."
    },
    {
      "@type": "HowToStep",
      "text": "Strew with the rest of the ginger and spring onions and steam for a moment longer until the onions have softened."
    },
    {
      "@type": "HowToStep",
      "text": "Before serving remove as much of the liquid as possible, thn sprinkle with pepper and coriander."
    }
  ],
  "keywords": [
    "Books",
    "Thai Food"
  ]
}
