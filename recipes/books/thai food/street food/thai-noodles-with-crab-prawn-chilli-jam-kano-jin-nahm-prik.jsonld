{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thai Noodles with Crab, Prawn & Chilli Jam (kano jin nahm prik)",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "3 cups coconut cream,",
    "3 tbsp roasted and ground mung beans,",
    "2 tbsp chilli jam,",
    "3 tbsp palm sugar,",
    "2 tbsp tamarind water,",
    "3 tbsp fish sauce,",
    "100g minced uncooked prawns,",
    "50g cooked crab meat,",
    "3 tbsp shredded sour snakeskin pear or green mango,",
    "2 tbsp kaffir lime juice,",
    "1 kaffir lime (cut in half),",
    "1 tbsp deep fried shallots,",
    "1 tbsp deep fried garlic,",
    "2 coils kanom jin rice noodles (about 100g).",
    "For the paste",
    "3 red shallots,",
    "4 cloves garlic,",
    "2 slices galangal (chopped),",
    "pinch of salt,",
    "2 coriander roots (scraped and chopped),",
    "1 tsp gapi shrimp paste (roasted)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "First, make the paste: roast shallots, garlic, and galangal; when cool enough to handle peel shallots and garlic. Gradual pound the ingredients together using a pestle and mortar, adding one by one, until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Bring coconut cream to the boil and add paste, ground mung beans and chilli jam. Simmer for a few minutes, then season with ugar, tamarind water, and fish sauce. The sauce should taste smoky, rich, salty and sweet."
    },
    {
      "@type": "HowToStep",
      "text": "Add minced prawns and stir to prevent clumping."
    },
    {
      "@type": "HowToStep",
      "text": "When cooked (about 5 minutes), add crab, snakeskin pear or green mango, kaffir lime juice and kaffir lime. The sauce should now taste fragrant sour, salty, sweet, yet slightly bitter."
    },
    {
      "@type": "HowToStep",
      "text": "Pour into a bowl, sprinkle with deep fried shallots and garlic. Serve alongside the noodles."
    }
  ],
  "keywords": [
    "Books",
    "Thai Food",
    "Street Food"
  ]
}
