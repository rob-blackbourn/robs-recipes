{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Grilled Liver (dap warn)",
  "recipeCategory": "tapas",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "200g calves liver",
    "1/2 - 1 tsp roasted chilli powder",
    "2 tbsp lime juice",
    "1 tbsp fish sauce",
    "handful of mint leaves",
    "handful of holy basil leaves (optional)",
    "2 tbsp chopped spring onion",
    "1 tbsp ground roasted rice"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Clean the liver and cut into 1/2cm slices."
    },
    {
      "@type": "HowToStep",
      "text": "Dip in and out of simmering water until just cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Combine chilli with lime juice and fish sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Dress the liver with the mixture and add the remaining ingredients."
    }
  ],
  "keywords": [
    "books",
    "thai",
    "street food",
    "fish"
  ]
}
