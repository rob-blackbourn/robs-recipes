{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Prawn Cakes (tort man gung)",
  "recipeCategory": "Tapas",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 coriander roots (scraped and chopped)",
    "a pinch of salt",
    "3 garlic cloves (peeled)",
    "1 slice ginger",
    "a large pinch of ground white pepper",
    "150g minced uncooked prawns",
    "a large pinch of palm sugar",
    "1-2 tbsp soy sauce",
    "oil for deep frying.g",
    "Serve with cucumber relish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pound the coriander roots, salt, garlic, ginger and pepper into a paste."
    },
    {
      "@type": "HowToStep",
      "text": "Combine with the minced prawns, then slap the mixture against the side of the bowl until it becomes firm and stickier."
    },
    {
      "@type": "HowToStep",
      "text": "Season with sugar and soy sauce. Test a little by poaching in water - it should taste salty and slightly sweet."
    },
    {
      "@type": "HowToStep",
      "text": "Roll into 2cm balls, flatten into cakes, and deep fry in plenty of medium hot oil."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1jH_Y94O5DeFPMUjYiUSlJm1lUuorcSl2ONCmqie9Dh4/edit?usp=sharing"
  ],
  "keywords": [
    "books",
    "thai",
    "street food"
  ]
}
