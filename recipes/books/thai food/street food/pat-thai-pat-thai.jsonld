{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Pat Thai (pat thai)",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "a good handful of dried thin rice noodles,",
    "1 tbsp palm sugar,",
    "1 tbsp white sugar,",
    "1 tbsp tamarind water,",
    "2 tbsp fish sauce,",
    "1 small bunch Chinese chives,",
    "1 tsp oil,",
    "2 red shallots (coarsely chopped with a pinch of salt),",
    "1 egg.",
    "50g firm bean curd (deep fried and cut into 1/2cm cubes),",
    "1 tbsp dried shrimps (rinsed and dried),",
    "1 tsp shredded white radish (rinsed and dried),",
    "a pinch of roasted chilli powder,",
    "handful of bean sprouts,",
    "1 tbsp crushed roasted peanuts,",
    "1 lime wedge,",
    "extra 1 tsp roasted chilli powder."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak noodles in water for 2 hours until soft, then drain."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer the palm sugar and white sugar with tamarind water and fish sauce for 1-2 minutes until dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Chop most of the chinese chives into 2cm lengths, reserving a few chopped into 5cm lengths for garnish."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a wok over a medium heat and fry the shallots until fragrant and beggining to colour."
    },
    {
      "@type": "HowToStep",
      "text": "Crack in the egg, turn down the heat and stir."
    },
    {
      "@type": "HowToStep",
      "text": "Mix in the bean curd, dried prawns and white radish, then add the noodles. Turn up the heat and stir fry for about a minute, allowing the noodles to brown a little."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prepared sauce and a pinch of chilli powder, then simmer for another 30 seconds - 1 minute until wilted."
    },
    {
      "@type": "HowToStep",
      "text": "Finally add most of the bean sprouts and chinese chives and cook for another 30 seconds until wilted."
    },
    {
      "@type": "HowToStep",
      "text": "Check the seasoning: the noodles should taste sweet, sour and salty."
    },
    {
      "@type": "HowToStep",
      "text": "Pile on a plate and top with the reserved bean sprouts and chinese chives. Serve with crushed roasted peanuts, a lime wedge, and roasted chilli powder on the side of the plate."
    }
  ],
  "keywords": [
    "Books",
    "Thai Food",
    "Street Food"
  ]
}
