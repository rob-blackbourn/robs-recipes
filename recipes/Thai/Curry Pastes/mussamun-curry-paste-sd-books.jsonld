  "name": "Mussamun Curry Paste - SD Books",
  "text": "Mussamun Curry Paste - SD Books\n\nYield: ½ cup\n\nPreparation time:\n\nCooking time:\n\nIngredients\n\n3 dried spur chilies (seeded and soaked until tender),\n\n1 tsp sea salt,\n\n1 tsp mature galangal (sliced and roasted),\n\n1 tbsp lemongrass (sliced and roasted),\n\n2 bulbs garlic (grilled and peeled),\n\n5 shallots (grilled and peeled),\n\n1 tbsp coriander seeds (roasted and ground),\n\n1 tsp cumin (roasted and ground),\n\n1 tsp pepper,\n\n1 tsp shrimp paste.\n\nPreparation\n\n1. Process to a smooth paste.",
  "recipeYield": "½ cup",
  "recipeIngredient": [
    "3 dried spur chilies (seeded and soaked until tender),",
    "1 tsp sea salt,",
    "1 tsp mature galangal (sliced and roasted),",
    "1 tbsp lemongrass (sliced and roasted),",
    "2 bulbs garlic (grilled and peeled),",
    "5 shallots (grilled and peeled),",
    "1 tbsp coriander seeds (roasted and ground),",
    "1 tsp cumin (roasted and ground),",
    "1 tsp pepper,",
    "1 tsp shrimp paste."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Process to a smooth paste."
    }
  ]
