{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Green Curry Paste",
  "text": "Green Curry Paste\n\nIngredients\n\n15 large fresh green hot chilies\n\n3 shallots, sliced\n\n9 cloves garlic\n\n1 tsp finely sliced fresh galangal\n\n1 tbsp sliced fresh lemon grass\n\n1/2 tsp finely sliced kaffir lime rind\n\n1 tsp chopped coriander root (or substitute coriander stems if unavailable)\n\n5 white peppercorns\n\n1 tbsp roasted coriander seeds\n\n1 tsp roasted cumin seeds\n\n1 tsp sea salt\n\n1 tsp shrimp paste\n\nPreparation\n\n1. Combine coriander seeds, cumin and peppercorn in a mortar, pound well. Transfer to a bowl and put aside.\n\n2. Pound hot chilies and salt together well. Add the remaining ingredients except shrimp paste, pound until mixed well.\n\n3. Add the cumin mixture and shrimp paste, continue pounding until smooth and fine.",
  "recipeIngredient": [
    "15 large fresh green hot chilies",
    "3 shallots, sliced",
    "9 cloves garlic",
    "1 tsp finely sliced fresh galangal",
    "1 tbsp sliced fresh lemon grass",
    "1/2 tsp finely sliced kaffir lime rind",
    "1 tsp chopped coriander root (or substitute coriander stems if unavailable)",
    "5 white peppercorns",
    "1 tbsp roasted coriander seeds",
    "1 tsp roasted cumin seeds",
    "1 tsp sea salt",
    "1 tsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Combine coriander seeds, cumin and peppercorn in a mortar, pound well. Transfer to a bowl and put aside."
    },
    {
      "@type": "HowToStep",
      "text": "2. Pound hot chilies and salt together well. Add the remaining ingredients except shrimp paste, pound until mixed well."
    },
    {
      "@type": "HowToStep",
      "text": "3. Add the cumin mixture and shrimp paste, continue pounding until smooth and fine."
    }
