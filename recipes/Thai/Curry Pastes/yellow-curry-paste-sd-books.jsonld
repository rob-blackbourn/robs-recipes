    "1 tbsp lemongrass (sliced),",
    "5 shallots (grilled and peeled),",
    "10 cloves small garlic (grilled and peeled),",
    "1 tbsp coriander seeds (roasted and ground),",
    "2 tsp curry powder,",
    "1 tsp shrimp paste."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Process to a smooth paste."
    }
  ]
