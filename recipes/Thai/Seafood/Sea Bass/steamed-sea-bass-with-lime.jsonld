    "1 whole sea bass (approximately 450g, cleaned, scaled, and trimmed),",
    "5 green and red hot chillis (finely chopped),",
    "5 cloves garlic (finely chopped),",
    "½ cup chicken stock (or water),",
    "3 tbsp lime juice,",
    "1 ½ tbsp light soy sauce.",
    "Garnish: 1 lime (sliced),",
    "Garnish: 1 sprig coriander,",
    "Garnish: 1 medium tomato."
  ],
