{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Chicken with Cashew Nuts",
  "recipeYield": "4",
  "prepTime": "PT24M",
  "recipeIngredient": [
    "2 dried red long chilies (deseeded and cut into 1 cm pieces),",
    "1 tbsp fish sauce,",
    "2 tbsp oyster sauce,",
    "3 tbsp chicken stock or water,",
    "1 tbsp sugar,",
    "4 tbsp vegetable oil,",
    "80 g cashew nuts,",
    "5 cloves of garlic (finely chopped),",
    "500 g chicken breast (thinly sliced),",
    "1/2 red pepper (cut into thin strips),",
    "1/2 carrot (thinly sliced diagonally),",
    "1 small onion (cut into 6 wedges),",
    "2 spring onions (cut into 1 cm lengths),",
    "Ground white pepper (to sprinkle)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix the fish sauce, oyster sauce, stock, and sugar in a small bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in the wok over a medium heat and stir fry the cashew nuts until light brown (2-3 minutes), then remove and drain on paper towels."
    },
    {
      "@type": "HowToStep",
      "text": "Stir fry the chilli and chopped garlic until the garlic is light brown. Add the chicken and stir fry until cooked (4-5 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Add the red pepper, carrot, onion, and the sauce mixture and continue to stir fry for another minute."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cashew nuts, chilies, and spring onions and toss well."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle with white pepper and serve."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Not hot enough - instructions changed."
    }
  ],
  "description": "Kai Phat Met Muang Himaphaan"
}
