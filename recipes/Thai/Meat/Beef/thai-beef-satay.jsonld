    {
      "@type": "HowToStep",
      "text": "Soak the skewers for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the marinade over and stir well to combine. Allow at least 1 hour for marinating, or longer (up to 24 hours)."
    },
