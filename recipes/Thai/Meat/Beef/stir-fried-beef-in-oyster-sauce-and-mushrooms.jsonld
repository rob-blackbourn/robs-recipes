    "400 g rump beef steak (very thinly sliced),",
    "2 tsp cornflour,",
    "2 tsp fish sauce,",
    "2 tsp dark soy sauce,",
    "2 1/2 tbsp oil,",
    "1 large clove of garlic (chopped),",
    "2 tbsp oyster sauce,",
    "1 tsp palm sugar,",
    "1 1/2 cups sliced fresh mushrooms,",
    "1 large red chilli (deseeded and sliced),",
    "1 spring onion (sliced)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Mix the beef with the cornflour, fish sauce, and dark soy sauce. Leave to marinate for 10 minutes."
    },
