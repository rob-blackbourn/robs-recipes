{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Stir Fried Beef in Oyster Sauce with Mushrooms",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "400 g rump beef steak (very thinly sliced),",
    "2 tsp cornflour,",
    "2 tsp fish sauce,",
    "2 tsp dark soy sauce,",
    "2 1/2 tbsp oil,",
    "1 large clove of garlic (chopped),",
    "2 tbsp oyster sauce,",
    "1 tsp palm sugar,",
    "1 1/2 cups sliced fresh mushrooms,",
    "1 large red chilli (deseeded and sliced),",
    "1 spring onion (sliced)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix the beef with the cornflour, fish sauce, and dark soy sauce. Leave to marinate for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in the wok and  stir fry the beef and garlic for 1 1/2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add half of the oyster sauce and a few tbsp of water, along with the sugar, mushrooms, chilli, and spring onion (reserving some of the greens)."
    },
    {
      "@type": "HowToStep",
      "text": "Stir fry until the mushrooms are tender and the meat is cooked (about 1 1/2 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the remaining oyster sauce then check seasoning adding extra sugar if necessary."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with reserved spring onion greens to serve."
    }
  ],
  "keywords": [
    "Meat",
    "Beef"
  ]
}
