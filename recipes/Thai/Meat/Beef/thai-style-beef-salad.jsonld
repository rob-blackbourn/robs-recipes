{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Thai-style beef salad",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "For the beef: 2 x 150g/5oz sirloin steaks",
    "For the beef: vegetable oil, for brushing",
    "For the beef: salt and freshly ground black pepper",
    "For the beef: For the salad",
    "For the beef: ¼ head Chinese leaf",
    "For the beef: 2 ripe tomatoes",
    "For the beef: 2 banana shallots or 4 small shallots",
    "For the beef: ½ cucumber",
    "For the beef: 3 spring onions",
    "For the beef: handful fresh basil leaves",
    "For the beef: handful fresh coriander",
    "For the dressing: 2 tsp palm sugar, from a 'cake' of sugar (substitute golden caster sugar",
    "For the dressing: if unavailable)",
    "For the dressing: 1½-2 limes, juice only",
    "For the dressing: 90ml/3fl oz fish sauce",
    "For the dressing: 2 red bird's-eye chillies",
    "For the dressing: lime wedges, to serve"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the beef, brush the steaks with oil and season with salt and freshly ground black pepper. Heat a ridged griddle pan until smoking, then add the steaks and griddle for 3-6 minutes on each side, or until cooked to your liking. Remove from the heat and leave to rest in a warm place for five minutes."
    },
    {
      "@type": "HowToStep",
      "text": "For the salad, finely slice the Chinese leaf and place into a large bowl. Cut the tomatoes into wedges and add to the bowl. Finely slice the shallots and add to the bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the cucumber in half down the middle. Remove the seeds with a teaspoon and slice the cucumber flesh on the diagonal. Discard the seeds and add the cucumber to the bowl. Slice the spring onions on the diagonal and add to the bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Tear the basil leaves and add to the bowl. Tear the coriander leaves and stalks and add to the bowl. Mix together to combine well."
    },
    {
      "@type": "HowToStep",
      "text": "For the dressing, grate about two teaspoons of the palm sugar into a small clean bowl. Roll the limes to release the juices. Cut in half and squeeze the juice into the bowl with the sugar. Stir until the sugar is dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Add the fish sauce to the dressing. Taste the dressing and adjust the flavours, adding more lime juice, fish sauce or palm sugar to taste. Finely chop the chillies and add to the dressing."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the cooked steak into thin slices on the diagonal. Add the sliced steak to the salad ingredients, drizzle over the dressing and mix together well. Add to the bowl the juices from the plate the meat was resting on."
    },
    {
      "@type": "HowToStep",
      "text": "Serve the salad on a large plate, with lime wedges on the side."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: less than 30 mins"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 10 to 30 mins"
    }
  ],
  "prepTime": "less than 30 mins",
  "cookTime": "10 to 30 mins",
  "keywords": [
    "Meat",
    "Beef"
  ]
}
