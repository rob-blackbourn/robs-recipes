    "For the curry sauce: 1 tsp whole cumin seed,",
    "For the curry sauce: 1/2 tsp white pepper,",
    "For the curry sauce: 1 tsp turmeric,",
    "For the curry sauce: 1/8 tsp cardamon,",
    "For the curry sauce: 1 tsp tamarind, or substitute 1 1bsp lime juice",
    "For the curry sauce: 1 tbsp brown sugar",
    "For the curry sauce: 3/4 tsp shrimp paste,",
    "For the curry sauce: 2 tbsp fish sauce,",
    "For the curry sauce: 400 ml can coconut milk"
