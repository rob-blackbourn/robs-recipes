{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Cucumber Dip",
  "recipeYield": "?",
  "recipeIngredient": [
    "¾ cup vinegar,",
    "1 cup caster sugar,",
    "⅓ cup palm sugar,",
    "1 ½ tsp salt,",
    "2 red spur chilies (sliced),",
    "9 cloves garlic,",
    "2 cucumbers (thinly sliced),",
    "2 coriander plants (sliced)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook the vinegar, caster sugar, palm sugar, and salt over a low heat until slightly thickened."
    },
    {
      "@type": "HowToStep",
      "text": "Add coarsely pounded chili and garlic, stirring well."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, then turn off the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cucumber and coriander just before serving."
    }
  ]
}
