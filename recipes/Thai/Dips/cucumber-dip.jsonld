  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Cucumber Dip",
  "text": "Cucumber Dip\n\nYield: ?\n\nIngredients\n\n¾ cup vinegar,\n\n1 cup caster sugar,\n\n⅓ cup palm sugar,\n\n1 ½ tsp salt,\n\n2 red spur chilies (sliced),\n\n9 cloves garlic,\n\n2 cucumbers (thinly sliced),\n\n2 coriander plants (sliced).\n\nPreparation\n\n1. Cook the vinegar, caster sugar, palm sugar, and salt over a low heat until slightly thickened.\n\n2. Add coarsely pounded chili and garlic, stirring well.\n\n3. Bring to the boil, then turn off the heat.\n\n4. Add the cucumber and coriander just before serving.",
  "recipeYield": "?",
  "recipeIngredient": [
    "¾ cup vinegar,",
    "1 cup caster sugar,",
    "⅓ cup palm sugar,",
    "1 ½ tsp salt,",
    "2 red spur chilies (sliced),",
    "9 cloves garlic,",
    "2 cucumbers (thinly sliced),",
    "2 coriander plants (sliced)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Cook the vinegar, caster sugar, palm sugar, and salt over a low heat until slightly thickened."
    },
    {
      "@type": "HowToStep",
      "text": "2. Add coarsely pounded chili and garlic, stirring well."
    },
    {
      "@type": "HowToStep",
      "text": "3. Bring to the boil, then turn off the heat."
    },
    {
      "@type": "HowToStep",
      "text": "4. Add the cucumber and coriander just before serving."
    }
  ]
}
