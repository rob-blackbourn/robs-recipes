{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Thailand",
  "name": "Chicken in Pandanus Leaves",
  "recipeYield": "18 servings",
  "recipeIngredient": [
    "300g chicken breast (thickly sliced across the breast),",
    "8 cloves garlic,",
    "½ tsp pepper,",
    "1½ tbsp light soy sauce,",
    "½ tbsp chinese wine,",
    "1 tsp sesame oil,",
    "⅛ tsp sea salt,",
    "1 tbsp palm sugar,",
    "4 cups vegetable oil,",
    "Pandanus leaves,",
    "Cocktail sticks."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Wash and slice the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the rest of the ingredients in a food processor or grind with a pestle and mortar."
    },
    {
      "@type": "HowToStep",
      "text": "Marinate the chicken for at least an hour."
    },
    {
      "@type": "HowToStep",
      "text": "Clean the pandanus leaves and pat dry.Wrap the chicken in the leaves in triangular packets, and secure with a cocktail stick."
    },
    {
      "@type": "HowToStep",
      "text": "Fry in some oil."
    }
  ]
}
