{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Rosemary Olive Bread",
  "text": "Rosemary Olive Bread\n\nYield: 1 large loaf\n\nPreparation time:\n\nCooking time:\n\nIngredients\n\n3 cups bread flour,\n\n1 tablespoon sugar,\n\n1 tablespoon salt,\n\n1 tablespoon active dry yeast,\n\n1 egg,\n\n6 oz warm water,\n\n2 oz olive oil,\n\n2 tablespoons fresh rosemary,\n\n1 cup pitted olives.\n\nPreparation\n\n1. Dissolve the yeast in the warm water.\n\n2. Combine beaten egg, olive oil, sugar, rosemary and olives and add the yeast/water mixture.\n\n3. Add flour and knead for 5 minutes.\n\n4. Let the dough rest for 15 minutes.\n\n5. Add salt and knead for another 5 minutes.\n\n6. Place dough in bowl greased with olive oil. Cover. Let rise for one hour in a warm spot.\n\n7. Remove the dough.  Knead it a bit.  Form it into a ball and place on parchment paper.\n\n8. Loosely cover with a towel and place it in a warm spot for 30 min.\n\n9. Preheat the oven for one hour at Gas Mark 6 (400F, 200C).\n\n10. Slash the top of the loaf before baking. Bake for 40 minutes.\n\n11. Remove from the oven and allow to cool for two hours or so before eating.",
  "recipeYield": "1 large loaf",
  "recipeIngredient": [
    "3 cups bread flour,",
    "1 tablespoon sugar,",
    "1 tablespoon salt,",
    "1 tablespoon active dry yeast,",
    "1 egg,",
    "6 oz warm water,",
    "2 oz olive oil,",
    "2 tablespoons fresh rosemary,",
    "1 cup pitted olives."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Dissolve the yeast in the warm water."
    },
    {
      "@type": "HowToStep",
      "text": "2. Combine beaten egg, olive oil, sugar, rosemary and olives and add the yeast/water mixture."
    },
    {
      "@type": "HowToStep",
      "text": "3. Add flour and knead for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "4. Let the dough rest for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "5. Add salt and knead for another 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "6. Place dough in bowl greased with olive oil. Cover. Let rise for one hour in a warm spot."
    },
    {
      "@type": "HowToStep",
      "text": "7. Remove the dough.  Knead it a bit.  Form it into a ball and place on parchment paper."
    },
    {
      "@type": "HowToStep",
      "text": "8. Loosely cover with a towel and place it in a warm spot for 30 min."
    },
    {
      "@type": "HowToStep",
      "text": "9. Preheat the oven for one hour at Gas Mark 6 (400F, 200C)."
    },
    {
      "@type": "HowToStep",
      "text": "10. Slash the top of the loaf before baking. Bake for 40 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "11. Remove from the oven and allow to cool for two hours or so before eating."
    }
  ]
