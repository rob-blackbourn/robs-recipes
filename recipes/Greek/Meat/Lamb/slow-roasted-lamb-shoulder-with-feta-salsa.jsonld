{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Greece",
  "name": "Slow-Roasted Lamb Shoulder with Feta Salsa",
  "prepTime": "PT30M",
  "cookTime": "PT3H",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "120ml extra virgin olive oil,",
    "1 tsp cumin,",
    "2 garlic cloves (For the lamb)",
    "1 lemon (For the lamb)",
    "Salt and pepper,",
    "1.5 kg shoulder of lamb.",
    "1 courgette (diced  into 1cm cubes),",
    "1 red onion (diced  into 1cm cubes),",
    "1 red pepper (de-seeded and diced  into 1cm cubes),",
    "400g tinned chickpeas,",
    "Some extra-virgin olive oil.",
    "1 mini cucumber (or 1/2 cucumber),",
    "500ml Greek yogurt,",
    "3 tbsp mint (finely chopped).",
    "120ml olive oil,",
    "2 garlic cloves (For the salsa)",
    "1 lemon (For the salsa)",
    "200g barrel-aged feta cheese.",
    "12 tortillas or flat bread,",
    "200g mixed salad leaves,",
    "Chilli sauce or Harissa."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Take half of the olive oil and add 1 tsp of cumin, 2 cloves of crushed garlic, zest of 1 lemon and pinch of salt and pepper. Mix together then rub all over the lamb, cover in a bowl and leave to marinade overnight."
    },
    {
      "@type": "HowToStep",
      "text": "For the salsa, in a small saucepan add the remaining olive oil, zest of 1 lemon (thinly sliced), 2 garlic cloves (sliced  as thinly as possible) and bring to a very gentle simmer. This will infuse the oil. Leave overnight."
    },
    {
      "@type": "HowToStep",
      "text": "The next day, preheat the oven to 220°C. Place the lamb in an ovenproof dish and put in the oven for 35 minutes. Take out of the oven, baste, cover the tray with foil then return to the oven turning the heat down to 150°C. Cook for 2 1/2 hours or until the meat is falling away from the bone."
    },
    {
      "@type": "HowToStep",
      "text": "Whilst the lamb is cooking, heat some olive oil and gently saute the vegetables until cooked and they begin to color. Add the chickpeas, season and if a little dry, a touch of virgin olive oil. Allow to cool and then gently reheat before serving."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from oven and rest for 30 minutes with the foil still on so it keeps warm."
    },
    {
      "@type": "HowToStep",
      "text": "For the yoghurt sauce, dice  the cucumber into 1/2cm cubes and add to the yoghurt along with the chopped  mint. Season and mix thoroughly. Refrigerate until needed."
    },
    {
      "@type": "HowToStep",
      "text": "To finish the salsa, reheat the oil and when it's gently simmering, remove from heat and crumble the feta cheese in and stir until mixed. Season and squeeze in the juice of 1 lemon. Keep warm."
    },
    {
      "@type": "HowToStep",
      "text": "With the lamb rested, pour out all the excess out and begin to take the meat from the bone by shredding it with two forks. Pour the feta salsa over the meat and keep warm."
    },
    {
      "@type": "HowToStep",
      "text": "To assemble the kebab take your bread and lay out on a flat surface. Take some salad and lay in the middle. Next spoon a layer of the warmed vegetables, then a layer of the lamb and salsa and finally the yogurt and chilli sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Fold over one end then roll up the kebab."
    }
  ],
  "keywords": [
    "Meat",
    "Lamb"
  ]
}
