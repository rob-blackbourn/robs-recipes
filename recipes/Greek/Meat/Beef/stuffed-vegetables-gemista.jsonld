  "@type": "Recipe",
  "name": "Stuffed Vegetables (Gemista)",
  "text": "Stuffed Vegetables (Gemista)\n\nPreparation time: 20 minutes\n\nCooking time: 90 minutes\n\nYield: 6\n\nIngredients\n\n250g minced beef,\n\n5 large tomatoes,\n\n6 green bell peppers (five cored, and one chopped),\n\n1 red onion (finely diced)\n\n4 cloves of garlic (crushed and finely diced),\n\n4 tbsp long grain rice rice,\n\n1 corguette (grated),\n\n1 carrot (grated),\n\n4 potatoes (cut into wedges,\n\n1/2 bunch mint (finely chopped),\n\n1/2 bunch dill (finely chopped),\n\n1/2 bunch parsley (finely chopped),,\n\n2 tsp dried thyme,\n\n2 tsp dried oregano,\n\n1 tbsp parmesan cheese.\n\nOlive oil\n\nPreparation\n\nBrown the beef,\n\nCut the tops of five large tomatoes, scoop out the flesh with a spoon and reserve.\n\nCut the tops off five green bell peppers, tear out the insides and discard.\n\nPuree the tomato flesh in a food processor.\n\nBring a medium frying pan up to medium heat and add olive oil and add one onion, finely diced.\n\nAfter the onion is soft add four chopped garlic cloves and cook until soft.\n\nAdd four tablespoons of rice and stir.\n\nAdd the grated courgette, and carrot and cook for two minutes.\n\nAdd one chopped green bell pepper and cook for another minute.\n\nAdd three quarters of the tomato puree,\n\nAdd the fresh herbs and the dried herbs and the cheese.\n\nAdd the browned beef and season,\n\nStuff the vegetables with the mixture\n\nPut the potato wedges into a dish and mix with olive oil, oregano, salt, and pepper.\n\nPut the stuffed vegetables in a baking tray a mix in the potato wedges.\n\nPour in the remaining tomato puree, water, oregano, salt and pepper, and a drizzle of olive oil.\n\nCook covered in the oven at 180C for one hour, then uncovered for a further 30 minutes.",
  "prepTime": "PT20M",
  "cookTime": "PT1H30M",
  "recipeYield": "6",
  "recipeIngredient": [
    "250g minced beef,",
    "5 large tomatoes,",
    "6 green bell peppers (five cored, and one chopped),",
    "1 red onion (finely diced)",
    "4 cloves of garlic (crushed and finely diced),",
    "4 tbsp long grain rice rice,",
    "1 corguette (grated),",
    "1 carrot (grated),",
    "4 potatoes (cut into wedges,",
    "1/2 bunch mint (finely chopped),",
    "1/2 bunch dill (finely chopped),",
    "1/2 bunch parsley (finely chopped),,",
    "2 tsp dried thyme,",
    "2 tsp dried oregano,",
    "1 tbsp parmesan cheese.",
    "Olive oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Brown the beef,"
    },
    {
      "@type": "HowToStep",
      "text": "Cut the tops of five large tomatoes, scoop out the flesh with a spoon and reserve."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the tops off five green bell peppers, tear out the insides and discard."
    },
    {
      "@type": "HowToStep",
      "text": "Puree the tomato flesh in a food processor."
    },
    {
      "@type": "HowToStep",
      "text": "Bring a medium frying pan up to medium heat and add olive oil and add one onion, finely diced."
    },
    {
      "@type": "HowToStep",
      "text": "After the onion is soft add four chopped garlic cloves and cook until soft."
    },
    {
      "@type": "HowToStep",
      "text": "Add four tablespoons of rice and stir."
    },
    {
      "@type": "HowToStep",
      "text": "Add the grated courgette, and carrot and cook for two minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add one chopped green bell pepper and cook for another minute."
    },
    {
      "@type": "HowToStep",
      "text": "Add three quarters of the tomato puree,"
    },
    {
      "@type": "HowToStep",
      "text": "Add the fresh herbs and the dried herbs and the cheese."
    },
    {
      "@type": "HowToStep",
      "text": "Add the browned beef and season,"
    },
    {
      "@type": "HowToStep",
      "text": "Stuff the vegetables with the mixture"
    },
    {
      "@type": "HowToStep",
      "text": "Put the potato wedges into a dish and mix with olive oil, oregano, salt, and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Put the stuffed vegetables in a baking tray a mix in the potato wedges."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the remaining tomato puree, water, oregano, salt and pepper, and a drizzle of olive oil."
    },
    {
      "@type": "HowToStep",
      "text": "Cook covered in the oven at 180C for one hour, then uncovered for a further 30 minutes."
    }
