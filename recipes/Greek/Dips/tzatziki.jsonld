  "recipeCuisine": "Greece",
  "name": "Tzatziki",
  "text": "Tzatziki\n\nPreparation time: 10 minutes\n\nYield:\n\nIngredients\n\nLarge pot of Greek yoghurt\n\n1/2 cucumber,\n\nFresh mint (finely chopped),\n\n1 tbsp lemon juice,\n\n1 clove of garlic (crushed),\n\n1 tbsp extra virgin olive oil,\n\nSalt and pepper,\n\n1 tsp sugar,\n\npaprika (for sprinkling)\n\nPreparation\n\n1. Place a sieve over a glass bowl and grate the cucumber into the bowl. Push out as much water as possible.\n\n2.  Combine the yoghurt, cucumber, lemon juice and garlic. Add a dash of olive oil and sprinkle with paprika.\n\n3. Season with sugar, salt and pepper.",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "recipeIngredient": [
    "Large pot of Greek yoghurt",
    "1/2 cucumber,",
    "Fresh mint (finely chopped),",
    "1 tbsp lemon juice,",
    "1 clove of garlic (crushed),",
    "1 tbsp extra virgin olive oil,",
    "Salt and pepper,",
    "1 tsp sugar,",
    "paprika (for sprinkling)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place a sieve over a glass bowl and grate the cucumber into the bowl. Push out as much water as possible."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the yoghurt, cucumber, lemon juice and garlic. Add a dash of olive oil and sprinkle with paprika."
    },
    {
      "@type": "HowToStep",
      "text": "Season with sugar, salt and pepper."
    }
  ]
}
