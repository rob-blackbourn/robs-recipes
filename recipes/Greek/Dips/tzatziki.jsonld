{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Greece",
  "name": "Tzatziki",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "recipeYield": "500 ml",
  "recipeIngredient": [
    "Large pot of Greek yoghurt",
    "1/2 cucumber,",
    "Fresh mint (finely chopped),",
    "1 tbsp lemon juice,",
    "1 clove of garlic (crushed),",
    "1 tbsp extra virgin olive oil,",
    "Salt and pepper,",
    "1 tsp sugar,",
    "paprika (for sprinkling)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place a sieve over a glass bowl and grate the cucumber into the bowl. Push out as much water as possible."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the yoghurt, cucumber, lemon juice and garlic. Add a dash of olive oil and sprinkle with paprika."
    },
    {
      "@type": "HowToStep",
      "text": "Season with sugar, salt and pepper."
    }
  ]
}
