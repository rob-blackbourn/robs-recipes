{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Mauritius",
  "name": "Mauritian Chicken Curry",
  "text": "Mauritian Chicken Curry\n\nCooking Time: 60 minutes\n\nPreparation Time: 15 minutes\n\nYield: 4 portions\n\nIngredients\n\n1 medium onion (diced)\n\n1 inch of fresh ginger root (very finely diced)\n\n2 cloves of garlic (finely diced)\n\n2 chicken breasts (sliced)\n\n1 tsp thyme\n\n1 tomato (diced)\n\n2 cardamom pods (crushed)\n\n2 tsp garam masala\n\n1 small bunch of coriander (stalks chopped finely, leaves roughly chopped)\n\n1/4 tsp turmeric\n\n1/2 star anise\n\n2 chilies (finely chopped)\n\n2 dried bay leaves (cushed)\n\n4 medium potatoes (diced into 1cm cubes)\n\n4 medium potatoes (quartered)\n\nPreparation\n\nAdd some vegetable oil to a medium saucepan over medium heat.\n\nWhen the oil is up to temperature add the ginger and fry for 1 minute.\n\nAdd the onion and fry for a further 3 minutes. If the onions start to brown reduce the temperature so they do not colour.\n\nAdd the garlic a fry for a further 2 minutes until the garlic is fragrant.\n\nMeanwhile put the tomato, garam masala, turmeric, bay leaves, chillie, coriander stalks, star anise and cardamom pods into a bowl and mix thoroughly.  If the mixture is dry add a little water.\n\nAdd the sliced chicken and thyme to the saucepan, increase the heat, and cook for a minute on either side until the chicken is brown.\n\nAdd the spice mix and the 1cm diced potatoes to the saucepan and enough water to cover the contents with 1/2 inch extra.\n\nCover the saucepan and transfer to an oven, preheated to 180C for 40 minutes.\n\nAdded the quartered potatoes to the saucepan and return to the oven for another 30 minutes.\n\nA minute before serving and most of the coriander leaves.\n\nServe with rice and dress with the last of the coriander leaves..",
  "cookTime": "PT1H",
  "prepTime": "PT15M",
  "recipeYield": "4 portions",
  "recipeIngredient": [
    "1 medium onion (diced)",
    "1 inch of fresh ginger root (very finely diced)",
    "2 cloves of garlic (finely diced)",
    "2 chicken breasts (sliced)",
    "1 tsp thyme",
    "1 tomato (diced)",
    "2 cardamom pods (crushed)",
    "2 tsp garam masala",
    "1 small bunch of coriander (stalks chopped finely, leaves roughly chopped)",
    "1/4 tsp turmeric",
    "1/2 star anise",
    "2 chilies (finely chopped)",
    "2 dried bay leaves (cushed)",
    "4 medium potatoes (diced into 1cm cubes)",
    "4 medium potatoes (quartered)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add some vegetable oil to a medium saucepan over medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "When the oil is up to temperature add the ginger and fry for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion and fry for a further 3 minutes. If the onions start to brown reduce the temperature so they do not colour."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic a fry for a further 2 minutes until the garlic is fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile put the tomato, garam masala, turmeric, bay leaves, chillie, coriander stalks, star anise and cardamom pods into a bowl and mix thoroughly.  If the mixture is dry add a little water."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sliced chicken and thyme to the saucepan, increase the heat, and cook for a minute on either side until the chicken is brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add the spice mix and the 1cm diced potatoes to the saucepan and enough water to cover the contents with 1/2 inch extra."
    },
    {
      "@type": "HowToStep",
      "text": "Cover the saucepan and transfer to an oven, preheated to 180°C for 40 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Added the quartered potatoes to the saucepan and return to the oven for another 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "A minute before serving and most of the coriander leaves."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with rice and dress with the last of the coriander leaves.."
    }
  ]
}
