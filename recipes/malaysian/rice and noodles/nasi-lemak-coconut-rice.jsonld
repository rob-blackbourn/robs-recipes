{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Nasi Lemak (Coconut Rice)",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 cups basmati rice",
    "1/2 cup water",
    "1 1/2 cups coconut milk",
    "1 tbsp ginger root, 5 cm long (peeled and cut into julienne strips)",
    "2 star anise",
    "1 cinnamon bark about 2” long",
    "4 cardamom seeds",
    "1 pandan leaf tied in a knot",
    "1/2 tsp salt",
    "1 tsp white sugar"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Wash and rinse the rice in a pot about three times or until the water runs clear."
    },
    {
      "@type": "HowToStep",
      "text": "Add all the ingredients, including coconut milk, and stir."
    },
    {
      "@type": "HowToStep",
      "text": "Cook on a medium heat, bringing it to the boil. Once boiled, turn down the heat, letting it simmer until the rice has gone fluffy."
    },
    {
      "@type": "HowToStep",
      "text": "Stir it with a wooden or plastic spoon."
    },
    {
      "@type": "HowToStep",
      "text": "Take off the heat and set aside for 10 minutes before serving."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Prep time: ?"
