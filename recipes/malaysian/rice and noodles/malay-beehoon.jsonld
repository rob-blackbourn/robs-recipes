{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Malay Beehoon",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 carrot (cut into matchsticks)",
    "225 g fresh prawns (peeled)",
    "120 ml chicken stock",
    "2 tbsp dark soy sauce",
    "175 g beansprouts",
    "115 g mustard greens or pak choi (shredded)",
    "225 g dried rice vermicelli (soaked in lukewarm water until pliable and drained)",
    "1-2 fresh chilies (de-seeded and finely sliced)",
    "Fresh coriander leaves (roughly chopped)",
    "4 dried red chilies (soaked until soft and de-seeded)",
    "4 cloves of garlic",
    "4 shallots (chopped)",
    "25 g fresh root ginger (peeled and chopped)",
    "1 tsp ground turmeric"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the ingredients for the rempah in a mortar and pestle or food processor into a paste."
    },
    {
      "@type": "HowToStep",
      "text": "In a wok fry off the rempah in a little oil until it begins to colour and becomes fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Toss in the carrots and cook for a few minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prawns."
    },
    {
      "@type": "HowToStep",
      "text": "Add the stock and soy sauce and cook for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beansprouts and mustard greens."
    },
    {
      "@type": "HowToStep",
      "text": "Add the noodles."
    },
    {
      "@type": "HowToStep",
      "text": "Toss well to ensure the vegetables and noodles are coated and heated through."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a serving plate and garnish with the sliced chilies and coriander."
    }
  ],
  "keywords": [
    "Rice and Noodles",
    "seafood",
    "prawns"
  ]
}
