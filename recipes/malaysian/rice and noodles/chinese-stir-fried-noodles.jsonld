{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Chinese Stir-Fried Noodles",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 cloves of garlic",
    "2 red chillies (de-seeded and finely sliced)",
    "1 Chinese sausage (finely sliced)",
    "12 fresh prawns (peeled)",
    "2 small squid (trimmed, cleaned, skinned and sliced)",
    "500g fresh rice noodles",
    "2 tbsp light soy sauce",
    "3 tbsp kepac manis",
    "2-3 mustard green leaves (chopped)",
    "1 handful beansprouts",
    "2 eggs (slightly beaten)",
    "Ground black pepper",
    "Fresh coriander leaves"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a hot wok fry the garlic and chillies until fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Add the Chinese sausage, followed by the prawns and the squid, tossing them to mix thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Toss in the noodles and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Add the soy sauce and kepac manis."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mustard leaves and beansprouts."
    },
    {
      "@type": "HowToStep",
      "text": "Quickly stir in the eggs for a few seconds until set."
    },
    {
      "@type": "HowToStep",
      "text": "Season with black pepper, garnish with coriander, and serve."
    }
  ],
  "keywords": [
    "Rice and Noodles"
  ]
}
