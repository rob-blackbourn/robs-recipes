{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Chinese Clay Pot Rice with Chicken",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "500 g chicken breast fillets",
    "5 dried shiitake mushrooms (soaked inn hot water for 30 minutes until soft)",
    "1 Chinese sausage (sliced)",
    "750 ml chicken stock",
    "225 g long grain rice (washed and drained)",
    "Fresh coriander leaves (chopped for the garnish)",
    "2 tbsp sesame oil",
    "3 tbsp oyster sauce",
    "2 tbsp soy sauce",
    "25 g fresh root ginger (finely grated)",
    "2 spring onions (trimmed and finely sliced)",
    "1 red chilli (deseeded and finely sliced)",
    "1 tsp sugar",
    "Ground black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix together the ingredients for the marinade and toss in the chicken. Set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Squeeze the water out of the soaked mushrooms, and with a sharp knife trim any hard stems, and halve."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mushrooms and the sausage to the marinating chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Bring the stock to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the rice and bring back to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce to a simmer and cook for 15-20 minutes until almost all of the liquid has been absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Spread the chicken and marinade mixture over the top of the rice."
    },
    {
      "@type": "HowToStep",
      "text": "Leave to steam for 10-15 minutes until the chicken has been cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with coriander and serve."
    }
  ],
  "keywords": [
    "Rice and Noodles"
  ]
}
