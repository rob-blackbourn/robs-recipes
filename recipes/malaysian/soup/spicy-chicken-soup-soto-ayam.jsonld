{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Spicy Chicken Soup - Soto Ayam",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "8 shallots (chopped)",
    "8 garlic cloves (chopped)",
    "6 candlenuts or macadamia nuts",
    "50 g galangal (chopped)",
    "2 stalks of lemongrass (chopped) (For the rempah)",
    "4 fresh kaffir lime leaves (For the rempah)",
    "1 tbsp ground coriander",
    "2 tsp ground turmeric",
    "1 tbsp vegetable oil (For the rempah)",
    "1 small chicken",
    "2 stalks of lemongrass (For the soup)",
    "25 g fresh root ginger (peeled and sliced)",
    "2 fresh kaffir lime leaves (For the soup)",
    "1 dried red chilli",
    "2 tbsp vegetable oil (For the soup)",
    "50 g mung bean thread noodles (soaked until pliable)",
    "3 hard-boiled eggs (peeled and halved)",
    "115 g beansprouts",
    "Small bunch of fresh coriander",
    "2 limes (quartered)",
    "Chilli oil",
    "Soy sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the ingredients for the rempah in a food processor and process into a paste then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Put the chicken, lemongrass, ginger, lime leaves, and chilli into a saucepan and pour in water to over."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boild, then reduce to a simmer."
    },
    {
      "@type": "HowToStep",
      "text": "Continue to simmer for 1 hour."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the chicken, discard the skin and tear the meat into shreds, then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Strain the stock into a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Heat some oil in a wok and stir in the rempah. Cook for 1-2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the stock. Stir well and season."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the noodles into the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Add the hard boiled eggs, beansprouts, and shredded chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Ladle in the stock."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with coriander."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with limes, chilli oil and soy sauce on the side."
    }
  ],
  "keywords": [
    "Soup",
    "poultry",
    "chicken"
  ]
}
