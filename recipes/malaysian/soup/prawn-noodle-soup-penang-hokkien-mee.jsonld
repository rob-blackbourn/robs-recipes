{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Prawn Noodle Soup - Penang Hokkien Mee",
  "recipeYield": "6 servings",
  "prepTime": "PT20M",
  "recipeIngredient": [
    "3 tbsp dried shrimp,",
    "1 dried red chilli,",
    "50 g fresh root ginger (peeled and sliced),",
    "2 onions (quartered),",
    "4 cloves of garlic (bruised),",
    "2 lemongrass stalks (bruised),",
    "1/2 tsp black peppercorns,",
    "2-3 tbsp dark soy sauce,",
    "700 g pork and chicken bones (or pork ribs and chicken wings),",
    "Heads and shells of prawns.",
    "1 tbsp sugar,",
    "6 rashers sliced bacon (or cubed pork belly),",
    "150 g fresh egg noodles,",
    "20 large prawns (peeled, reserving shells for stock),",
    "90 g beansprouts,",
    "2 spring onions (trimmed and finely sliced),",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the stock ingredients into a deep pan along with the prawn shells."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in 2 l of water and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat and simmer gently, uncovered, for about 2 hours, until the stock has reduced by half."
    },
    {
      "@type": "HowToStep",
      "text": "Strain the stock into a fresh pan and put on a low heat to keep warm."
    },
    {
      "@type": "HowToStep",
      "text": "Season the stock with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "In a small pan heat the sugar with 15 ml of water until it turns rich and brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sugar to the stock and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "In a heavy pan deep fry the bacon or pork belly and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Using a perforated ladle of sieve, plunge the noodles into the hot stock for 1 minute to heat through."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the noodles and divide into the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prawns to the stock and cook for 1 minute, then remove with a slotted spoon and divide between the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beansprouts to the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Ladle the stock into the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with bacon and spring onions."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 2 1/4 hours"
    },
    {
      "@type": "Comment",
      "text": "Status: Untried"
    },
    {
      "@type": "Comment",
      "text": "Original yield: 4-6"
    }
  ],
  "cookTime": "PT2H15M",
  "keywords": [
    "Soup"
  ]
}
