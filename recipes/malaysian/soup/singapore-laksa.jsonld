{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Singapore Laksa",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "8 shallots (chopped) (For the spice paste)",
    "4 cloves of garlic (chopped)",
    "40 g fresh root ginger (peeled and chopped)",
    "2 stalks of lemongrass (chopped)",
    "6 candlenut or macadamia nuts",
    "4 dried red chilies (soaked until soft and deseed)",
    "2 tbsp dried shrimp (soaked until soft)",
    "1-2 tsp belacon (Malaysian shrimp paste)",
    "1-2 tsp sugar",
    "1 tbsp vegetable oil",
    "6 shallots (finely sliced) (For the laksa)",
    "600 ml coconut milk",
    "400 ml chicken stock",
    "90 g prawn (peeled)",
    "90 g shrimp (cleaned, trimmed and sliced)",
    "6-8 scallops",
    "75 g cockles (shelled)",
    "225 g rice noodles or dried rice vermicelli (soaked in luke warm water until pliable)",
    "90 g beansprouts",
    "Salt and pepper for seasoning",
    "A small bunch of Vietnamese mint of fresh garden mint (roughly chopped)",
    "Chilli oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Make the spice paste."
    },
    {
      "@type": "HowToStep",
      "text": "Put all the spice paste ingredients except the oil into a food processor and process."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oil and process into a paste, then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry the shallots and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "In a wok, fry the spice paste in a little oil on a low heat for 3-4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the coconut milk and chicken stock and bring to the boil, stirring continually."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prawns, squid, and scallops, and simmer gently for 5-10 minutes until cooked."
    },
    {
      "@type": "HowToStep",
      "text": "At the last minute add the cockles and season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Ladle the noodles into bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beansprouts."
    },
    {
      "@type": "HowToStep",
      "text": "Add the soup."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with crispy shallots, mint, and a drizzle of chilli oil."
    }
  ],
  "keywords": [
    "Soup",
    "seafood",
    "scallops",
    "prawns",
    "shrimp"
  ]
}
