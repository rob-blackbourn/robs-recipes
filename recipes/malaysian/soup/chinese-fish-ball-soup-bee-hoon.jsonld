{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Chinese Fish Ball Soup - Bee Hoon",
  "recipeYield": "6 servings",
  "prepTime": "PT20M",
  "cookTime": "PT10M",
  "recipeIngredient": [
    "450g white fish fillets (haddock, cod, bream - boned and flaked),",
    "1 - 2 tbsp rice flour,",
    "Salt and pepper for seasoning",
    "1 ½ l fish or chicken stock,",
    "1 - 2 tbsp light soy sauce,",
    "4-6 mustard green leaves (chopped),",
    "90 g mung bean thread noodles (soaked in hot water until soft).",
    "For the garnish",
    "2 spring onions,",
    "1 red or green chilli,",
    "Fresh coriander leaves (chopped)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Bring the stock to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile make the fish balls."
    },
    {
      "@type": "HowToStep",
      "text": "Grind the flaked fish into a paste using a mortar and pestle or a food processor."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in 4 tbsp water."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle with rice flour and mould into balls."
    },
    {
      "@type": "HowToStep",
      "text": "Season stock and add fish balls, simmering for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the shredded mustard greens and simmer for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the noodles between the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Put the fish balls and soup into the bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with spring onions, chilli, and chopped coriander."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4-6"
    }
  ],
  "keywords": [
    "Soup"
  ]
}
