{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Fried Hard Boiled Eggs in Hot Red Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "8 shelled hard boiled eggs",
    "1 stalk of lemongrass (trimmed quartered and crushed)",
    "2 large tomatoes (skinned, seeded, and chopped to a pulp)",
    "1-2 tsp sugar",
    "2 tbsp dark soy sauce",
    "1 lime (juiced)",
    "1 sprig of fresh coriander (coarsely chopped)",
    "1 sprig mint (coarsely chopped)",
    "For the rempah",
    "4-6 red chilies (seeded and chopped)",
    "4 shallots (chopped)",
    "2 cloves of garlic (chopped)",
    "1/2 tsp shrimp paste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Process the rempah into a smooth paste."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry the eggs until golden brown."
    },
    {
      "@type": "HowToStep",
      "text": "Put some oil in a wok and fry the rempah until it becomes fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Add the lemongrass, tomatoes, and sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Cook for 2-3 minutes until it becomes a thick paste."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the soy sauce and lime juice."
    },
    {
      "@type": "HowToStep",
      "text": "Add up to 2 tbsp water to thin the sauce then add the eggs and toss until coated."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with chopped coriander and mint."
    }
  ],
  "keywords": [
    "Snacks"
  ]
}
