{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Rendang Ayam Negeri Sembilan",
  "recipeYield": "6 servings",
  "prepTime": "PT20M",
  "cookTime": "PT45M",
  "recipeIngredient": [
    "1 chicken (about 1.5 kg, cut into bite sized pieces)",
    "1 tsp salt",
    "12 shallots (peeled and sliced)",
    "6 cloves of garlic (peeled and sliced)",
    "2 stalks of lemongrass (lightly crushed)",
    "1 l coconut cream",
    "2 leaves of turmeric",
    "4 tbsp grated coconut",
    "20 dried chillies (soaked)",
    "20 birds eye chillies",
    "1” piece of ginger (peeled)",
    "1” piece of galangal (peeled)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Into a mixing bowl put chicken, 1 tsp salt, shallots, garlic lemongrass and group ingredients. Mix well and leave for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the marinated meat to a pot and add coconut cream. Bring to a slow boil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the turmeric leaves and simmer gently until the gravy is thick."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in kerisik and salt to taste, then simmer until chicken is tender and very little gravy remains."
    }
  ],
  "keywords": [
    "Meat Curry",
    "poultry",
    "chicken"
  ]
}
