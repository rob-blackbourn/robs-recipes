{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Spiced Fish Cakes in Banana Leaves - Ikan Otakotak",
  "recipeCuisine": "Malaysia",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "4 shallots (chopped)",
    "1 stalk lemongrass (trimmed and chopped)",
    "25 g galangal (chopped)",
    "4 candlenuts or macadamia nuts (roasted)",
    "4 dried red chillies (soaked in warm water until soft, squeezed dry and de-seeded)",
    "1 tsp shrimp paste",
    "1 tsp ground turmeric",
    "250 ml coconut cream",
    "1 tbsp dark soy sauce",
    "2 tsp palm sugar",
    "450 g fresh mackerel (cleaned skinned and flaked)",
    "4 kaffir lime leaves (finely shredded)",
    "2 eggs (lightly beaten)",
    "12 banana leaves cut into pieces about 20 cm square",
    "2 limes (quartered lengthwise and chilli or peanut sambal, to serve)",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Using a pestle and mortar or a food processor make a paste from the shallots, lemongrass, galangal, nuts, and chillies."
    },
    {
      "@type": "HowToStep",
      "text": "Beat in the shrimp paste and turmeric."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the coconut cream, soy sauce, and sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Put the flaked fish and lime leaves in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the spiced coconut cream and the beaten eggs, and season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Lay a square of banana leaf on a flat surface. Place 2 tbsp of fish mixture just off centre and fold the sides of the leaf over the top, leaving a little room for expansion."
    },
    {
      "@type": "HowToStep",
      "text": "Secure the package with a cocktail stick."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200°C and bake the fish cakes for 30 minutes or grill them for 15 minutes on each side."
    }
  ],
  "keywords": [
    "fish",
    "mackerel"
  ]
}
