{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Portugal",
  "name": "Salt Cod, Onions and Potatoes (Bacalhau A Gomes De Sa)",
  "cookTime": "PT45M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "175 g salt cod, 111g",
    "olive oil",
    "1 onion (thinly sliced)",
    "2 cloves garlic",
    "Salt and pepper for seasoning",
    "250 g waxy potatoes (sliced 6 mm thick and cooked until tender)",
    "2 hard-boiled eggs",
    "4 black olives",
    "1/2 tbsp parsley leaves (finely chopped)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the cod in cold water to cover for 24 to 36 hours, changing the water occasionally, drain."
    },
    {
      "@type": "HowToStep",
      "text": "Flake the cod into small pieces, removing any bones. Set aside."
    },
    {
      "@type": "HowToStep",
      "text": "In a large saute pan, over medium heat, add 1/4 cup of the oil. When the oil is hot, add the onions and the garlic. Season with salt and pepper. Saute until lightly golden, about 6 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 176.7°C."
    },
    {
      "@type": "HowToStep",
      "text": "Grease a medium ovenproof casserole dish with 1 teaspoon of olive oil. Season the potatoes with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Spread half of the potatoes over the bottom of the prepared dish. Sprinkle half of the salt cod over the potatoes. Place half of the onion mixture over the salt cod. Top the onion mixture with more salt cod. Place another layer of potatoes over the top of the cod. Drizzle the entire pan with the remaining 1/4 cup of oil."
    },
    {
      "@type": "HowToStep",
      "text": "Place in the oven and bake for 30 to 40 minutes, or until golden."
    },
    {
      "@type": "HowToStep",
      "text": "Place on a serving platter. Garnish with the sliced eggs, olives, and parsley."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 1 day soaking"
    }
  ],
  "prepTime": "PT20M"
}
