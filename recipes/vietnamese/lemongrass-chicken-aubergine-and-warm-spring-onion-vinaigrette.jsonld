{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Vietnam",
  "name": "Lemongrass Chicken, Aubergine, and Warm Spring Onion Vinaigrette",
  "prepTime": "PT30M",
  "cookTime": "PT30M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "4 chicken thighs, skinless and boneless",
    "4 tbsp chopped lemongrass (very finely chop the bottom part of the",
    "lemongrass)",
    "2 tbsp vegetable oil",
    "1 tsp fish sauce (For the chicken thighs)",
    "35g dark palm sugar",
    "2 tbsp fish sauce (For the fish caramel sauce)",
    "For the smoky aubergine",
    "1 Japanese long aubergine",
    "10g finely chopped shallot",
    "1 tbsp chopped spring onion (green part only)",
    "1 shallot, sliced into rings",
    "sea salt",
    "75g pickling liquor (equal quantities of caster sugar and water,",
    "flavoured with a smashed garlic clove)",
    "75g Vietnamese chilli paste",
    "To serve",
    "2 lime leaves, thinly sliced",
    "Jasmine rice, to serve"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the chicken thighs, put the chicken in a bowl and add half the lemongrass and oil, and all the fish sauce. Leave to marinade for 20 minutes, or longer if convenient."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200°C."
    },
    {
      "@type": "HowToStep",
      "text": "For the fish caramel sauce, heat a flameproof casserole. Add a tablespoon of water and the palm sugar. Cook over a low heat until the sugar has dissolved and the mixture has a syrup-like consistency."
    },
    {
      "@type": "HowToStep",
      "text": "Set aside to cool for two minutes, then add the fish sauce and marinated chicken. Return to the heat and cook for 5-8 minutes. Transfer to the oven to finish."
    },
    {
      "@type": "HowToStep",
      "text": "For the smoky aubergine, heat a deep-fat fryer to 180°C. (CAUTION: hot oil can be dangerous. Do not leave unattended.)"
    },
    {
      "@type": "HowToStep",
      "text": "Pierce the aubergines all over with a fork and place over an open flame until it is blistered and burnt all over and tender inside. Set aside to cool a little."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, for the spring onion vinaigrette place all the ingredients in a pan with 460ml water. Heat gently."
    },
    {
      "@type": "HowToStep",
      "text": "For the smoky aubergine, add then finely chopped shallot and spring onions to the spring onion vinaigrette."
    },
    {
      "@type": "HowToStep",
      "text": "Place the shallot rings in the deep fat fryer and deep fry until crisp. Drain and place onto a plate lined with kitchen roll to drain."
    },
    {
      "@type": "HowToStep",
      "text": "To finish, top and tail the aubergine then slice it down the middle lengthwise. Scoop out the tender flesh from the burnt skin and divide between serving plates. Use scissors to cut it into bite-sized pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Take the spring onions out of the vinaigrette and drain them, reserving the vinaigrette for dressing."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with the blanched spring onions, crisp shallots and lime leaves. Dress with the vinaigrette. Serve the chicken in the casserole with jasmine rice."
    }
  ]
}
