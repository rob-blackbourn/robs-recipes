      "@type": "HowToStep",
      "text": "Pour in the stock and simmer to reduce it."
    },
    {
      "@type": "HowToStep",
      "text": "Add the noodles and toss them around in the wok for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the carrot and cabbage."
    },
    {
      "@type": "HowToStep",
