{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Malaysia",
  "name": "Singapore Laksa",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "For the spice paste: 8 shallots (chopped),",
    "For the spice paste: 4 cloves of garlic (chopped),",
    "For the spice paste: 40 g fresh root ginger (peeled and chopped),",
    "For the spice paste: 2 stalks of lemongrass (chopped),",
    "For the spice paste: 6 candlenut or macadamia nuts,",
    "For the spice paste: 4 dried red chilies (soaked until soft and deseed),",
    "For the spice paste: 2 tbsp dried shrimp (soaked until soft),",
    "For the spice paste: 1-2 tsp belacon (Malaysian shrimp paste),",
    "For the spice paste: 1-2 tsp sugar,",
    "For the spice paste: 1 tbsp vegetable oil.",
    "For the laksa: 6 shallots (finely sliced),",
    "For the laksa: 600 ml coconut milk,",
    "For the laksa: 400 ml chicken stock,",
    "For the laksa: 90 g prawn (peeled),",
    "For the laksa: 90 g shrimp (cleaned, trimmed and sliced),",
    "For the laksa: 6-8 scallops,",
    "For the laksa: 75 g cockles (shelled),",
    "For the laksa: 225 g rice noodles or dried rice vermicelli (soaked in luke warm water until pliable),",
    "For the laksa: 90 g beansprouts,",
    "For the laksa: Salt and freshly ground black pepper,",
    "For the laksa: A small bunch of Vietnamese mint of fresh garden mint (roughly chopped),",
    "For the laksa: Chilli oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Make the spice paste."
    },
    {
      "@type": "HowToStep",
      "text": "Put all the spice paste ingredients except the oil into a food processor and process."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oil and process into a paste, then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry the shallots and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "In a wok, fry the spice paste in a little oil on a low heat for 3-4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the coconut milk and chicken stock and bring to the boil, stirring continually."
    },
    {
      "@type": "HowToStep",
      "text": "Add the prawns, squid, and scallops, and simmer gently for 5-10 minutes until cooked."
    },
    {
      "@type": "HowToStep",
      "text": "At the last minute add the cockles and season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Ladle the noodles into bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beansprouts."
    },
    {
      "@type": "HowToStep",
      "text": "Add the soup."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with crispy shallots, mint, and a drizzle of chilli oil."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4-6"
    }
  ]
}
