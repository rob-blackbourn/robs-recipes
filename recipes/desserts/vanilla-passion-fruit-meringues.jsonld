{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Vanilla & Passion Fruit Meringues",
  "prepTime": "PT20M",
  "recipeYield": "6 meringues",
  "recipeIngredient": [
    "1 vanilla pod",
    "4 egg whites",
    "100 g caster sugar",
    "4 tbsp passion fruit seeds (approx 2 medium fruits)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 90°C."
    },
    {
      "@type": "HowToStep",
      "text": "Split the vanilla pod lengthwise and scrape out the seeds. Set the seeds aside."
    },
    {
      "@type": "HowToStep",
      "text": "Follow the preparation for classic meringues."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 1 1/2 hours"
    }
  ],
  "cookTime": "PT1H30M",
  "keywords": [
    "Desserts"
  ]
}
