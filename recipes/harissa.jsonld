{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Harissa",
  "prepTime": "PT10M",
  "totalTime": "PT10M",
  "recipeYield": "150 g",
  "recipeIngredient": [
    "12 dried red chili peppers",
    "3 cloves garlic",
    "1 tsp salt, or to taste",
    "1 tsp ground cumin (optional)",
    "1/2 tsp ground coriander seeds (optional)",
    "1/2 tsp ground caraway seeds (optional)",
    "2 tsp lemon juice",
    "Olive oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Remove the seeds from the dried chili peppers and place them in a bowl. Cover them with very hot water and leave to soften for 30 minutes to an hour."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the chili peppers, and gently squeeze out excess water with a paper towel. Using a mortar and pestle (or a blender or mini food processor) grind the chili peppers, garlic, salt and spices to a paste. Add the lemon juice and just enough olive oil to moisten the harissa, or add additional olive oil to thin it."
    },
    {
      "@type": "HowToStep",
      "text": "Store unused harissa in an airtight container in the fridge. For long storage, lightly top the harissa with a little oil before covering."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Status: Untried"
    },
    {
      "@type": "Comment",
      "text": "For 150 g yield the chillies should weigh 100 g which is usually 12 to 15 chillies."
    }
  ]
}
