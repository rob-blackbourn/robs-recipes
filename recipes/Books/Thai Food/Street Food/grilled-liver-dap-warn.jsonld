{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Grilled Liver (dap warn)",
  "text": "Grilled Liver (dap warn)\n\nPreparation time:\n\nCooking time:\n\nYield:\n\nIngredients\n\n200g calves liver,\n\n1/2 - 1 tsp roasted chilli powder,\n\n2 tbsp lime juice,\n\n1 tbsp fish sauce,\n\nhandful of mint leaves,\n\nhandful of holy basil leaves (optional),\n\n2 tbsp chopped spring onion,\n\n1 tbsp ground roasted rice.\n\nPreparation\n\n1. Clean the liver and cut into 1/2cm slices.\n\n2. Dip in and out of simmering water until just cooked.\n\n3. Combine chilli with lime juice and fish sauce.\n\n4. Dress the liver with the mixture and add the remaining ingredients.",
  "recipeIngredient": [
    "200g calves liver,",
    "1/2 - 1 tsp roasted chilli powder,",
    "2 tbsp lime juice,",
    "1 tbsp fish sauce,",
    "handful of mint leaves,",
    "handful of holy basil leaves (optional),",
    "2 tbsp chopped spring onion,",
    "1 tbsp ground roasted rice."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Clean the liver and cut into 1/2cm slices."
    },
    {
      "@type": "HowToStep",
      "text": "Dip in and out of simmering water until just cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Combine chilli with lime juice and fish sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Dress the liver with the mixture and add the remaining ingredients."
    }
  ]
}
