{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Crème anglaise",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "150ml / 51⁄2 fl oz whole milk,",
    "150ml / 51⁄2 fl oz double cream,",
    "1 vanilla pod (split lengthways, seeds scraped out),",
    "2 large egg yolks,",
    "3 tbsp caster sugar,",
    "1 orange (zest only)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the crème anglaise, place the milk, double cream, vanilla pod and seeds into a non-stick saucepan and heat until just boiling."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, whisk together the egg yolks and caster sugar, until light and fluffy."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the vanilla pod from the warm milk and cream mixture and gradually add the milk to the beaten eggs and sugar, whisking continuously."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the mixture back into the saucepan and heat, whisking continuously, for a further two minutes, or until the custard has thickened slightly."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the heat and stir in the orange zest."
    }
  ],
  "keywords": [
    "Desserts"
  ]
}
