  "recipeCuisine": "Lebanon",
  "name": "Stuffed Bell Peppers in Olive Oil",
  "text": "Stuffed Bell Peppers in Olive Oil\n\nCooking time: 50 minutes\n\nPreparation time: 30 minutes\n\nYield: 4\n\nIngredients\n\n4 colourful peppers\n\n3 tbsp olive oil,\n\nJuice of 1 lemon,\n\n2 tsp granulated sugar,\n\nPomegranate syrup or molasses for drizzling,\n\nLemon wedges to serve\n\nFor the stuffing\n\n2 tbsp olive oil,\n\n1 red onion finely chopped,\n\n1 tsp granulated sugar,\n\n2 tbsp pine nuts,\n\n2 tbsp tiny currants soaked in boiling water for 10 minutes then drained,\n\n2 tsp ground cinnamon,\n\n1 tsp allspice,\n\n1 tsp dried mint,\n\n1 tsp tomato puree,\n\n200g short grain or risotto rice (washed and drained)\n\nSalt & pepper,\n\nSmall bunch flat leaf parsley (finely chopped),\n\nSmall bunch dill (finely chopped),\n\nSmall bunch mint (finely chopped).\n\nPreparation\n\nPreheat the oven to 180C (gas 4)\n\nHeat the olive oil in a heavy based frying pan.\n\nStir in the onion and sugar for 2 minutes\n\nStir in the pine nuts until they turn golden.\n\nStir in the currents until they plump up.\n\nAdd the cinnamon, allspice, dried mint, and tomato puree, and stir in the rice to coat it with the mixture.\n\nPour in 400ml of water\n\nSeason with salt and pepper and bring to the boil.\n\nReduce the heat and cook gently for 15 minutes (until the water is absorbed, but the rice is still firm).\n\nToss in the fresh herbs.\n\nSlice the stalk end off each pepper and remove the core and seeds.\n\nFill the peppers with the rice mixture.\n\nPut in a shallow baking dish\n\nIn a bowl mix together the olive oil and lemon juice with 50ml water and 2 tsp sugar.\n\nPour the mixture over and around the peppers\n\nPut in the preheated oven for 50 minutes, basting from time to time, until they are tender and the liquid is caramelized.\n\nEither eat hot or leave to cool.\n\nServe with a little of the cooking syrup drizzled over and a little for the pomegranate syrup or molasses.",
  "cookTime": "PT50M",
  "prepTime": "PT30M",
  "recipeYield": "4",
  "recipeIngredient": [
    "4 colourful peppers",
    "3 tbsp olive oil,",
    "Juice of 1 lemon,",
    "2 tsp granulated sugar,",
    "Pomegranate syrup or molasses for drizzling,",
    "Lemon wedges to serve",
    "For the stuffing: 2 tbsp olive oil,",
    "For the stuffing: 1 red onion finely chopped,",
    "For the stuffing: 1 tsp granulated sugar,",
    "For the stuffing: 2 tbsp pine nuts,",
    "For the stuffing: 2 tbsp tiny currants soaked in boiling water for 10 minutes then drained,",
    "For the stuffing: 2 tsp ground cinnamon,",
    "For the stuffing: 1 tsp allspice,",
    "For the stuffing: 1 tsp dried mint,",
    "For the stuffing: 1 tsp tomato puree,",
    "For the stuffing: 200g short grain or risotto rice (washed and drained)",
    "For the stuffing: Salt & pepper,",
    "For the stuffing: Small bunch flat leaf parsley (finely chopped),",
    "For the stuffing: Small bunch dill (finely chopped),",
    "For the stuffing: Small bunch mint (finely chopped)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 180C (gas 4)"
    },
    {
      "@type": "HowToStep",
      "text": "Heat the olive oil in a heavy based frying pan."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the onion and sugar for 2 minutes"
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the pine nuts until they turn golden."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the currents until they plump up."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cinnamon, allspice, dried mint, and tomato puree, and stir in the rice to coat it with the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in 400ml of water"
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat and cook gently for 15 minutes (until the water is absorbed, but the rice is still firm)."
    },
    {
      "@type": "HowToStep",
      "text": "Toss in the fresh herbs."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the stalk end off each pepper and remove the core and seeds."
    },
    {
      "@type": "HowToStep",
      "text": "Fill the peppers with the rice mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Put in a shallow baking dish"
    },
    {
      "@type": "HowToStep",
      "text": "In a bowl mix together the olive oil and lemon juice with 50ml water and 2 tsp sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the mixture over and around the peppers"
    },
    {
      "@type": "HowToStep",
      "text": "Put in the preheated oven for 50 minutes, basting from time to time, until they are tender and the liquid is caramelized."
    },
    {
      "@type": "HowToStep",
      "text": "Either eat hot or leave to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with a little of the cooking syrup drizzled over and a little for the pomegranate syrup or molasses."
    }
  ]
