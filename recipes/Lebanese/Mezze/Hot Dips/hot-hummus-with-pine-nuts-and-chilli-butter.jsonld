{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Lebanon",
  "name": "Hot Hummus with Pine Nuts and Chilli Butter",
  "text": "Hot Hummus with Pine Nuts and Chilli Butter\n\nCooking time: 25 minutes\n\nPreparation time: 10 minutes\n\nYield: 2\n\nIngredients\n\n400g can chickpeas drained and thoroughly rinsed,\n\n1 tsp cumin seeds,\n\n1 cloves garlic,\n\n2 tbsp olive oil,\n\n1 lemons (juice of),\n\n1 tbsp tahini,\n\n150ml thick creamy yogurt,\n\nSalt & pepper,\n\n1 tbsp pine nuts,\n\n25g butter,\n\n1/2 tsp finely chopped dried red chilli (or chilli flakes).\n\nPreparation\n\nPreheat the oven to 200C (gas 6),\n\nInto a food processor add the chickpeas, cumin seeds, crushed garlic, olive oil and lemon juice and process to a thick paste.\n\nAdd the tahini and continue to blend until the mixture is smooth.\n\nAdd the yogurt and process until the mixture has loosened and the texture is creamy.\n\nSeason generously with salt and pepper and put into an oven proof dish.\n\nRoast the pine nuts in a small frying pan until they turn golden and smell nutty.\n\nAdd the butter to the pine nuts and stir until it melts,\n\nStir in the chilli flakes and pour the liquid over the hummus, scattering the pine nuts over the top.\n\nPut into the pre heated oven for 25 minutes, until the hummus has risen a little and the butter is absorbed.\n\nServe immediately with bread.",
  "cookTime": "PT25M",
  "prepTime": "PT10M",
  "recipeYield": "2",
  "recipeIngredient": [
    "400g can chickpeas drained and thoroughly rinsed,",
    "1 tsp cumin seeds,",
    "1 cloves garlic,",
    "2 tbsp olive oil,",
    "1 lemons (juice of),",
    "1 tbsp tahini,",
    "150ml thick creamy yogurt,",
    "Salt & pepper,",
    "1 tbsp pine nuts,",
    "25g butter,",
    "1/2 tsp finely chopped dried red chilli (or chilli flakes)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200C (gas 6),"
    },
    {
      "@type": "HowToStep",
      "text": "Into a food processor add the chickpeas, cumin seeds, crushed garlic, olive oil and lemon juice and process to a thick paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tahini and continue to blend until the mixture is smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add the yogurt and process until the mixture has loosened and the texture is creamy."
    },
    {
      "@type": "HowToStep",
      "text": "Season generously with salt and pepper and put into an oven proof dish."
    },
    {
      "@type": "HowToStep",
      "text": "Roast the pine nuts in a small frying pan until they turn golden and smell nutty."
    },
    {
      "@type": "HowToStep",
      "text": "Add the butter to the pine nuts and stir until it melts,"
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the chilli flakes and pour the liquid over the hummus, scattering the pine nuts over the top."
    },
    {
      "@type": "HowToStep",
      "text": "Put into the pre heated oven for 25 minutes, until the hummus has risen a little and the butter is absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Serve immediately with bread."
    }
  ]
}
