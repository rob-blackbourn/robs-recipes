{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Duck Spring Rolls",
  "recipeCuisine": "China",
  "recipeCategory": "Starter",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "500g beansprouts",
    "500g cabbage (shredded)",
    "500g green beans (cut diagonally)",
    "1 carrot (thinly sliced)",
    "2 stalks of chopped celery",
    "4 cloves minced garlic",
    "1/2 onion (finely chopped)",
    "500g roast duck (shredded)",
    "1 egg white",
    "Black pepper",
    "Soy sauce",
    "Olive oil",
    "Spring roll wrappers"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put oil into the wok."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic and fry till golden."
    },
    {
      "@type": "HowToStep",
      "text": "Add the minced onion and fry until golden."
    },
    {
      "@type": "HowToStep",
      "text": "Add the meat and mix."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beans."
    },
    {
      "@type": "HowToStep",
      "text": "Add the carrot."
    },
    {
      "@type": "HowToStep",
      "text": "Add the celery."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cabbage."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beansprouts."
    },
    {
      "@type": "HowToStep",
      "text": "Let warm through for a minute."
    },
    {
      "@type": "HowToStep",
      "text": "Add soy sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Season with pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Put the mixture into a strainer and let it cool."
    },
    {
      "@type": "HowToStep",
      "text": "When the filling is cool"
    }
  ],
  "keywords": [
    "poultry",
    "duck"
  ]
}
