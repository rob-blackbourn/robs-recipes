{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Red Cooked Wild Boar",
  "prepTime": "PT20M",
  "cookTime": "PT1H30M",
  "recipeCuisine": "China",
  "recipeCategory": "Main",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "1.5 kg wild boar (diced)",
    "6 tbsp dark soy sauce",
    "10 tbsp Sunflower oil",
    "6 tbsp of water",
    "2 tbsp sugar",
    "4 tbsp Chinese rice wine or dry sherry",
    "25 g fresh ginger (peeled and finely grated)",
    "5-6 x 5mm dried Chinese tangerine peel",
    "2.5 cm cinnamon stick",
    "4 cloves garlic",
    "2 star anis",
    "1/2 tsp Sichuan peppercorn (dry roasted and grounded)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put diced wild boar into bowl with soy sauce, mix well together and rest for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 160°C. Heat the oil in a medium sized oven-proof casserole dish to 190°C."
    },
    {
      "@type": "HowToStep",
      "text": "Lift wild boar out of soy sauce and deep fry in batches, turning until nicely brown."
    },
    {
      "@type": "HowToStep",
      "text": "Discard the cooking oil, return the wild boar to the casserole dish and add the remaining soy sauce and all the other ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Cover with a well fitting lid and cook in the oven for 1 1/2 hours, until the meat is really tender."
    }
  ],
  "keywords": [
    "meat",
    "pork"
  ]
}
