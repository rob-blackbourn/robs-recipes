  "recipeCuisine": "United Kingdom",
  "name": "Roast Lamb",
  "text": "Roast Lamb\n\nPreparation time: 10 minutes\n\nYield: 4\n\nIngredients\n\n1.75 kg half leg,\n\n2 cloves garlic,\n\n6 anchovy fillets,\n\n4 sprigs rosemary,\n\nsalt and pepper.\n\nPreparation\n\n1. Preheat the oven to 190C/Gas 5.\n\n2. Stud the lamb with slices of garlic, rosemary, and anchovy fillets.\n\n3. Put in the oven for 20 mins per 500g plus 20 mins, or until the internal temperature has reached 52C for rare, 60C for medium, 75C for rare.",
  "prepTime": "PT10M",
  "cookTime": "PT1H30M",
  "recipeYield": "4",
  "recipeIngredient": [
    "1.75 kg half leg,",
    "2 cloves garlic,",
    "6 anchovy fillets,",
    "4 sprigs rosemary,",
    "salt and pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 190°C."
    },
    {
      "@type": "HowToStep",
      "text": "Stud the lamb with slices of garlic, rosemary, and anchovy fillets."
    },
    {
      "@type": "HowToStep",
      "text": "Put in the oven for 20 mins per 500g plus 20 mins, or until the internal temperature has reached 52°C for rare, 60°C for medium, 75°C for rare."
    }
  ]
}
