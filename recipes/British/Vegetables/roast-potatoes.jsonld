{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Roast Potatoes",
  "text": "Roast Potatoes\n\nPreparation time: 10 minutes\n\nCooking time: 1 hour\n\nYield: 2\n\nIngredients\n\n2 tbsp fat (preferably duck fat),\n\n2 medium size potatoes (Maris Piper or King Edward),\n\n2 cloves of garlic,\n\n1 sprig thyme,\n\nsemolina flour,\n\nsalt.\n\nPreparation\n\n1. Preheat the oven to 190C/375F/Gas 5.\n\n2. Parboil the potatoes for 8 minutes.\n\n3. Drain, and shake until slightly rough on the outside.\n\n4. Dust with semolina flour.\n\n5. Put the fat in the baking tray, and leave in the oven for 5 minutes.\n\n6. Roast for 45 minutes to 1 hour, basting occasionally.",
  "prepTime": "PT10M",
  "cookTime": "PT1H",
  "recipeYield": "2",
  "recipeIngredient": [
    "2 tbsp fat (preferably duck fat),",
    "2 medium size potatoes (Maris Piper or King Edward),",
    "2 cloves of garlic,",
    "1 sprig thyme,",
    "semolina flour,",
    "salt."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 190C/375F/Gas 5."
    },
    {
      "@type": "HowToStep",
      "text": "Parboil the potatoes for 8 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Drain, and shake until slightly rough on the outside."
    },
    {
      "@type": "HowToStep",
      "text": "Dust with semolina flour."
    },
    {
      "@type": "HowToStep",
      "text": "Put the fat in the baking tray, and leave in the oven for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Roast for 45 minutes to 1 hour, basting occasionally."
    }
  ]
}
