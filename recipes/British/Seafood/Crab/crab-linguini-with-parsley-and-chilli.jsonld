    "1/2 tbsp chopped parsley,",
    "3/4 tbsp lemon juice,",
    "25 ml extra virgin olive oil,",
    "pinch dried chilli flakes,",
    "1/2 finely chopped clove of garlic."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Cook the pasta in a large pan of salted boiling water."
    },
    {
      "@type": "HowToStep",
      "text": "2. Put the remaining ingredients into a small pan and warm through."
    },
    {
      "@type": "HowToStep",
      "text": "3. Drain the pasta and mix with the sauce."
    }
  ]
