{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Arbroath Smokie Kedgeree With Grilled Haddock & Grain Mustard Cream Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 onion (diced),",
    "1 tsp garlic purée,",
    "250g butter,",
    "1kg Arborio rice,",
    "500ml white wine,",
    "2l fish stock,",
    "250g Parmesan (grated),",
    "200ml cream,",
    "2 flaked Arbroath Smokies 1 pkt,",
    "dill (finely chopped),",
    "Salt and pepper.",
    "For the grain mustard sauce: 570ml cream",
    "For the grain mustard sauce: 570ml fish stock,",
    "For the grain mustard sauce: 2 tbsp coarse grain mustard,",
    "For the grain mustard sauce: Juice of 1 lemon,",
    "For the grain mustard sauce: Salt and pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sweat onion and garlic in half the butter. • Add rice and sweat for 2 minutes.• Add wine and stock bit by bit."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to boil, reduce heat."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer for 15 minutes or so, until liquid is absorbed and rice is cooked."
    },
    {
      "@type": "HowToStep",
      "text": "Add flaked Smokies, then add rest of butter, cream, Parmesan and dill."
    },
    {
      "@type": "HowToStep",
      "text": "Stir until all combined and butter melted."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste."
    },
    {
      "@type": "HowToSection",
      "name": "For the sauce",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Place cream, stock, lemon juice and mustard in pan."
        },
        {
          "@type": "HowToStep",
          "text": "Bring to boil and reduce until coats the back of a spoon, season to taste."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "For The Haddock",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Place portion of haddock on tray, season with salt, drizzle with fresh squeezed lemon juice, place knob of butter on top. Grill until just cooked."
        },
        {
          "@type": "HowToStep",
          "text": "Assembly"
        },
        {
          "@type": "HowToStep",
          "text": "Spoon kedgeree onto centre of plate, place grilled haddock on top, top with soft poached egg and drizzle mustard cream sauce over the top and around plate."
        }
      ]
    }
  ],
  "keywords": [
    "Seafood",
    "Smoked Haddock"
  ]
}
