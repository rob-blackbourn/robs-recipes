{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Cullen Skink",
  "recipeIngredient": [
    "675g natural smoked haddock,",
    "180g leek chopped,",
    "60g onion chopped,",
    "675g potato cooked and diced,",
    "800ml milk,",
    "250ml double cream ,",
    "30g butter,",
    "2 dspn chopped parsley,",
    "Salt and cracked pepper,",
    "5g plain flour."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Trim off and remove any bones, cut fish into small chunks."
    },
    {
      "@type": "HowToStep",
      "text": "Chop and wash leek and onion."
    },
    {
      "@type": "HowToStep",
      "text": "Put butter in a large pan and sweat onion and leek."
    },
    {
      "@type": "HowToStep",
      "text": "Add flour, cook for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Slowly add milk and cream, then add smoked haddock chunks and cook on a gentle heat, DO NOT BOIL this will cause it to split."
    },
    {
      "@type": "HowToStep",
      "text": "Add cooked potato."
    },
    {
      "@type": "HowToStep",
      "text": "Finish off with parsley and salt & pepper to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with warm oatcakes or crusty bread."
    }
  ]
}
