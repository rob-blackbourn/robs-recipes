{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Rosti Fish Cakes",
  "text": "Rosti Fish Cakes\n\nPreparation time:\n\nCooking time:\n\nYield: 10 cakes\n\nIngredients\n\n500g waxy potatoes  (unpeeled weight),\n\n500g haddock fillets (cut into large chunks),\n\n15g chives (chopped),\n\n1 medium egg,\n\n2 tbsp sunflower oil\n\nPreparation\n\n1. Peel and coarsely grate the potatoes and pat dry with kitchen paper.\n\n2. Place the fish, chives and egg in a food processor with salt and pepper.\n\n3. Using the pulse button, process briefly until combined - do not overprocess or  you will have a gluey paste.\n\n4. Mix this with the potatoes then divide into 9–10 balls.\n\n5. Flatten out slightly and place on a kitchen paper-lined plate.\n\n6. Chill for one hour or so, then pat dry again.\n\n7. Heat the oil in a frying pan and, once very hot, brown the fishcakes for 3–4 minutes then turn and brown the other  side.\n\n8. Place them on a baking sheet and cook in a low oven (150 ̊C/300 ̊F/Gas 2) for about 30 minutes or until piping hot  and cooked through.\n\n9. Serve warm.",
  "recipeYield": "10 cakes",
  "recipeIngredient": [
    "500g waxy potatoes  (unpeeled weight),",
    "500g haddock fillets (cut into large chunks),",
    "15g chives (chopped),",
    "1 medium egg,",
    "2 tbsp sunflower oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Peel and coarsely grate the potatoes and pat dry with kitchen paper."
    },
    {
      "@type": "HowToStep",
      "text": "2. Place the fish, chives and egg in a food processor with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "3. Using the pulse button, process briefly until combined - do not overprocess or  you will have a gluey paste."
    },
    {
      "@type": "HowToStep",
      "text": "4. Mix this with the potatoes then divide into 9–10 balls."
    },
    {
      "@type": "HowToStep",
      "text": "5. Flatten out slightly and place on a kitchen paper-lined plate."
    },
    {
      "@type": "HowToStep",
      "text": "6. Chill for one hour or so, then pat dry again."
    },
    {
      "@type": "HowToStep",
      "text": "7. Heat the oil in a frying pan and, once very hot, brown the fishcakes for 3–4 minutes then turn and brown the other  side."
    },
    {
      "@type": "HowToStep",
      "text": "8. Place them on a baking sheet and cook in a low oven (150 ̊C/300 ̊F/Gas 2) for about 30 minutes or until piping hot  and cooked through."
    },
    {
      "@type": "HowToStep",
      "text": "9. Serve warm."
    }
  ]
}
