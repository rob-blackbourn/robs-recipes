{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Smoked Haddock Lasagne with Mustard Sauce",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1kg smoked haddock fillets,",
    "500ml milk and water mixed,",
    "300g fresh pasta lasagne sheets or 150g dried,",
    "400ml fish stock,",
    "100ml dry white wine,",
    "150ml double cream,",
    "1 tbsp coarse grain mustard,",
    "1 tbsp chopped fresh chives,",
    "200g wild mushrooms or chestnut mushrooms (sliced),",
    "2 tbsp olive oil,",
    "12–16 asparagus tips,",
    "150g baby spinach leaves (washed and dried),",
    "1 tbsp freshly grated Parmesan cheese,",
    "Sea salt and freshly ground pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Poach the haddock in simmering milk mixture to just cover fish for about 5 minutes until it starts to flake then drain. Skin, bone and flake the fish whilst it is still hot - it is easier. Set the flesh aside."
    },
    {
      "@type": "HowToStep",
      "text": "Blanch the pasta sheets in boiling salted water for just 2 minutes for fresh sheets; 4-5 for dried. Drain, rinse in cold water then pat dry with paper towel."
    },
    {
      "@type": "HowToStep",
      "text": "Boil the stock and wine until reduced by half to about 250ml then add the cream and boil for another 3 minutes. Stir in the mustard and chives and check the seasoning."
    },
    {
      "@type": "HowToStep",
      "text": "Sauté the mushrooms with the oil in a frying pan until just softened. Remove and drain. Peel the stems of the asparagus with a vegetable peeler, and then blanch for 2 minutes in boiling water. Drain."
    },
    {
      "@type": "HowToStep",
      "text": "Now you can put the lasagne together. First pre-heat the oven to 190°C. Lightly grease a medium size ovenproof dish."
    },
    {
      "@type": "HowToStep",
      "text": "Pour a little mustard sauce on the base of the dish and arrange pasta sheets on the sauce. Scatter over baby spinach leaves and a third of the fish and then a third of the mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "Trickle with a little more sauce and repeat the layers twice again – pasta, spinach, fish, mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "Arrange the blanched asparagus tips on top and pour over the last of the sauce. Sprinkle with the Parmesan then  bake for about 15 minutes until hot and bubbling. Allow to stand to about 10 minutes before serving."
    }
  ]
}
