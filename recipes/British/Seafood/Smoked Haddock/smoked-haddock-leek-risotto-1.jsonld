{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Smoked Haddock & Leek Risotto",
  "prepTime": "PT10M",
  "cookTime": "PT35M",
  "recipeYield": "4",
  "recipeIngredient": [
    "400g smoked haddock,",
    "olive oil,",
    "butter,",
    "4 young leeks (halved lengthwise and thinly sliced),",
    "300g arborio rice or carnaroli rice,",
    "1 glass dry white wine,",
    "1.5 l chicken stock,",
    "a small bunch of chives (snipped)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the haddock in a heatproof dish and just cover with boiling water. Cover with clingfilm and leave for 10 minutes. Flake into decent-sized chunks."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, heat 2 tbsp oil and a knob of butter in a wide shallow pan then add the leeks. Cook slowly for 10 minutes until completely softened."
    },
    {
      "@type": "HowToStep",
      "text": "Turn up the heat, add the rice and stir to coat the grains."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the wine and stir until absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Add the stock, a ladleful at a time, stirring each lot in, until the rice is just tender and creamy."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the haddock and chives and serve."
    }
  ]
}
