{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Chorizo, New Potato & Haddock One-Pot",
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 tbsp extra-virgin olive oil (plus extra to serve),",
    "50g chorizo (peeled and thinly sliced),",
    "450g salad or new potatoes (sliced),",
    "4 tbsp dry sherry,",
    "2 skinless thick fillets of haddock,",
    "good handful cherry tomatoes (halved),",
    "20g bunch parsley (chopped),",
    "crusty bread (to serve)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat a large lidded frying pan, then add the oil."
    },
    {
      "@type": "HowToStep",
      "text": "Tip in the chorizo, fry for 2 mins until it starts to release its oils."
    },
    {
      "@type": "HowToStep",
      "text": "Tip in the potatoes and season."
    },
    {
      "@type": "HowToStep",
      "text": "Splash over 3 tbsp Sherry, cover the pan tightly, then leave to cook for 10-15 mins stirring once until the potatoes are just tender."
    },
    {
      "@type": "HowToStep",
      "text": "Season the fish well."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cherry tomatoes and most of the chopped parsley to the pan, then lay the fish on top. Splash over 1 tbsp Sherry, put the lid on again, then leave to cook for 5 mins, or until the fish has turned white and is flaky when prodded in the middle."
    },
    {
      "@type": "HowToStep",
      "text": "Scatter the whole dish with a little more parsley and drizzle with more extra virgin oil."
    },
    {
      "@type": "HowToStep",
      "text": "Serve straight away with crusty bread."
    }
  ]
}
