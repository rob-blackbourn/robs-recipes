{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Baked Risotto of Smoked Haddock & Leek",
  "prepTime": "PT5M",
  "cookTime": "PT35M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "small knob of butter,",
    "1 large leek (thinly sliced),",
    "300 g risotto rice,",
    "700 ml fish or vegetable stock,",
    "250 ml full-fat milk,",
    "375 g smoked haddock (skinned and cut into large chunks),",
    "3 tbsp crème fraîche,",
    "100g baby spinach."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat oven to 200°C / 180°C fan."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the butter in a large ovenproof dish over a medium heat."
    },
    {
      "@type": "HowToStep",
      "text": "Cook the leek for 4-5 mins, stirring regularly, until just tender."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rice and stir for a further 2 mins."
    },
    {
      "@type": "HowToStep",
      "text": "Add the stock and milk, bring to the boil and bubble for 5 mins."
    },
    {
      "@type": "HowToStep",
      "text": "Put the haddock on top."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and bake in the oven for 18 mins until the rice is tender."
    },
    {
      "@type": "HowToStep",
      "text": "Fold in the crème fraîche and spinach, season with plenty of black pepper, then cover the pan again and leave to rest out of the oven for 3 mins to allow the spinach to soften."
    }
  ]
}
