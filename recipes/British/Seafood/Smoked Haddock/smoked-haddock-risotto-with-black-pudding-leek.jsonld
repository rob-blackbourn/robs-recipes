    "170g black pudding,",
    "2 leeks",
    "Mascarpone cheese,",
    "Parmesan cheese,",
    "Salt and pepper,",
    "Fresh flat parsley (chopped),",
    "White wine."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Peel and chop the onions and garlic, and sauté in a pan with a little butter and add the rice and cook for a further 30 seconds, then add the white wine and fish stock."
