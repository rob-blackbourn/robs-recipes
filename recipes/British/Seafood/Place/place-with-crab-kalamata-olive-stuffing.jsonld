    "100 g fresh white breadcrumbs,",
    "30 g finely chopped Kalamata olives,",
    "1/2 bunch flat leaf parsley (finely chopped),",
    "zest of 1 lemon,",
    "extra virgin olive oil,",
    "salt & pepper."
