{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Monkfish Osso Bucco with Gremolata",
  "recipeYield": "4",
  "recipeIngredient": [
    "2 x 250g Monkfish tail (cut into steaks),",
    "plain flour (for dusting),",
    "salt & pepper,",
    "extra virgin olive oil (for frying).",
    "For the sauce: 60g unsalted butter,",
    "For the sauce: 1/2 onion (peeled and finely chopped),",
    "For the sauce: 1 garlic clove (peeled and crushed),",
    "For the sauce: 1 small carrot (peeled and finely chopped),",
    "For the sauce: 1 celery stick (finely chopped),",
    "For the sauce: pinch of saffron,",
    "For the sauce: 3 sprigs thyme (chopped),",
    "For the sauce: 2 tbsp tomato puree,",
    "For the sauce: 125 ml white wine,",
    "For the sauce: 250 ml beef stock.",
    "For the gremolata: 2 garlic cloves (peeled and crushed),",
    "For the gremolata: 1 lemon (zested and finely chopped),",
    "For the gremolata: 15g bunch parsley (finely chopped),",
    "For the gremolata: 3 tbsp olive oil,",
    "For the gremolata: salt & pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the ingredients for the gremolade in a small glass bowl, season, then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Pre-heat the oven to 200°C."
    },
    {
      "@type": "HowToStep",
      "text": "Melt half the butter in a medium sized heavy based saucepan over a low to medium heat and cook the onion, garlic, carrot, and celery until soft, without colouring."
    },
    {
      "@type": "HowToStep",
      "text": "Add the saffron, thyme, and tomato puree and cook for a minute."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the white wine and reduce by three quarters."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beef stock, bring to the boil and simmer until reduced by half."
    },
    {
      "@type": "HowToStep",
      "text": "Set aside until the monkfish is ready."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly flour and season the monkfish."
    },
    {
      "@type": "HowToStep",
      "text": "Heat a nonstick frying pan until smoking, add the fish, and cook for 3 minutes on each side until golden brown."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to an oven proof dish and place in the oven for 8 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Reheat the sauce and whisk in the rest of the butter."
    },
    {
      "@type": "HowToStep",
      "text": "Place the fish on plates, pour over the sauce, then drizzle with gremolata."
    }
  ],
  "tool": [
    {
      "@type": "HowToTool",
      "name": "Medium sized heavy based saucepan,"
    },
    {
      "@type": "HowToTool",
      "name": "Small glass bowl,"
    },
    {
      "@type": "HowToTool",
      "name": "Metal handled frying pan (suitable for the oven)."
    }
  ]
}
