{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Seared Scallops with Noodles, Chilli, Garlic and Coriander",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "50 g fine dried egg noodles,",
    "1 tbsp sunflower oil,",
    "2 thinly sliced cloves of garlic,",
    "1 deseeded and thinly sliced chilli,",
    "1/2 cm piece of root ginger cut into slithers,",
    "6 prepared scallops halved horizontally,",
    "1/2 tsp dark soy sauce,",
    "roughly chopped coriander,",
    "a few drops of sesame oil."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Bring a pan of lightly salted water to the boil, add the noodles, then turn off the heat and leave for 4 minutes, then drain."
    },
    {
      "@type": "HowToStep",
      "text": "Add 1 tbsp oil to a frying pan over a medium low heat. Add the garlic, chilli and ginger and cook for 3-4 minutes, stirring frequently until softened. Remove from the pan and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Increase the heat and add the rest of the oil. Fry the scallops for 20 seconds on each side, until lightly browned. Set the scallops aside."
    },
    {
      "@type": "HowToStep",
      "text": "Add the noodles, garlic and chilli to the pan. Add the soy sauce. Stir until coated. Add the scallops, sesame oil and coriander. Toss gently and serve."
    }
  ],
  "keywords": [
    "Seafood",
    "Scallops"
  ]
}
