{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "United Kingdom",
  "name": "Char Grilled Snapper with an a Avocado, Mango, Prawn and Chilli Salsa",
  "prepTime": "PT15M",
  "cookTime": "PT8M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "2 fillets of snapper,",
    "extra virgin olive oil,",
    "coriander sprigs (to garnish).",
    "For the salsa: 1 deseeded and thinly sliced chilli,",
    "For the salsa: 50 g thickly sliced cooked tiger prawns,",
    "For the salsa: 2 thinly sliced spring onions,",
    "For the salsa: 1/2 finely chopped garlic clove,",
    "For the salsa: 1/2 peeled and diced avocado,",
    "For the salsa: 1/4 peeled and diced mango,",
    "For the salsa: juice of 1/2 lime."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all the salsa ingredients together."
    },
    {
      "@type": "HowToStep",
      "text": "Halve the fillets diagonally, brush with oil, season, and grill."
    },
    {
      "@type": "HowToStep",
      "text": "Spoon the salsa on the plates and lay the fish on top. Garnish with the coriander."
    }
  ],
  "keywords": [
    "Seafood",
    "Snapper"
  ]
}
