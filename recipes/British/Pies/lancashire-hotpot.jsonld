    "1 tbsp plain flour,",
    "250ml lamb stock,",
    "1 sprig fresh thyme,",
    "2 fresh bay leaves,",
    "1 tbsp Worcestershire sauce,",
    "50g butter (cut into cubes, plus extra for greasing),",
    "2 x 250g black pudding rings (outer casing removed, thickly sliced),",
    "1kg potatoes (peeled and sliced),",
    "Salt and freshly ground black pepper."
  ],
