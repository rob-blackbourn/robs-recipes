{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Indonesia",
  "name": "Nasi Goreng",
  "recipeYield": "2",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "recipeIngredient": [
    "For the spice paste: 1 peeled garlic cloves,",
    "For the spice paste: tiny pinch nutmeg,",
    "For the spice paste: good pinch freshly ground black pepper,",
    "For the spice paste: 1/4 tsp ground turmeric,",
    "For the spice paste: 1 peeled shallots,",
    "For the spice paste: 20 g unsalted peanuts,",
    "For the spice paste: 1/2 tsp salt,",
    "For the spice paste: 1 birds'-eye chilli (deseeded),",
    "For the spice paste: 1/2 tbsp palm sugar,",
    "For the spice paste: 1/2-1 tbsp vegetable oil (or more if necessary),",
    "For the stir-fry: 1 tbsp vegetable or groundnut oil (plus extra for frying the eggs),",
    "For the stir-fry: 1 chicken breasts (skin removed and cut into thin strips),",
    "For the stir-fry: 120 g prawns (heads and shells removed and de-veined),",
    "For the stir-fry: 60 g fine green beans (trimmed and sliced into 1cm pieces),",
    "For the stir-fry: 2 spring onions (sliced),",
    "For the stir-fry: 120 g cooked long-grain rice (this must be cold),",
    "For the stir-fry: splash light soy sauce,",
    "For the stir-fry: splash ketjap manis,",
    "For the stir-fry: 2 eggs,",
    "For the garnish: 1/4 cucumber (peeled, seeds removed, finely diced),",
    "For the garnish: 1/2 tbsp roughly chopped coriander,",
    "For the garnish: 25g peanuts,",
    "For the garnish: 1/2 lime cut into wedges,",
    "For the garnish: handful crispy fried shallots,",
    "For the garnish: Asian-style chilli oil to serve."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Spice Paste",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Put the peanuts in the chopper/grinder and grind until all the large pieces have broken down."
        },
        {
          "@type": "HowToStep",
          "text": "Add all the other ingredients except the oil and chop until slightly lump paste."
        },
        {
          "@type": "HowToStep",
          "text": "Add the oil and blend to a smooth paste."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Garnish",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Chop the cucumber in half and remove the seeds with a spoon."
        },
        {
          "@type": "HowToStep",
          "text": "Roughly crush the peanuts in a pestle and mortar."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Crispy shallots",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat the oil in the wok and fry two finely chopped shallots until crispy."
        },
        {
          "@type": "HowToStep",
          "text": "Put on a paper towel to remove the oil, then set aside."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Fried egg",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Fry each egg in the oil and set aside somewhere warm."
        }
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Stir Fry",
      "itemListElement": [
        {
          "@type": "HowToStep",
          "text": "Heat the oil in a wok over a high heat until shimmering"
        },
        {
          "@type": "HowToStep",
          "text": "hot, then add the chicken and fry for a minute or so."
        },
        {
          "@type": "HowToStep",
          "text": "Add the spice paste and prawns and stir well, cooking for a good 4-5 minutes."
        },
        {
          "@type": "HowToStep",
          "text": "Add the beans and spring onions and fry for another minute, keeping everything moving."
        },
        {
          "@type": "HowToStep",
          "text": "Add the cooked rice and stir until it's all been incorporated (add a few tablespoons of water at this point if it becomes dry and starts to stick)."
        },
        {
          "@type": "HowToStep",
          "text": "Season with soy sauce and ketjap manis, to taste."
        },
        {
          "@type": "HowToStep",
          "text": "Using a spare bowl form each portion by pressing the rice into the bowl and poping out onto a plate."
        },
        {
          "@type": "HowToStep",
          "text": "Put the fried egg on the top."
        },
        {
          "@type": "HowToStep",
          "text": "Put the cucumber and crushed peanuts on the side."
        },
        {
          "@type": "HowToStep",
          "text": "Drizzle a little chilli oil over the top."
        }
      ]
    }
  ]
}
