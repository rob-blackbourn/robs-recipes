{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Beef Strogranoff",
  "prepTime": "PT20M",
  "cookTime": "PT10M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "For the seared steak: 700g fillet or sirloin steak cut into thin strips,",
    "For the seared steak: 1 tbsp Worcestershire sauce,",
    "For the seared steak: 1 tsp salt,",
    "For the seared steak: 1/4 tsp pepper,",
    "For the seared steak: 1/2 tsp nutmeg,",
    "For the seared steak: 2 tsp allspice,",
    "For the seared steak: 2 tbsp vegetable oil",
    "For the Stroganoff sauce: 500g tagliatelli,",
    "For the Stroganoff sauce: 6 tbsp olive oil,",
    "For the Stroganoff sauce: 700g mushrooms,",
    "For the Stroganoff sauce: 2 medium onions - sliced,",
    "For the Stroganoff sauce: 6 cloves garlic - minced,",
    "For the Stroganoff sauce: 4 tbsp flour,",
    "For the Stroganoff sauce: 1/2 glass (120g) dry white wine,",
    "For the Stroganoff sauce: 750 ml beef stock,",
    "For the Stroganoff sauce: 150 ml double cream,",
    "For the Stroganoff sauce: 150 ml sour cream,",
    "For the Stroganoff sauce: 2 tbsp Dijon Mustard,",
    "For the Stroganoff sauce: 2 tbsp Worcestershire sauce,",
    "For the Stroganoff sauce: A ladle of pasta water,",
    "For the Stroganoff sauce: 2 tbsp flat leaf parsley - minced,",
    "For the Stroganoff sauce: salt and pepper - to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "With the meat in a bowl, sprinkle over 1 tsp salt, 1/4 tsp pepper, 1/2 tsp nutmeg and 2 tsp allspice. And massage into the meat. Add 1 tbsp Worcestershire sauce, 2 tbsp olive oil, massage again, and marinade for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Pat dry the meat and sear in batches with vegetable oil over medium heat, then set aside. Remember to pat dry the pan between batches if it gets too moist."
    },
    {
      "@type": "HowToStep",
      "text": "Deglaze the pan with 2 ladles of beef stock. Taste, and if not bitter, return to the stock."
    },
    {
      "@type": "HowToStep",
      "text": "In a large saucepan, add some olive oil and bring to a medium heat. Add the mushrooms and cook until brown. Then set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Lower the heat and add some more olive oil and the onions and cook until softened (about 10 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic and cook until soft (2 minutes)"
    },
    {
      "@type": "HowToStep",
      "text": "Add 84g butter."
    },
    {
      "@type": "HowToStep",
      "text": "Add 4 tbsp or plain flour, and cook until no longer white (around 1 minute)."
    },
    {
      "@type": "HowToStep",
      "text": "Add a glass of white wine and stir into the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the 750ml of stock and add 2 tbsp of Dijon mustard and 2 tbsp worcestershire sauce.."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mushrooms and the steak."
    },
    {
      "@type": "HowToStep",
      "text": "Add 120ml of double cream and mix in."
    },
    {
      "@type": "HowToStep",
      "text": "After 30 seconds add 120ml of sour cream and simmer for 3 to 4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    }
  ]
}
