{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Agedashi Dofu",
  "cookTime": "PT10M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "200g firm tofu",
    "Grated white radish (daikon)",
    "Spring onions, chopped",
    "Bonito Flakes",
    "Cornflour or potato starch",
    "Vegetable oil",
    "1/2 cup dashi soup stock (konbu dashi)",
    "1/2 tbsp mirin",
    "1/2 tbsp light soy sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Wrap tofu in paper towels and squeeze out excess water."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the tofu into 4 small squares."
    },
    {
      "@type": "HowToStep",
      "text": "Coat the tofu cubes with cornflour evenly."
    },
    {
      "@type": "HowToStep",
      "text": "Deep fry the tofu in pre-heated oil (170°C) for about 4 minutes or until light golden brown."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the deep fried tofu on tempura papers and then place them on serving plates."
    },
    {
      "@type": "HowToStep",
      "text": "In a saucepan, bring the ingredients for the sauce to a boil. Pour the hot sauce over the tofu."
    },
    {
      "@type": "HowToStep",
      "text": "Top each tofu with grated radish, bonito flakes and spring onions."
    }
  ],
  "image": [
    "agedashi dofu.assets/image1.png"
  ],
  "keywords": [
    "Tofu"
  ]
}
