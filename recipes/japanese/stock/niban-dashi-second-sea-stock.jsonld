{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Niban Dashi (Second Sea Stock)",
  "recipeYield": "4 cups",
  "recipeIngredient": [
    "4 cups water",
    "Kombu and katsuobushi used in ichiban dashi"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine all of the ingredients in a pan."
    },
    {
      "@type": "HowToStep",
      "text": "Place the pan over low heat and cook the mixture for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the pan from the heat and then strain the stock through a wire sieve lined with muslin or filter paper."
    },
    {
      "@type": "HowToStep",
      "text": "Refrigerate the stock in a tightly covered container for up to 4 days in the refrigerator."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1REqN4CHP5wws7DraOUMLb5WGEIx2Ow1HJHdx3sxS0E0/edit?usp=sharing"
  ],
  "keywords": [
    "Stock"
  ]
}
