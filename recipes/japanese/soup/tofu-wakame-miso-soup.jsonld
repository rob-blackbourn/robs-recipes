{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Tofu & Wakame Miso Soup",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "400ml dashi",
    "1/2 tablespoon dried wakame, soaked in water for 5 minutes then drained",
    "85 g enoki mushrooms (trimmed)",
    "1 tbsp shiro miso",
    "1/2 tbsp aka miso",
    "85 g firm tofu (cut into cubes)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Bring the dashi to a boil in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the wakame and mushrooms (if you are using them), and simmer for 1 minute."
    },
    {
      "@type": "HowToStep",
      "text": "Put the miso paste in a separate bowl and add a small amount of the dashing, a little at a time, to prevent lumps."
    },
    {
      "@type": "HowToStep",
      "text": "When the miso is well diluted, ad it to the remaining dashi."
    },
    {
      "@type": "HowToStep",
      "text": "Add then the tofu, and reheat slightly, but do not boil."
    }
  ],
  "keywords": [
    "Soup"
  ]
}
