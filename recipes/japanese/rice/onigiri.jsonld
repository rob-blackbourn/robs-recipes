{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Onigiri",
  "recipeCategory": "Snack",
  "recipeYield": "1 serving",
  "recipeIngredient": [
    "Sushi rice,",
    "Nori seaweed sheets,",
    "Filling: shiozake (salted salmon, grilled and flaked), umeboshi (salty pickled plum), tarako (salty cod roe cooked and cut into small chunks), okaka (bonito flakes mixed with a little soy sauce), umukaka (bonito flakes mixed with umeboshi), limbo no tsukudani or ship Kombu (kombu seaweed cooked in soy sauce until tender and salty)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Make the rice."
    },
    {
      "@type": "HowToStep",
      "text": "Make a bowl of slightly salty water."
    },
    {
      "@type": "HowToStep",
      "text": "Moisten your hands with the salty water and mold into shape."
    }
  ],
  "keywords": [
    "Rice"
  ]
}
