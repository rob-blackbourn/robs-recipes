{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Ingen Goma-ae",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "100g string beans (trimmed and cut into two or three pieces)",
    "3 tbsp toasted white or black sesame seeds",
    "2 tsp dashi stock",
    "1 tsp sugar",
    "1 tsp soy sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Boil in salted water for 2 minutes, then remove and strain."
    },
    {
      "@type": "HowToStep",
      "text": "Lightly toast the sesame seeds in a dry frying pan, moving continually."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a mortar and grind to a rough texture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the sugar and soy sauce and mix."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dashi stock and mix into a dry paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add the beans and coat with the paste."
    }
  ],
  "keywords": [
    "Vegetables"
  ]
}
