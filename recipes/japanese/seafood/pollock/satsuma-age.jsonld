{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Satsuma-age",
  "prepTime": "PT10M",
  "cookTime": "PT4M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "150g Pacific cod or pollock (skinned, pin boned, roughly chopped)",
    "1/2 tbsp sake",
    "1/3 tsp salt",
    "1/2~1 tbsp potato starch or cornstarch",
    "1/2 egg",
    "1/2 tsp ginger root juice",
    "10g carrot (finely diced)",
    "1/4 onion (finely diced)",
    "1 tsp plain flour",
    "Oil for deep frying",
    "soy sauce",
    "grated ginger root"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the fish, sake, and salt in the food processor and process of a few seconds."
    },
    {
      "@type": "HowToStep",
      "text": "Add the egg, starch, and ginger root juice and process briefly."
    },
    {
      "@type": "HowToStep",
      "text": "Put the onion and carrot in a bowl and mix in the flour."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the fish mixture with the vegetable mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Divide into 6 and deep fry for 4 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with the ginger and soy sauce."
    }
  ],
  "keywords": [
    "Seafood",
    "Pollock"
  ]
}
