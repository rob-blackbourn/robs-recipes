{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Shiozake",
  "recipeYield": "1 fillet",
  "recipeIngredient": [
    "Fillet of salmon with the skin on",
    "Maldon sea salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Dry the salmon with kitchen towel."
    },
    {
      "@type": "HowToStep",
      "text": "Salt both sides."
    },
    {
      "@type": "HowToStep",
      "text": "Wrap in kitchen towel and put in a sieve over a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Refridgerate for 24 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Unwrap and either dry fry or grill."
    }
  ],
  "keywords": [
    "Seafood",
    "Salmon",
    "fish"
  ]
}
