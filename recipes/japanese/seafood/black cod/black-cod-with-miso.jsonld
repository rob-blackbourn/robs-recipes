{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Black Cod With Miso",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 fillets of black cod",
    "800 g Nobu-style saikyo miso",
    "1 stalk hajikami (to garnish)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pat the fillets dry with a paper towel. Slather the fish with the miso sauce, place in a bowl, cover with plastic wrap, and leave in the fridge for 2-3 days."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 200°C. Preheat the grill. Lightly wipe off any excess miso, but don't rinse it off. Grill, skin side toward the heat, until the skin crisps up. Then bake for 10-15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with the hajikami and add a few drops of the sauce to the plate."
    }
  ],
  "citation": [
    "../../sauces/nobu-style-saikyo-miso.jsonld"
  ],
  "keywords": [
    "seafood",
    "black cod",
    "fish"
  ]
}
