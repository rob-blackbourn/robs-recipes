{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Tuna Teriyaki",
  "recipeYield": "1 serving",
  "recipeIngredient": [
    "1 tuna steak",
    "120 ml teriyaki sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Dry fry one side of the tuna in a non-stick frying pan over a medium heat until golden brown."
    },
    {
      "@type": "HowToStep",
      "text": "Turn and add the teriyaki sauce, a little at a time, basting the steak."
    }
  ],
  "citation": [
    "https://docs.google.com/document/d/1gYeLt_TeKKaORiNzzBvoreHP3iWZ_JaYaUsonelq3fM/edit?usp=sharing"
  ],
  "keywords": [
    "Seafood",
    "Tuna"
  ]
}
