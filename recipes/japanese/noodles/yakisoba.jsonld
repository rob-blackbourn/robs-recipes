{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Yakisoba",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1/2 cup ketchup",
    "2 tbsp Worcestershire sauce",
    "1 tbsp soy sauce",
    "2 tsp prepared hot mustard (preferably Japanese, but Colman's will work too)",
    "1 tsp freshly ground black pepper",
    "3 tbsp vegetable oil",
    "220 g thinly sliced pork (or thick, uncured bacon), cut into 1-inch wide pieces",
    "3 cups shredded savoy cabbage",
    "2 cups bean sprouts",
    "1/2 medium yellow onion, diced",
    "500 g cooked Chinese egg noodles (yakisoba noodles, sometimes labeled “chukamen”), at room temperature",
    "Salt and pepper for seasoning",
    "Ao nori (shredded nori seaweed)—to taste",
    "Beni shoga (julienned red pickled ginger)—to garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare the sauce: Whisk together the sauce ingredients in a small bowl. Cover and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Heat one tablespoon of oil in a 12-inch skillet or wok and cook the pork until just barely cooked.  Using a slotted spoon, transfer the meat to a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Cook the cabbage, bean sprouts, and onion in the same skillet, over medium-high heat until tender, but not browned. While cooking, drizzle in additional oil as needed."
    },
    {
      "@type": "HowToStep",
      "text": "Add the noodles to the skillet. Gently toss them to break them up and incorporate them with the rest of the ingredients. When the noodles have warmed through and are starting to crisp, add the cooked meat and half of the sauce and stir until everything is evenly coated. Add additional sauce until you have reached your desired moisture level. Garnish with a pinch of ao nori and beni shoga (optional) and serve immediately."
    }
  ],
  "keywords": [
    "noodles",
    "pork",
    "meat"
  ]
}
