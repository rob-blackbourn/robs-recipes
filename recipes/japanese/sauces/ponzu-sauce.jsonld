{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Ponzu Sauce",
  "cookTime": "PT0M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "75-100 ml yuzu juice (substitute 2 lemons or limes)",
    "100 ml soy sauce",
    "2 tbsp mirin",
    "3 g kombu Seaweed",
    "3 g bonito Flakes"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the bonito flakes and kombu seaweed into a bottle."
    },
    {
      "@type": "HowToStep",
      "text": "Squeeze the citrus fruit and add the measured amount into the bottle."
    },
    {
      "@type": "HowToStep",
      "text": "Add the soy sauce and mirin."
    },
    {
      "@type": "HowToStep",
      "text": "Shake the bottle and leave in the fridge for 24 hours."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Allow 24 hours to infuse."
    }
  ],
  "prepTime": "PT10M",
  "keywords": [
    "Sauces",
    "fish",
    "bonito"
  ]
}
