{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Ginger Duck Gyoza with Ponzu Plum Sauce",
  "recipeYield": "50 pieces",
  "recipeIngredient": [
    "350 g Napa cabbage (about 1/2 of a medium head), chopped very fine",
    "1 1/2 tsp. Kosher salt, divided (cut in half if using table salt)",
    "2 cloves garlic, minced or grated",
    "2 tsp. fresh ginger, minced or grated",
    "2 scallions, sliced into fine rings",
    "1/2 tsp. freshly ground black pepper",
    "3 tbsp soy sauce",
    "2 tbsp rice wine",
    "450 g ground duck (chicken or pork can be substituted)",
    "1 1/2 c. Japanese ponzu sauce",
    "3 tbsp neri ume paste (3 tbsp extra plum sauce can be substituted)",
    "6 tbsp Chinese plum sauce",
    "3 tbsp Asian chili oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put chopped cabbage in a colander and toss with 1 tsp. Kosher salt.  Set aside for at least 20 minutes to allow for some of the liquid to drain off."
    },
    {
      "@type": "HowToStep",
      "text": "In a large bowl, combine 1/2 tsp. Kosher salt, garlic, ginger, scallions, ground pepper, soy sauce, and rice wine."
    },
    {
      "@type": "HowToStep",
      "text": "Squeeze as much liquid as possible from the cabbage and add it to the soy sauce mixture.  Add the duck and mix gently.  Chill until ready to fill the gyoza."
    },
    {
      "@type": "HowToStep",
      "text": "In a small bowl, whisk together the plum dipping sauce ingredients: ponzu sauce, neri ume, and plum sauce.  Add the chili oil last, mixing gently.  The oil will float on top of the sauce."
    }
  ],
  "keywords": [
    "meat",
    "pork",
    "poultry",
    "chicken",
    "duck"
  ]
}
