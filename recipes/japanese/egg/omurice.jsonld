{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Japan",
  "name": "Omurice",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "130 g chicken",
    "1 clove of garlic",
    "1/4 onion",
    "4 button mushrooms",
    "1 tbsp sake",
    "200 g canned tomato",
    "1 tbsp tomato ketchup",
    "1/2 bouillon cube",
    "1 bay leaf",
    "30 g frozen peas",
    "olive oil",
    "Salt and pepper for seasoning",
    "280 g steamed rice (cooked with less water)",
    "4 eggs",
    "2 tsp single cream",
    "baby salad greens",
    "parsley"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the chicken into 1/2 inch pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Rub the seasonings into the chicken meat."
    },
    {
      "@type": "HowToStep",
      "text": "Finely dice the onion,"
    },
    {
      "@type": "HowToStep",
      "text": "Slice the mushroom."
    },
    {
      "@type": "HowToStep",
      "text": "Very finely dice the garlic."
    },
    {
      "@type": "HowToStep",
      "text": "Finely slice the stock cube."
    },
    {
      "@type": "HowToStep",
      "text": "Pour hot water over the frozen peas, drain, then season with salt."
    },
    {
      "@type": "HowToStep",
      "text": "Crack the eggs into a bowl, mix well, and add the cream. Season with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Put a large frying pan on a low heat. Add a little olive oil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic."
    },
    {
      "@type": "HowToStep",
      "text": "When softened, increase the heat to medium and add the onion."
    },
    {
      "@type": "HowToStep",
      "text": "When translucent, add the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "When the chicken begins to brown add the button mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "Add the wine and cook out the alcohol."
    },
    {
      "@type": "HowToStep",
      "text": "Add the canned tomato, ketchup, shave stock cube, and a bay leaf."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the sauce slightly, then add the peas."
    },
    {
      "@type": "HowToStep",
      "text": "When the sauce is thick and begins to sizzle, remove the bay leaf, taste, and adjust the seasoning."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rice and combine."
    },
    {
      "@type": "HowToStep",
      "text": "Divide into two bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Make an omelette with two eggs. When the omelette is done, lay the filling in a thick stip across the centre. Bring the sides of the omelette up around the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Turn out onto a plate, and shape with a paper towel."
    },
    {
      "@type": "HowToStep",
      "text": "Drizzle tomato ketchup over in a zig zag style."
    }
  ],
  "image": [
    "omurice.assets/image1.png"
  ],
  "keywords": [
    "egg",
    "omelette",
    "chicken",
    "poultry"
  ]
}
