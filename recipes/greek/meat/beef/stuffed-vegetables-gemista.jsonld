{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Greece",
  "name": "Stuffed Vegetables (Gemista)",
  "prepTime": "PT20M",
  "cookTime": "PT1H30M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "250g minced beef",
    "5 large tomatoes",
    "6 green bell peppers (five cored, and one chopped)",
    "1 red onion (finely diced)",
    "4 cloves of garlic (crushed and finely diced)",
    "4 tbsp long grain rice rice",
    "1 courgette (grated)",
    "1 carrot (grated)",
    "4 potatoes (cut into wedges)",
    "1/2 bunch mint (finely chopped)",
    "1/2 bunch dill (finely chopped)",
    "1/2 bunch parsley (finely chopped)",
    "2 tsp dried thyme",
    "2 tsp dried oregano",
    "1 tbsp parmesan cheese",
    "Olive oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Brown the beef,"
    },
    {
      "@type": "HowToStep",
      "text": "Cut the tops of five large tomatoes, scoop out the flesh with a spoon and reserve."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the tops off five green bell peppers, tear out the insides and discard."
    },
    {
      "@type": "HowToStep",
      "text": "Puree the tomato flesh in a food processor."
    },
    {
      "@type": "HowToStep",
      "text": "Bring a medium frying pan up to medium heat and add olive oil and add one onion, finely diced."
    },
    {
      "@type": "HowToStep",
      "text": "After the onion is soft add four chopped garlic cloves and cook until soft."
    },
    {
      "@type": "HowToStep",
      "text": "Add four tablespoons of rice and stir."
    },
    {
      "@type": "HowToStep",
      "text": "Add the grated courgette, and carrot and cook for two minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add one chopped green bell pepper and cook for another minute."
    },
    {
      "@type": "HowToStep",
      "text": "Add three quarters of the tomato puree,"
    },
    {
      "@type": "HowToStep",
      "text": "Add the fresh herbs and the dried herbs and the cheese."
    },
    {
      "@type": "HowToStep",
      "text": "Add the browned beef and season,"
    },
    {
      "@type": "HowToStep",
      "text": "Stuff the vegetables with the mixture"
    },
    {
      "@type": "HowToStep",
      "text": "Put the potato wedges into a dish and mix with olive oil, oregano, salt, and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Put the stuffed vegetables in a baking tray a mix in the potato wedges."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the remaining tomato puree, water, oregano, salt and pepper, and a drizzle of olive oil."
    },
    {
      "@type": "HowToStep",
      "text": "Cook covered in the oven at 180°C for one hour, then uncovered for a further 30 minutes."
    }
  ],
  "keywords": [
    "Meat",
    "Beef"
  ]
}
