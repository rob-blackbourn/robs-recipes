{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Fresh Pasta - Food processor",
  "prepTime": "PT20M",
  "cookTime": "PT0M",
  "recipeYield": "4",
  "recipeIngredient": [
    "140 g (5 oz) plain flour or Italias ‘00’ flour,",
    "1 whole egg,",
    "1 egg yolk."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the flour in a food processor and pulse it. Add the whole egg and egg yolk and keep whizzing until the mixture resembles fine breadcrumbs (it shouldn't be dusty, nor should it be a big, gooey ball). This takes 2-3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Tip out the dough and knead to form into a ball shape. Knead it briskly for 1 minute, it should be quite stiff and hard to knead. Wrap in cling film and leave to rest in a cool place for 1 hour before using."
    },
    {
      "@type": "HowToStep",
      "text": "Now cut the dough into 2 pieces. For each piece, flatten with a rolling pin to about 5mm/¼ in) thickness. Fold over the dough and pass it through the pasta machine at its widest setting, refolding and rolling 7 times (not changing the setting) until you have a rectangular shape 7.5x18cm / 3x7 in. It is important to work the dough until it is nice and shiny, as this gives it the \"al dente\" texture. Repeat with the second piece of dough."
    },
    {
      "@type": "HowToStep",
      "text": "Now you are ready to roll out. Start with the pasta machine at its widest setting, pass the dough through the rollers. Do not fold but repeat this process, decreasing the roller setting down grade by grade with each pass. For most uses, I take the pasta down to the penultimate setting - especially for ravioli, as you are sandwiching two layers together when it is folded. Use straight away to make the ravioli."
    }
  ]
}
