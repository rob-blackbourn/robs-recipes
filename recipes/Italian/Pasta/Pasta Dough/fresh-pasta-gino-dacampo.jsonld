{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Fresh Pasta - Gino D’Acampo",
  "text": "Fresh Pasta - Gino D’Acampo\n\nPreparation time: 30 minutes\n\nCooking time: 2 minutes\n\nYield: 1\n\nIngredients\n\n200g/7oz 00 or plain flour (plus extra to flour the pasta machine),\n\n4 free-range egg yolks,\n\n½ tsp salt.\n\nPreparation method\n\n1. For the pasta, mix the flour and egg yolks in a blender with the salt until combined.\n\n2. Turn out onto a floured surface and flour a pasta machine.\n\n3. Starting at the lowest (thickest) setting, feed the dough through the machine, holding the dough with one hand as it comes out of the machine.\n\n4. Change the setting on the machine to the next-thickest setting, flour the machine again and feed the pasta through.\n\n5. Repeat this process 3-4 times or until the desired thickness is achieved.",
  "prepTime": "PT30M",
  "cookTime": "PT2M",
  "recipeYield": "1",
  "recipeIngredient": [
    "200g/7oz 00 or plain flour (plus extra to flour the pasta machine),",
    "4 free-range egg yolks,",
    "½ tsp salt."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. For the pasta, mix the flour and egg yolks in a blender with the salt until combined."
    },
    {
      "@type": "HowToStep",
      "text": "2. Turn out onto a floured surface and flour a pasta machine."
    },
    {
      "@type": "HowToStep",
      "text": "3. Starting at the lowest (thickest) setting, feed the dough through the machine, holding the dough with one hand as it comes out of the machine."
    },
    {
      "@type": "HowToStep",
      "text": "4. Change the setting on the machine to the next-thickest setting, flour the machine again and feed the pasta through."
    },
    {
      "@type": "HowToStep",
      "text": "5. Repeat this process 3-4 times or until the desired thickness is achieved."
    }
  ]
}
