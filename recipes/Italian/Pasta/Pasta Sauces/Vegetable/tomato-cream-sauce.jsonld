{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Tomato Cream Sauce",
  "text": "Tomato Cream Sauce\n\nPreparation time:\n\nCooking time:\n\nYield:\n\nIngredients\n\n1 tbsp olive oil,\n\n2 big tomatoes,\n\n2 garlic cloves,\n\n5 sprigs thyme or more,\n\n1/4 cup white wine,\n\n1/2 cup double cream,\n\n20 yellow and red grape tomatoes,\n\nsalt.\n\nPreparation\n\n1. Heat olive oil in a pan over medium heat.  Chop tomatoes and garlic and add to the pan.  Cook covered for about 10 minutes until tomatoes soften.\n\n2. Add white wine and chopped thyme.  Bring to boil and cook uncovered for 5 more minutes until half of liquid evaporates.  Remove from heat, let it cool for a bit.\n\n3. Then transfer to blender and puree the tomato mixture.  Transfer the puree back to the pan, reheat to medium heat and add heavy cream.  Stir until well incorporated.\n\n4. Cut each grape tomato in half and add all of them to the pan with the tomato cream sauce. Salt to taste and and more chopped thyme if needed.  Cook for 5 more minutes.",
  "recipeIngredient": [
    "1 tbsp olive oil,",
    "2 big tomatoes,",
    "2 garlic cloves,",
    "5 sprigs thyme or more,",
    "1/4 cup white wine,",
    "1/2 cup double cream,",
    "20 yellow and red grape tomatoes,",
    "salt."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat olive oil in a pan over medium heat.  Chop tomatoes and garlic and add to the pan.  Cook covered for about 10 minutes until tomatoes soften."
    },
    {
      "@type": "HowToStep",
      "text": "Add white wine and chopped thyme.  Bring to boil and cook uncovered for 5 more minutes until half of liquid evaporates.  Remove from heat, let it cool for a bit."
    },
    {
      "@type": "HowToStep",
      "text": "Then transfer to blender and puree the tomato mixture.  Transfer the puree back to the pan, reheat to medium heat and add heavy cream.  Stir until well incorporated."
    },
    {
      "@type": "HowToStep",
      "text": "Cut each grape tomato in half and add all of them to the pan with the tomato cream sauce. Salt to taste and and more chopped thyme if needed.  Cook for 5 more minutes."
    }
  ]
}
