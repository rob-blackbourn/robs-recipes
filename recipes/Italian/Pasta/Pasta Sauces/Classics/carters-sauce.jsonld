{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Carter’s Sauce",
  "text": "Carter’s Sauce\n\nPreparation time: 15 minutes\n\nYield: 6\n\nIngredients\n\n4 - 5 cloves of garlic,\n\n50 g / 2 oz basil leaves,\n\npinch of dried chilli,\n\n150 ml / 1/4 pint olive oil,\n\n6 ripe tomatoes (about 750 g / 1 1/2 lb, skinned and chopped),\n\n125 g / 4 oz salted ricotta cheese or pecorino cheese (grated),\n\nPreparation\n\n1. Put the garlic, basil, chilli flakes and a pinch of salt into a food processor and work until smooth.\n\n2. Add the oil slowly until the sauce becomes smooth again.\n\n3. Mix the puree into the chopped tomatoes.\n\n2. Stir half of the cheese into the sauce and sprinkle the remaining cheese on top.\n\n3. Serve with a small bowl of grated cheese, handed around separately.",
  "prepTime": "PT15M",
  "cookTime": "PT0M",
  "recipeYield": "6",
  "recipeIngredient": [
    "4 - 5 cloves of garlic,",
    "50 g / 2 oz basil leaves,",
    "pinch of dried chilli,",
    "150 ml / 1/4 pint olive oil,",
    "6 ripe tomatoes (about 750 g / 1 1/2 lb, skinned and chopped),",
    "125 g / 4 oz salted ricotta cheese or pecorino cheese (grated),"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the garlic, basil, chilli flakes and a pinch of salt into a food processor and work until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oil slowly until the sauce becomes smooth again."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the puree into the chopped tomatoes."
    },
    {
      "@type": "HowToStep",
      "text": "Stir half of the cheese into the sauce and sprinkle the remaining cheese on top."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with a small bowl of grated cheese, handed around separately."
    }
  ]
}
