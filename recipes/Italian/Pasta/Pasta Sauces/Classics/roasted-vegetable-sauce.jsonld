    "2 tsp chopped rosemary,",
    "125 ml olive oil,",
    "1 tbsp balsamic vinegar,",
    "1 tbsp clear honey,",
    "Salt & pepper,",
    "Freshly ground Parmesan cheese."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Whiz the aubergines in a food processor until chopped into small uneven pieces and tip into a large roasting tin.whiz the courgettes and peppers and add to the tin. Stir in the onions and rosemary and drizzle with 100 ml of olive oil."
