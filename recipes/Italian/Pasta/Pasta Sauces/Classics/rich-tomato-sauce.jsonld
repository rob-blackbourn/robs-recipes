{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Rich Tomato Sauce",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "t tbsp olive oil,",
    "1 onion (finely chopped),",
    "2 cloves garlic (crushed),",
    "125 g button mushrooms (finely chopped),",
    "2 carrots (finely chopped),",
    "750 g ripe plum tomatoes (skinned and chopped),",
    "2 tbsp tomato puree,",
    "1/2 tsp castor sugar,",
    "4 tbsp single cream,",
    "Salt & pepper,",
    "1 tbsp oregano leaves to garnish,",
    "Freshly grated Parmesan cheese to serve."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a large saucepan. Add the onions, garlic, mushrooms, and carrots, and fry over a moderate heat for 5 minutes until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes, tomato puree and sugar and stir well. Bring to the boil, then reduce the heat, cover the pan and simmer for 20 minutes, stirring occasionally. Season to taste with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Stir the cream into the sauce, garnish with oregano and serve with freshly grated Parmesan cheese."
    }
  ]
}
