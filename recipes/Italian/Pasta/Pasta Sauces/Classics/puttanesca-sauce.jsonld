{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Puttanesca Sauce",
  "text": "Puttanesca Sauce\n\nPreparation time: 10 minutes\n\nCooking time: 30 minutes\n\nYield: 4\n\nIngredients\n\n4 tbsp olive oil,\n\n2 small onions,\n\n2 cloves of garlic,\n\n8 anchovy fillets (coarsely chopped),\n\n400 g (13 oz) can of plum tomatoes (drained and diced),\n\n12 black olives (pitted and halved),\n\n1 tbsp capers (drained),\n\n2 tbsp chopped oregano,\n\nsalt and pepper,\n\nred basil leaves to garnish,\n\n125 g (4 oz) Parmesan cheese (freshly grated) to serve.\n\nPreparation\n\n1. Heat the oil in a saucepan over a moderate heat, add the onions and cook gently for 5 minutes until softened.\n\n2. Add the garlic, anchovies, and cook for about 3 minutes, until the anchovies completely disintegrate.\n\n3. Stir in the tomatoes, olives, capers and oregano, and season to taste with salt and pepper. Bring to the boil, then reduce heat and simmer the sauce gently for about 20 minutes, stirring occasionally. Garnish the sauce with red basil leaves and serve with grated Parmesan cheese.",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "recipeYield": "4",
  "recipeIngredient": [
    "4 tbsp olive oil,",
    "2 small onions,",
    "2 cloves of garlic,",
    "8 anchovy fillets (coarsely chopped),",
    "400 g (13 oz) can of plum tomatoes (drained and diced),",
    "12 black olives (pitted and halved),",
    "1 tbsp capers (drained),",
    "2 tbsp chopped oregano,",
    "salt and pepper,",
    "red basil leaves to garnish,",
    "125 g (4 oz) Parmesan cheese (freshly grated) to serve."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a saucepan over a moderate heat, add the onions and cook gently for 5 minutes until softened."
    },
