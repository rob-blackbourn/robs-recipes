{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Peperonata Sauce",
  "text": "Peperonata Sauce\n\nPreparation time: 15 minutes\n\nCooking time: 30 minutes\n\nYield: 4\n\nIngredients\n\n2 tbsp olive oil,\n\n3 onions (finely chopped),\n\n2 cloves of garlic (finely chopped),\n\n400 g / 13 oz can chopped tomatoes,\n\n1 tbsp tomato puree,\n\n1 tbsp chopped oregano,\n\n2 bay leaves,\n\n1 green pepper (cored, deseeded, and diced),\n\nfreshly grated Parmesan to serve.\n\nPreparation\n\n1. Heat the garlic in a saucepan, add the onio and garlic and cook for 5 minutes.\n\n2. Add the tomatoes with their juice, the tomato puree, oregano and bay leaves.\n\n3. Bring to the boil, reduce the heat and simmer for 10 minutes.\n\n4. Add the peppers and cook for another 10 minutes until they are soft.\n\n5. Season to taste.\n\n6. Remove the bay leaves and serve with a bowl of grated Parmesan cheese.",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "recipeYield": "4",
  "recipeIngredient": [
    "2 tbsp olive oil,",
    "3 onions (finely chopped),",
    "2 cloves of garlic (finely chopped),",
    "400 g / 13 oz can chopped tomatoes,",
    "1 tbsp tomato puree,",
    "1 tbsp chopped oregano,",
    "2 bay leaves,",
    "1 green pepper (cored, deseeded, and diced),",
    "freshly grated Parmesan to serve."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Heat the garlic in a saucepan, add the onio and garlic and cook for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "2. Add the tomatoes with their juice, the tomato puree, oregano and bay leaves."
    },
    {
      "@type": "HowToStep",
      "text": "3. Bring to the boil, reduce the heat and simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "4. Add the peppers and cook for another 10 minutes until they are soft."
    },
    {
      "@type": "HowToStep",
      "text": "5. Season to taste."
    },
    {
      "@type": "HowToStep",
      "text": "6. Remove the bay leaves and serve with a bowl of grated Parmesan cheese."
    }
  ]
