{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Meatball Sauce",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "recipeYield": "5 servings",
  "recipeIngredient": [
    "For the meatballs: 500 g minced beef,",
    "For the meatballs: 1/2 large onion (very finely chopped),",
    "For the meatballs: 1 clove of garlic,",
    "For the meatballs: 1 tsp chopped oregano,",
    "For the meatballs: 1 tsp dried mixed herbs,",
    "For the meatballs: 50 g (2 oz) fresh breadcrumbs,",
    "For the meatballs: 1 egg (beaten),",
    "For the meatballs: 2 tbsp olive oil,",
    "For the meatballs: salt and pepper,",
    "For the sauce: 1 onion,",
    "For the sauce: 400 g (13 oz) can plum tomatoes,",
    "For the sauce: 600 ml (1 pint) beef stock,",
    "For the sauce: 2 tbsp tomato puree,",
    "For the sauce: 1 tbsp red wine vinegar,",
    "For the sauce: 1 tsp chopped oregano,",
    "For the sauce: 1 tsp dried mixed herbs,",
    "For the sauce: 1 tsp caster sugar."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the sauce ingredients into a blender and work to a puree. Transfer to a pan and season. Bring to the boil, stirring. Reduce the heat, cover and simmer, stirring occasionally while making the meatballs."
    },
    {
      "@type": "HowToStep",
      "text": "Place the beef in a bowl and combine it with the onion, garlic, herbs, breadcrumbs and egg. Season to taste. Knead for about 5 minutes until the meat is sticky. Shape into 50 meatballs."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a nonstick frying pan and fry the meatballs in batches for 5-7 minutes until they are brown on all sides. Remove and place on kitchen paper to drain."
    },
    {
      "@type": "HowToStep",
      "text": "Add the meatballs to the sauce. Cover the pan and cook gently for 20 minutes. shaing the pan occasionally. Garnish with parsley sprigs."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 4 - 5"
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
