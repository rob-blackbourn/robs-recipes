{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Napolitana Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT25M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 tbsp olive oil,",
    "1 onion (chopped),",
    "2 cloves of garlic (crushed),",
    "2 carrots (finely chopped and blanched),",
    "2 red peppers (cored, deseeded, and finely chopped),",
    "4 large tomatoes (chopped),",
    "150 ml / 1/4 pint red wine,",
    "400 g / 14 oz can chopped tomatoes with herbs,",
    "basil leaves ( to garnish)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a large frying pan."
    },
    {
      "@type": "HowToStep",
      "text": "Add the onion and garlic and fry for 3 minutes until softened, but not coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Add the carrots and red peppers and fry for a further 3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the tomatoes and red wine."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to the boil, then reduce the heat and simmer, partially covered, for 15 minnutes."
    },
    {
      "@type": "HowToStep",
      "text": "Season to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with shredded basil leaves."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
