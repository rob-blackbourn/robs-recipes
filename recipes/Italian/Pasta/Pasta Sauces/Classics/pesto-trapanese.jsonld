{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Pesto Trapanese",
  "prepTime": "PT12M",
  "cookTime": "PT0M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "3 ripe tomatoes",
    "4 cloves of garlic,",
    "50 g (2 oz) basil leaves (plus extra to garnish),",
    "125 g (4 oz) blanched almonds (toasted),",
    "150 ml (1/4 pint) olive oil,",
    "salt and pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place all of the ingredients in a food processor and blend until they are smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Can be kept in a lidded jar covered with olive oil for up to 5 days."
    },
    {
      "@type": "Comment",
      "text": "Original yield: 4 - 6"
    }
  ]
}
