{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Lentil Bolognese Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT55M",
  "recipeYield": "4",
  "recipeIngredient": [
    "250 g (8 oz) whole green lentils,",
    "2 tsp vegetable oil,",
    "2 onions (chopped),",
    "2 cloves of garlic (crushed),",
    "2 sticks of celery,",
    "2 carrots (finely diced),",
    "2 tbsp tomato puree,",
    "salt pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Rinse the lentils, place in a pan, cover with water and bring to the boil. Reduce the heat and simmer gently for 40 minutes until tender. Drain, reserving the liquid."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, heat the oil in a large pan, add the onions and cook for 5 minutes, until soft. Add the garlic, celery and carrots. Cook the vegetables covered for 15 minutes, until tender."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the lentils, tomato puree, a little of the reserved lentil cooking liquid to make a thick soft consistency. Season with salt and pepper. Bring to the boil, then reduce the heat and simmer for 10 minutes, adding more liquid if necessary."
    }
  ]
}
