  "recipeCuisine": "Italy",
  "name": "Creamy Tomato & Bacon Sauce",
  "text": "Creamy Tomato & Bacon Sauce\n\nPreparation time: 5 minutes\n\nCooking time: 15 minutes\n\nYield: 4\n\nIngredients\n\n2 cloves garlic,\n\n2 x 400 g cans chopped tomatoes,\n\n4 tbsp olive oil,\n\n1 tsp dried oregano,\n\n1 tsp castor sugar,\n\n8 rashers of smoked back bacon (finely chopped),\n\n75 g mascarpone cheese\n\nPreparation\n\n1. Put the garlic, tomatoes, oil, oregano and sugar in a saucepan, bring to the boil, then reduce the heat,  cover and simmer for 10 minutes.\n\n2. Add the bacon and simmer, uncovered for a further 5 minutes. Season to taste with salt and peper.\n\n3. Stir in the marscapone, heat through, and adjust the seasoning if necessary.",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "recipeYield": "4",
  "recipeIngredient": [
    "2 cloves garlic,",
    "2 x 400 g cans chopped tomatoes,",
    "4 tbsp olive oil,",
    "1 tsp dried oregano,",
    "1 tsp castor sugar,",
    "8 rashers of smoked back bacon (finely chopped),",
    "75 g mascarpone cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Put the garlic, tomatoes, oil, oregano and sugar in a saucepan, bring to the boil, then reduce the heat,  cover and simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "2. Add the bacon and simmer, uncovered for a further 5 minutes. Season to taste with salt and peper."
    },
    {
      "@type": "HowToStep",
      "text": "3. Stir in the marscapone, heat through, and adjust the seasoning if necessary."
    }
  ]
}
