{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Creamy Tomato & Bacon Sauce",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 cloves garlic,",
    "2 x 400 g cans chopped tomatoes,",
    "4 tbsp olive oil,",
    "1 tsp dried oregano,",
    "1 tsp castor sugar,",
    "8 rashers of smoked back bacon (finely chopped),",
    "75 g mascarpone cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the garlic, tomatoes, oil, oregano and sugar in a saucepan, bring to the boil, then reduce the heat,  cover and simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the bacon and simmer, uncovered for a further 5 minutes. Season to taste with salt and peper."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the marscapone, heat through, and adjust the seasoning if necessary."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
