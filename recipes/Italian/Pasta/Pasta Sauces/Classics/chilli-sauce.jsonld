{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Chilli Sauce",
  "prepTime": "PT15M",
  "cookTime": "PT45M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1-2 tbsp olive oil,",
    "1 large onion (finely chopped),",
    "2 cloves garlic (crushed),",
    "125 g rindless streaky bacon (chopped),",
    "1-2 fresh red or green chilies (chopped),",
    "400 g can of chopped tomatoes,",
    "50-75 g pecorino or Parmesan cheese (shaved),",
    "Salt & pepper,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a pan and cook the onion, garlic and bacon until lightly coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chilies, tomatoes, and 25 g of the cheese. Cook over a gentle heat for 30-40 minutes until the sauce thickens. Season to taste with salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Server at once, sprinkled with the remaining cheese."
    }
  ],
  "keywords": [
    "Pasta",
    "Pasta Sauces",
    "Classics"
  ]
}
