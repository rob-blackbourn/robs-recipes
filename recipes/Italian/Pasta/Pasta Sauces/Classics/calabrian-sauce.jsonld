  "recipeCuisine": "Italy",
  "name": "Calabrian Sauce",
  "text": "Calabrian Sauce\n\nPreparation time: 15 minutes\n\nCooking time: 35 minutes\n\nYield: 4\n\nIngredients\n\n1 1/2 x 400 g cans plum tomatoes,\n\n1/2 tbsp olive oil,\n\n2 garlic cloves (each cut into 3-4 pieces),\n\n1 chilli (cored and deseeded),\n\n125 g salami (thickly sliced),\n\nsalt,\n\n75 g pecorino cheese (shaved to serve).\n\nPreparation\n\n1. Crush the tomatoes or puree them in a food processor.\n\n2. Heat the oil in a saucepan and add the garlic and chilli and fry gently until the garlic is golden, crushing the chilli to release its flavour.\n\n3. Add the tomatoes and slices of salami and season to taste with salt. Bring to the biol, then reduce the heat and simmer for 30 minutes, until the sauce becomes denser and darker in colour. Serve sprinkled with pecorino shavings.",
  "prepTime": "PT15M",
  "cookTime": "PT35M",
  "recipeYield": "4",
  "recipeIngredient": [
    "1 1/2 x 400 g cans plum tomatoes,",
    "1/2 tbsp olive oil,",
    "2 garlic cloves (each cut into 3-4 pieces),",
    "1 chilli (cored and deseeded),",
    "125 g salami (thickly sliced),",
    "salt,",
    "75 g pecorino cheese (shaved to serve)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Crush the tomatoes or puree them in a food processor."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a saucepan and add the garlic and chilli and fry gently until the garlic is golden, crushing the chilli to release its flavour."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes and slices of salami and season to taste with salt. Bring to the biol, then reduce the heat and simmer for 30 minutes, until the sauce becomes denser and darker in colour. Serve sprinkled with pecorino shavings."
    }
  ]
