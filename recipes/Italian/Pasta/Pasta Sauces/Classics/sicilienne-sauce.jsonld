{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Sicilienne Sauce",
  "prepTime": "PT40M",
  "cookTime": "PT25M",
  "recipeYield": "4",
  "recipeIngredient": [
    "1 large aubergine (diced),",
    "1 tbsp olive oil,",
    "2 onions (chopped),",
    "2 cloves of garlic (chopped),",
    "400 g (13 oz) can chopped tomatoes,",
    "2 tsp chopped basil,",
    "salt and pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the diced aubergine in a colander, sprinkle with salt and leave for 30 minutes to remove any bitter taste. Rinse in cold water and dry well with kitchen paper."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a saucepan. Add the onion, garlic and aubergine and cook for 2-3 minutes. Add the tomatoes and their juice, together with basil, and season to taste with salt and pepper. Bring to the boil, then reduce the heat and simmer for 15-20 minutes."
    }
  ]
}
