{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Three Cheese Sauce",
  "prepTime": "PT5M",
  "cookTime": "PT5M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "4 tbsp lemon infused olive oil,",
    "3 tbsp chopped chives,",
    "1 tsp finely chopped rosemary,",
    "Good pinch of cayenne pepper,",
    "150 g ricotta cheese,",
    "50 g provolone or fontina cheese (thinly sliced),",
    "50 g Parmesan or pecorino cheese (freshly grated)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the oil, chives, rosemary and cayenne pepper into a saucepan and heat gently for 2 minutes so the herbs and spice infuse the oil."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the ricotta and heat gently, stirring, until it has softened."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the remaining cheeses and heat through gently for 1 minute until the sauce is smooth and creamy."
    }
  ]
}
