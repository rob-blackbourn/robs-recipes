{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Three Cheese Sauce",
  "text": "Three Cheese Sauce\n\nPreparation time: 5 minutes\n\nCooking time: 5 minutes\n\nYield: 2\n\nIngredients\n\n4 tbsp lemon infused olive oil,\n\n3 tbsp chopped chives,\n\n1 tsp finely chopped rosemary,\n\nGood pinch of cayenne pepper,\n\n150 g ricotta cheese,\n\n50 g provolone or fontina cheese (thinly sliced),\n\n50 g Parmesan or pecorino cheese (freshly grated).\n\nPreparation\n\n1. Put the oil, chives, rosemary and cayenne pepper into a saucepan and heat gently for 2 minutes so the herbs and spice infuse the oil.\n\n2. Stir in the ricotta and heat gently, stirring, until it has softened.\n\n3. Stir in the remaining cheeses and heat through gently for 1 minute until the sauce is smooth and creamy.",
  "prepTime": "PT5M",
  "cookTime": "PT5M",
  "recipeYield": "2",
  "recipeIngredient": [
    "4 tbsp lemon infused olive oil,",
    "3 tbsp chopped chives,",
    "1 tsp finely chopped rosemary,",
    "Good pinch of cayenne pepper,",
    "150 g ricotta cheese,",
    "50 g provolone or fontina cheese (thinly sliced),",
    "50 g Parmesan or pecorino cheese (freshly grated)."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Put the oil, chives, rosemary and cayenne pepper into a saucepan and heat gently for 2 minutes so the herbs and spice infuse the oil."
    },
    {
      "@type": "HowToStep",
      "text": "2. Stir in the ricotta and heat gently, stirring, until it has softened."
    },
    {
      "@type": "HowToStep",
      "text": "3. Stir in the remaining cheeses and heat through gently for 1 minute until the sauce is smooth and creamy."
    }
  ]
}
