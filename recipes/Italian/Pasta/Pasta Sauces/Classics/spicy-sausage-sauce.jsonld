{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Spicy Sausage Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT20M",
  "recipeYield": "4",
  "recipeIngredient": [
    "2 tsp cardamom pods,",
    "1 tsp cumin seeds,",
    "1 tsp fennel seeds,",
    "2 tbsp olive oil,",
    "1 red onion (thinly sliced),",
    "500 g sausages (skins removed),",
    "50 g pine nuts,",
    "3 tbsp chopped herbs (parsley, fennel, coriander),",
    "150 g green cabbage (very finely shredded),",
    "300 ml single cream,",
    "Salt & pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Crush the cardamom pods to release the seeds. Discard the shells and add to the cumin and fennel seeds. Crush until lighty ground."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oil in a large frying pan and fry the onion for 3 minutes. Ass the skinned sausages and fry gently, breaking them up into small pieces with a wooden spoon, for 6-8 minutes, until cooked through."
    },
    {
      "@type": "HowToStep",
      "text": "Add the pine nuts and the crushed seeds to the pan and cook gently for 3-5 minutes stirring frequently. Add the herbs and cabbage and fry for 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the cream and heat through for a further 2 minutes. Season to taste with salt and pepper."
    }
  ]
}
