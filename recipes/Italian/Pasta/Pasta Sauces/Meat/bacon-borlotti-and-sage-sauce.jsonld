    "250 g  can borlotti beans (rinsed and drained),",
    "2 tbsp chicken stock,",
    "1/2 tsp plain flour,",
    "1 tbsp tomato puree,",
    "2 tbsp red wine,",
    "salt & pepper,",
    "2 tbsp freshly grated Parmesan cheese,",
    "1 tbsp freshly grated pecorino cheese."
  ],
