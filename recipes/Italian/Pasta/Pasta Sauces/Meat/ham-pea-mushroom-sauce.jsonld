{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Ham Pea & Mushroom Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "50 g (2 oz) butter,",
    "250 g (8 oz) mushrooms (thinly sliced),",
    "100 g (4 oz) frozen peas,",
    "300 ml (1/2 pint) single cream,",
    "125 g (4 oz) lean cooked ham (cut into matchstick strips),",
    "125 g Parmesan cheese (finely grated),",
    "salt & pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt half the butter and gently fry the mushrooms until just tender. Season to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile cook the peas in boiling salted water until tender, then drain."
    },
    {
      "@type": "HowToStep",
      "text": "Put the remaining butter and cream into a saucepan and heat gently without allowing the mixture to boil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the mushrooms with their juice, the peas, and the ham."
    },
    {
      "@type": "HowToStep",
      "text": "Add one third of the Parmesan cheese and heat."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with the remaining Parmesan cheese."
    }
  ]
}
