    "300 ml (1/2 pint) single cream,",
    "125 g (4 oz) lean cooked ham (cut into matchstick strips),",
    "125 g Parmesan cheese (finely grated),",
    "salt & pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt half the butter and gently fry the mushrooms until just tender. Season to taste."
