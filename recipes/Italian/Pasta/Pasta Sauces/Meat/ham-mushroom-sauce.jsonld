{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Ham & Mushroom Sauce",
  "prepTime": "PT10M",
  "cookTime": "PT8M",
  "recipeYield": "4",
  "recipeIngredient": [
    "25 g (1 oz) butter,",
    "125 g (4 oz) mushrooms (sliced),",
    "175 g (6 oz) cooked ham (cut into matchstick strips),",
    "150 ml (1/4 pint) double cream,",
    "175 g (6 oz) Cheddar cheese (freshly grated),",
    "1 tbsp finely chopped parsley,",
    "handful of pitted black olives,",
    "salt & pepper,",
    "2 tbsp freshly grated Parmesan cheese."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt the butter in a large saucepan. Add the mushrooms and ham and fry for about 5 minutes until softened,"
    },
    {
      "@type": "HowToStep",
      "text": "Mix together the cream and cheese and stir into the mushroom and ham mixture. along with the parsley and olives. Stir gently over a low heat until slightly thickened. Season to taste and serve with grated Parmesan cheese."
    }
  ]
}
