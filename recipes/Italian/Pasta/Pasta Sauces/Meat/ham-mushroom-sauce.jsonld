  "recipeCuisine": "Italy",
  "name": "Ham & Mushroom Sauce",
  "text": "Ham & Mushroom Sauce\n\nPreparation time: 10 minutes\n\nCooking time: 8 minutes\n\nYield: 4\n\nIngredients\n\n25 g (1 oz) butter,\n\n125 g (4 oz) mushrooms (sliced),\n\n175 g (6 oz) cooked ham (cut into matchstick strips),\n\n150 ml (1/4 pint) double cream,\n\n175 g (6 oz) Cheddar cheese (freshly grated),\n\n1 tbsp finely chopped parsley,\n\nhandful of pitted black olives,\n\nsalt & pepper,\n\n2 tbsp freshly grated Parmesan cheese.\n\nPreparation\n\n1 Melt the butter in a large saucepan. Add the mushrooms and ham and fry for about 5 minutes until softened,\n\n2. Mix together the cream and cheese and stir into the mushroom and ham mixture. along with the parsley and olives. Stir gently over a low heat until slightly thickened. Season to taste and serve with grated Parmesan cheese.",
  "prepTime": "PT10M",
  "cookTime": "PT8M",
  "recipeYield": "4",
  "recipeIngredient": [
    "25 g (1 oz) butter,",
    "125 g (4 oz) mushrooms (sliced),",
    "175 g (6 oz) cooked ham (cut into matchstick strips),",
    "150 ml (1/4 pint) double cream,",
    "175 g (6 oz) Cheddar cheese (freshly grated),",
    "1 tbsp finely chopped parsley,",
    "handful of pitted black olives,",
    "salt & pepper,",
    "2 tbsp freshly grated Parmesan cheese."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1 Melt the butter in a large saucepan. Add the mushrooms and ham and fry for about 5 minutes until softened,"
    },
    {
      "@type": "HowToStep",
      "text": "2. Mix together the cream and cheese and stir into the mushroom and ham mixture. along with the parsley and olives. Stir gently over a low heat until slightly thickened. Season to taste and serve with grated Parmesan cheese."
    }
  ]
}
