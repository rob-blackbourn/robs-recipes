{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Pheasant Ravioli Filling",
  "recipeYield": "6 portions",
  "recipeIngredient": [
    "2 pheasant legs (deboned),",
    "a sprig of rosemary,",
    "1 banana shallot,",
    "40 g pancetta (chopped),",
    "4 tbsp double cream,",
    "1 egg,",
    "2 tbsp grated Parmesan."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 220°C."
    },
    {
      "@type": "HowToStep",
      "text": "Cut off the pheasant's legs, debone the thighs, reserving the bones and the lower leg for stock. Chop into two pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Season the skin."
    },
    {
      "@type": "HowToStep",
      "text": "Heat an ovenproof sauté pan until it smokes, add a tablespoon of vegetable oil and put in the legs, skin-side down. Cook until the skin turns golden."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chopped pancetta and a finely chopped shallot."
    },
    {
      "@type": "HowToStep",
      "text": "Turn over the legs, cook for a couple more minutes, then add a glass of dry white wine and cook until the alcohol evaporates."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to the oven until the meat is cooked through, then remove and allow to cool a little."
    },
    {
      "@type": "HowToStep",
      "text": "While the meat is still warm, tip the lot into a food processor and whizz to a rough paste."
    },
    {
      "@type": "HowToStep",
      "text": "Spoon a little of the mixture at a time on to a board, and run over it with a spatula or table knife, to feel whether there is any shot in it - if so, remove it."
    },
    {
      "@type": "HowToStep",
      "text": "Put the mixture into a bowl, add two tablespoons of grated Parmesan and one egg, and season."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in four tablespoons of double cream, then put into the fridge."
    },
    {
      "@type": "HowToStep",
      "text": "Once it's cold, roll small amounts of the mixture into little balls (two legs should give you enough for 32 balls), and place on a tray or plate, ready for filling your ravioli. These balls can also be frozen, for later use."
    }
  ]
}
