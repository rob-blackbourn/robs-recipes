{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Crab Tortellini with Lemongrass & Ginger Sauce",
  "recipeYield": "4",
  "recipeIngredient": [
    "For the crab ravioli mousse: 40g scallops,",
    "For the crab ravioli mousse: 1 egg yolk,",
    "For the crab ravioli mousse: 25ml double cream,",
    "For the crab ravioli mousse: 40g brown crab meat,",
    "For the crab ravioli mousse: 1 tsp finely chopped ginger (blanched three times),",
    "For the crab ravioli mousse: 125g white crab meat,",
    "For the crab ravioli mousse: cayenne pepper,",
    "For the crab ravioli mousse: lemon juice (to taste),",
    "For the crab ravioli mousse: salt and freshly ground black pepper,",
    "For the crab ravioli mousse: 1 pink grapefruit (peeled and cut into segments),",
    "For the crab ravioli mousse: 2 tbsp basil cress.",
    "For the basil oil: 10g fresh basil,",
    "For the basil oil: 100ml oz olive oil.",
    "For the basil purée: 500g basil leaves,",
    "For the basil purée: salt and freshly ground black pepper,",
    "For the pasta: 20g basil purée (see above),",
    "For the pasta: 20g basil oil (see above),",
    "For the pasta: 3 egg yolks,",
    "For the pasta: 1 egg,",
    "For the pasta: 250g ‘00’ plain flour,",
    "For the pasta: 1 tsp salt,",
    "For the pasta: 2 tsp water.",
    "For the lemongrass and ginger sauce: 75g unsalted butter,",
    "For the lemongrass and ginger sauce: 75g shallots,",
    "For the lemongrass and ginger sauce: 25g fresh ginger,",
    "For the lemongrass and ginger sauce: 50g fresh lemongrass,",
    "For the lemongrass and ginger sauce: 5g white peppercorns,",
    "For the lemongrass and ginger sauce: 5g coriander seeds,",
    "For the lemongrass and ginger sauce: 75g brown crab meat,",
    "For the lemongrass and ginger sauce: 250g crab carcasses (available from fishmongers),",
    "For the lemongrass and ginger sauce: 250ml fish stock,",
    "For the lemongrass and ginger sauce: 300g unsalted butter,",
    "For the lemongrass and ginger sauce: ½ tsp salt,",
    "For the lemongrass and ginger sauce: pinch ground white pepper,",
    "For the lemongrass and ginger sauce: 1 tsp lemon juice."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the crab ravioli mousse, place the scallops, egg yolk, cream and brown crab meat into a food processor and mix until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the mixture from the food processor and spoon into a bowl suspended over ice."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the ginger and white crabmeat. Season with salt, freshly ground black pepper and a pinch of cayenne pepper. Add a few drops of lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "For the basil oil, heat the oil to 80°C (use a thermometer to check this) and add the basil. Infuse for a few minutes and then blend in a food processor until smooth. Pass the mixture through a fine sieve and set aside"
    },
    {
      "@type": "HowToStep",
      "text": "For the basil purée, bring a pan of lightly salted water to the boil, add the basil leaves and cook for 1-2 minutes, or until soft and tender. Drain and refresh in iced water."
    },
    {
      "@type": "HowToStep",
      "text": "Pat the basil dry on kitchen paper, blend in a food processor until smooth and pass the mixture through a fine sieve."
    },
    {
      "@type": "HowToStep",
      "text": "For the ravioli pasta, place the basil purée, basil oil, egg, egg yolk, flour and salt into a food processor. Switch on the processor and slowly add the water until well combined. Remove the dough from the food processor, knead briefly until smooth, then wrap in clingfilm and chill in the fridge for 30 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "For the sauce, heat a heavy-based saucepan until medium hot, add the butter, shallots, ginger and lemongrass and fry for five minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the peppercorns and coriander seeds and fry for another two minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add the brown crab meat and crab carcasses and fry for five minutes"
    },
    {
      "@type": "HowToStep",
      "text": "Pour in the fish stock and bring to the boil then simmer for 20 minutes. Pass the mixture through a fine sieve into a clean saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "To finish the sauce, add the butter, salt, freshly ground black pepper and lemon juice. Whisk until well combined."
    },
    {
      "@type": "HowToStep",
      "text": "Split the crab mousse into four equal portions."
    },
    {
      "@type": "HowToStep",
      "text": "Roll the pasta out thinly using a pasta machine or rolling pin. Using a pastry cutter, cut the dough into 10cm/4in circles."
    },
    {
      "@type": "HowToStep",
      "text": "Place a spoonful of crab mixture onto a pasta circle, fold the top over to form a semicircle, press down lightly to seal then wrap the edges of the semi-circle around your index finger and join together."
    },
    {
      "@type": "HowToStep",
      "text": "Bring a saucepan of salted water to the boil, add the pasta and simmer for 4-5 minutes. Drain."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, place the tortellini into serving bowls, pour over the sauce and scatter with pink grapefruit and cress. Drizzle with a little basil oil."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 30 mins to 1 hour"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 10 to 30 mins"
    }
  ],
  "prepTime": "30 mins to 1 hour",
  "cookTime": "10 to 30 mins"
}
