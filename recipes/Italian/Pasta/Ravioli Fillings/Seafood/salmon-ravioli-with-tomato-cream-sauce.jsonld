    "For the sauce: 2 cups cherry tomatoes,",
    "For the sauce: 1 tbsp extra virgin olive oil,",
    "For the sauce: 1 clove finely chopped garlic,",
    "For the sauce: 1 tbsp finely chopped sage leaves,",
    "For the sauce: 3 anchovy fillets,",
    "For the sauce: 1/4 cup white wine,",
    "For the sauce: 1/2 cup double cream,",
    "For the sauce: salt and freshly ground black pepper,",
    "For the sauce: 1/2 cup freshly grated Parmesan,"
  ],
