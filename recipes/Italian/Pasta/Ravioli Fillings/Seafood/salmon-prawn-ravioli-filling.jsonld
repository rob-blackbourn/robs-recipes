{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Salmon & Prawn Ravioli Filling",
  "text": "Salmon & Prawn Ravioli Filling\n\nPreparation time: 10 minutes (with 20 minutes chilling time)\n\nCooking time: 5 minutes\n\nYield:\n\nIngredients\n\n400g smoked salmon,\n\n150g prawns,\n\n50ml heavy cream,\n\nJuice of 1/2 lemon,\n\nDill.\n\nPreparation\n\n1. Roughly chop 100g of smoked salmon and, in a food processor, combine with the cream and process to a paste. Chill for 20 minutes.\n\n2. Finely chop 300g of salmon and 150g prawns and mix with the chilled salmon and cream paste. Add roughly chopped dill.\n\n3. Chill for 20 minutes then roll into balls, or use immediately.",
  "cookTime": "PT5M",
  "recipeIngredient": [
    "400g smoked salmon,",
    "150g prawns,",
    "50ml heavy cream,",
    "Juice of 1/2 lemon,",
    "Dill."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Roughly chop 100g of smoked salmon and, in a food processor, combine with the cream and process to a paste. Chill for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "2. Finely chop 300g of salmon and 150g prawns and mix with the chilled salmon and cream paste. Add roughly chopped dill."
    },
    {
      "@type": "HowToStep",
      "text": "3. Chill for 20 minutes then roll into balls, or use immediately."
    }
  ],
  "comment": [
