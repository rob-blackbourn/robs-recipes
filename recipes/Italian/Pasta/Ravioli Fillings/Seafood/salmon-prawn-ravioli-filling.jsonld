{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Salmon & Prawn Ravioli Filling",
  "cookTime": "PT5M",
  "recipeIngredient": [
    "400g smoked salmon,",
    "150g prawns,",
    "50ml heavy cream,",
    "Juice of 1/2 lemon,",
    "Dill."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Roughly chop 100g of smoked salmon and, in a food processor, combine with the cream and process to a paste. Chill for 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Finely chop 300g of salmon and 150g prawns and mix with the chilled salmon and cream paste. Add roughly chopped dill."
    },
    {
      "@type": "HowToStep",
      "text": "Chill for 20 minutes then roll into balls, or use immediately."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 10 minutes (with 20 minutes chilling time)"
    }
  ],
  "prepTime": "10 minutes (with 20 minutes chilling time)"
}
