{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Fresh Salmon & Caper Ravioli Filling",
  "recipeYield": "4",
  "recipeIngredient": [
    "450g/1lb Skinless Salmon Fillet",
    "90ml/3fl.oz Crème Fraîche or Double Cream",
    "4 Spring (green) Onions, chopped",
    "4 tbsp Capers, chopped",
    "3 tbsp Fresh Coriander (Cilantro)",
    "1 tbsp Fresh Lemon Juice",
    "Salt and Black Pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the salmon into chunks then place in a food processor and pulse to chop."
    },
    {
      "@type": "HowToStep",
      "text": "Add the remaining ingredients and process until well blended but not too smooth."
    }
  ]
}
