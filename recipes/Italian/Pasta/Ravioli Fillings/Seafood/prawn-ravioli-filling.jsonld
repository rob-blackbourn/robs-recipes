{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Prawn Ravioli Filling",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 tbsp Butter",
    "1tbsp Olive Oil",
    "450g/1lb Raw Prawns (shrimp), Shelled and deveined",
    "1 Garlic Clove, chopped",
    "4 Spring Onions (Scallion), chopped",
    "Salt and black pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the butter and oil in a large frying pan, add the prawns, garlic and spring onions and stir fry for a few minutes until the prawns turn pink and are just cooked through."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the mixture to a food processor, season with salt and pepper and process until finely chopped but not too smooth. Allow to cool before using."
    }
  ]
}
