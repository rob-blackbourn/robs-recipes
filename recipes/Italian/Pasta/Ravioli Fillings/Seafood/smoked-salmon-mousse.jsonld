{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Smoked Salmon Mousse",
  "recipeIngredient": [
    "1/2 lb (250 g) smoked salmon,",
    "1 egg,",
    "100 ml double cream,",
    "1 tsp fresh chopped chives,",
    "pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Puree the smoked salmon and egg until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cream, chives and a little pepper."
    }
  ]
}
