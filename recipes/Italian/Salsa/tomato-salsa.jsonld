  "name": "Tomato Salsa",
  "prepTime": "PT10M",
  "recipeYield": "2",
  "recipeIngredient": [
    "1 vine tomatoes (de-seeded and chopped),",
    "1handful fresh basil leaves (torn),",
    "1 garlic clove (crushed to a paste with a knife),",
    "3tbsp olive oil,",
    "1 courgette (cut into ribbons with a potato peeler or mandolin),",
    "1 tbsp white wine vinegar,"
  ],
