{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Salsa Verde",
  "prepTime": "PT10M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "4 anchovy fillets,",
    "1 tbsp capers,",
    "1 clove garlic,",
    "1/2 lemon (zest and juice only),",
    "90ml olive oil,",
    "2 tbsp flat leaf parsley (chopped),",
    "1 tbsp basil (chopped),",
    "Salt & freshly ground black pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the anchovy fillets, capers and garlic into a mortar and pestle and pound until broken down."
    },
    {
      "@type": "HowToStep",
      "text": "Add the lemon zest and juice."
    },
    {
      "@type": "HowToStep",
      "text": "Add the olive oil in a steady stream, whisking to combine."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the parsley and basil then season with salt and pepper."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 30 minutes (to combine)"
    }
  ],
  "cookTime": "30 minutes (to combine)"
}
