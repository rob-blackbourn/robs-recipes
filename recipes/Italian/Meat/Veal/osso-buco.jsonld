    "Dried bay leaf",
    "Butter",
    "Olive oil",
    "Flour",
    "Red wine"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Season, dredge and sear the veal shanks on a medium high heat with olive oil and butter for 5 minutes on each side.."
    },
    {
      "@type": "HowToStep",
      "text": "Set aside the veal shanks and saute the onion, carrot and celery for about 5 minutes until softened."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic and saute for another 30 seconds"
    },
    {
      "@type": "HowToStep",
      "text": "Deglaze the pan with wine,"
    },
    {
      "@type": "HowToStep",
      "text": "Add the veal, tomatoes and stock."
    },
    {
      "@type": "HowToStep",
      "text": "Add the bay leaf and bouquet garnet."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and cook in the oven on 160°C for 2 to 2 1/2 hours."
    }
