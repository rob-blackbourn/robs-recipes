{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Vanilla Panna Cotta",
  "recipeYield": "4",
  "recipeIngredient": [
    "For the panna cotta: 3 gelatine leaves",
    "For the panna cotta: 250ml/9fl oz milk",
    "For the panna cotta: 250ml/9fl oz double cream",
    "For the panna cotta: 1 vanilla pod, split lengthways, seeds scraped out",
    "For the panna cotta: 25g/1oz sugar",
    "For the panna cotta: For the sauce",
    "For the panna cotta: 175g/6oz sugar",
    "For the panna cotta: 175ml/6fl oz water",
    "For the panna cotta: splash cherry liqueur",
    "For the panna cotta: 350g/12oz raspberries",
    "To serve: 4 sprigs fresh mint",
    "To serve: icing sugar, to dust"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "For the panna cotta, soak the gelatine leaves in a little cold water until soft."
    },
    {
      "@type": "HowToStep",
      "text": "Place the milk, cream, vanilla pod and seeds and sugar into a pan and bring to a simmer. Remove the vanilla pod and discard."
    },
    {
      "@type": "HowToStep",
      "text": "Squeeze the water out of the gelatine leaves, then add to the pan and take off the heat. Stir until the gelatine has dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the mixture among four ramekins and leave to cool. Place into the fridge for at least an hour, until set."
    },
    {
      "@type": "HowToStep",
      "text": "For the sauce, place the sugar, water and cherry liqueur into a pan and bring to the boil. Reduce the heat and simmer until the sugar has dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Take the pan off the heat and add half the raspberries. Using a hand blender, blend the sauce until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Pass the sauce through a sieve into a bowl and stir in the remaining fruit."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, turn each panna cotta out onto a serving plate. Spoon over the sauce and garnish with a sprig of mint. Dust with icing sugar."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 1 - 2 hours"
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 10 - 30 minutes"
    }
  ],
  "prepTime": "1 - 2 hours",
  "cookTime": "10 - 30 minutes"
}
