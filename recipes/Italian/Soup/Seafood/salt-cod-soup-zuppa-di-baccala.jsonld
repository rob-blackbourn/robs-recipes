{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Italy",
  "name": "Salt cod soup (Zuppa di baccala)",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "300 g salt cod,",
    "1 white onion (peeled),",
    "2 small carrots (peeled),",
    "2 sticks celery (trimmed, pale green inner leaves reserved),",
    "2 cloves garlic (peeled),",
    "1 small bunch fresh flat-leaf parsley (stalks and leaves separated),",
    "extra virgin olive oil,",
    "1 small dried red chilli (crumbled),",
    "2 x 400 g good-quality tinned plum tomatoes,",
    "425 ml light chicken stock,",
    "sea salt and freshly ground black pepper,",
    "juice of 1 lemon."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soak the fillets in cold water for 24 hours, changing the water a few times during this period."
    },
    {
      "@type": "HowToStep",
      "text": "Chop the onion, carrots, celery, garlic and parsley stalks. Heat a splash of olive oil in a saucepan, and add the chopped vegetables, parsley stalks and dried chilli. Sweat very slowly with the lid ajar for 15 to 20 minutes until soft, but not brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomatoes and simmer for 10 minutes, then add the stock and bring back to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Break up any larger pieces of tomato with a wooden spoon and drop the salt cod fillets into the hot soup. Simmer gently for 15 minutes, just until the fish has poached and flakes apart when prodded with a fork."
    },
    {
      "@type": "HowToStep",
      "text": "Pick out any bits of skin. Gently fold the flakes of fish through the soup, taste and season with pepper, salt (if needed) and a little lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "Chop the parsley and celery leaves and scatter over the soup. Drizzle with plenty of extra virgin olive oil."
    }
  ]
}
