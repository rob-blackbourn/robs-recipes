{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Moroccan Beef & Cauliflower",
  "prepTime": "PT15M",
  "cookTime": "PT1H10M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 head cauliflower",
    "1 1/2 lbs beef stew meat",
    "2 tablespoons olive oil",
    "1/2 onion, diced",
    "2 medium garlic cloves",
    "1/4 cup fresh parsley, finely chopped",
    "1 tablespoon tomato paste",
    "1 beef bouillon cube",
    "1 teaspoon cumin",
    "1/2 teaspoon ginger",
    "1/2 teaspoon black pepper",
    "1/2 teaspoon salt",
    "1/4 teaspoon turmeric"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pull off the green leaves surrounding the cauliflower. Then cut the bottom off & break the cauliflower into large pieces. Rinse & then place in a bowl to be used later."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the olive oil in either a saucepan or pressure cooker. Cook the beef in the oil until all the sides are brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add enough water in the pot to cover the beef. At this point put everything into the pot except the cauliflower and cover with a lid. If using a saucepan simmer the beef for 40 minutes, stirring occasionally. If you are using a pressure cooker, let the beef cook for 15 minutes (after the cooker begins to hiss)."
    },
    {
      "@type": "HowToStep",
      "text": "Dip the cauliflower into the sauce to cover all the sides. Once that is done leave it in the pot & recover with a lid. Simmer for another 15 minutes or until the cauliflower is done. If using a pressure cooker, cover and cook for additional 5-7 minutes (after the cooker begins to hiss)."
    }
  ]
}
