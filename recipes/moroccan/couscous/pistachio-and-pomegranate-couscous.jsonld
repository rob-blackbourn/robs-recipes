{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Morocco",
  "name": "Pistachio and Pomegranate Couscous",
  "prepTime": "PT5M",
  "cookTime": "PT10M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "200g couscous",
    "1 tbsp olive oil",
    "½ lemon, juice only",
    "250ml boiling water",
    "50g pistachio nuts, roughly chopped",
    "4 tbsp pomegranate seeds",
    "2 tbsp chopped fresh coriander leaves",
    "Salt and pepper for seasoning",
    "To serve",
    "1 lemon, juice only",
    "4 fresh coriander sprigs, leaves only"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the couscous, olive oil and lemon juice into a bowl. Pour over the boiling water, stir once, then cover the bowl tightly with cling film. Set aside for five minutes, or until the couscous has absorbed all of the water, then fluff the couscous grains with a fork."
    },
    {
      "@type": "HowToStep",
      "text": "Stir the chopped pistachios, pomegranate seeds and coriander into the couscous until well combined, then season, to taste, with salt and freshly ground black pepper."
    }
  ],
  "keywords": [
    "Couscous"
  ]
}
