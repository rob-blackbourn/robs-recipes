    "2 tsp cumin seeds",
    "2 tsp coriander seeds",
    "2 tbsp sweet paprika",
    "1 tbsp harissa paste",
    "1 tbsp salt",
    "1 tsp ground cinnamon",
    "1 tsp cayenne pepper",
    "1 tsp ground black pepper",
    "4 garlic cloves"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Grid spices and combine."
    }
  ],
