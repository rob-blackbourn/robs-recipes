{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Walnut Bread",
  "recipeYield": "1 loaf",
  "recipeIngredient": [
    "2 tsp dried active yeast",
    "1 cup strong wholemeal bread flour",
    "1/2 cup strong white bread flour",
    "1 tbsp olive oil",
    "165 ml warm water",
    "1 tsp salt",
    "1/4 cup walnut pieces"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix the yeast with 4 tbsp warm water."
    },
    {
      "@type": "HowToStep",
      "text": "Put the flour in a large mixing bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add the salt and mix thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Add the oil and yeast and make a dough, adding extra water if necessary."
    },
    {
      "@type": "HowToStep",
      "text": "Knead for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Set aside to prove for 40 minutes"
    },
    {
      "@type": "HowToStep",
      "text": "Add the walnuts."
    },
    {
      "@type": "HowToStep",
      "text": "Knock down and knead for another 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Set aside for 30 mins or until doubled in size."
    },
    {
      "@type": "HowToStep",
      "text": "Cook on 220°C (oven) for 25 minutes."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 1 small loaf"
    }
  ],
  "keywords": [
    "Miscellaneous",
    "Bread"
  ]
}
