{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Rosemary Olive Bread",
  "recipeYield": "1 loaf",
  "recipeIngredient": [
    "3 cups bread flour,",
    "1 tablespoon sugar,",
    "1 tablespoon salt,",
    "1 tablespoon active dry yeast,",
    "1 egg,",
    "170 g warm water,",
    "55 g olive oil,",
    "2 tablespoons fresh rosemary,",
    "1 cup pitted olives."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Dissolve the yeast in the warm water."
    },
    {
      "@type": "HowToStep",
      "text": "Combine beaten egg, olive oil, sugar, rosemary and olives and add the yeast/water mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add flour and knead for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Let the dough rest for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add salt and knead for another 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Place dough in bowl greased with olive oil. Cover. Let rise for one hour in a warm spot."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the dough.  Knead it a bit.  Form it into a ball and place on parchment paper."
    },
    {
      "@type": "HowToStep",
      "text": "Loosely cover with a towel and place it in a warm spot for 30 min."
    },
    {
      "@type": "HowToStep",
      "text": "Preheat the oven for one hour at 200°C."
    },
    {
      "@type": "HowToStep",
      "text": "Slash the top of the loaf before baking. Bake for 40 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from the oven and allow to cool for two hours or so before eating."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 1 large loaf"
    }
  ],
  "keywords": [
    "Miscellaneous",
    "Bread"
  ]
}
