{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Hard Boiled Eggs",
  "prepTime": "PT0M",
  "recipeYield": "4 eggs",
  "recipeIngredient": [
    "4 eggs"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the eggs in a cold pan of water."
    },
    {
      "@type": "HowToStep",
      "text": "Turn on the heat and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "From when it starts cook for 7 1/2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a bowl of cold water."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Cooking time: 10 minutes with 10 minutes waiting"
    }
  ],
  "cookTime": "PT10M",
  "keywords": [
    "Basics"
  ]
}
