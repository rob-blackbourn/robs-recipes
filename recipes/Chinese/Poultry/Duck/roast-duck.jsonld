{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "China",
  "name": "Roast Duck",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "1.8 kg Duck,",
    "5 cm piece of fresh ginger,",
    "2 tbsp dark soy sauce,",
    "1 tbsp honey,",
    "1 1/2 tsp Chinese five spice,",
    "1/2 tsp freshly ground white pepper,",
    "2 spring onions (chopped),",
    "Sesame oil or vegetable oil for basting."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Remove the giblets from the duck and rinse well."
    },
    {
      "@type": "HowToStep",
      "text": "Pour boiling water over the skin and set aside to dry for 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Grate 1/2 the ginger and squeeze the liquid into a small mixing bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add the honey, soy sauce, five spice powder and pepper to the bowl and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Paint 3/4 of the mixture over the duck skin."
    },
    {
      "@type": "HowToStep",
      "text": "Place the spring onions and the remaining ginger into the cavity."
    },
    {
      "@type": "HowToStep",
      "text": "Brush a large piece of foil with oil and set the duck in the centre and wrap well."
    },
    {
      "@type": "HowToStep",
      "text": "Place the duck in an oven dish and bake for 2 hours at 160°C."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the foil and prick the skin to release fat. Brush with the reserved marinade, then with oil."
    },
    {
      "@type": "HowToStep",
      "text": "Bake uncovered for 30 minutes, turning once."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Preparation time: 5 minutes then 2 hours wait, then 10 minutes."
    },
    {
      "@type": "Comment",
      "text": "Cooking time: 2 1/2 hours"
    }
  ],
  "prepTime": "5 minutes then 2 hours wait, then 10 minutes.",
  "cookTime": "PT2H30M"
}
