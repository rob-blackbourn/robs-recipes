{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Peking Duck",
  "text": "Peking Duck\n\nPreparation time:\n\nCooking time:\n\nYield: 1 duck\n\nIngredients\n\n1 duck,\n\nFor the stuffing\n\n4 tbsp hoisin sauce,\n\n2 tbsp sugar,\n\n2 tbsp garlic powder,\n\n1 tbsp 5 spice powder,\n\n1 tbsp white pepper,\n\n1 tbsp salt,\n\n1 tbsp ginger powder,\n\n1 slice ginger,\n\n1 spring onion\n\nFor the baste\n\n2 gallons water,\n\n1 tbsp dried liquorice,\n\n1 tbsp star anise,\n\n1 tbsp dried citrus peel\n\nFor the glaze\n\n450 ml honey.\n\n1 tbsp lemon juice,\n\n450ml vinegar,\n\n250ml maltose,\n\nPreparation\n\nIf the duck has the head on, pump air through the cavity to separate the skin from the flesh.\n\nIf they are not already removed, cut off the wings and the feet.\n\nIf they are not already removed, remove the innards.\n\nWash the duck, paying particular attention to the cavity.\n\nMix the ingredients for the stuffing.\n\nPut the stuffing inside the cavity.\n\nUse a skewer to sew up the cavity.\n\nIf you are going to hang the duck in the oven use two hooks under the legs or just use string.\n\nRefrigerate for 24 hours.\n\nAdd 2 gallons of water to a large pot.\n\nAdd the liquorice, star anise, and dried citrus peel, and boil for 15 minutes until the water changes colour.\n\nPut the honey in a medium sized bowl.\n\nAdd the lemon juice, vinegar, maltose.\n\nAdd the glaze to the baste.\n\nBaste the duck for 30 seconds.\n\nHang the duck to dry for a minimum of 5 hours. You can use a fan. The skin should become springy.\n\nHeat the oven to 350F.\n\nWhen the oven is up to temperature hang it in the oven and reduce the heat to 300F and cook for 40 - 45 minutes.\n\nTurn the duck after 20 minutes.",
  "recipeYield": "1 duck",
  "recipeIngredient": [
    "1 duck,",
    "For the stuffing: 4 tbsp hoisin sauce,",
    "For the stuffing: 2 tbsp sugar,",
    "For the stuffing: 2 tbsp garlic powder,",
    "For the stuffing: 1 tbsp 5 spice powder,",
    "For the stuffing: 1 tbsp white pepper,",
    "For the stuffing: 1 tbsp salt,",
    "For the stuffing: 1 tbsp ginger powder,",
    "For the stuffing: 1 slice ginger,",
    "For the stuffing: 1 spring onion",
    "For the baste: 2 gallons water,",
    "For the baste: 1 tbsp dried liquorice,",
    "For the baste: 1 tbsp star anise,",
    "For the baste: 1 tbsp dried citrus peel",
    "For the glaze: 450 ml honey.",
    "For the glaze: 1 tbsp lemon juice,",
    "For the glaze: 450ml vinegar,",
    "For the glaze: 250ml maltose,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "If the duck has the head on, pump air through the cavity to separate the skin from the flesh."
    },
    {
      "@type": "HowToStep",
      "text": "If they are not already removed, cut off the wings and the feet."
    },
    {
      "@type": "HowToStep",
      "text": "If they are not already removed, remove the innards."
    },
    {
      "@type": "HowToStep",
      "text": "Wash the duck, paying particular attention to the cavity."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the ingredients for the stuffing."
    },
    {
      "@type": "HowToStep",
      "text": "Put the stuffing inside the cavity."
    },
    {
      "@type": "HowToStep",
      "text": "Use a skewer to sew up the cavity."
    },
    {
      "@type": "HowToStep",
      "text": "If you are going to hang the duck in the oven use two hooks under the legs or just use string."
    },
    {
      "@type": "HowToStep",
      "text": "Refrigerate for 24 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Add 2 gallons of water to a large pot."
    },
    {
      "@type": "HowToStep",
      "text": "Add the liquorice, star anise, and dried citrus peel, and boil for 15 minutes until the water changes colour."
    },
    {
      "@type": "HowToStep",
      "text": "Put the honey in a medium sized bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add the lemon juice, vinegar, maltose."
    },
    {
      "@type": "HowToStep",
      "text": "Add the glaze to the baste."
    },
    {
      "@type": "HowToStep",
      "text": "Baste the duck for 30 seconds."
    },
    {
      "@type": "HowToStep",
      "text": "Hang the duck to dry for a minimum of 5 hours. You can use a fan. The skin should become springy."
    },
    {
      "@type": "HowToStep",
      "text": "Heat the oven to 350F."
    },
    {
      "@type": "HowToStep",
      "text": "When the oven is up to temperature hang it in the oven and reduce the heat to 300F and cook for 40 - 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Turn the duck after 20 minutes."
    }
  ]
}
