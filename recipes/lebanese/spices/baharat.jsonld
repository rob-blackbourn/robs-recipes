{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Baharat",
  "recipeCuisine": "Lebanese",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "recipeYield": "1 portion",
  "recipeIngredient": [
    "4 parts black pepper",
    "3 parts coriander seeds",
    "3 parts cinnamon",
    "3 parts cloves",
    "4 parts cumin seeds",
    "1 part cardamom pods",
    "3 parts nutmeg",
    "6 parts paprika"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all the ingredients into a pestle and grind until a fine powder."
    }
  ],
  "keywords": [
    "spice"
  ]
}
