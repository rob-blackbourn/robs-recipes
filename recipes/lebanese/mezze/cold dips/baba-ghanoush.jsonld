{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Baba Ghanoush",
  "recipeCuisine": "Lebanese",
  "cookTime": "PT30M",
  "prepTime": "PT5M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "1 large aubergine",
    "1 tbsp tahini",
    "1 clove garlic (crushed)",
    "1 tsp lemon juice",
    "Salt",
    "Olive oil to drizzle",
    "1 tbsp pomegranate seeds or flat leaf parsley (chopped) - optional"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the grill to it’s highest setting and grill the aubergine for about 30 minutes, turning regularly until their skins are blackened, the insides feel soft and they smell smokey."
    },
    {
      "@type": "HowToStep",
      "text": "Cut the aubergine in half and scoop out the soft flesh into a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Using a potato masher work into a coarse paste."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tahini, crushed garlic, lemon juice, a drizzle of olive oil, season with salt and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Make a well in the centre and drizzle in some olive oil, and sprinkle with pomegranate seeds or chopped flat leaf parsley."
    }
  ],
  "comment": [
    {
      "@type": "Comment",
      "text": "Original yield: 2 portions"
    }
  ],
  "keywords": [
    "Mezze",
    "Cold Dips"
  ]
}
