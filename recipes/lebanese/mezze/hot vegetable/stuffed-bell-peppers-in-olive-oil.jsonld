{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "recipeCuisine": "Lebanon",
  "name": "Stuffed Bell Peppers in Olive Oil",
  "cookTime": "PT50M",
  "prepTime": "PT30M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 colourful peppers",
    "3 tbsp olive oil",
    "Juice of 1 lemon",
    "2 tsp granulated sugar",
    "Pomegranate syrup or molasses for drizzling",
    "Lemon wedges to serve",
    "2 tbsp olive oil (For the stuffing)",
    "1 red onion finely chopped",
    "1 tsp granulated sugar (For the stuffing)",
    "2 tbsp pine nuts",
    "2 tbsp tiny currants soaked in boiling water for 10 minutes then drained",
    "2 tsp ground cinnamon",
    "1 tsp allspice",
    "1 tsp dried mint",
    "1 tsp tomato puree",
    "200g short grain or risotto rice (washed and drained)",
    "Salt and pepper for seasoning",
    "Small bunch flat leaf parsley (finely chopped)",
    "Small bunch dill (finely chopped)",
    "Small bunch mint (finely chopped)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat the oven to 180°C"
    },
    {
      "@type": "HowToStep",
      "text": "Heat the olive oil in a heavy based frying pan."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the onion and sugar for 2 minutes"
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the pine nuts until they turn golden."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the currents until they plump up."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cinnamon, allspice, dried mint, and tomato puree, and stir in the rice to coat it with the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Pour in 400ml of water"
    },
    {
      "@type": "HowToStep",
      "text": "Season with salt and pepper and bring to the boil."
    },
    {
      "@type": "HowToStep",
      "text": "Reduce the heat and cook gently for 15 minutes (until the water is absorbed, but the rice is still firm)."
    },
    {
      "@type": "HowToStep",
      "text": "Toss in the fresh herbs."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the stalk end off each pepper and remove the core and seeds."
    },
    {
      "@type": "HowToStep",
      "text": "Fill the peppers with the rice mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Put in a shallow baking dish"
    },
    {
      "@type": "HowToStep",
      "text": "In a bowl mix together the olive oil and lemon juice with 50ml water and 2 tsp sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the mixture over and around the peppers"
    },
    {
      "@type": "HowToStep",
      "text": "Put in the preheated oven for 50 minutes, basting from time to time, until they are tender and the liquid is caramelized."
    },
    {
      "@type": "HowToStep",
      "text": "Either eat hot or leave to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with a little of the cooking syrup drizzled over and a little for the pomegranate syrup or molasses."
    }
  ],
  "keywords": [
    "Mezze",
    "Hot Vegetable"
  ]
}
