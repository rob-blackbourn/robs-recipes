{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Garlicky potato puree with Olive Oil, Lemon and Parsley",
  "recipeCuisine": "Lebanese",
  "cookTime": "PT20M",
  "prepTime": "PT5M",
  "recipeYield": "2 servings",
  "recipeIngredient": [
    "350 g fluffy potatoes (peeled and roughly chopped)",
    "2 tbsp olive oil",
    "2 cloves garlic (crushed)",
    "1/2 lemon (juice)",
    "2 tbsp fresh dill",
    "2 spring onions (finely sliced)",
    "2 tbsp flat leaf parsley (finely chopped)",
    "Salt and pepper for seasoning"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Boil the potatoes in salted water until they are soft."
    },
    {
      "@type": "HowToStep",
      "text": "Drain, add the olive oil, and roughly mash."
    },
    {
      "@type": "HowToStep",
      "text": "Add the garlic, lemon juice, and dill and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer to a serving dish and sprinkle over with spring onions and parsely."
    }
  ],
  "keywords": [
    "mezze",
    "hot",
    "vegetable"
  ]
}
