{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Cosmopolitan",
  "recipeYield": "1 glass",
  "recipeCuisine": "Cocktail",
  "recipeIngredient": [
    "4 parts vodka",
    "1 1/2 parts cointreau",
    "1 1/2 parts lime juice",
    "3 parts cranberry juice"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add all ingredients into cocktail shaker filled with ice. Shake well and double strain into large cocktail glass. Garnish with lime wheel."
    }
  ],
  "keywords": [
    "Drinks"
  ]
}
