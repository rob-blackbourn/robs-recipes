{
  "name": "recipe-collection",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "normalize:temperatures": "node --experimental-strip-types scripts/normalize-temperatures.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html README.md .github/workflows/pages.yml",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html README.md .github/workflows/pages.yml"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
