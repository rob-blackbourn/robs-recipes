{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Thawt Man Plaa - Fish Cakes",
  "text": "Thawt Man Plaa - Fish Cakes\n\nYield: 30\n\nIngredients\n\n450g firm white fish fillets (roughly chopped),\n\n1 tbsp red curry paste,\n\n1 tbsp fish sauce,\n\n1 egg,\n\n50g green beans (very thinly sliced),\n\n5 kaffir lime leaves (finely shredded),\n\nPreparation\n\n1. Mince the fish in a food processor until smooth.\n\n2. Add the curry paste, fish sauce, and egg, then blend briefly.\n\n3. Spoon into a bowl and mix with the beans and lime leaves.\n\n4. Take a tbsp of the mixture and form into a 2” round cake.\n\n5. Shallow fry on both sides.",
  "recipeYield": "30",
  "recipeIngredient": [
    "450g firm white fish fillets (roughly chopped),",
    "1 tbsp red curry paste,",
    "1 tbsp fish sauce,",
    "1 egg,",
    "50g green beans (very thinly sliced),",
    "5 kaffir lime leaves (finely shredded),"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Mince the fish in a food processor until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "2. Add the curry paste, fish sauce, and egg, then blend briefly."
    },
    {
      "@type": "HowToStep",
      "text": "3. Spoon into a bowl and mix with the beans and lime leaves."
    },
    {
      "@type": "HowToStep",
      "text": "4. Take a tbsp of the mixture and form into a 2” round cake."
    },
    {
      "@type": "HowToStep",
      "text": "5. Shallow fry on both sides."
    }
  ]
}
