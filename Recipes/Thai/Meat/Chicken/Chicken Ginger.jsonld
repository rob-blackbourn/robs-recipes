  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add oil to the wook."
    },
    {
      "@type": "HowToStep",
      "text": "On a low heat, add the ginger and garlic and fry to 30 seconds. It should become fragrant."
    },
    {
      "@type": "HowToStep",
      "text": "Add the chicken. Increase to a medium heat. Fry for 2 minutes until slightly undercooked. The chicken should be white on the outside, but still slightly pink in the center."
