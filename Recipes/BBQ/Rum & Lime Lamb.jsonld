{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Rum & Lime Lamb",
  "text": "Rum & Lime Lamb\n\nPreparation time:\n\nCooking time:\n\nYield:\n\nIngredients\n\n220 g lamb neck fillet (cut into 1 inch cubes,\n\n1 tbsp olive oil,\n\n2 tbsp rum,\n\njuice of 1 lime,\n\n2 small spring onions,\n\n1/2 bay leaf,\n\n1 chilli (seeded and sliced),\n\n1/2 tsp ground allspice,\n\n1/2 tsp dried thyme,\n\n1 pinch cloves,\n\nPreparation\n\n1. Mix together and marinate for 4 hours.",
  "recipeIngredient": [
    "220 g lamb neck fillet (cut into 1 inch cubes,",
    "1 tbsp olive oil,",
    "2 tbsp rum,",
    "juice of 1 lime,",
    "2 small spring onions,",
    "1/2 bay leaf,",
    "1 chilli (seeded and sliced),",
    "1/2 tsp ground allspice,",
    "1/2 tsp dried thyme,",
    "1 pinch cloves,"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Mix together and marinate for 4 hours."
    }
  ]
}
