    "1 tbsp mirin,",
    "3 tbsp sake,",
    "1 chilli pepper."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Put all the ingredients into a saucepan and bring to the boil."
