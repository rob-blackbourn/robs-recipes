{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Ninjin Shirishiri",
  "text": "Ninjin Shirishiri\n\nPreparation time:\n\nCooking time:\n\nYield: 2\n\nIngredients\n\n1 large carrot (about 120g, half grated, half cut into matchsticks),\n\n40g tin of tuna in oil,\n\n1 egg (seasoned with a pinch of salt and lightly beaten),\n\n1 tsp sesame oil,\n\n1/2 tsp soy sauce,\n\nsalt,\n\n3 tbsp bonito flakes.\n\nPreparation\n\n1. Open the tin of tuna and drain the oil into a small frying pan.\n\n2. Fry the carrot in the pan. Adding a small amount of water will help the carrot cook quickly. Cook until soft.\n\n3. Add the tuna. Crumble into small pieces.\n\n4. Season with soy sauce and salt, and continue to stir fry.\n\n5. Pour over the egg and mix.\n\n6. Add the bonito flakes, lightly stir, and remove from the heat.",
  "recipeYield": "2",
  "recipeIngredient": [
    "1 large carrot (about 120g, half grated, half cut into matchsticks),",
    "40g tin of tuna in oil,",
    "1 egg (seasoned with a pinch of salt and lightly beaten),",
    "1 tsp sesame oil,",
    "1/2 tsp soy sauce,",
    "salt,",
    "3 tbsp bonito flakes."
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "1. Open the tin of tuna and drain the oil into a small frying pan."
    },
    {
      "@type": "HowToStep",
      "text": "2. Fry the carrot in the pan. Adding a small amount of water will help the carrot cook quickly. Cook until soft."
    },
    {
      "@type": "HowToStep",
      "text": "3. Add the tuna. Crumble into small pieces."
    },
    {
      "@type": "HowToStep",
      "text": "4. Season with soy sauce and salt, and continue to stir fry."
    },
    {
      "@type": "HowToStep",
      "text": "5. Pour over the egg and mix."
    },
    {
      "@type": "HowToStep",
      "text": "6. Add the bonito flakes, lightly stir, and remove from the heat."
    }
  ]
}
